// arXiv source page 4
#original-page(594.96pt, 842.04pt, none)[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.58pt, 790.2pt, "4 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 95.9pt, "technique, wherein the combs directly interrogate a sample—limiting its applicability to ")
  #line-at(85.104pt, 123.5pt, "passive or spontaneous optical phenomena that cannot be externally excited ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(451.78pt, 123.5pt, "[24]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(471.94pt, 123.5pt, ".  ")
  #line-at(96.984pt, 165.02pt, "To address this limitation, dual-comb correlation spectroscopy (DCCS) has emerged ")
  #line-at(85.104pt, 192.62pt, "as a passive measurement technique ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(278.81pt, 192.62pt, "[25-27]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(314.95pt, 192.62pt, ". In DCCS, two asynchronous combs ")
  #line-at(85.104pt, 220.22pt, "independently sample an external light source. By computing the temporal cross-")
  #line-at(85.104pt, 247.85pt, "correlation of the acquired signals, the system reconstructs the source’s spectral and phase ")
  #line-at(85.104pt, 275.45pt, "contents. This approach has been successfully demonstrated in the microwave domain ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(85.104pt, 303.05pt, "[26]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(105.26pt, 303.05pt, " and in the spectral reconstruction of natural incoherent light ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(405.43pt, 303.05pt, "[27]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(425.62pt, 303.05pt, ", though it has so ")
  #line-at(85.104pt, 330.65pt, "far been restricted to static or quasi-static measurements. ")
  #line-at(96.984pt, 372.29pt, "In this work, we extend DCCS for the first time to the investigation of laser dynamics, ")
  #line-at(85.104pt, 399.89pt, "demonstrating its previously unexplored ability to retrieve the complex behaviors—")
  #line-at(85.104pt, 427.51pt, "including intensity, frequency modes, and phase—of a laser during its startup process. ")
  #line-at(85.104pt, 455.11pt, "Using a high-repetition-rate dual-comb system, we capture rapid transitions from ")
  #line-at(85.104pt, 482.71pt, "amplified spontaneous emission (ASE) to the emergence of a CW background and the ")
  #line-at(85.104pt, 510.31pt, "eventual formation of coherent pulses. These results offer insights into transient processes ")
  #line-at(85.104pt, 537.91pt, "that are inaccessible with direct TS-DFT or conventional spectrometers.  ")
]

