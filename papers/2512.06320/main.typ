#original-page(594.96pt, 842.04pt, (image("graphics/page-07.png", width: 216pt), 221.5pt, 226.5pt))[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.58pt, 790.2pt, "7 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(96.984pt, 95.9pt, "When applied to the study of laser dynamics, DCCS offers several key advantages. (1) ")
  #line-at(85.104pt, 123.5pt, "It can resolve longitudinal laser modes and phase with exceptionally high resolution, set ")
  #line-at(85.104pt, 151.1pt, "primarily by the Fourier-transform time window. (2) Compared with laser heterodyne ")
  #line-at(85.104pt, 178.7pt, "radiometry (LHR), in which the test source is heterodyned with a single-frequency CW ")
  #line-at(85.104pt, 206.3pt, "laser, DCCS provides broadband spectral access and removes spectral ambiguities [")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(491.14pt, 206.3pt, "26")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(503.14pt, 206.3pt, "]. ")
  #line-at(85.104pt, 234.86pt, "(3)")
  #line-at(101.66pt, 234.86pt, "It enables rapid measurements with temporal resolutions set by of 1/")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(437.26pt, 234.86pt, "f")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(440.62pt, 234.86pt, ", which can be ")
  #line-at(85.104pt, 263.33pt, "as short as a few microseconds (μs), or potentially down to the nanosecond (ns) level [")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(491.14pt, 263.33pt, "28")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(503.14pt, 263.33pt, "]. ")
  #line-at(85.104pt, 290.93pt, "Combining these advantages, DCCS is expected to reveal laser dynamic processes that ")
  #line-at(85.104pt, 318.53pt, "are otherwise ‘invisible’ to traditional techniques. ")
  #line-at(96.984pt, 360.05pt, "Figure 1c illustrates our experimental setup. We employed two electro-optic (EO) ")
  #line-at(85.104pt, 388.61pt, "combs with ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(145.46pt, 388.61pt, "f")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.82pt, 389.57pt, "r")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(151.46pt, 388.61pt, "=25 GHz and ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(229.13pt, 388.61pt, "f")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(232.49pt, 388.61pt, " =1 MHz, supporting data refresh times as short as 1 μs. ")
  #line-at(85.104pt, 417.07pt, "Both combs were seeded by the same CW laser at 1550 nm (see Methods), ensuring an ")
  #line-at(85.104pt, 444.67pt, "excellent mutual coherence with dual-comb beat-note linewidths below 1 Hz. The two ")
  #line-at(85.104pt, 472.27pt, "combs were mixed on a photodetector to generate standard dual-comb signals for spectral ")
  #line-at(85.104pt, 499.87pt, "calibration. For DCCS measurements, the laser under investigation was equally split into ")
  #line-at(85.104pt, 527.47pt, "two paths and heterodyned with the two combs on separate balanced photodetectors ")
  #line-at(85.104pt, 555.07pt, "(BPDs, 20 GHz bandwidth). Meanwhile, a small fraction of the test laser was analyzed ")
  #line-at(85.104pt, 582.67pt, "using a TS-DFT system comprising a 10-km single-mode fiber (dispersion, –24 ps/nm/km) ")
  #line-at(85.104pt, 610.3pt, "and a high-speed photodetector (40 GHz bandwidth). The outputs of all four detectors ")
  #line-at(85.104pt, 637.9pt, "were simultaneously recorded by a four-channel high-speed oscilloscope (33 GHz ")
  #line-at(85.104pt, 665.5pt, "bandwidth, 20 GHz sampling rate), and the acquired data were post-processed to ")
  #line-at(85.104pt, 693.1pt, "reconstruct the test laser spectrum. Further experimental details are provided in ")
  #line-at(85.104pt, 720.7pt, "Supplementary Fig. S1. ")
]

