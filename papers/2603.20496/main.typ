#original-page(612pt, 792pt, (image("graphics/page-03.png", width: 471.5pt), 70.5pt, 72pt))[
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 81.08pt, "prior studies on laser-assisted contact optimization, ")
  #line-at(72.1pt, 91.58pt, "which have shown that reducing series resistance at ")
  #line-at(72.1pt, 102.85pt, "the contact interface leads to higher FF and overall ")
  #line-at(72.1pt, 114.1pt, "device efficiency [31], [32]. ")
  #line-at(86.35pt, 130.62pt, "The performance improvements are closely tied to ")
  #line-at(72.1pt, 141.12pt, "interfacial structural and chemical changes [32], ")
  #line-at(72.1pt, 152.4pt, "discussed in the following sections. Section 2A ")
  #line-at(72.1pt, 163.65pt, "describes the formation of Cu₃Si via interfacial ")
  #line-at(72.1pt, 174.17pt, "alloying; Section 2B examines its chemical durability; ")
  #line-at(72.1pt, 185.42pt, "Section ")
  #line-at(112.65pt, 185.42pt, "2C ")
  #line-at(135.18pt, 185.42pt, "evaluates its ")
  #line-at(202.611pt, 185.42pt, "role ")
  #line-at(228.858pt, 185.42pt, "in ")
  #line-at(246.856pt, 185.42pt, "mitigating ")
  #line-at(72.1pt, 195.92pt, "electromigration; and Section 2D discusses broader ")
  #line-at(72.1pt, 207.2pt, "implications for LECO-treated Cu contacts in scalable ")
  #line-at(72.1pt, 218.45pt, "manufacturing")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(132.93pt, 218.45pt, ".")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(86.35pt, 234.97pt, "A. Interfacial Alloying and Silicide Formation")
  #line-at(86.35pt, 364.1pt, "Figure 2: STEM/EDS elemental mapping of Cu ")
  #line-at(72.1pt, 375.35pt, "and Si at the contact interface. ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.35pt, 391.87pt, "Figure")
  #line-at(115.65pt, 391.87pt, "2")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(120.9pt, 391.87pt, " is the cross-sectional STEM bright-field ")
  #line-at(72.1pt, 402.37pt, "(BF) analysis, which provides direct morphological ")
  #line-at(72.1pt, 413.62pt, "and elemental evidence of interfacial alloying in ")
  #line-at(72.1pt, 424.9pt, "LECO-treated Cu-contact sample. EDS mapping ")
  #line-at(72.1pt, 435.4pt, "revealed localized co-distribution of copper and ")
  #line-at(72.1pt, 446.67pt, "silicon near the contact interface, indicating the ")
  #line-at(72.1pt, 457.17pt, "formation of Cu–Si intermetallic ")
  #line-at(234.171pt, 457.17pt, "phases. The ")
  #line-at(72.1pt, 468.42pt, "composition and distribution are consistent with the ")
  #line-at(72.1pt, 478.95pt, "formation of the copper-rich Cu₃Si phase, which is ")
  #line-at(72.1pt, 490.2pt, "thermodynamically stable and known to emerge under ")
  #line-at(72.1pt, 501.48pt, "moderate thermal activation. In contrast, nonLECO ")
  #line-at(72.1pt, 511.98pt, "samples exhibited sharp segregation of copper and ")
  #line-at(72.1pt, 523.23pt, "silicon, spatially separated by an intact glass frit layer, ")
  #line-at(72.1pt, 534.5pt, "with no signs of silicide formation. ")
  #line-at(86.35pt, 551.02pt, "These observations suggest that the LECO process ")
  #line-at(72.1pt, 561.53pt, "generates localized thermal conditions sufficient to ")
  #line-at(72.1pt, 572.78pt, "overcome the activation barrier for solid-state ")
  #line-at(72.1pt, 583.3pt, "diffusion, allowing silicon atoms to penetrate the ")
  #line-at(72.1pt, 594.55pt, "copper layer and form silicide. Literature reports ")
  #line-at(72.1pt, 605.83pt, "confirm that Cu₃Si can form at temperatures as low as ")
  #line-at(72.1pt, 616.32pt, "300 °C, with diffusion-limited growth kinetics typical ")
