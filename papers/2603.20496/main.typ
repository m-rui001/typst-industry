  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(86.35pt, 250.72pt, "Abstract")
  #set text(font: "Times New Roman", size: 11.25pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.15pt, 250.72pt, "—")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#222222"))
  #line-at(128.4pt, 250.72pt, "The formation of stable copper–silicide ")
  #line-at(72.1pt, 261.25pt, "(Cu₃Si) interfaces is crucial for cost-effective, high-")
  #line-at(72.1pt, 271pt, "efficiency solar cells. However, copper’s diffusivity and ")
  #line-at(72.1pt, 280.75pt, "electromigration issues pose challenges for contact ")
  #line-at(72.1pt, 290.52pt, "stability. This study employs Laser-Enhanced Contact ")
  #line-at(72.1pt, 300.27pt, "Optimization (LECO) to induce localized nano-scale ")
  #line-at(72.1pt, 310.8pt, "Joule heating at the Cu–Si interface in phosphorus-")
  #line-at(72.1pt, 320.55pt, "doped p-PERC solar cells. High-resolution STEM and ")
  #line-at(72.1pt, 330.3pt, "bright field analyses confirm stable Cu₃Si formation in ")
  #line-at(72.1pt, 340.07pt, "LECO-treated samples, with significantly reduced ")
  #line-at(72.1pt, 349.83pt, "material segregation compared to nonLECO samples. ")
  #line-at(72.1pt, 359.58pt, "SEM and post-etch EDS mapping demonstrate improved ")
  #line-at(72.1pt, 369.35pt, "chemical ")
  #line-at(119.359pt, 369.35pt, "resistance ")
  #line-at(170.371pt, 369.35pt, "and ")
  #line-at(198.109pt, 369.35pt, "interface ")
  #line-at(244.621pt, 369.35pt, "cleanliness. ")
  #line-at(72.1pt, 379.1pt, "Electrically, LECO treatment reduces series resistance ")
  #line-at(72.1pt, 388.85pt, "by a factor of 3, enhancing fill factor and efficiency while ")
  #line-at(72.1pt, 399.37pt, "preserving diode quality. These results highlight LECO ")
  #line-at(72.1pt, 409.12pt, "as a scalable method for reliable, silver-free solar cell ")
  #line-at(72.1pt, 418.9pt, "metallization. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(86.35pt, 434.65pt, "Keywords—PERC solar cells, Copper metallization, ")
  #line-at(72.1pt, 444.42pt, "LECO, Copper silicide, ")
  #line-at(178.73pt, 444.42pt, "Electromigration, ")
  #line-at(252.98pt, 444.42pt, "Diffusion ")
  #line-at(72.1pt, 454.18pt, "barrier, Intermetallic phases, Reliability, TEM, EDS, ")
  #line-at(72.1pt, 463.92pt, "Screen-printed ")
  #line-at(138.123pt, 463.92pt, "contacts, ")
  #line-at(181.73pt, 463.92pt, "Contact ")
  #line-at(221.492pt, 463.92pt, "resistance, ")
  #line-at(271.739pt, 463.92pt, "Cost ")
  #line-at(72.1pt, 473.7pt, "reduction ")
  #set text(font: "Times New Roman", size: 15.775pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(140.43pt, 495.45pt, "I. Introduction ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(86.35pt, 513.47pt, "Laser-Enhanced Contact Optimization (LECO) ")
  #line-at(72.1pt, 524.75pt, "offers an alternative strategy by applying localized, ")
  #line-at(72.1pt, 535.25pt, "high-density Joule heating directly at the metal–")
  #line-at(72.1pt, 546.5pt, "semiconductor interface ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.73pt, 546.5pt, "[1], ")
  #line-at(212.485pt, 546.5pt, "[2], ")
  #line-at(237.24pt, 546.5pt, "[3]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(248.55pt, 546.5pt, ". ")
  #line-at(262.07pt, 546.5pt, "LECO ")
  #line-at(72.1pt, 557.77pt, "selectively activates interface regions without globally ")
  #line-at(72.1pt, 568.28pt, "heating the entire wafer, thereby preserving the ")
  #line-at(72.1pt, 579.55pt, "sensitive surface passivation and underlying emitter ")
  #line-at(72.1pt, 590.05pt, "structures ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(113.4pt, 590.05pt, "[2], [4]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(141.93pt, 590.05pt, ". LECO has demonstrated the ability ")
  #line-at(72.1pt, 601.3pt, "to enhance Ag–Si bonding by promoting sintering and ")
  #line-at(72.1pt, 611.82pt, "decreasing contact resistivity ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(194.5pt, 611.82pt, "[1], [3]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(223.78pt, 611.82pt, ". For the Ag-Si ")
  #line-at(72.1pt, 623.07pt, "contact metallization, this has translated into lower ")
  #line-at(72.1pt, 634.35pt, "series ")
  #line-at(108.867pt, 634.35pt, "resistance ")
  #line-at(162.092pt, 634.35pt, "and ")
  #line-at(190.562pt, 634.35pt, "improved ")
  #line-at(242.257pt, 634.35pt, "mechanical ")
  #line-at(72.1pt, 644.85pt, "adhesion")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108.87pt, 644.85pt, "[3], [5]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(138.93pt, 644.85pt, " and hence higher fill factor and ")
  #line-at(72.1pt, 656.1pt, "efficiency boost. Despite the improved efficiency of ")
  #line-at(72.1pt, 666.63pt, "the solar cells due to the LECO post anneal process, ")
  #line-at(72.1pt, 677.88pt, "the cost of Ag metallization is still high and should be ")
  #line-at(72.1pt, 688.4pt, "replaced with an alternative metal such as Cu ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(257.57pt, 688.4pt, "[6], [7]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(285.35pt, 688.4pt, ",")
  #line-at(72.1pt, 699.65pt, "as highlighted by the long-term divergence in Ag and ")
  #line-at(72.1pt, 710.15pt, "Cu market prices shown in ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(182.47pt, 710.15pt, "Figure 1")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(216.27pt, 710.15pt, ". The extension of ")
  #line-at(324.4pt, 249.97pt, "LECO to Cu, introduces new interfacial dynamics due ")
  #line-at(324.4pt, 261.25pt, "to copper’s unique chemical behavior ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(479.1pt, 261.25pt, "[8]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(490.35pt, 261.25pt, ". ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(324.4pt, 443.67pt, "Figure 1: Historical Ag and Cu market prices over the past ")
  #line-at(324.4pt, 454.18pt, "two decades [9], [10].")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(338.67pt, 474.45pt, "However, a particular concern in Cu metallization ")
  #line-at(324.4pt, 485.7pt, "is the formation of hillocks stress-induced protrusions ")
  #line-at(324.4pt, 496.98pt, "that ")
  #line-at(352.119pt, 496.98pt, "develop ")
  #line-at(396.316pt, 496.98pt, "during ")
  #line-at(435.297pt, 496.98pt, "post-deposition ")
  #line-at(509.737pt, 496.98pt, "thermal ")
  #line-at(324.4pt, 507.48pt, "processing ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(373.95pt, 507.48pt, "[11], [12]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(416pt, 507.48pt, ". These hillocks can breach ")
  #line-at(324.4pt, 518.73pt, "dielectric caps or interlayer dielectrics, leading to short ")
  #line-at(324.4pt, 529.25pt, "circuits and early failure of devices ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(495.6pt, 529.25pt, "[11], [13]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(538.4pt, 529.25pt, ". ")
  #line-at(324.4pt, 540.5pt, "Traditional approaches to mitigate hillock formation, ")
  #line-at(324.4pt, 551.02pt, "such as introducing thick dielectric layers, pre-")
  #line-at(324.4pt, 562.27pt, "annealing strategies, or doping Cu with aluminum, ")
  #line-at(324.4pt, 573.52pt, "often require additional process complexity or ")
  #line-at(324.4pt, 584.05pt, "sacrifice scalability ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407pt, 584.05pt, "[12], [14], [15]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(469.32pt, 584.05pt, ". Likewise, while ")
  #line-at(324.4pt, 595.3pt, "conventional diffusion barriers like TaN or TiN are ")
  #line-at(324.4pt, 605.83pt, "widely used to confine Cu, they can introduce high ")
  #line-at(324.4pt, 617.08pt, "interfacial resistance or complicate integration with ")
  #line-at(324.4pt, 627.57pt, "low-temperature processes in solar cell manufacturing ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(324.4pt, 638.85pt, "[13], [16]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(362.7pt, 638.85pt, ". ")
  #line-at(338.67pt, 656.1pt, "For copper (Cu) to be used as a front-side ")
  #line-at(324.4pt, 666.63pt, "metallization material in solar cells for the next-")
  #line-at(324.4pt, 677.88pt, "generation photovoltaics, the challenges associated ")
  #line-at(324.4pt, 688.4pt, "with high diffusivity, chemical reactivity, and ")
  #line-at(324.4pt, 699.65pt, "mechanical instability under thermal and electrical ")
  #line-at(324.4pt, 710.15pt, "stress  should be investigated ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.05pt, 710.15pt, "[17], [18], [19], [20], ")
]

// arXiv source page 2
#original-page(612pt, 792pt, (image("graphics/page-02.png", width: 471.5pt), 70.5pt, 72pt))[
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 81.08pt, "[21]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(88.6pt, 81.08pt, ". These factors give rise to undesirable effects such ")
  #line-at(72.1pt, 91.58pt, "as contact degradation, diffusion into passivation ")
  #line-at(72.1pt, 102.85pt, "layers, and electromigration, all of which compromise ")
  #line-at(72.1pt, 113.35pt, "long-term device performance and yield ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(245.55pt, 113.35pt, "[22], [23], ")
  #line-at(72.1pt, 124.62pt, "[24]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(88.6pt, 124.62pt, ".  ")
  #line-at(86.35pt, 141.12pt, "Unlike Ag, Cu readily reacts with silicon at ")
  #line-at(72.1pt, 152.4pt, "moderate temperatures to form a series of intermetallic ")
  #line-at(72.1pt, 163.65pt, "silicides, notably Cu₅Si, Cu₁₅Si₄, and Cu₃Si, depending ")
  #line-at(72.1pt, 174.17pt, "on the local silicon availability and processing ")
  #line-at(72.1pt, 185.42pt, "temperature ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.65pt, 185.42pt, "[25]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(144.17pt, 185.42pt, ". Of these, Cu₃Si has received ")
  #line-at(72.1pt, 195.92pt, "particular attention due to its stability and self-limiting ")
  #line-at(72.1pt, 207.2pt, "nature during solid-state diffusion. The formation of ")
  #line-at(72.1pt, 217.7pt, "Cu₃Si at the copper–silicon interface has been shown ")
  #line-at(72.1pt, 228.97pt, "to reduce the availability of mobile Cu atoms, which ")
  #line-at(72.1pt, 239.47pt, "are otherwise prone to diffusive and electromigration-")
  #line-at(72.1pt, 250.72pt, "driven transport. Thermodynamic analyses have ")
  #line-at(72.1pt, 262pt, "confirmed that this silicidation reaction is mildly ")
  #line-at(72.1pt, 272.5pt, "exothermic, and kinetic studies show that it proceeds ")
  #line-at(72.1pt, 283.77pt, "via diffusion-limited mechanisms at temperatures as ")
  #line-at(72.1pt, 294.28pt, "low as 200–300 °C ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(162.2pt, 294.28pt, "[25], [26]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(204.25pt, 294.28pt, ". Notably, epitaxial ")
  #line-at(72.1pt, 305.53pt, "growth of Cu₃Si on Cu has been observed under ")
  #line-at(72.1pt, 316.05pt, "controlled silane treatments, forming coherent and ")
  #line-at(72.1pt, 327.3pt, "defect-minimized interfaces ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.73pt, 327.3pt, "[27], [28]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(225.27pt, 327.3pt, ". ")
  #line-at(86.35pt, 344.57pt, "In microelectronic applications, copper silicide has ")
  #line-at(72.1pt, 355.08pt, "been investigated as a passivation material that ")
  #line-at(72.1pt, 366.35pt, "simultaneously serves as a diffusion barrier and ")
  #line-at(72.1pt, 376.85pt, "adhesion promoter ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(158.45pt, 376.85pt, "[29], [30]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(200.5pt, 376.85pt, ". The silicide layer ")
  #line-at(72.1pt, 388.1pt, "“locks” copper atoms into a chemically stable lattice, ")
  #line-at(72.1pt, 398.62pt, "limiting their mobility and thereby suppressing ")
  #line-at(72.1pt, 409.87pt, "electromigration ")
  #line-at(148.53pt, 409.87pt, "and hillock ")
  #line-at(210.696pt, 409.87pt, "formation. Patent ")
  #line-at(72.1pt, 421.15pt, "disclosures have further emphasized its utility in ")
  #line-at(72.1pt, 431.65pt, "reducing oxidation, enhancing barrier performance, ")
  #line-at(72.1pt, 442.93pt, "and improving electromigration lifetime in damascene ")
  #line-at(72.1pt, 454.18pt, "interconnect structures ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(165.95pt, 454.18pt, "[14], [26]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(203.5pt, 454.18pt, ". ")
  #line-at(86.35pt, 470.7pt, "These insights suggest that LECO, by enabling ")
  #line-at(72.1pt, 481.2pt, "localized thermal activation, may trigger the formation ")
  #line-at(72.1pt, 492.45pt, "of such interfacial silicide layers in Cu metallization ")
  #line-at(72.1pt, 502.98pt, "schemes without the need for conventional high-")
  #line-at(72.1pt, 514.23pt, "temperature furnace annealing or plasma-enhanced ")
  #line-at(72.1pt, 525.5pt, "silane ")
  #line-at(106.586pt, 525.5pt, "environments. However, ")
  #line-at(224.52pt, 525.5pt, "the ")
  #line-at(247.754pt, 525.5pt, "interfacial ")
  #line-at(72.1pt, 536pt, "chemistry and structural consequences of LECO-")
  #line-at(72.1pt, 547.25pt, "induced silicidation in Cu contacts remain largely ")
  #line-at(72.1pt, 557.77pt, "unexplored, particularly in the context of solar cell ")
  #line-at(72.1pt, 569.02pt, "metallization. ")
  #line-at(86.35pt, 585.55pt, "To address this gap, we apply LECO to Cu contacts ")
  #line-at(72.1pt, 596.8pt, "on phosphorus-doped emitters and systematically ")
  #line-at(72.1pt, 608.08pt, "investigate the resulting interfacial transformations. ")
  #line-at(72.1pt, 618.57pt, "Using ")
  #line-at(109.608pt, 618.57pt, "high-resolution ")
  #line-at(183.856pt, 618.57pt, "Scanning ")
  #line-at(234.059pt, 618.57pt, "Transmission ")
  #line-at(72.1pt, 629.82pt, "Electron Microscopy (STEM) and post-etch Scanning ")
  #line-at(72.1pt, 640.35pt, "Electron Microscopy (SEM), we analyze the structural ")
  #line-at(72.1pt, 651.6pt, "and compositional changes induced by LECO. ")
  #line-at(72.1pt, 662.12pt, "Particular attention is given to the emergence of ")
  #line-at(72.1pt, 673.38pt, "copper silicide ")
  #line-at(145.537pt, 673.38pt, "phases, the suppression of Cu ")
  #line-at(72.1pt, 684.63pt, "diffusion, and the potential implications for contact ")
  #line-at(72.1pt, 695.9pt, "stability and performance.  ")
  #set text(font: "Times New Roman", size: 15.775pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(359.7pt, 86.33pt, "II. Experimental Method ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(338.67pt, 104.35pt, "Phosphorus-doped p-PERC silicon solar cells were ")
  #line-at(324.4pt, 114.85pt, "fabricated and metallized with screen-printed Cu front ")
  #line-at(324.4pt, 126.12pt, "contacts. After metallization, a subset of samples ")
  #line-at(324.4pt, 137.37pt, "underwent Laser-Enhanced Contact Optimization ")
  #line-at(324.4pt, 147.9pt, "(LECO), in which localized Joule heating was induced ")
  #line-at(324.4pt, 159.15pt, "at the metal–semiconductor interface to promote ")
  #line-at(324.4pt, 169.65pt, "contact formation while avoiding global wafer ")
  #line-at(324.4pt, 180.92pt, "heating. nonLECO samples were retained as controls ")
  #line-at(324.4pt, 191.42pt, "for ")
  #line-at(349.896pt, 191.42pt, "all ")
  #line-at(373.15pt, 191.42pt, "comparisons. ")
  #line-at(439.84pt, 191.42pt, "Current–voltage ")
  #line-at(518.785pt, 191.42pt, "(I–V) ")
  #line-at(324.4pt, 202.7pt, "measurements were performed before and after LECO ")
  #line-at(324.4pt, 213.95pt, "to quantify changes in device performance metrics, ")
  #line-at(324.4pt, 225.2pt, "including series resistance, fill factor, and efficiency. ")
  #line-at(338.67pt, 241.72pt, "Interfacial structure was examined using cross-")
  #line-at(324.4pt, 252.22pt, "sectional scanning transmission electron microscopy ")
  #line-at(324.4pt, 263.5pt, "(STEM) in bright-field (BF) mode. To assess chemical ")
  #line-at(324.4pt, 274pt, "durability and residual copper behavior, metallized ")
  #line-at(324.4pt, 285.27pt, "regions were sequentially etched in 70% HNO₃ ")
  #line-at(324.4pt, 295.77pt, "followed by 2.5% HF, and the post-etch morphology ")
  #line-at(324.4pt, 307.02pt, "and composition were evaluated by scanning electron ")
  #line-at(324.4pt, 318.3pt, "microscopy (SEM) at representative regions. ")
  #set text(font: "Times New Roman", size: 15.775pt, weight: "regular", style: "normal", fill: rgb("#000000"))
