#original-page(612pt, 792pt, (image("graphics/page-04.png", width: 471.5pt), 70.5pt, 72pt))[
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(72.1pt, 81.08pt, "and the Cu₃Si interface is likely passivated by a thin ")
  #line-at(72.1pt, 91.58pt, "SiO₂ layer formed through partial oxidation ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(248.55pt, 91.58pt, "[26], [36]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(286.1pt, 91.58pt, ". ")
  #line-at(72.1pt, 102.85pt, "HF may etch this oxide, but the underlying silicide ")
  #line-at(72.1pt, 113.35pt, "remains thin, adherent, and dispersed yielding a ")
  #line-at(72.1pt, 124.62pt, "weaker Cu signal in EDS, especially against the strong ")
  #line-at(72.1pt, 135.87pt, "Si background. ")
  #line-at(86.35pt, 152.4pt, "The absence of visible Cu-rich byproducts in ")
  #line-at(72.1pt, 163.65pt, "LECO-treated regions confirms that localized silicide ")
  #line-at(72.1pt, 174.17pt, "formation improves the chemical cleanliness and ")
  #line-at(72.1pt, 185.42pt, "integrity of the contact interface. These findings align ")
  #line-at(72.1pt, 195.92pt, "with reports of Cu₃Si forming a stable, conductive, and ")
  #line-at(72.1pt, 207.2pt, "corrosion-resistant interfacial layer, reinforcing the ")
  #line-at(72.1pt, 217.7pt, "role of LECO in both suppressing unwanted residues ")
  #line-at(72.1pt, 228.97pt, "and enabling high-quality metallization for solar cell ")
  #line-at(72.1pt, 240.22pt, "manufacturing. ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(86.35pt, 256.75pt, "C. Electromigration Resistance and Hillock ")
  #line-at(72.1pt, 268pt, "Suppression ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(86.35pt, 284.52pt, "At the atomic level, Cu₃Si formation immobilizes ")
  #line-at(72.1pt, 295.77pt, "copper atoms within ")
  #line-at(179.993pt, 295.77pt, "an intermetallic ")
  #line-at(260.938pt, 295.77pt, "lattice, ")
  #line-at(72.1pt, 306.27pt, "significantly reducing atomic mobility ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(244.8pt, 306.27pt, "[37]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(261.33pt, 306.27pt, ". This ")
  #line-at(72.1pt, 317.55pt, "structural ")
  #line-at(124.565pt, 317.55pt, "stabilization ")
  #line-at(188.252pt, 317.55pt, "effectively ")
  #line-at(245.201pt, 317.55pt, "suppresses ")
  #line-at(72.1pt, 328.05pt, "electromigration, a known reliability failure mode in ")
  #line-at(72.1pt, 339.33pt, "copper conductors and inhibits hillock formation ")
  #line-at(72.1pt, 350.58pt, "during thermal cycling. These reliability benefits are ")
  #line-at(72.1pt, 361.08pt, "well-documented in dual-damascene interconnects ")
  #line-at(72.1pt, 372.35pt, "and metal–insulator–metal (MIM) capacitors, where ")
  #line-at(72.1pt, 382.85pt, "silicide ")
  #line-at(110.349pt, 382.85pt, "formation has been shown to extend ")
  #line-at(72.1pt, 394.12pt, "electromigration ")
  #line-at(149.281pt, 394.12pt, "lifetime ")
  #line-at(191.264pt, 394.12pt, "and prevent thermal ")
  #line-at(72.1pt, 405.37pt, "extrusion defects ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(143.43pt, 405.37pt, "[14], [30]")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(180.98pt, 405.37pt, ". ")
  #line-at(86.35pt, 421.9pt, "Furthermore, the silicide layer naturally eliminates ")
  #line-at(72.1pt, 433.15pt, "native copper oxides such as CuO and Cu₂O, which are ")
  #line-at(72.1pt, 443.67pt, "typically brittle and poorly adhered. Their removal ")
  #line-at(72.1pt, 454.92pt, "during silicidation enhances interfacial adhesion and ")
  #line-at(72.1pt, 465.43pt, "provides a cleaner, more stable surface for subsequent ")
  #line-at(72.1pt, 476.7pt, "dielectric deposition. This is especially important in ")
  #line-at(72.1pt, 487.2pt, "PERC solar cells, where poor contact adhesion can ")
  #line-at(72.1pt, 498.48pt, "lead to delamination or contact degradation during ")
  #line-at(72.1pt, 509.73pt, "operation or encapsulation. ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(86.35pt, 526.25pt, "D. Implications for Device Performance and ")
  #line-at(72.1pt, 537.5pt, "Manufacturing ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(86.35pt, 554.03pt, "In addition to its chemical and mechanical ")
  #line-at(72.1pt, 565.28pt, "benefits, Cu₃Si retains good electrical conductivity. Its ")
  #line-at(72.1pt, 575.77pt, "presence at the contact interface improves the contact ")
  #line-at(72.1pt, 587.05pt, "homogeneity, which helps to lower the contact ")
  #line-at(72.1pt, 597.55pt, "resistance. By forming a nanometer-thick, conductive, ")
  #line-at(72.1pt, 608.83pt, "and self-limiting silicide layer, the LECO process ")
  #line-at(72.1pt, 620.08pt, "addresses both performance and reliability concerns ")
  #line-at(72.1pt, 630.58pt, "associated with copper metallization. This enables a ")
  #line-at(72.1pt, 641.85pt, "path forward for alternative to silver metal contacts ")
  #line-at(72.1pt, 652.35pt, "without compromising efficiency or longevity as a key ")
  #line-at(72.1pt, 663.62pt, "goal for cost-effective, high-volume solar cell ")
  #line-at(72.1pt, 674.13pt, "production. Collectively, these findings validate the ")
  #line-at(72.1pt, 685.4pt, "LECO process as an effective means of engineering ")
  #line-at(72.1pt, 696.65pt, "the Cu–Si interface through localized silicidation. The ")
  #line-at(72.1pt, 707.15pt, "resulting copper silicide layer serves as both a ")
  #line-at(72.1pt, 718.425pt, "diffusion barrier and mechanical stabilizer, reducing ")
  #line-at(324.4pt, 81.08pt, "copper mobility, enhancing adhesion, and suppressing ")
  #line-at(324.4pt, 91.58pt, "failure modes such as electromigration and hillock ")
  #line-at(324.4pt, 102.85pt, "growth. ")
  #set text(font: "Times New Roman", size: 15.775pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(387.47pt, 125.37pt, "IV. Conclusions ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(338.67pt, 143.37pt, "Through comparative analyses of LECO-treated ")
  #line-at(324.4pt, 153.9pt, "and nonLECO samples, we have shown that LECO ")
  #line-at(324.4pt, 165.15pt, "facilitates the formation of a chemically stable and ")
  #line-at(324.4pt, 175.67pt, "structurally copper silicide (Cu₃Si) layer at the Cu–Si ")
  #line-at(324.4pt, 186.92pt, "interface. This intermetallic layer resists chemical ")
  #line-at(324.4pt, 197.42pt, "etching and preserves the electrical and mechanical ")
  #line-at(324.4pt, 208.7pt, "integrity of the contact region under processing and ")
  #line-at(324.4pt, 219.95pt, "operational conditions. Microscopic and spectroscopic ")
  #line-at(324.4pt, 230.47pt, "characterization confirmed the presence of Cu₃Si and ")
  #line-at(324.4pt, 241.72pt, "related silicide phases, which function as self-aligned ")
  #line-at(324.4pt, 252.22pt, "diffusion barriers that mitigate copper migration and ")
  #line-at(324.4pt, 263.5pt, "electromigration, persistent challenges in copper-")
  #line-at(324.4pt, 274pt, "based metallization. Additionally, the silicide layer ")
  #line-at(324.4pt, 285.27pt, "improves interfacial adhesion and suppresses hillock ")
  #line-at(324.4pt, 295.77pt, "and void formation, both of which are critical to ")
  #line-at(324.4pt, 307.02pt, "ensuring long-term reliability. These findings align ")
  #line-at(324.4pt, 318.3pt, "with established thermodynamic and kinetic models of ")
  #line-at(324.4pt, 328.8pt, "silicide formation and are further supported by atomic-")
  #line-at(324.4pt, 340.07pt, "scale analyses and prior patent literature. ")
  #set text(font: "Times New Roman", size: 15.775pt, weight: "regular", style: "normal", fill: rgb("#000000"))
