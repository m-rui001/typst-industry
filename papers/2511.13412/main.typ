  #line-at(72pt, 512.88pt, "      Meanwhile, bulk-mode piezoelectric transformers are used to unify power and signal transfer (")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(521.88pt, 512.88pt, "Fig. ")
  #line-at(72pt, 525.54pt, "1c")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(82.38pt, 525.54pt, ")")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.04pt, 521.04pt, "24,25")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(101.82pt, 525.54pt, ", featuring excellent EMI immunity by their mechanical nature. Current piezoelectric transformers ")
  #line-at(72pt, 538.2pt, "use low-frequency bulk mechanical (elastic) waves generated piezoelectrically to deliver power from the ")
  #line-at(72pt, 550.86pt, "primary to the secondary side. At the receiver end, passive components, such as diode bridge rectifiers and ")
  #line-at(72pt, 563.46pt, "trigger circuits, are used for signal reconstruction, providing high fidelity signals with power driving ")
  #line-at(72pt, 576.12pt, "capabilities")
