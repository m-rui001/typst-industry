  #line-at(502.74pt, 94.92pt, "). High-")
  #line-at(72pt, 107.52pt, "frequency SAWs are well capable of carrying energies in solids; the SAWs are well confined in the device ")
  #line-at(72pt, 120.18pt, "region with minimal leakages. This allows future designs to put multiple SAW devices on a single chip die ")
  #line-at(72pt, 132.84pt, "without crosstalk.  ")
  #line-at(72pt, 153.48pt, "      Our SAW device achieves electrically isolated power and signal co-transmission for gate driving of ")
  #line-at(72pt, 166.14pt, "power transistors, while only signal transmission through SAW devices was explored in previous work")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
