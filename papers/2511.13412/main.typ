  #line-at(72pt, 197.1pt, "electrodes, known as IDTs, to piezoelectrically generate and receive microwave-frequency acoustic waves. ")
  #line-at(72pt, 209.76pt, "A full-bridge rectifier is used to down-convert the received signal from microwave frequency to low ")
  #line-at(72pt, 222.36pt, "frequency; for example, from amplitude-modulated 223 MHz signals to 10s kHz square wave signals. The ")
  #line-at(72pt, 235.02pt, "maximum cable-to-cable power transmission is -5.12 dB for the 223 MHz acoustic wave (")
