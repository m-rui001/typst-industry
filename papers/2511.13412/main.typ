  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(537.36pt, 166.14pt, ". ")
  #line-at(72pt, 178.8pt, "The carrier frequency of the radio frequency (RF) signal is tuned to the optimal frequency of the IDT. A 10 ")
  #line-at(72pt, 191.46pt, "kHz, 50% duty cycle pulse-width modulation (PWM) waveform (")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(357pt, 191.46pt, "Fig. 2d")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(388.92pt, 191.46pt, ") is used to modulate the RF carrier ")
