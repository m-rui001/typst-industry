  #line-at(72pt, 223.62pt, "Abstract ")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 244.26pt, "Electrical isolation is critical to ensure safety and minimize electromagnetic interference (EMI), yet existing ")
  #line-at(72pt, 256.86pt, "methods struggle to simultaneously transmit power and signals through a unified channel. Here we ")
  #line-at(72pt, 269.52pt, "demonstrate a mechanically-isolated gate driver based on microwave-frequency surface acoustic wave ")
  #line-at(72pt, 282.18pt, "(SAW) device on lithium niobate that achieves galvanic isolation of 2.75 kV with ultralow isolation ")
  #line-at(72pt, 294.84pt, "capacitance (0.032 pF) over 1.25 mm mechanical propagation length, delivering 13.4 V open-circuit voltage ")
  #line-at(72pt, 307.5pt, "and 44.4 mA short-circuit current. We demonstrate isolated gate driving for a gallium nitride (GaN) high-")
  #line-at(72pt, 320.16pt, "electron-mobility transistor, achieving a turn-on time of 108.8 ns comparable to commercial drivers and ")
  #line-at(72pt, 332.76pt, "validate its operation in a buck converter. In addition, our SAW device operates over an ultrawide ")
  #line-at(72pt, 345.42pt, "temperature range from 0.5 K (-272.6 °C) to 544 K (271 °C). The microwave-frequency SAW devices offer ")
  #line-at(72pt, 358.08pt, "inherent EMI immunity and potential for heterogeneous integration on multiple semiconductor platforms, ")
  #line-at(72pt, 370.74pt, "enabling compact, high-performance isolated power and signal transmission in advanced power electronics. ")
  #set text(font: "Times New Roman", size: 11.989pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 409.02pt, "Main ")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 429.84pt, "Power electronics form the backbone for modern electrical and electronic systems, supporting the ")
  #line-at(72pt, 442.5pt, "applications such as renewable energies, data centers, electric vehicles and space explorations")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(498.18pt, 438pt, "1,2")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(506.94pt, 442.5pt, ". These ")
  #line-at(72pt, 455.1pt, "systems usually operate across different voltage levels, including high voltages for power stages, and low ")
  #line-at(72pt, 467.76pt, "voltages for digital computing, control, and sensing stages. For example, the large DC motors used on high-")
  #line-at(72pt, 480.42pt, "speed trains can take 6.6 kV and 150 A")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(248.04pt, 475.92pt, "3,4")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(256.8pt, 480.42pt, ", while their control and sensing circuits remain at low voltages ")
  #line-at(72pt, 493.08pt, "(typically around 1 to 5 V)")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(192.84pt, 488.58pt, "5,6")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(201.66pt, 493.08pt, "; data centers receives medium-voltage AC (up to 35 kV) from utilities and ")
  #line-at(72pt, 505.74pt, "step it down through multiple stages to GPUs (a typical core voltage is around 1 V)")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(440.64pt, 501.24pt, "7,8")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.46pt, 505.74pt, " . Such large voltage ")
  #line-at(72pt, 518.34pt, "differences across high-power circuits and sensitive circuits necessitate robust and efficient electrical ")
  #line-at(72pt, 531pt, "isolation for preventing fault propagation, ensuring user and equipment safety, and preserving signal ")
  #line-at(72pt, 543.66pt, "integrity in complex electromagnetic environments")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(302.88pt, 539.16pt, "9-12")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(315.72pt, 543.66pt, ". This isolation typically requires separating both ")
  #line-at(72pt, 556.32pt, "control signals and the power that drives them, making simultaneous co-transmission of isolated power and ")
  #line-at(72pt, 568.98pt, "high-speed signals an attractive capability. As a representative example of isolated power and signal co-")
  #line-at(72pt, 581.64pt, "transmission, gate drivers for high-voltage transistors, which act as critical interfaces between control and ")
  #line-at(72pt, 594.24pt, "power domains, typically require both isolated pulse-width modulation (PWM) signals and isolated power ")
  #line-at(72pt, 606.9pt, "supplies to deliver 5–20 V gate control signals. This is usually implemented using discrete digital isolators ")
  #line-at(72pt, 619.56pt, "and isolated power modules, which increases system complexity and vulnerability")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(433.68pt, 615.06pt, "13,14")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.46pt, 619.56pt, ".  ")
  #line-at(72pt, 640.2pt, "      Galvanic isolated gate drivers have been achieved by inductive")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(384.24pt, 635.7pt, "15-17")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(400.62pt, 640.2pt, ", capacitive")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.94pt, 635.7pt, "18-20")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(469.32pt, 640.2pt, ", optoelectronic ")
  #line-at(72pt, 652.86pt, "components")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(125.16pt, 648.36pt, "21-23")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(141.54pt, 652.86pt, " (")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(149.46pt, 652.86pt, "Figs. 1a and 1b")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(224.82pt, 652.86pt, ") and low-frequency piezoelectric transducers")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(431.52pt, 648.36pt, "24,25")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(447.3pt, 652.86pt, " (")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(455.22pt, 652.86pt, "Fig. 1c")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.8pt, 652.86pt, "). Inductive ")
  #line-at(72pt, 665.52pt, "transformers offer high power capability and efficient energy conversion. However, they are typically bulky, ")
  #line-at(72pt, 678.18pt, "emit electromagnetic radiation, and require separate channels for signal and power transmission")
  #set text(font: "Times New Roman", size: 7.013pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(516.24pt, 673.68pt, "26")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(523.32pt, 678.18pt, ". In ")
  #line-at(72pt, 690.78pt, "addition, their large interwinding capacitance can act as a path for electromagnetic interference (EMI) ")
  #line-at(72pt, 703.44pt, "propagation. Capacitive isolation offers high-bandwidth signal transmission, but the fragile on-chip ")
  #line-at(72pt, 716.1pt, "capacitive barriers are typically susceptible to EMI. Besides, there is currently no simple and cost-effective ")
]

