  #line-at(342.72pt, 82.26pt, ", we measure the mechanical displacement ")
  #line-at(72pt, 94.92pt, "profile showing the acoustic wave propagation between the input and output IDTs (")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "bold", style: "normal", fill: rgb("#000000"))
