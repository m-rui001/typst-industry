  #line-at(122.04pt, 571.62pt, "24")
  #set text(font: "Times New Roman", size: 10.97pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(129.12pt, 576.12pt, ". Nevertheless, for current piezoelectric transformers, their operating frequencies below tens ")
  #line-at(72pt, 588.78pt, "of megahertz and their high mechanical ")
