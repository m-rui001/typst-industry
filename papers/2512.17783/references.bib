@article{zhou_divided-pulse_2007,
	title = {Divided-pulse amplification of ultrashort pulses},
	volume = {32},
	rights = {© 2007 Optical Society of America},
	issn = {1539-4794},
	url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-32-7-871},
	doi = {10.1364/OL.32.000871},
	abstract = {We propose and demonstrate a new approach, to the best of our knowledge, for avoiding nonlinear effects in the amplification of ultrashort optical pulses. The initial pulse is divided longitudinally into a sequence of lower-energy pulses that are otherwise identical to the original, except for the polarization. The low-intensity pulses are amplified and then recombined to create a final intense pulse. This divided-pulse amplification complements techniques based on dispersion management.},
	pages = {871--873},
	number = {7},
	journal = {Optics Letters},
	shortjournal = {Opt. Lett., {OL}},
	author = {Zhou, Shian and Wise, Frank W. and Ouzounov, Dimitre G.},
	urlyear = {2024-11-06},
	year = {2007},
	keywords = {Dispersion, Nonlinear effects, Optical amplifiers, Phase shift, Picosecond pulses, Ultrashort pulses},
}


@article{zhou_efficient_2007,
	title = {Efficient temporal shaping of ultrashort pulses with birefringent crystals},
	volume = {46},
	rights = {© 2007 Optical Society of America},
	issn = {2155-3165},
	url = {https://opg.optica.org/ao/abstract.cfm?uri=ao-46-35-8488},
	doi = {10.1364/AO.46.008488},
	abstract = {We report on a simple and robust technique to temporally shape ultrashort pulses. A number of birefringent crystals with appropriate crystal length and orientation form a crystal set. When a short pulse propagates through the crystal set, the pulse is divided into numerous pulses, producing a desired temporal shape. Flexibility in the final pulse shape is achieved through varying initial pulse duration, divided-pulse number, the polarization-mode delay, and energy distribution of the divided pulses. The energy efficiency of the technique is near 100\% for a pulse train of alternating polarizations, and 50\% for a linearly polarized pulse train.},
	pages = {8488--8492},
	number = {35},
	journal = {Applied Optics},
	shortjournal = {Appl. Opt., {AO}},
	author = {Zhou, Shian and Ouzounov, Dimitre and Li, Heng and Bazarov, Ivan and Dunham, Bruce and Sinclair, Charles and Wise, Frank W.},
	urlyear = {2024-11-06},
	year = {2007},
	keywords = {Deformable mirrors, Femtosecond pulses, Michelson interferometers, Picosecond pulses, Spatial light modulators, Ultrashort pulses},
}


@article{daniault_high_2012,
	title = {High peak-power stretcher-free femtosecond fiber amplifier using passive spatio-temporal coherent combining},
	volume = {20},
	rights = {© 2012 {OSA}},
	issn = {1094-4087},
	url = {https://opg.optica.org/oe/abstract.cfm?uri=oe-20-19-21627},
	doi = {10.1364/OE.20.021627},
	abstract = {We report on the passive coherent combining of up to 8 temporally and spatially separated ultrashort pulses amplified in a stretcher-free ytterbium-doped fiber system. An initial femtosecond pulse is split into 4 temporal replicas using divided-pulse amplification, and subsequently divided in two counter-propagating beams in a Sagnac interferometer containing a fiber amplifier. The spatio-temporal distribution of the peak-power inside the amplifier allows the generation of record 3.1 µJ and 50 fs pulses at 1 {MHz} of repetition rate with 52 {MW} of peak-power from a stretcher-free fiber amplifier and without additional nonlinear post-compression stages.},
	pages = {21627--21634},
	number = {19},
	journal = {Optics Express},
	shortjournal = {Opt. Express, {OE}},
	author = {Daniault, L. and Hanna, M. and Papadopoulos, D. N. and Zaouter, Y. and Mottay, E. and Druon, F. and Georges, P.},
	urlyear = {2024-11-06},
	year = {2012},
	keywords = {Femtosecond lasers, Femtosecond pulses, Free space optics, Laser sources, Photonic crystal fibers, Ultrashort pulses},
}


@article{ji_high-speed_2008,
	title = {High-speed, low-photodamage nonlinear imaging using passive pulse splitters},
	volume = {5},
	issn = {1548-7105},
	doi = {10.1038/nmeth.1175},
	abstract = {Pulsed lasers are key elements in nonlinear bioimaging techniques such as two-photon fluorescence excitation ({TPE}) microscopy. Typically, however, only a percent or less of the laser power available can be delivered to the sample before photoinduced damage becomes excessive. Here we describe a passive pulse splitter that converts each laser pulse into a fixed number of sub-pulses of equal energy. We applied the splitter to {TPE} imaging of fixed mouse brain slices labeled with {GFP} and show that, in different power regimes, the splitter can be used either to increase the signal rate more than 100-fold or to reduce the rate of photobleaching by over fourfold. In living specimens, the gains were even greater: a ninefold reduction in photobleaching during in vivo imaging of Caenorhabditis elegans larvae, and a six- to 20-fold decrease in the rate of photodamage during calcium imaging of rat hippocampal brain slices.},
	pages = {197--202},
	number = {2},
	journal = {Nature Methods},
	shortjournal = {Nat Methods},
	author = {Ji, Na and Magee, Jeffrey C. and Betzig, Eric},
	year = {2008},
	pmid = {18204458},
	keywords = {Animals, Equipment Design, Equipment Failure Analysis, Image Enhancement, Mice, Microscopy, Fluorescence, Lighting, Caenorhabditis elegans, Cell Survival, Cells, Cultured, Lasers, Light, Nonlinear Dynamics, Rats},
}



