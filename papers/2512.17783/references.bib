	langid = {english},
	keywords = {Microscopy, Fluorescence imaging},
	file = {41467_2019_13841_MOESM1_ESM.pdf:C\:\\Users\\zhu\\Documents\\BaiduNetdiskWorkspace\\storage\\C27ZTJ23\\41467_2019_13841_MOESM1_ESM.pdf:application/pdf;Full Text PDF:C\:\\Users\\zhu\\Documents\\BaiduNetdiskWorkspace\\storage\\I326DD35\\Mandracchia et al. - 2020 - Fast and accurate sCMOS noise correction for fluor.pdf:application/pdf},
