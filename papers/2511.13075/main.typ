  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 84.14pt, "The two curves measured under zero-field cooling (ZFC) and field cooling (FC) ")
