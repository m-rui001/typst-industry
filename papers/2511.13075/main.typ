// arXiv source page 11
#original-page(595.32pt, 841.92pt, (image("graphics/page-11.png", width: 415.5pt), 90pt, 104pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 84.14pt, "Discussion ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 99.74pt, "The observed magnetism in the embedded zGNRs corroborate the nature of the ")
  #line-at(90.024pt, 115.34pt, "predicted emergent magnetic order in zGNRs. The results are not only of scientific ")
  #line-at(90.024pt, 130.94pt, "interest in the interplay between electric fields and electronic spin degree of freedom in ")
  #line-at(90.024pt, 146.54pt, "solids")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(118.1pt, 141.98pt, "6,7,48,49")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.34pt, 146.54pt, " but may also open a new path to explore spintronics")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(401.11pt, 141.98pt, "3,50-52")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(426.1pt, 146.54pt, "at the nanometre ")
  #line-at(90.024pt, 162.14pt, "scale, based on graphene. Further, first-principle calculations showed that zigzag-")
  #line-at(90.024pt, 177.74pt, "oriented GNRs could display the property of half-metallicity when electric fields were ")
  #line-at(90.024pt, 193.34pt, "applied across the zigzag directions")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(258.05pt, 188.78pt, "4,10")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(272.21pt, 193.34pt, ". As a spin-polarized conductance mode, the half-")
  #line-at(90.024pt, 208.94pt, "metallicity is an important enabling phenomenon for the development of graphene-")
  #line-at(90.024pt, 224.54pt, "based spintronic devices because it provides an energy-efficient route to control ")
  #line-at(90.024pt, 240.14pt, "magnetic properties using electric field. It is expect that the availability of zGNRs will ")
  #line-at(90.024pt, 255.77pt, "enable the characterization of their predicted spin-related properties, such as spin ")
  #line-at(90.024pt, 271.37pt, "confinement")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.9pt, 266.81pt, "11,53 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(171.98pt, 271.37pt, "and filtering")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(231.41pt, 266.81pt, "54")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(239.57pt, 271.37pt, ", and will ultimately add the spin degree of freedom to ")
  #line-at(90.024pt, 286.97pt, "graphene-based circuitry. Therefore, our work ignites the potential of structure ")
  #line-at(90.024pt, 302.57pt, "engineering for driving nonmagnetic graphene into magnetic phases, thereby opening ")
  #line-at(90.024pt, 318.17pt, "new directions for exploring spin transport in graphene-based magnets.  ")
