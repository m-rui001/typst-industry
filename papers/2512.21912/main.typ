  #line-at(209.4pt, 421.56pt, "n")
  #set text(font: "Times New Roman", size: 9.695pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(214.32pt, 421.56pt, " is the number of ")
  #line-at(45.6pt, 433.2pt, "points (406,702), and ")
  #set text(font: "Times New Roman", size: 9.695pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(131.4pt, 433.2pt, "T")
  #set text(font: "Times New Roman", size: 6.307pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.8pt, 434.16pt, "0")
