  #set text(font: "Times New Roman", size: 10.746pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(279.96pt, 166.32pt, ", Chengrong Wang, Changjun Liu, ")
  #set text(font: "Times New Roman", size: 10.746pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(430.92pt, 166.32pt, "senior")
  #line-at(460.32pt, 166.32pt, "Member, IEEE,  ")
  #set text(font: "Times New Roman", size: 10.746pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(186.48pt, 178.56pt, "Xiang Zhao, and Liping Yan, ")
  #set text(font: "Times New Roman", size: 10.746pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(315.36pt, 178.56pt, "senior")
  #line-at(344.76pt, 178.56pt, "Member, IEEE")
  #set text(font: "Times New Roman", size: 8.76pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(47.76pt, 202.08pt, "Abstract")
  #set text(font: "Times New Roman", size: 8.76pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(78pt, 202.08pt, "—A novel method for enhancing microwave heating ")
  #line-at(45.6pt, 213pt, "uniformity using a 2-bit coding metasurface is proposed. This ")
  #line-at(45.6pt, 223.44pt, "metasurface is specially designed to scatter incident waves into ")
  #line-at(45.6pt, 234.12pt, "multiple directions at 2.45 GHz rather than just one, significantly ")
  #line-at(45.6pt, 244.56pt, "improving the electric field distribution uniformity within a ")
  #line-at(45.6pt, 255.24pt, "cavity, eliminating the need to redesign the cavity itself or modify ")
  #line-at(45.6pt, 265.8pt, "the power excitation. Simulated results demonstrate a reduction ")
  #line-at(45.6pt, 276.36pt, "in the coefficient of variation (COV) of potato temperature from ")
  #line-at(45.6pt, 286.92pt, "0.694 to 0.461, indicating enhanced heating uniformity while ")
  #line-at(45.6pt, 297.48pt, "maintaining efficiency. Additionally, the measured potato ")
  #line-at(45.6pt, 308.16pt, "temperatures show excellent agreements with the simulated ")
  #line-at(45.6pt, 318.6pt, "results, validating the effectiveness of the proposed method. ")
  #set text(font: "Times New Roman", size: 8.76pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(45.6pt, 340.32pt, "Index ")
  #line-at(77.609pt, 340.32pt, "Terms")
  #set text(font: "Times New Roman", size: 8.76pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(100.44pt, 340.32pt, "—Microwave ")
  #line-at(162.337pt, 340.32pt, "heating ")
  #line-at(201.455pt, 340.32pt, "cavity, ")
  #line-at(237.231pt, 340.32pt, "2-bit ")
  #line-at(266.045pt, 340.32pt, "coding ")
  #line-at(45.6pt, 350.4pt, "metasurface, uniformity improvement. ")
  #set text(font: "Times New Roman", size: 9.695pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.56pt, 384.24pt, "I.")
  #line-at(135.24pt, 384.24pt, "INTRODUCTION ")
  #line-at(87.6pt, 399.36pt, "CROWAVE heating has been widely applied in ")
  #line-at(87.6pt, 411.12pt, "food processing, drying, chemical reactions, and ")
  #line-at(87.6pt, 422.88pt, "medicine due to its high heating efficiency, low ")
  #line-at(45.6pt, 434.64pt, "energy consumption, and environmental friendliness [1] - [3]. ")
  #line-at(45.6pt, 446.28pt, "However, the non-uniform distribution of electric field (E-")
  #line-at(45.6pt, 458.16pt, "field) within microwave heating cavities presents a significant ")
  #line-at(45.6pt, 469.92pt, "technical challenge [4]. This uneven distribution leads to ")
  #line-at(45.6pt, 481.56pt, "issues such as hotspots and thermal runaway, which are major ")
  #line-at(45.6pt, 493.44pt, "obstacles to large-scale industrial applications [5], [6].")
  #line-at(55.44pt, 505.2pt, "Turntables [7] and mode stirrers [8] are two traditional ")
  #line-at(45.6pt, 516.84pt, "methods for improving heating uniformity, which remain ")
  #line-at(45.6pt, 528.6pt, "effective even today. In recent years, numerous methods have ")
  #line-at(45.6pt, 540.36pt, "been proposed to further enhance heating uniformity. These ")
  #line-at(45.6pt, 552.12pt, "methods can be categorized into two main types: boundary ")
  #line-at(45.6pt, 563.88pt, "variation-based methods, such as optimizing irregular cavity ")
  #line-at(45.6pt, 575.64pt, "walls [9] and loading rotary metallic columns array in the ")
  #line-at(45.6pt, 587.4pt, "cavity [4], and microwave power excitation-changing ")
  #line-at(45.6pt, 599.04pt, "methods, ")
  #line-at(92.203pt, 599.04pt, "such ")
  #line-at(120.937pt, 599.04pt, "as ")
  #line-at(140.124pt, 599.04pt, "rotatable ")
  #line-at(185.281pt, 599.04pt, "dual-port ")
  #line-at(231.929pt, 599.04pt, "feeding ")
  #line-at(272.313pt, 599.04pt, "[10], ")
  #line-at(45.6pt, 610.92pt, "continuously adjustable multiple excitation sources [11], ")
  #line-at(45.6pt, 622.68pt, "phase-shifting dual-port feeders [12], frequency stirring [13], ")
  #line-at(45.6pt, 634.32pt, "and reconfigurable Fresnel zone plates for beam steering [14]. ")
  #line-at(45.6pt, 646.2pt, "While these methods can effectively improve heating ")
  #set text(font: "Times New Roman", size: 7.826pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(55.44pt, 670.92pt, "This work was supported in part by the National Natural Science ")
  #line-at(45.6pt, 679.8pt, "Foundation of China (NSFC) under Grant U22A2015 and in part by the ")
  #line-at(45.6pt, 688.8pt, "Sichuan Science and Technology Program under Grant 2024YFHZ0282.")
  #set text(font: "Times New Roman", size: 7.826pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(45.6pt, 697.8pt, "(Corresponding author: Liping Yan). ")
  #set text(font: "Times New Roman", size: 7.826pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(55.44pt, 706.68pt, "Zhongyin Peng, Changjun Liu, Xiang Zhao, Liping Yan are with the ")
  #line-at(45.6pt, 717.36pt, "College of Electronics and Information Engineering, Sichuan University")
  #set text(font: "Times New Roman", size: 9.695pt, weight: "regular", style: "normal", fill: rgb("#000000"))
