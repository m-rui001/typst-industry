  #set text(font: "YuMincho-Regular", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.89pt, 769.776pt, "9 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 112.1pt, "interlayer thermal conductance in the Janus bilayer at small twist angles, suggesting an underlying ")
  #line-at(85.104pt, 130.1pt, "mechanism for the dramatic change in twist-angle-dependent TC. ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 166.1pt, "Conclusion ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(95.664pt, 184.1pt, "In Janus MoSSe/MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.01pt, 185.06pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(190.49pt, 184.1pt, ", a dramatic decrease in TC within the small-twist-angle regime, followed by ")
  #line-at(85.104pt, 202.1pt, "a slight increase in the twist angle was observed.")
  #line-at(289.97pt, 202.1pt, "This twist angle dependent TC is extremely sensitive ")
  #line-at(85.104pt, 220.1pt, "compared with previously reported 2D bilayer systems. Raman spectroscopy combined with TEM ")
  #line-at(85.104pt, 238.1pt, "observations and DFT calculations show that Janus functionalization facilitates atomic reconstruction ")
  #line-at(85.104pt, 256.1pt, "by weakening the interlayer sliding barrier, reducing the lattice deformation energy, and increasing the ")
  #line-at(85.104pt, 274.13pt, "energy compensation for forming stable stacking configurations. Consequently, a unique locally ")
  #line-at(85.104pt, 292.13pt, "distorted aperiodic moiré pattern emerges in twisted Janus MoSSe/MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(384.55pt, 293.09pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(388.03pt, 292.13pt, ", which is a result of the post-")
  #line-at(85.104pt, 310.13pt, "reconstruction of the moiré pattern of the bilayer MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(321.67pt, 311.09pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.15pt, 310.13pt, ". This aperiodic moiré pattern weakens the ")
  #line-at(85.104pt, 328.13pt, "interlayer interaction, corresponding to a dramatic drop in TC in the small twist angle regime, while a ")
  #line-at(85.104pt, 346.13pt, "further increase in the twist angle brings periodicity back in the moiré pattern, restoring the interlayer ")
  #line-at(85.104pt, 364.13pt, "coupling and slightly increasing TC. Our findings advance the understanding of thermal transport ")
  #line-at(85.104pt, 382.13pt, "mechanisms in 2D systems by linking moiré pattern engineering driven by atomic reconstruction to ")
  #line-at(85.104pt, 400.13pt, "interlayer interactions and TC, highlighting Janus functionalization an effective engineering strategy ")
  #line-at(85.104pt, 418.13pt, "for phonon transport.  ")
]

