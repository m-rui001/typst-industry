// arXiv source page 2
#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "YuMincho-Regular", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.89pt, 769.776pt, "2 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 112.1pt, "Abstract ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 130.1pt, "In two-dimensional moiré bilayers, atomic reconstruction, the spontaneous structural relaxation ")
  #line-at(85.104pt, 148.1pt, "toward energy-minimizing stacking registries in the near-commensurate regime, can strongly modify ")
  #line-at(85.104pt, 166.1pt, "local stacking and interlayer coupling, providing a possibility to significantly control phonon-mediated ")
  #line-at(85.104pt, 184.1pt, "properties. Here we show that the twist-angle dependence of interlayer thermal conductance can be ")
  #line-at(85.104pt, 202.1pt, "modified by introducing Janus-induced mirror-symmetry breaking into bilayer MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(446.62pt, 203.06pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.98pt, 202.1pt, ". The intrinsic ")
  #line-at(85.104pt, 220.1pt, "out-of-plane dipole in MoSSe/MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(237.41pt, 221.06pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(240.89pt, 220.1pt, " bilayers leads to frictionless interface, and reduces the lattice ")
  #line-at(85.104pt, 238.1pt, "deformation energy, thereby promoting atomic-reconstruction into locally distorted aperiodic moiré ")
  #line-at(85.104pt, 256.1pt, "patterns. These features weaken interlayer coupling and suppress phonon transmission across the ")
  #line-at(85.104pt, 274.13pt, "interface, leading to an anomalously strong twist-angle dependence of thermal conductance, with a ")
  #line-at(85.104pt, 292.13pt, "pronounced minimum at small twist angles and a reduction rate nearly one order of magnitude larger ")
  #line-at(85.104pt, 310.13pt, "than that of twisted bilayer MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(218.81pt, 311.09pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(222.29pt, 310.13pt, ". Our results demonstrate that interlayer thermal transport is modified ")
  #line-at(85.104pt, 328.13pt, "by atomic reconstruction, highlighting Janus-induced mirror-symmetry breaking as an effective way ")
  #line-at(85.104pt, 346.13pt, "to promoting phonon engineering in two-dimensional moiré structures.  ")
]

// arXiv source page 3
#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "YuMincho-Regular", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.89pt, 769.776pt, "3 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 112.1pt, "Introduction ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(95.664pt, 130.1pt, "The properties of crystalline materials are fundamentally governed by lattice symmetry and ")
  #line-at(85.104pt, 148.1pt, "periodicity. In two-dimensional (2D) van der Waals (vdW) materials, these structural factors can be ")
  #line-at(85.104pt, 166.1pt, "flexibly reconfigured through stacking and twisting, giving rise to highly tunable electronic, optical, ")
  #line-at(85.104pt, 184.1pt, "and magnetic properties")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(188.81pt, 180.62pt, "1–3")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(199.25pt, 184.1pt, ". Particularly important is the near-commensurate regime at small twist ")
  #line-at(85.104pt, 202.1pt, "angles, where atomic reconstruction, the spontaneous structural relaxation toward energy-minimizing ")
  #line-at(85.104pt, 220.1pt, "stacking registries, transforms the rigid moiré geometry into a new periodic pattern composed of ")
  #line-at(85.104pt, 238.1pt, "commensurate domains separated by disordered regions")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(322.15pt, 234.62pt, "4")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.63pt, 238.1pt, ". As a result, subtle differences in the initial ")
  #line-at(85.104pt, 256.1pt, "structure can be amplified into pronounced changes in the reconstructed moiré texture and the resulting ")
  #line-at(85.104pt, 274.13pt, "physical properties")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(164.66pt, 270.65pt, "5,6")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(173.42pt, 274.13pt, ", as demonstrated in correlated electronic states")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(371.35pt, 270.65pt, "7")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(374.83pt, 274.13pt, ", interlayer excitons")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(457.78pt, 270.65pt, "8,9")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(466.54pt, 274.13pt, ", and spin-")
  #line-at(85.104pt, 292.13pt, "related phenomena")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(165.5pt, 288.65pt, "10")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(172.46pt, 292.13pt, ". Phonons, as the fundamental lattice excitations that both reflect and influence ")
  #line-at(85.104pt, 310.13pt, "these emergent properties, have also attracted increasing attention. However, most studies have ")
  #line-at(85.104pt, 328.13pt, "focused on static characteristics, such as mode frequencies")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(344.71pt, 324.65pt, "11")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(351.43pt, 328.13pt, " and their spatial distributions")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(483.94pt, 324.65pt, "12")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(490.9pt, 328.13pt, ". By ")
  #line-at(85.104pt, 346.13pt, "contrast, the transport properties of phonons in 2D moiré structures remain much less explored. With ")
  #line-at(85.104pt, 364.13pt, "recent progress in the large-area synthesis and integration of 2D devices")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(408.19pt, 360.65pt, "13,14")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(423.91pt, 364.13pt, ", understanding and ")
  #line-at(85.104pt, 382.13pt, "controlling phonon-mediated thermal transport is not only important in the fundamental phonon ")
  #line-at(85.104pt, 400.13pt, "physics but has become increasingly important in light of their practical applications")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(440.14pt, 396.65pt, "15")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(447.1pt, 400.13pt, ". ")
  #line-at(95.664pt, 418.13pt, "In the out-of-plane direction, weak vdW coupling strongly limits phonon transmission, in sharp ")
  #line-at(85.104pt, 436.13pt, "contrast to the high in-plane thermal conductivity of most 2D materials. A central issue here is to ")
  #line-at(85.104pt, 454.15pt, "elucidate how symmetry and the periodicity govern phonon transmission across atomically thin ")
  #line-at(85.104pt, 472.15pt, "interfaces. Kim et al. demonstrated a dramatic suppression of interlayer thermal transport in randomly ")
  #line-at(85.104pt, 490.15pt, "twisted multilayer transition metal dichalcogenides (TMD)")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.59pt, 486.67pt, "16")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(336.55pt, 490.15pt, ", highlighting twist-angle control of moiré ")
  #line-at(85.104pt, 508.15pt, "structures as a promising platform for phonon engineering and inspiring subsequent studies of twist-")
  #line-at(85.104pt, 526.15pt, "modulated interlayer thermal conductance (TC) in systems such as bilayer graphene")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(453.46pt, 522.67pt, "17")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(460.42pt, 526.15pt, ", MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.78pt, 527.11pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(491.26pt, 526.15pt, " and ")
  #line-at(85.104pt, 544.15pt, "WS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(100.94pt, 545.11pt, "2")
  #line-at(104.42pt, 540.67pt, "18")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(111.38pt, 544.15pt, ". A further conceptual advance came from twisted graphite interfaces, where a frictionless ")
  #line-at(85.104pt, 562.15pt, "interfacial state was shown to suppress transverse-acoustic phonon transmission and hinder thermal ")
  #line-at(85.104pt, 580.15pt, "transport. This work provided important insight into the correlation between the in-plane displacement ")
  #line-at(85.104pt, 598.15pt, "energy and interlayer coupling for explaining the twist-dependent changes in TC")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(423.67pt, 594.67pt, "19")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(430.63pt, 598.15pt, ".  ")
  #line-at(95.664pt, 616.15pt, "Nevertheless, previous studies have generally shown only a gradual twist-angle dependence of TC ")
  #line-at(85.104pt, 634.18pt, "when the stacking deviates from commensurate configurations (0° or 60° twist angles). One possible ")
  #line-at(85.104pt, 652.18pt, "route to amplify this response is to combine twist with mirror-symmetry control through ")
  #line-at(85.104pt, 670.18pt, "heterostructural integration. Although thermal transport across heterointerfaces has been studied ")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(490.42pt, 666.7pt, "20–22")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(507.82pt, 670.18pt, ", ")
  #line-at(85.104pt, 688.18pt, "TC under the combined control of twist and hetero-structuring have only been experimentally ")
  #line-at(85.104pt, 706.18pt, "examined in MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(160.34pt, 707.14pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(163.82pt, 706.18pt, "/WS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(182.54pt, 707.14pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(186.05pt, 706.18pt, " bilayer")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(217.97pt, 702.7pt, "23")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(224.93pt, 706.18pt, ". Notably, integrating MoS")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(337.99pt, 707.14pt, "2")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
