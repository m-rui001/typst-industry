  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.464pt, 606.43pt, " represents the binary bits “1” and “0” (Figure 1c), respectively. The on/off function can be ")
