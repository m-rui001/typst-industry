  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(160.46pt, 716.86pt, " achieving current-driven motions of skyrmions in strongly confined ")
  #line-at(70.104pt, 744.456pt, "elementary geometries (size ≈ 90 nm) remains challenging.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(354.67pt, 739.9pt, "37, 38")
]

