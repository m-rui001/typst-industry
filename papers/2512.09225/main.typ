  #line-at(70.104pt, 440.81pt, "micomagnetic simulations (detail see Supplementary Section I) of the 280-nm long nanostripe ")
  #line-at(70.104pt, 468.43pt, "reveal two binary equilibrium positions with the lowest total free energy ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(420.67pt, 468.43pt, "E")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(428.11pt, 468.43pt, ", as shown in Figure ")
  #line-at(70.104pt, 496.03pt, "1b. This energy landscape offers a novel switching functionality in topological spintronic ")
  #line-at(70.104pt, 523.63pt, "devices, facilitating the motion of the skyrmion between the two binary equilibrium positions, ")
  #line-at(70.104pt, 551.23pt, "−")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(76.824pt, 551.23pt, "x")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(82.104pt, 552.19pt, "0")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.184pt, 551.23pt, " and ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(113.42pt, 551.23pt, "x")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(118.7pt, 552.19pt, "0")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(122.78pt, 551.23pt, ", driven by electrical currents. In this scenario, half of the nanostructured stripe ")
  #line-at(70.104pt, 578.83pt, "serves as the detection region for on-off devices. Specifically, the skyrmion located at −")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(495.22pt, 578.83pt, "x")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
