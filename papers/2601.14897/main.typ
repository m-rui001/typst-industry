  #line-at(53.99pt, 480.126pt, "sample dishes filled with photopolymer resins, to the plane floor. We cured the polymers in-flight using UV LED arrays ")
  #line-at(53.98pt, 491.649pt, "mounted inside the desiccator lids. We regulated convective heat flow by activating fans mounted inside the chambers. With ")
  #line-at(53.98pt, 503.172pt, "the fans turned off, we had natural convection under 1g and no convection in 0g. Activating the fans established consistent ")
  #line-at(53.97pt, 514.635pt, "forced convection in both gravity regimes. We measured the temperature distribution inside the polymers with embedded ")
  #line-at(53.97pt, 526.158pt, "thermocouples placed at predefined heights. GoPro cameras inside the desiccators recorded the evolution of thermal defects ")
  #line-at(53.96pt, 537.801pt, "during polymerization. ")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(150.443pt, 537.801pt, "(C)")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(164.296pt, 537.801pt, " Image sequence of the photopolymer surface during polymerization in microgravity: At ")
