  #line-at(533.908pt, 537.801pt, "𝑡𝑡= 0")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(556.653pt, 537.801pt, ", ")
  #line-at(53.97pt, 549.384pt, "under microgravity conditions, we activated the UV LED array above the liquid polymer resin, initiating photopolymerization. ")
  #line-at(53.97pt, 561.027pt, "At this point, the liquid surface was smooth and defect-free. At ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.889pt, 561.027pt, "𝑡𝑡= 10 s")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.698pt, 561.027pt, ", we measured an internal temperature of 89 °C and ")
