#original-page(612pt, 792pt, none)[
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(303.78pt, 762.54pt, "2 ")
  #line-at(54.007pt, 82.263pt, "We here report the material characterization measurements of: TJ-3704A, a commercial acrylate-based resin also ")
  #line-at(54.007pt, 96.779pt, "sold under the brand name ‘VidaRosa’ (Dongguan Tianxingjian Electronic Technology Co., Ltd, Guandong, ")
  #line-at(54.007pt, 111.36pt, "China), and NOA61 & NOA63 (Norland Optical Adhesive, Norland Products Incorporated, New Jersey, USA), ")
  #line-at(54.007pt, 125.876pt, "which were used in this work. ")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(54.007pt, 169.258pt, "S2.")
  #line-at(72.003pt, 169.258pt, "Thermal diffusivity, ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(168.836pt, 169.258pt, "𝜶𝜶")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(176.214pt, 169.258pt, ", characterization by Laser Flash Analysis (LFA) ")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(53.974pt, 189.9pt, "Laser flash analysis (LFA) is a widely used transient technique for measuring a material’s thermal diffusivity and ")
  #line-at(53.974pt, 204.482pt, "is considered one of the principal methods for thermal transport characterization in solids and liquids. In this ")
  #line-at(53.985pt, 218.997pt, "method, a short laser pulse is applied to one face of a small (dia. ranging between ca. 6 to 25 mm), planar sample, ")
  #line-at(53.985pt, 233.578pt, "and the resulting temperature rise is recorded on the opposite face as a function of time with an infra-red detector. ")
  #line-at(53.974pt, 248.094pt, "By fitting the rear-face temperature response to an analytical heat-diffusion solution considering diverse ")
  #line-at(53.974pt, 262.675pt, "conditions of heat loss (conduction through the samples’ faces, radial edges, radiation, etc.) and pulse-time ")
  #line-at(53.974pt, 277.378pt, "corrections, the through-thickness thermal diffusivity, ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(293.788pt, 277.378pt, "𝛼𝛼")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(300.684pt, 277.378pt, ", can be extracted.")
  #set text(font: "Times New Roman", size: 7.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(380.4pt, 272.88pt, "1")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(53.997pt, 298.022pt, "In this work, we used LFA to characterize the thermal diffusivity of the photopolymer resins in both liquid and ")
  #line-at(53.997pt, 312.604pt, "solid states at isothermal temperatures of 25 and 50 °C, by applying short (0.5 ms) Nd-YAG laser pulses. We ")
  #line-at(53.986pt, 327.119pt, "implemented the measurements using a NETZSCH LFA-457 ")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(341.398pt, 327.119pt, "MicroFlash")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(393.301pt, 327.119pt, " ® apparatus. We tested cylindrical ")
  #line-at(53.997pt, 341.701pt, "polymer samples with a diameter of 12.7 mm, and a nominal thickness of 1.65 mm. Liquid polymer resin samples ")
  #line-at(54.008pt, 356.216pt, "were measured with the use of dedicated aluminum sample containers (NETZSCH catalog number 6.256.4-")
  #line-at(54.008pt, 370.732pt, "91.6.00). Following typical procedure, we spray-coated all the samples front and rear faces with black carbon to ")
  #line-at(53.986pt, 385.313pt, "ensure uniform laser absorption and emissivity and applied the Cape-Lehman method to correct for heat losses ")
  #line-at(53.997pt, 399.829pt, "from both back and front faces of the samples as well as for the effects of finite pulse durations.")
  #set text(font: "Times New Roman", size: 7.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(507.48pt, 395.34pt, "2")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(511.02pt, 399.84pt, " To assess ")
  #line-at(53.999pt, 414.421pt, "measurement uncertainties and improve accuracy, we measured each sample N = 3 times at each temperature and ")
  #line-at(53.988pt, 428.937pt, "material state. Our results are reported in Table S1. For the temperatures measured we found a negligible variation ")
  #line-at(53.988pt, 443.518pt, "in the sample’s thermal diffusivity. We found that the liquid polymer samples have a larger thermal diffusivity ")
  #line-at(53.988pt, 458.034pt, "than their solid counterparts, however, as this variation is small, it leads to negligible effects on our thermal model ")
  #line-at(53.988pt, 472.615pt, "simulation predictions. Thus, for simulations of photopolymer curing of these specific polymers, we treat the ")
  #line-at(53.977pt, 487.318pt, "thermal diffusivity, ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(141.642pt, 487.318pt, "𝛼𝛼")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.537pt, 487.318pt, ", as a material specific constant, ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(263.728pt, 507.96pt, "𝛼𝛼(𝛷𝛷, 𝑇𝑇) = 𝛼𝛼")
  #set text(font: "Cambria Math", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(320.04pt, 510.24pt, "0")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.14pt, 507.96pt, ",")
  #line-at(537.899pt, 507.422pt, "(S1)")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(54pt, 528.96pt, "where ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(84.535pt, 528.96pt, "𝛷𝛷")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(92.935pt, 528.96pt, " is the material phase and ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(212.76pt, 528.96pt, "𝑇𝑇")
  #set text(font: "Times New Roman", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(219.534pt, 528.96pt, " is its temperature. Future applications of our model to other photopolymer ")
  #line-at(54pt, 543.662pt, "formulations should begin with similar material characterization. If such measurements reveal a strong variation in ")
  #line-at(53.989pt, 558.178pt, "thermal diffusivity, we suggest expanding the modeled thermal diffusivity to a more general form by assuming a ")
  #line-at(53.989pt, 572.88pt, "linear dependance on the material state ")
  #set text(font: "Cambria Math", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(228.11pt, 572.88pt, "𝛷𝛷,")
  #line-at(173.572pt, 594.785pt, "α(𝛷𝛷, 𝑇𝑇) = α(𝛷𝛷= 0, 𝑇𝑇) +")
  #line-at(288.368pt, 594.785pt, " ൫α")
  #line-at(302.071pt, 594.247pt, "(𝛷𝛷= 1, 𝑇𝑇) −α(𝛷𝛷= 0, 𝑇𝑇)")
  #line-at(419.129pt, 594.785pt, "൯𝛷𝛷")
  #line-at(432.448pt, 594.785pt, ".  ")
  #line-at(537.878pt, 594.247pt, "(S2)")
]

