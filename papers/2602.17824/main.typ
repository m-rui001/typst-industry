  #line-at(72pt, 517.84pt, "(whiskers) of the computed LMTD for the various inlet temperature combinations, Reynold’s number and for both ")
  #line-at(72pt, 531.16pt, "HX architectures. ")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "bold", style: "normal", fill: rgb("#000000"))
