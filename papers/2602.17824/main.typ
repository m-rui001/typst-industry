  #line-at(537.48pt, 138.02pt, ". ")
  #line-at(72pt, 152.78pt, "However, the associated specific pressure drop of the gyroid structure was significantly higher in all flow regimes, on ")
  #line-at(72pt, 166.22pt, "average about 14.55 times higher in the laminar flow regime (i.e. ")
