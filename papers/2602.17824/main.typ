  #line-at(180.14pt, 179.84pt, "𝑅𝑒≥3000)")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(231.02pt, 179.84pt, ". On this basis, the tessellated wavy channel structure outperforms the gyroid ")
  #line-at(72pt, 193.4pt, "structure when ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(133.4pt, 193.4pt, "𝑅𝑒≥7000")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(180.14pt, 193.4pt, ", however the relative performance is subject to interpretation when ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(451.6pt, 193.4pt, "𝑅𝑒< 7000")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(498.34pt, 193.4pt, ". Based on ")
  #line-at(72pt, 206.96pt, "the heat transfer efficiency quantified by the Nusselt number, ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.68pt, 206.96pt, "𝑁𝑢")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(337pt, 206.96pt, ", the gyroid structure was found to have relatively ")
  #line-at(72pt, 220.4pt, "higher values, on average about 5.2 times that of the tessellated wavy channel structure over the entire range of ")
  #line-at(72pt, 233.72pt, "Reynold’s number consider. However, the flow resistance of the gyroid structure quantified by the Fanning friction ")
  #line-at(72pt, 247.04pt, "factor was also found to be significantly higher than that of the tessellated wavy channel structure, on average about ")
  #line-at(72pt, 260.48pt, "8.4 times higher in the laminar flow regime (i.e. ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(264.02pt, 260.48pt, "𝑅𝑒≤2000")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(310.76pt, 260.48pt, ") and about 1.87 times higher in the turbulent flow regime ")
  #line-at(72pt, 274.1pt, "(i.e. ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.66pt, 274.1pt, "𝑅𝑒≥3000)")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(141.56pt, 274.1pt, ". The overall thermal-hydraulic performance of both structures was assessed based on the AGF or  ")
  #set text(font: "Cambria Math", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 287.66pt, "𝑗𝑓")
