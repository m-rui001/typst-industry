  #line-at(70.86pt, 598.84pt, "At 0.5 dpa, no platelets/nanocracks are observed; only isolated, sub-nanometer helium bubbles ")
  #line-at(70.86pt, 619.54pt, "remain, indicating complete suppression of large-scale defect formation. ")
  #line-at(70.86pt, 648.28pt, "To elucidate the atomic-level mechanisms behind these observations, we conducted a molecular ")
  #line-at(70.86pt, 668.98pt, "dynamics (MD) cascade simulation of 6H-SiC with a preexisting void. The primary knock-on ")
  #line-at(70.86pt, 689.68pt, "atom (PKA), typically a Si atom, is given 10 keV kinetic energy directed along the negative z-")
  #line-at(70.86pt, 710.4pt, "axis. In all cascade simulations, the initial distance between the PKA atom to the center of the ")
  #line-at(70.86pt, 731.1pt, "void is about 15 Å for the sake of comparison. Fig. 11 presents atomistic snapshots for both ")
  #line-at(70.86pt, 751.8pt, "pristine (Fig. 11a) and pre-damaged systems containing voids of varying radii (5, 10, 15, and ")
]

