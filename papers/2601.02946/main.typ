// arXiv source page 2
#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Calibri", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(518.94pt, 790.2pt, "2 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.86pt, 114.78pt, "Abstract ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.86pt, 135.5pt, "Helium accumulation in structural ceramics used in nuclear, fusion, and aerospace systems ")
  #line-at(70.86pt, 156.2pt, "causes swelling, cracking, and early failure, yet controlling this damage has remained elusive. ")
  #line-at(70.86pt, 176.9pt, "Here, we introduce defect landscape engineering, the deliberate creation of vacancy clusters ")
  #line-at(70.86pt, 197.6pt, "prior to helium exposure, as a general strategy to suppress helium-induced degradation. Using ")
  #line-at(70.86pt, 218.3pt, "α-SiC as a model, we combine advanced microscopy, strain mapping, helium depth profiling, ")
  #line-at(70.86pt, 239pt, "positron annihilation spectroscopy, and atomistic simulations to demonstrate that tailored pre-")
  #line-at(70.86pt, 259.7pt, "damage transforms helium defect evolution. Instead of forming extended platelets and ")
  #line-at(70.86pt, 280.4pt, "nanocracks, helium is trapped in stable, uniformly dispersed nanobubbles. Simulations reveal ")
  #line-at(70.86pt, 301.1pt, "that small vacancy clusters act as dual-function sinks for irradiation-induced interstitials and ")
  #line-at(70.86pt, 321.8pt, "preferential helium traps, fundamentally altering cascade recombination dynamics. This ")
  #line-at(70.86pt, 342.44pt, "mechanism is composition-independent and scalable, offering a new design principle for ")
  #line-at(70.86pt, 363.14pt, "radiation-tolerant ceramics across carbides, nitrides, and oxides. By viewing defect control as ")
  #line-at(70.86pt, 383.84pt, "a tunable parameter instead of a fixed material property, this work outlines a possible design ")
  #line-at(70.86pt, 404.54pt, "route toward enhanced radiation tolerance in ceramics used in extreme environments. ")
]

// arXiv source page 3
#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Calibri", size: 10.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(518.94pt, 790.2pt, "3 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.86pt, 82.08pt, "Introduction ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.86pt, 102.78pt, "As the world races to decarbonize energy systems and mitigate the intensifying effects of ")
  #line-at(70.86pt, 123.48pt, "climate change, advanced nuclear energy technologies have emerged as a critical solution. Their ")
  #line-at(70.86pt, 144.2pt, "potential to deliver reliable, low-carbon power is unparalleled, but realizing this promise hinges ")
  #line-at(70.86pt, 164.9pt, "on one key factor: the resilience of structural materials operating in some of the most extreme ")
  #line-at(70.86pt, 185.6pt, "environments engineered by humans. Inside nuclear reactor cores, materials face relentless ")
  #line-at(70.86pt, 206.3pt, "bombardment by high-energy neutrons, reaching doses as high as 200 displacements per atom ")
  #line-at(70.86pt, 227pt, "(dpa) ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(98.9pt, 222.5pt, "1,2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108.92pt, 227pt, ". Under such intense conditions, maintaining the mechanical integrity, safety, and long-")
  #line-at(70.86pt, 247.7pt, "term performance of these materials becomes one of the most pressing challenges in the field. ")
  #line-at(70.86pt, 276.38pt, "The extension of current reactor lifespans and the deployment of next-generation fission and ")
  #line-at(70.86pt, 297.08pt, "fusion systems further intensify the demand for materials with exceptional irradiation tolerance ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.86pt, 313.28pt, "3,4")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(80.88pt, 317.78pt, ". When exposed to neutron or heavy-ion irradiation, metals and ceramics accumulate a ")
  #line-at(70.86pt, 338.48pt, "spectrum of defects, vacancies, interstitials, dislocation loops, voids, bubbles, and stacking fault ")
  #line-at(70.86pt, 359.18pt, "tetrahedra ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(122.06pt, 354.68pt, "5–11")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(138.08pt, 359.18pt, ", which evolve into macroscopic degradation phenomena such as embrittlement, ")
  #line-at(70.86pt, 379.88pt, "void swelling, radiation-induced hardening, and creep ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.8pt, 375.38pt, "12–17")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(352.78pt, 379.88pt, ". ")
  #line-at(70.86pt, 408.56pt, "A particularly insidious contributor to irradiation damage is helium, produced by transmutation ")
  #line-at(70.86pt, 429.28pt, "reactions or introduced externally in plasma-facing environments. Because of its extremely low ")
  #line-at(70.86pt, 449.98pt, "solubility in solids, helium atoms readily cluster to form bubbles, cavities, and platelets, which ")
  #line-at(70.86pt, 470.68pt, "can grow and coalesce into nanocracks and larger-scale defects ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(371.8pt, 466.18pt, "18–22")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(391.9pt, 470.68pt, ". As these gas-filled cavities ")
  #line-at(70.86pt, 491.38pt, "accumulate beneath material surfaces, the internal pressure can reach a critical threshold, ")
  #line-at(70.86pt, 512.08pt, "leading to blistering, surface upheaval, and ultimately, spallation ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(384.04pt, 507.58pt, "23–25")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(404.08pt, 512.08pt, ". This blistering behavior ")
  #line-at(70.86pt, 532.78pt, "has been observed in materials like silicon carbide (SiC), where helium implantation leads to ")
  #line-at(70.86pt, 553.48pt, "bubble nucleation, platelet growth, and surface failure ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(333.16pt, 548.98pt, "26–28")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(353.2pt, 553.48pt, ". ")
  #line-at(70.86pt, 582.16pt, "Developing materials with built-in resistance to such degradation is now a central objective of ")
  #line-at(70.86pt, 602.86pt, "nuclear materials science. A wave of innovation has yielded several promising strategies such ")
  #line-at(70.86pt, 623.56pt, "as grain boundary engineering, which enhances defect sink efficiency by tailoring the grain ")
  #line-at(70.86pt, 644.26pt, "boundary character and distribution ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(260.84pt, 639.76pt, "29–32")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(280.88pt, 644.26pt, "; Multilayered nanocomposites, which leverage ")
  #line-at(70.86pt, 664.96pt, "interface-dominated architectures to absorb and annihilate radiation-induced defects ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(501.24pt, 660.46pt, "33–36")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(521.22pt, 664.96pt, "; ")
  #line-at(70.86pt, 685.66pt, "Metallic glasses, whose amorphous structure resists amorphization and void formation under ")
  #line-at(70.86pt, 706.38pt, "irradiation ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(124.52pt, 701.88pt, "37–39")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(144.5pt, 706.38pt, "; Nanochannel structures, created via physical vapor deposition (PVD), which ")
  #line-at(70.86pt, 727.08pt, "promote helium outgassing and thermal self-healing ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(322.6pt, 722.58pt, "40,41")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(340.6pt, 727.08pt, "; Nanotwinned metals, where coherent ")
  #line-at(70.86pt, 747.78pt, "twin boundaries serve as defect traps and enhance both strength and radiation resistance ")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(503.16pt, 743.28pt, "42,43")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(521.16pt, 747.78pt, "; ")
]

