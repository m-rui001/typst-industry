  #line-at(46.8pt, 510.91pt, "higher than that of GaN, showcasing the promise of this ")
  #line-at(46.8pt, 522.43pt, "material platform for RF and mm-wave electronics[4]. β-")
  #line-at(46.8pt, 533.83pt, "Ga₂O₃ RF transistors have shown rapid advancements over the ")
  #line-at(46.8pt, 545.35pt, "past decade. Early MOSFETs achieved modest frequencies ")
  #line-at(46.8pt, 556.87pt, "(fₜ=3.3 GHz, fₘₐₓ=12.9 GHz) using recessed gates and heavily ")
  #line-at(46.8pt, 568.42pt, "doped contacts [5]. Significant improvement emerged with ")
  #line-at(46.8pt, 579.94pt, "delta-doped channels, increasing fₜ to 27 GHz using 120 nm T-")
  #line-at(46.8pt, 591.46pt, "gates [6]. By using modulation-doped heterostructures, ")
  #line-at(46.8pt, 602.86pt, "researchers demonstrated enhancement-mode HFETs reaching ")
  #line-at(46.8pt, 614.38pt, "even higher frequencies (fₜ=30 GHz, fₘₐₓ=37 GHz), marking a ")
  #line-at(46.8pt, 625.9pt, "critical breakthrough for β-Ga₂O₃ RF transistors [7].  ")
