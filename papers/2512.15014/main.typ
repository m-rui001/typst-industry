  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(411.712pt, 255.36pt, "-implanted MgO, but further ")
  #line-at(306.24pt, 267.36pt, "studies are required to optimize this approach. ")
  #set text(font: "Century", size: 9.03pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(398.362pt, 291.212pt, "5. Summary")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(319.74pt, 309.36pt, "We have developed the XFMR spectrometer with out-")
  #line-at(306.24pt, 321.36pt, "of-vacuum photodetectors. Details of the apparatus, ")
  #line-at(306.24pt, 333.36pt, "including the microwave circuit and the XEOL detection ")
  #line-at(306.24pt, 345.36pt, "system, have been presented. We demonstrated typical ")
  #line-at(306.24pt, 357.36pt, "XFMR measurements, delay scans of a Py film on an ")
  #line-at(306.24pt, 369.36pt, "MgO(001) substrate. A unique feature of this system is ")
  #line-at(306.24pt, 381.36pt, "its out-of-vacuum photodetectors, which enables the ")
  #line-at(306.24pt, 393.36pt, "integration of various functional detectors, such as a ")
  #line-at(306.24pt, 405.36pt, "visible-light spectrometer or a CCD camera. This ")
  #line-at(306.24pt, 417.36pt, "flexibility significantly expands the capabilities of XFMR, ")
  #line-at(306.24pt, 429.36pt, "enabling measurements beyond conventional setups. The ")
  #line-at(306.24pt, 441.36pt, "deployment of this type of XFMR spectrometer at a ")
  #line-at(306.24pt, 453.36pt, "dedicated ")
  #line-at(356.373pt, 453.36pt, "beamline ")
  #line-at(404.848pt, 453.36pt, "in ")
  #line-at(423.472pt, 453.36pt, "a ")
  #line-at(438.77pt, 453.36pt, "high-brilliance, ")
  #line-at(512.552pt, 453.36pt, "fourth-")
  #line-at(306.24pt, 465.36pt, "generation synchrotron radiation facility, such as ")
  #line-at(306.24pt, 477.36pt, "NanoTerasu in Sendai, Japan, will provide new ")
  #line-at(306.24pt, 489.36pt, "opportunities to observe element-specific spin dynamics ")
  #line-at(306.24pt, 501.36pt, "in novel magnetic and spintronic materials and ")
  #line-at(306.24pt, 513.36pt, "devices")
  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(336.237pt, 510.96pt, "66,67)")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
