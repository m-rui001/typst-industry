  #line-at(306.24pt, 123.36pt, "used. For light shielding, all viewports around the XFMR ")
  #line-at(306.24pt, 135.36pt, "chamber except for XEOL optical path were closed, and ")
  #line-at(306.24pt, 147.36pt, "the photodetector was enclosed with a blackout curtain. ")
