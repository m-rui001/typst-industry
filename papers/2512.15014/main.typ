  #line-at(306.24pt, 195.36pt, "to those reported previously were observed, indicating ")
  #line-at(306.24pt, 207.36pt, "Cr")
  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(316.734pt, 204.96pt, "3+")
