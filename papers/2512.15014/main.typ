  #line-at(306.24pt, 315.36pt, "remanent magnetization lies in the film plane. XMCD ")
  #line-at(306.24pt, 327.36pt, "spectrum was obtained as a subtraction of XAS for right-")
  #line-at(306.24pt, 339.36pt, "handed circular polarization from that for left-handed ")
  #line-at(306.24pt, 351.36pt, "circular polarization. ")
  #line-at(319.74pt, 363.36pt, "In ")
  #line-at(339.701pt, 363.36pt, "TEY-detected ")
  #line-at(407.165pt, 363.36pt, "Fe ")
