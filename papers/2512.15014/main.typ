  #line-at(533.206pt, 670.56pt, "in ")
  #line-at(306.24pt, 682.56pt, "antiferromagnetic layers")
  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(410.662pt, 680.16pt, "44)")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(419.334pt, 682.56pt, " have been observed. XFMR ")
