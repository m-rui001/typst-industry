  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(520.731pt, 231.36pt, " XAS ")
  #line-at(306.24pt, 243.36pt, "of a 100-nm-thick Py film on MgO by TEY and XEOL as ")
