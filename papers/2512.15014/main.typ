  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(358.313pt, 531.84pt, "2,3")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(366.654pt, 531.36pt, " edges, however it is not obvious as in the ")
  #line-at(306.24pt, 543.36pt, "case of the Fe L")
  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(381.832pt, 543.84pt, "2,3")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.173pt, 543.36pt, " edges. Overall spectral shapes of ")
  #line-at(306.24pt, 555.36pt, "XEOL-XAS and XMCD are like those of bulk Ni including ")
  #line-at(306.24pt, 567.36pt, "so-called 6-eV satellite")
  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(402.34pt, 564.96pt, "59)")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(411.012pt, 567.36pt, ". As demonstrated above, bulk ")
  #line-at(306.24pt, 579.36pt, "sensitivity ")
  #line-at(360.063pt, 579.36pt, "of ")
  #line-at(377.887pt, 579.36pt, "XEOL ")
  #line-at(414.048pt, 579.36pt, "detection ")
  #line-at(462.374pt, 579.36pt, "suppress ")
  #line-at(509.527pt, 579.36pt, "relative ")
  #line-at(306.24pt, 591.36pt, "contribution of oxidized surface layer and is well-suited ")
  #line-at(306.24pt, 603.36pt, "for XFMR measurements. Moreover, XEOL detection ")
  #line-at(306.24pt, 615.36pt, "enables one to probe buried magnetic layers in the depth ")
  #line-at(306.24pt, 627.36pt, "which is hardly reached by TEY detection. ")
