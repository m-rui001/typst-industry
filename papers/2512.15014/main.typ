  #set text(font: "Century", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.92pt, 385.2pt, "1")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(74.257pt, 384.72pt, " and F")
