  #line-at(67.26pt, 714.24pt, "In this paper, we report design and performance of an ")
  #line-at(53.76pt, 726.24pt, "XFMR spectrometer developed at the Photon Factory ")
  #line-at(53.76pt, 738.24pt, "(PF), High Energy Accelerator Research Organization ")
  #line-at(53.76pt, 750.24pt, "(KEK), Japan. In XFMR experiments, X-ray excited ")
  #line-at(306.24pt, 304.32pt, "optical luminescence (XEOL) is usually detected to ")
  #line-at(306.24pt, 316.32pt, "obtain an X-ray absorption signal. In most XFMR ")
  #line-at(306.24pt, 328.32pt, "instruments, a photodiode at the sample manipulator ")
  #line-at(306.24pt, 340.32pt, "under ultra-high vacuum (UHV) conditions is used to ")
  #line-at(306.24pt, 352.32pt, "detect XEOL. This setup allows for a large numerical ")
  #line-at(306.24pt, 364.32pt, "aperture (NA) to efficiently collect the XEOL signal ")
  #line-at(306.24pt, 376.32pt, "emitted over a ")
  #set text(font: "Cambria Math", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(372.57pt, 376.32pt, "4𝜋")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(383.081pt, 376.32pt, " solid angle; however, it restricts the ")
  #line-at(306.24pt, 388.32pt, "quick replacement of detectors for specific experimental ")
  #line-at(306.24pt, 400.32pt, "purposes. In the present XFMR spectrometer, a pair of ")
  #line-at(306.24pt, 412.32pt, "plano-convex lenses collimates and focuses XEOL to the ")
  #line-at(306.24pt, 424.32pt, "outside of the UHV chamber where photodetectors are ")
  #line-at(306.24pt, 436.32pt, "placed. This design enables easy replacement of detectors, ")
  #line-at(306.24pt, 448.32pt, "such ")
  #line-at(337.357pt, 448.32pt, "as ")
  #line-at(358.492pt, 448.32pt, "photodiodes ")
  #line-at(419.976pt, 448.32pt, "with ")
  #line-at(450.774pt, 448.32pt, "various ")
  #line-at(493.568pt, 448.32pt, "wavelength ")
  #line-at(306.24pt, 460.32pt, "sensitivities, ")
  #line-at(371.111pt, 460.32pt, "CCD ")
  #line-at(403.315pt, 460.32pt, "cameras, ")
  #line-at(452.684pt, 460.32pt, "and ")
  #line-at(480.556pt, 460.32pt, "spectrometers, ")
  #line-at(306.24pt, 472.32pt, "depending on the experimental requirements. ")
  #set text(font: "Century", size: 9.03pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.267pt, 496.172pt, "2. Experimental")
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
