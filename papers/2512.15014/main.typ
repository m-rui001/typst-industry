  #line-at(306.24pt, 435.36pt, "detection is bulk sensitive because film-transmitted X-")
  #line-at(306.24pt, 447.36pt, "ray excites XEOL in the substate. Therefore, XEOL-XAS ")
  #line-at(306.24pt, 459.36pt, "exhibits a single peak of metallic iron which comes from ")
  #line-at(306.24pt, 471.36pt, "100-nm-thick averaged signal (lower side in Fig. 3(c)). ")
  #line-at(306.24pt, 483.36pt, "XMCD peaks appear only at the absorption edges of ")
