#original-page(595.44pt, 841.92pt, (image("graphics/page-03.png", width: 209.5pt), 67pt, 62.5pt))[
  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
