  #set text(font: "Century", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(96.963pt, 485.04pt, ", which defines the temporal resolution of the ")
  #line-at(53.76pt, 497.04pt, "XFMR experiment. ")
  #line-at(67.26pt, 509.04pt, "We used permalloy (Py), i.e., Ni")
