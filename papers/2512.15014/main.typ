  #line-at(306.24pt, 526.32pt, "at BL-19B of the PF, Institute of Materials Structure ")
  #line-at(306.24pt, 538.32pt, "Science, KEK, Japan. BL-19B is a branch beamline of ")
  #line-at(306.24pt, 550.32pt, "BL-19A which is dedicated for scanning transmission X-")
  #line-at(306.24pt, 562.32pt, "ray microscopy (STXM)")
