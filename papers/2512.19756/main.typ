  #line-at(262.8pt, 564.72pt, " A schematic illustration of the basic elements required for ")
  #line-at(54pt, 578.52pt, "building with liquids – a liquid polymer, a density-matched immersion liquid, a set of boundary ")
  #line-at(54pt, 592.32pt, "conditions, and means to cure the polymer (e.g. thermal, UV). ")
