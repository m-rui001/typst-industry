  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(307.44pt, 647.52pt, " This process can be repeated, with the end of the ")
  #line-at(54pt, 661.32pt, "solidified shape serving as a new boundary condition for the subsequent polymer volume. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(479.64pt, 661.32pt, "j, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(489pt, 661.32pt, "A solid object, ")
  #line-at(54pt, 675.12pt, "22 cm tall, built with LiquiFab. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
