  #line-at(320.759pt, 558.48pt, "The robotic system is based on a 6DOF robot that ")
  #line-at(54pt, 572.28pt, "controls the location of an injection nozzle in space, operating in sync with a syringe pump that supplies ")
  #line-at(54pt, 586.08pt, "the polymer to the nozzle.  The nozzle is submerged in an immersion liquid container, fixed to the top of ")
  #line-at(54pt, 599.88pt, "a transparent glass plate within a polymerization sphere. Under the plate are three baffled UV LEDs that ")
  #line-at(54pt, 613.68pt, "serve as light sources for the polymerization phases of the sequence. The slitted lid allows the nozzle to ")
  #line-at(54pt, 627.48pt, "remain in place even during polymerization.  Any exposed regions of the polymer’s flow path are covered ")
  #line-at(54pt, 641.28pt, "with Kapton tape to prevent stray light from initiating premature photopolymerization.  ")
]

