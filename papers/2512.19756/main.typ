  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(470.88pt, 477.36pt, " A geodesic dome ")
  #line-at(54pt, 491.16pt, "design based on a 2v-icosahedron. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(224.64pt, 491.16pt, "a,")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(233.64pt, 491.16pt, " the 2v-icosahedron introduced by architect Buckminster Fuller. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(548.4pt, 491.16pt, "b, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(54pt, 504.96pt, "At each edge’s midpoint we define a circular boundary surface with a normal that is perpendicular both ")
  #line-at(54pt, 518.76pt, "to the edge and to the average normal of the facets connected by the edge. Each face is thus replaced by a ")
  #line-at(54pt, 532.56pt, "three-dimensional object, as illustrated by the simulation.")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(334.92pt, 532.56pt, " c,")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(347.16pt, 532.56pt, " Simulation of the geodesic dome obtained ")
  #line-at(54pt, 546.36pt, "using the edge boundaries. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(185.88pt, 546.36pt, "d,")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(195.6pt, 546.36pt, " The automated fabrication system uses a 6 DOF robotic arm to control the ")
  #line-at(54pt, 560.16pt, "location of a boundary element within an immersion liquid, and creates an object through a sequence of ")
  #line-at(54pt, 573.96pt, "polymer injections and polymerizations. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(253.8pt, 573.96pt, "e-g, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(276pt, 573.96pt, "Time-lapse images showing the main fabrication steps. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(549.72pt, 573.96pt, "e, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(54pt, 587.76pt, "Polymer")
  #line-at(97.8pt, 587.76pt, "wetting of an existing boundary.")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(253.8pt, 587.76pt, " f, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(267pt, 587.76pt, "Retraction and further injection to bring adjacent boundaries ")
  #line-at(54pt, 601.56pt, "into liquid contact. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(148.44pt, 601.56pt, "g, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(160.8pt, 601.56pt, "Repositioning while further injecting to create the element’s final shape. UV light ")
  #line-at(54pt, 615.36pt, "is then turned on for polymerization (not shown). ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(293.64pt, 615.36pt, "h, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(306.36pt, 615.36pt, "The fully polymerized construct.")
]

