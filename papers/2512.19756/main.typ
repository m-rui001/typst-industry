  #line-at(54pt, 477.36pt, "Fig 4:  Computational design and robotic fabrication of a geodesic construct")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(446.28pt, 477.36pt, ".")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
