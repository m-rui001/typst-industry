  #set text(font: "Times New Roman", size: 15.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(54pt, 86.88pt, "Supplementary figures ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(54pt, 580.8pt, "Supplementary Fig. 1: the basic experimental system – exploded view.")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(424.32pt, 580.8pt, " The polymeric objects are ")
  #line-at(54pt, 594.6pt, "created inside the container containing an immersion liquid. The polymer injection is driven by a syringe ")
  #line-at(54pt, 608.4pt, "pump, which is connected via a silicone tube to one or more nozzles submerged in the container.  The ")
  #line-at(54pt, 622.2pt, "nozzles are held in space through a fixator that rests on the upper edge of the container. To ensure uniform ")
  #line-at(54pt, 636pt, "polymerization, the container is enclosed within a ‘polymerization sphere’ containing multiple UV LEDs. ")
  #line-at(54pt, 649.8pt, "Each LED is covered by a baffle so that the polymer is not illuminated directly by the light sources, but ")
  #line-at(54pt, 663.6pt, "instead receives light that the sphere's inner surface has diffused. The ‘polymerization sphere’ is mounted ")
  #line-at(54pt, 677.4pt, "on a breadboard to filter vibrations from the environment. ")
]

