#original-page(612pt, 792pt, (image("graphics/page-03.png", width: 242pt), 323pt, 238pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(560.26pt, 30.96pt, "3 ")
  #line-at(46.8pt, 42.48pt, "> REPLACE THIS LINE WITH YOUR MANUSCRIPT ID NUMBER (DOUBLE-CLICK HERE TO EDIT) < ")
  #line-at(46.8pt, 65.4pt, "0.27 mm) were tested in three versions of micro-mirror ")
  #line-at(46.8pt, 77.52pt, "layouts (Fig. 2). The 4×10 section of grating couplers had SiP ")
  #line-at(46.8pt, 89.66pt, "loops between nearest neighbors, that yielded a -4.9 dB ")
  #line-at(46.8pt, 101.66pt, "insertion loss for TE polarized light near the 1550 nm ")
  #line-at(46.8pt, 113.78pt, "telecommunication band when probed by SMFs. ")
  #line-at(57pt, 125.9pt, "The three designs of micro-mirror arrangements showed a ")
  #line-at(46.8pt, 137.9pt, "progression of mirror-waveguide circuitry design from least to ")
  #line-at(46.8pt, 150.02pt, "most compact. Design A was based on the simplest waveguide ")
  #line-at(46.8pt, 162.02pt, "routing configuration, leading to TIR mirrors organized into ")
  #line-at(46.8pt, 174.14pt, "ten groups of four, and spread over an interposer height of ")
  #line-at(46.8pt, 186.26pt, "2 mm. Designs B and C compressed the mirror arrangement 2-")
  #line-at(46.8pt, 198.26pt, "fold, to 1 mm, by reconfiguring five groups of mirrors to align ")
  #line-at(46.8pt, 210.38pt, "at similar planes as the lowest 5 mirror groups in Design A. ")
  #line-at(46.8pt, 222.38pt, "This arrangement pushed pairs of mirrors onto overlapping ")
  #line-at(46.8pt, 234.5pt, "waveguide tracks for coupling with the MCF, requiring a re-")
  #line-at(46.8pt, 246.62pt, "routing of waveguides and/or offsetting of mirror positions to ")
  #line-at(46.8pt, 258.65pt, "enable waveguides to bypass the first set of mirrors. In Design ")
  #line-at(46.8pt, 270.77pt, "B, the back group of mirrors were offset laterally by 30 µm in ")
  #line-at(46.8pt, 282.89pt, "±Z (Fig. 2(b)) while in Design C the back group of mirrors ")
  #line-at(46.8pt, 294.89pt, "were sifted in 50 µm in +Y (Fig. 2(c)). ")
  #line-at(57pt, 307.01pt, "In Designs A and C, an array of 10 straight waveguides ")
  #line-at(46.8pt, 319.01pt, "were formed at 10° angle off vertical and arranged in 4 ")
