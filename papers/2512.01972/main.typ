  #line-at(60.36pt, 106.1pt, "Laser Structured Optical Interposer for Ultra-dense ")
  #line-at(71.304pt, 133.7pt, "Vertical Coupling of Multi-core Fibers to Silicon ")
  #line-at(236.93pt, 161.3pt, "Photonic Chip ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(185.66pt, 187.58pt, "Gligor Djogo, Amir Rahimnouri, and Peter R. Herman ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(56.88pt, 237.38pt, "Abstract")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(87.984pt, 237.38pt, "—Femtosecond laser writing in glass was harnessed to ")
  #line-at(46.8pt, 247.7pt, "fabricate photonic circuits comprised of waveguides, micro-")
  #line-at(46.8pt, 258.05pt, "mirrors, and fiber sockets, in an optical interposer chip. The ")
  #line-at(46.8pt, 268.37pt, "compact design enabled ultra-dense routing of 40 optical ")
  #line-at(46.8pt, 278.81pt, "channels from six multi-core fibers, in a two-layer array, ")
  #line-at(46.8pt, 289.13pt, "vertically coupling onto a 2D grid of silicon photonic grating ")
  #line-at(46.8pt, 299.45pt, "couplers. Various photonic circuit designs were explored and ")
  #line-at(46.8pt, 309.77pt, "tested, achieving an average single-pass insertion loss of -5.0 dB ")
  #line-at(46.8pt, 320.21pt, "for the fully packaged system, with a minimum loss of -3.2 dB. ")
  #line-at(46.8pt, 330.53pt, "The reasonably low loss and low-profile, compact package make ")
  #line-at(46.8pt, 340.85pt, "such interposers an attractive option for densifying interconnects ")
  #line-at(46.8pt, 351.17pt, "to address bottlenecks in optical networks, datacenters, and ")
  #line-at(46.8pt, 361.61pt, "optical computing applications.  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(46.8pt, 383.45pt, "Index Terms")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(96.984pt, 383.45pt, "—Femtosecond laser processing, multi-core fiber, ")
  #line-at(46.8pt, 393.77pt, "photonic circuits, photonic packaging, silicon photonic chip, ")
  #line-at(46.8pt, 404.09pt, "vertical coupling.  ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(131.06pt, 438.91pt, "I.")
  #line-at(138.98pt, 438.91pt, "INTRODUCTION ")
  #line-at(73.824pt, 454.39pt, "ILICON photonics (SiP) has developed into a powerful ")
  #line-at(73.824pt, 466.51pt, "integrated optics platform for telecommunications, ")
  #line-at(73.824pt, 478.63pt, "datacenters, ")
  #line-at(135.686pt, 478.63pt, "quantum ")
  #line-at(184.968pt, 478.63pt, "optics, ")
  #line-at(225.515pt, 478.63pt, "and ")
  #line-at(254.289pt, 478.63pt, "biomedical ")
  #line-at(46.8pt, 490.63pt, "applications [1,2,3 Ghiasi, Yu, Siew]. In comparison to the ")
  #line-at(46.8pt, 502.75pt, "miniaturized SiP chips, the advanced optical networks used to ")
  #line-at(46.8pt, 514.87pt, "interconnect between chip devices are based on optical fiber, ")
  #line-at(46.8pt, 526.87pt, "harboring waveguides with dimensions about 30-fold larger. ")
  #line-at(46.8pt, 538.99pt, "Bridging between these dissimilar platforms has been a major ")
  #line-at(46.8pt, 550.99pt, "challenge in next generation optical interconnects that are ")
  #line-at(46.8pt, 563.11pt, "aiming for higher channel-densities and scaling up of channel ")
  #line-at(46.8pt, 575.23pt, "counts, all the while maintaining low-loss designs [4 ")
  #line-at(46.8pt, 587.23pt, "Marchetti]. ")
  #line-at(57pt, 599.35pt, "Edge coupling of single-mode fibers directly on the chip ")
  #line-at(46.8pt, 611.38pt, "facet is a well-established technique, where engineered tapers ")
  #line-at(46.8pt, 623.5pt, "and lensed fibers have overcome large mode-mismatch loss ")
  #line-at(46.8pt, 635.62pt, "between the fiber and the chip waveguides [4,5 Marchetti, ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 656.74pt, "Manuscript received XX Month 2024; revised XX Month 2024; accepted ")
  #line-at(46.8pt, 665.98pt, "XX Month 2024. This work was supported by the Natural Sciences and ")
  #line-at(46.8pt, 675.22pt, "Research Council of Canada (NSERC) under grant XXX. ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(247.85pt, 675.22pt, "(Corresponding ")
  #line-at(46.8pt, 684.34pt, "author: Gligor Djogo).")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 693.576pt, "The authors are with the Edward S. Rogers Sr. Department of Electrical ")
  #line-at(46.8pt, 702.816pt, "and Computer Engineering, University of Toronto, Toronto, ON M5S 1A4, ")
  #line-at(46.8pt, 711.936pt, "Canada (e-mail: g.djogo@mail.utoronto.ca).  ")
  #line-at(56.88pt, 721.176pt, "Color versions of one or more of the figures in this article are available ")
  #line-at(46.8pt, 730.416pt, "online at http://ieeexplore.ieee.org ")
  #line-at(56.88pt, 739.536pt, "Digital Object Identifier XXX.  ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.25pt, 225.74pt, "Nauriyal]. Limits in the linear packaging density of fiber ")
  #line-at(313.25pt, 237.86pt, "arrays can be overcome with 3D waveguide fanouts formed in ")
  #line-at(313.25pt, 249.86pt, "glass interposers [6,7,8 DjogoIJEM, Zhao, Doany], facilitating ")
  #line-at(313.25pt, 262.01pt, "high packing densities of up to 50 channels/mm in the SiP ")
  #line-at(313.25pt, 274.01pt, "edge when routing from similarly dense multi-core fibers ")
  #line-at(313.25pt, 286.13pt, "(MCF). These channel spacings are at the threshold of ")
  #line-at(313.25pt, 298.25pt, "crosstalk in silica-based waveguides, thus limiting the 1D ")
  #line-at(313.25pt, 310.25pt, "scalability for edge coupling. ")
  #line-at(323.45pt, 322.37pt, "To better harness the high areal density of 448 cores/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(562.18pt, 318.89pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.25pt, 334.37pt, "available today in MCF [9 VIKopp], one must consider ")
  #line-at(313.25pt, 346.49pt, "vertical coupling to the surface of the SiP chip [4 Marchetti]. ")
  #line-at(313.25pt, 358.61pt, "Vertical coupling may be driven either through waveguide-to-")
  #line-at(313.25pt, 370.61pt, "waveguide adiabatic coupling [10,11 Brusberg, Poulopoulos] ")
  #line-at(313.25pt, 382.73pt, "or grating coupling [12,13 CKopp, Mirshafiei]. The latter is ")
  #line-at(313.25pt, 394.85pt, "preferred due to more relaxed alignment and packaging ")
  #line-at(313.25pt, 406.85pt, "tolerances, as well as higher coupling efficiencies by mode-")
  #line-at(313.25pt, 418.97pt, "matching of the silicon-grating to fiber waveguide modes. ")
  #line-at(313.25pt, 430.99pt, "These advantages tend to outweigh the restrictions on the ")
  #line-at(313.25pt, 443.11pt, "bandwidth (i.e., < 100 nm) and the selective polarization ")
  #line-at(313.25pt, 455.23pt, "response of the gratings [12,4 CKopp, Marchetti]. Simple ")
  #line-at(313.25pt, 467.23pt, "packaging of fiber orthogonally onto a 2D grid of grating ")
  #line-at(313.25pt, 479.35pt, "couplers [9,14 VIKopp, Ding] has been demonstrated up to 37 ")
  #line-at(313.25pt, 491.35pt, "fiber channels, while a more robust packaging solution used ")
  #line-at(313.25pt, 503.47pt, "an interposer with a waveguide fanout impinging vertically on ")
  #line-at(313.25pt, 515.59pt, "SiP grating couplers arrayed at 87 channels/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(516.22pt, 512.11pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(519.34pt, 515.59pt, " density [7 ")
  #line-at(313.25pt, 527.59pt, "Zhao]. However, the optical fibers remained vertically ")
  #line-at(313.25pt, 539.71pt, "mounted above the SiP chip owing to the limited bend radius ")
  #line-at(313.25pt, 551.83pt, "available. ")
  #line-at(323.45pt, 563.83pt, "Facilitating dense, 3D routing of channels in vertical ")
  #line-at(313.25pt, 575.95pt, "coupling requires new means for creating steep waveguide ")
  #line-at(313.25pt, 587.95pt, "bends within the interposer, to enable a flattening of these ")
  #line-at(313.25pt, 600.07pt, "intermediate ")
  #line-at(374.155pt, 600.07pt, "coupling ")
  #line-at(420.061pt, 600.07pt, "layers ")
  #line-at(454.722pt, 600.07pt, "into ")
  #line-at(481.206pt, 600.07pt, "compact ")
  #line-at(526.036pt, 600.07pt, "packages. ")
  #line-at(313.25pt, 612.22pt, "Alternatively, embedded mirrors within the interposer can ")
  #line-at(313.25pt, 624.22pt, "offer low-profile packaging onto the surface of a SiP chip that ")
  #line-at(313.25pt, 636.34pt, "meet robustness and compactness requirements for industrial ")
  #line-at(313.25pt, 648.46pt, "settings. In one approach, mirrored surfaces, often based on ")
  #line-at(313.25pt, 660.46pt, "total internal reflection (TIR), have been proposed in a variety ")
  #line-at(313.25pt, 672.58pt, "of geometric configurations [13,15,16,17,18,19 Mirshafiei, ")
  #line-at(313.25pt, 684.58pt, "Wang, Cheng, Huang, Boucaud, Chou], where machining, ")
  #line-at(313.25pt, 696.696pt, "etching, or polishing away of substrate material enables tight ")
  #line-at(313.25pt, 708.816pt, "redirection of light from inside fiber or within optical circuits. ")
  #line-at(313.25pt, 720.816pt, "In glass, hollowed-out trenches have shown to be strong TIR ")
  #line-at(313.25pt, 732.936pt, "reflectors [15,16 Wang, Cheng], including fiber-to-waveguide ")
  #set text(font: "Times New Roman", size: 48.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 478.63pt, "S ")
]

