  #line-at(57pt, 674.02pt, "Overall, the experimental loss data could be well ")
  #line-at(46.8pt, 686.14pt, "represented by the simulated results in Table II, particularly ")
  #line-at(46.8pt, 698.256pt, "for Design A-3 where measured fanout and full interposer ")
