#original-page(612pt, 792pt, (image("graphics/page-02.png", width: 460.5pt), 50pt, 116.5pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(560.26pt, 30.96pt, "2 ")
  #line-at(46.8pt, 42.48pt, "> REPLACE THIS LINE WITH YOUR MANUSCRIPT ID NUMBER (DOUBLE-CLICK HERE TO EDIT) < ")
  #line-at(46.8pt, 65.4pt, "coupling [17 Huang], as long as the surface smoothness is ")
  #line-at(46.8pt, 77.52pt, "minimized. However, such macro-scale mirror-waveguide ")
  #line-at(46.8pt, 89.66pt, "circuits have failed to meet the higher channel densities ")
  #line-at(46.8pt, 101.66pt, "suitable for optical interconnects in SiP chips. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 320.09pt, "Fig. 1.")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 320.09pt, " Vision for a high-density vertical coupling platform using ")
  #line-at(46.8pt, 331.01pt, "micro-mirror and 3D waveguide circuits to interconnect MCFs to SiP ")
  #line-at(46.8pt, 341.81pt, "gratings. Insets show the grating layout on a real SiP test chip, with ")
  #line-at(46.8pt, 352.73pt, "the highlighted loops being targeted in the paper. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(57pt, 376.49pt, "Microfabrication techniques in polymer interposers have ")
  #line-at(46.8pt, 388.61pt, "permitted waveguides from a single horizontal plane to ")
  #line-at(46.8pt, 400.61pt, "terminate in TIR wedges, and couple vertically into SiP [18,19 ")
  #line-at(46.8pt, 412.73pt, "Boucaud, Chou]. Extension to 3D fanouts would be necessary ")
  #line-at(46.8pt, 424.73pt, "to fully exploit the high areal density available from grating ")
  #line-at(46.8pt, 436.87pt, "couplers. Glass interposers would offer higher robustness and ")
  #line-at(46.8pt, 448.99pt, "thermally stability over polymer materials. To this end, ")
  #line-at(46.8pt, 460.99pt, "femtosecond laser irradiation with chemical etching (FLICE) ")
  #line-at(46.8pt, 473.11pt, "[20,21 Hnatovsky, Marcinkevicius] is a promising direction ")
  #line-at(46.8pt, 485.23pt, "for opening micro-disks at arbitrary 3D positions in a glass ")
  #line-at(46.8pt, 497.23pt, "substrate and serve as TIR mirrors. FLICE surfaces with ")
  #line-at(46.8pt, 509.35pt, "smoothness down to 10 nm rms have been demonstrated [22 ")
  #line-at(46.8pt, 521.35pt, "Ho]. Such optical-grade disks have been applied as micro-")
  #line-at(46.8pt, 533.47pt, "optical resonators within a 3D waveguide circuit [23 Haque] ")
  #line-at(46.8pt, 545.59pt, "and as micro-mirror reflectors for high angled turns of buried ")
  #line-at(46.8pt, 557.59pt, "waveguides [24 Amir?]. The facility of 3D writing to precisely ")
  #line-at(46.8pt, 569.71pt, "register multi-level TIR optical components with 3D ")
  #line-at(46.8pt, 581.83pt, "waveguides may thus be extended over a large glass volume, ")
  #line-at(46.8pt, 593.83pt, "as waveguides can be routed around, above, or below mirrors ")
  #line-at(46.8pt, 605.98pt, "to generate compact interposer designs for vertical coupling to ")
  #line-at(46.8pt, 617.98pt, "SiP chips, without trading off system performance. ")
  #line-at(57pt, 630.1pt, "In this paper, a fully packaged glass interposer is presented ")
  #line-at(46.8pt, 642.22pt, "between a 2D array of MCFs and grating couplers on a SiP ")
  #line-at(46.8pt, 654.22pt, "chip, demonstrating low-loss vertical chip coupling through 40 ")
  #line-at(46.8pt, 666.34pt, "waveguide channels. Femtosecond laser micro-structuring was ")
  #line-at(46.8pt, 678.34pt, "harnessed to create high-density waveguide circuits and etched ")
  #line-at(46.8pt, 690.46pt, "TIR micro-mirrors on multiple layers inside the interposer, as ")
  #line-at(46.8pt, 702.576pt, "shown schematically in Fig. 1. The design also incorporated ")
  #line-at(46.8pt, 714.576pt, "fiber sockets [6,25 DjogoIJEM, DjogoJLT] that facilitated ")
  #line-at(46.8pt, 726.696pt, "self-alignment of MCFs into the interposer, while 3D laser ")
  #line-at(46.8pt, 738.816pt, "writing permitted precise registration of the waveguide circuits ")
  #line-at(313.25pt, 65.4pt, "to each optical element with minimal added loss. The optical ")
  #line-at(313.25pt, 77.52pt, "coupling through the interposer was limited by the bandwidth ")
  #line-at(313.25pt, 89.66pt, "and polarization sensitivity of the SiP gratings. Thus, the fully ")
  #line-at(313.25pt, 101.66pt, "packaged design demonstrates a step towards scaling up ")
  #line-at(313.25pt, 113.78pt, "robust, low-profile, high channel-density coupling systems, ")
  #line-at(313.25pt, 125.9pt, "reaching towards the large-scale coupling vision laid out in ")
  #line-at(313.25pt, 137.9pt, "Fig. 1. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(313.25pt, 415.37pt, "Fig. 2.")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(337.03pt, 415.37pt, " Waveguide paths and micro-mirror arrangements traced out ")
  #line-at(313.25pt, 426.17pt, "for the three circuit designs. (a) Design A spreads out ten mirror ")
  #line-at(313.25pt, 437.11pt, "groups in a linear array, (b) Design B compresses the mirror ")
  #line-at(313.25pt, 447.91pt, "arrangement by introducing additional S-bends, and (c) Design C ")
  #line-at(313.25pt, 458.83pt, "achieves a compressed arrangement with waveguide intersects ")
  #line-at(313.25pt, 469.63pt, "instead. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(392.71pt, 505.51pt, "II.")
  #line-at(403.99pt, 505.51pt, "I")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407.35pt, 505.51pt, "NTERPOSER ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(455.11pt, 505.51pt, "D")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(462.34pt, 505.51pt, "ESIGN")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.45pt, 520.99pt, "The interposer design targeted a three-dimensional ")
  #line-at(313.25pt, 532.99pt, "matching of waveguide links between on-chip grating couplers ")
  #line-at(313.25pt, 545.11pt, "(see [7 Zhao]) laid out at a density of 10 grating couplers per ")
  #line-at(313.25pt, 557.23pt, "row on 127 µm by 90 µm pitch (Fig. 1 inset) and multicore ")
  #line-at(313.25pt, 569.23pt, "fibers. The present MCF (Chiral Photonics, MCF-007_2) ")
  #line-at(313.25pt, 581.35pt, "provided six waveguide cores arranged in a hexagonal pattern ")
  #line-at(313.25pt, 593.47pt, "around a seventh central core, with 37 µm core-to-core ")
  #line-at(313.25pt, 605.5pt, "separations. In prior work, this MCF had been packaged with ")
  #line-at(313.25pt, 617.62pt, "a 3D interposer at a conservative linear density of 250 µm ")
  #line-at(313.25pt, 629.62pt, "fiber-to-fiber spacing, facilitated by a novel approach using ")
  #line-at(313.25pt, 641.74pt, "self-aligning sockets [6 DjogoIJEM]. For the present purpose, ")
  #line-at(313.25pt, 653.86pt, "such a single layer MCF array (28 core/mm) fell about 3-fold ")
  #line-at(313.25pt, 665.86pt, "short of matching the grating-coupler density (i.e., 111 ")
  #line-at(313.25pt, 677.98pt, "couplers/mm) on the SiP chip. Two versions of denser fiber ")
  #line-at(313.25pt, 689.98pt, "socket coupling were thus targeted, packaged in one row of six ")
  #line-at(313.25pt, 702.096pt, "stacked MCFs (Design A) or two rows of three MCFs (Design ")
  #line-at(313.25pt, 714.216pt, "B and C), as shown in Fig. 2. ")
  #line-at(323.45pt, 726.216pt, "In total, the interconnection of 40 input/output channels ")
  #line-at(313.25pt, 738.336pt, "over four rows of grating couplers (x = 1.143 mm by y = ")
]

