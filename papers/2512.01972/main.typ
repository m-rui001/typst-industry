  #line-at(313.25pt, 590.59pt, "3 (Fig. 5(a)), a repeating progression from shallow to deeper ")
  #line-at(313.25pt, 602.62pt, "waveguides on 4 channel cycles manifested in losses cycling ")
  #line-at(313.25pt, 614.74pt, "between -1.4 to -1.9 dB, with an average of -1.62 dB and ")
  #line-at(313.25pt, 626.74pt, "standard deviation of 0.14 dB for the fanout-only (blue) ")
  #line-at(313.25pt, 638.86pt, "interposer. The 0.5 dB higher loss for the deeper waveguides ")
  #line-at(313.25pt, 650.98pt, "arises from surface aberration effects on deep and large NA ")
  #line-at(313.25pt, 662.98pt, "laser focusing as widely reported in the literature [26 Ehsan, ")
  #line-at(313.25pt, 675.1pt, "others]. The addition of TIR mirrors and angled vertical ")
  #line-at(313.25pt, 687.22pt, "waveguides can be seen to disturb the cyclical pattern and add ")
  #line-at(313.25pt, 699.216pt, "a further ~ 1 dB increase to the insertion losses to yield an ")
  #line-at(313.25pt, 711.336pt, "average -2.63 dB loss (σ = 0.24 dB). The higher number ")
  #line-at(313.25pt, 723.336pt, "channels with higher reported losses (~ 2.9 dB) correlated ")
  #line-at(313.25pt, 735.456pt, "with the longest waveguides in the vertical coupling section of ")
