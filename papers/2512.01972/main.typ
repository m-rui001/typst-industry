  #line-at(313.25pt, 125.9pt, "2D grating array that was otherwise restricted to the edge ")
  #line-at(313.25pt, 137.9pt, "coupling case to about 33 channels/mm. Hence, it also ")
  #line-at(313.25pt, 150.02pt, "achieved the minimum single pass loss of -3.2 dB in loop 11, ")
  #line-at(313.25pt, 162.02pt, "for both vertical and edge couplers. ")
  #line-at(323.45pt, 174.14pt, "In the push to drive up the density for fiber-to-chip ")
  #line-at(313.25pt, 186.26pt, "interconnection Kopp et al. [9 VIKopp] harnessed a finely ")
  #line-at(313.25pt, 198.26pt, "pitched tapered fiber array for ultra dense coupling at ")
  #line-at(313.25pt, 210.38pt, "1250 channels/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(389.11pt, 206.9pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(392.35pt, 210.38pt, " and 3 dB average loss to SiP grating ")
  #line-at(313.25pt, 222.38pt, "arrays. However, this direct fiber-to-grating coupling presents ")
  #line-at(313.25pt, 234.5pt, "an intrusive geometry that precludes the benefits of 3D multi-")
  #line-at(313.25pt, 246.62pt, "layered packaging as facilitated by the present interposer ")
  #line-at(313.25pt, 258.65pt, "design (Fig. 4) via a thin (2 mm) silica optical circuit. Dense ")
  #line-at(313.25pt, 270.77pt, "2D arrays of MCF (6 MCF at 150 channels/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(508.66pt, 267.29pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(511.9pt, 270.77pt, ") on the edge ")
  #line-at(313.25pt, 282.89pt, "of the interposer were interconnected with the dense 2D array ")
  #line-at(313.25pt, 294.89pt, "of vertical grating couplers (87 channels/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(506.86pt, 291.41pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(510.1pt, 294.89pt, ") on the SiP ")
  #line-at(313.25pt, 307.01pt, "chip. The interposer average single-pass loss of -5.0 dB at ")
  #line-at(313.25pt, 319.01pt, "1505 nm ")
  #line-at(360.64pt, 319.01pt, "wavelength ")
  #line-at(418.687pt, 319.01pt, "(Fig. 6(c)) ")
  #line-at(471.853pt, 319.01pt, "which ")
  #line-at(508.188pt, 319.01pt, "improves ")
  #line-at(557.33pt, 319.01pt, "to ")
  #line-at(313.25pt, 331.13pt, "approximately -4.0 dB if the losses in both of the waveguide ")
  #line-at(313.25pt, 343.25pt, "and grating designs were minimized to the same 1550 nm ")
  #line-at(313.25pt, 355.25pt, "wavelength (Fig. 6(b)). ")
  #line-at(323.45pt, 367.37pt, "An interposer design by Zhao et al. [7 Zhao] provided an ")
  #line-at(313.25pt, 379.49pt, "improved single-pass loss of -2.4 dB at similar high-density ")
  #line-at(313.25pt, 391.49pt, "design of 87 channels/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(420.19pt, 388.01pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(423.43pt, 391.49pt, " to the SiP surface, but without the ")
  #line-at(313.25pt, 403.61pt, "TIR mirrors. With a comparable footprint of 6 mm by 2 mm, ")
  #line-at(313.25pt, 415.61pt, "the fibers projected vertically from the interposer standing ")
  #line-at(313.25pt, 427.75pt, "19 mm tall above the SiP surface, thus eliminating the ")
  #line-at(313.25pt, 439.87pt, "potential for multi-level stacking of board level integrated ")
  #line-at(313.25pt, 451.87pt, "electronics and photonics. Other interposer approaches for ")
  #line-at(313.25pt, 463.99pt, "low-profile vertical coupling have relied on TIR as induced by ")
  #line-at(313.25pt, 475.99pt, "angle polished wedges intercepting waveguides. With such ")
  #line-at(313.25pt, 488.11pt, "wedges, ")
  #line-at(359.066pt, 488.11pt, "laser ")
  #line-at(391.207pt, 488.11pt, "written ")
  #line-at(432.929pt, 488.11pt, "waveguides ")
  #line-at(493.486pt, 488.11pt, "[13 ")
  #line-at(520.199pt, 488.11pt, "Mirshafiei] ")
  #line-at(313.25pt, 500.23pt, "offered ")
  #line-at(354.19pt, 500.23pt, "-1.7 dB ")
  #line-at(395.936pt, 500.23pt, "insertion ")
  #line-at(442.807pt, 500.23pt, "loss, ")
  #line-at(472.668pt, 500.23pt, "polymer ")
  #line-at(517.966pt, 500.23pt, "waveguides ")
  #line-at(313.25pt, 512.23pt, "offered -5.5 dB loss [18 Boucaud], and ion-exchange ")
  #line-at(313.25pt, 524.35pt, "waveguides offered -1.6 dB average loss [27 Schroder]. In ")
  #line-at(313.25pt, 536.47pt, "these cases, various limitations were imposed by the large ")
  #line-at(313.25pt, 548.47pt, "wedge structure and planar waveguide circuitry, precluding a ")
  #line-at(313.25pt, 560.59pt, "scaling up to the higher channel numbers (40) or channel ")
  #line-at(313.25pt, 572.59pt, "densities (87 ch/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(403.15pt, 569.11pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.39pt, 572.59pt, ") in the present interposer (Fig. 2), ")
  #line-at(313.25pt, 584.71pt, "without the need for complex stacking and packaging of the ")
  #line-at(313.25pt, 596.83pt, "multi-layered wedge devices. For example, Schroder et al. ")
  #line-at(313.25pt, 608.86pt, "presented a 9-channel interposer with low density of 4 ")
  #line-at(313.25pt, 620.98pt, "channel/mm")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(362.83pt, 617.5pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(366.07pt, 620.98pt, ". ")
  #line-at(323.45pt, 632.98pt, "Direct writing of polymer waveguides in 3D, known as ")
  #line-at(313.25pt, 645.1pt, "photonic wire bonding, has coupled MCF and waveguides ")
  #line-at(313.25pt, 657.22pt, "with low loss and is a rapidly developing technology for high-")
  #line-at(313.25pt, 669.22pt, "density interconnects [28 Lindenmann]. However, polymer ")
  #line-at(313.25pt, 681.34pt, "waveguide materials have not offered the robustness and ")
  #line-at(313.25pt, 693.456pt, "scalability provided by dielectric waveguide circuits. The ")
  #line-at(313.25pt, 705.456pt, "selection of the fused silica substrate in this work was driven ")
  #line-at(313.25pt, 717.576pt, "by the FLICE processing, enabling low-loss TIR micro-")
  #line-at(313.25pt, 729.576pt, "mirrors (< -0.8 dB) to be embedded and interfaced with 3D ")
]

