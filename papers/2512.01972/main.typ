  #line-at(57pt, 695.256pt, "For each of the three interposer designs presented in Section ")
  #line-at(46.8pt, 707.256pt, "2, three versions of waveguide mapping were assessed for ")
  #line-at(46.8pt, 719.376pt, "propagation losses between the micro-mirrors and MCF ")
  #line-at(46.8pt, 731.496pt, "sockets by applying the loss parameters in Table I. Results for ")
  #line-at(313.25pt, 65.4pt, "average fanout losses as estimated over all 40 channels are ")
  #line-at(313.25pt, 77.52pt, "reported in Table II (column 3). Higher loss was found to ")
  #line-at(313.25pt, 89.66pt, "correlate with larger lateral offset of the waveguides ")
  #line-at(313.25pt, 101.66pt, "(column 2). For example, in Design B, smallest waveguide ")
  #line-at(313.25pt, 113.78pt, "offsets averaging in a range of 65 to 69 µm (with root mean ")
