#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 91.94pt, "modulation due to interference and standing-wave effects within the multilayer stack, ")
  #line-at(90.024pt, 123.14pt, "heat diffusion evolves over much longer spatial and temporal scales, making it difficult ")
  #line-at(90.024pt, 154.34pt, "for a unified finite-element mesh to simultaneously resolve both phenomena. Due to ")
  #line-at(90.024pt, 185.54pt, "these limitations, FEM also struggles to provide reliable and efficient predictions of ")
  #line-at(90.024pt, 216.74pt, "transient temperature fields in EUV multilayer mirrors. Overall, a unified, efficient, and ")
  #line-at(90.024pt, 247.94pt, "cross-scale framework that self-consistently couples electromagnetic absorption with ")
  #line-at(90.024pt, 279.17pt, "thermal evolution remains absent. ")
  #line-at(111.02pt, 310.37pt, "In this work, we develop an analytical cross-scale electromagnetic–thermal ")
  #line-at(90.024pt, 341.57pt, "coupling model (ETCM) that self-consistently captures the interplay between ")
  #line-at(90.024pt, 372.77pt, "interference-controlled electromagnetic absorption and transient heat diffusion in ")
  #line-at(90.024pt, 403.97pt, "nanoscale multilayers. The ETCM enables efficient and accurate prediction of ")
  #line-at(90.024pt, 435.17pt, "photothermal responses under pulsed EUV irradiation, while providing quantitative ")
  #line-at(90.024pt, 466.39pt, "insight into how external irradiation conditions and intrinsic interfacial properties ")
  #line-at(90.024pt, 497.59pt, "jointly govern thermal stability and structural evolution. Although established and ")
  #line-at(90.024pt, 528.79pt, "validated here for Mo/Si multilayers under 13.5-nm EUV irradiation, the underlying ")
  #line-at(90.024pt, 559.99pt, "coupling strategy—linking transfer-matrix-derived volumetric energy deposition with ")
  #line-at(90.024pt, 591.19pt, "multilayer heat conduction—is fundamentally general. It can be directly extended to ")
  #line-at(90.024pt, 622.42pt, "other multilayer optical stacks operating across a wide spectral range, from EUV to X-")
  #line-at(90.024pt, 653.62pt, "ray, and under diverse pulsed irradiation conditions. This framework therefore provides ")
  #line-at(90.024pt, 684.82pt, "a rigorous theoretical basis for elucidating irradiation-induced degradation mechanisms ")
  #line-at(90.024pt, 716.02pt, "in multilayer nanofilms and offers a practical route toward the thermal–optical co-")
  #line-at(90.024pt, 747.216pt, "design of multilayer optic systems. ")
]

