  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(111.02pt, 263.57pt, "By providing this reliable framework,")
  #line-at(300.89pt, 263.57pt, "the validated ETCM enables a systematic ")
  #line-at(90.024pt, 294.77pt, "investigation into the fundamental mechanisms governing the electromagnetic energy ")
  #line-at(90.024pt, 325.97pt, "deposition and thermal response of Mo/Si multilayers under EUV pulsed irradiation. In ")
  #line-at(90.024pt, 357.17pt, "the following studies, a more practical beam radius of 30 μm is adopted unless ")
  #line-at(90.024pt, 388.37pt, "otherwise specified. As illustrated in Fig. 3(a), the electromagnetic-field distribution ")
  #line-at(90.024pt, 419.57pt, "exhibits clear interference fringes due to multiple reflections at the interfaces, giving ")
  #line-at(90.024pt, 450.79pt, "rise to an intensity pattern that alternates with depth while undergoing gradual ")
  #line-at(90.024pt, 481.99pt, "attenuation. Furthermore,")
  #line-at(220.37pt, 481.99pt, "the resultant absorption energy distribution in Fig. 3(b), ")
  #line-at(90.024pt, 513.19pt, "derived from this interference pattern, decreases overall with depth and exhibits ")
  #line-at(90.024pt, 544.39pt, "noticeable oscillations across the multilayer stack. These features arise from the ")
  #line-at(90.024pt, 575.59pt, "interplay of interference and absorption, in which the interference modulates the local ")
  #line-at(90.024pt, 606.79pt, "field strength and thus leads to the oscillations, while material absorption accounts for ")
  #line-at(90.024pt, 638.02pt, "the monotonic energy decay with depth. This combined effect produces a non-uniform ")
  #line-at(90.024pt, 669.22pt, "absorption profile that directly determines the spatial variation of the electromagnetic ")
  #line-at(90.024pt, 700.42pt, "field and the resultant temperature. ")
]

