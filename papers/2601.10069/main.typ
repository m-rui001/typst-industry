  #line-at(90.024pt, 154.34pt, "because the compaction reduces the individual layer thicknesses, disrupting the precise ")
  #line-at(90.024pt, 185.54pt, "optical periodicity required to establish a stable interference condition for 13.5-nm ")
  #line-at(90.024pt, 216.74pt, "EUV light. When the total compaction reaches approximately 12.8 nm, the reflectivity ")
  #line-at(90.024pt, 247.94pt, "drops sharply to 26.6%, an exponential fraction of its initial peak value of ~72.3%. Thus, ")
  #line-at(90.024pt, 279.17pt, "we define 12.8 nm (3.7% of the total mirror thickness) as the functional failure ")
  #line-at(90.024pt, 310.37pt, "threshold for Mo/Si multilayers, below which the mirror cannot meet operational ")
  #line-at(90.024pt, 341.57pt, "requirements. Using this defined threshold, the compaction model is integrated with ")
  #line-at(90.024pt, 372.77pt, "ETCM to predict the evolution of interfacial compaction under prolonged EUV ")
  #line-at(90.024pt, 403.97pt, "irradiation at different laser energy densities (see Supplementary Note 9 for details). ")
