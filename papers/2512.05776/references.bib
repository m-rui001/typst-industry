title = {Measurement of the optically induced spin polarisation of N-V centres in diamond},
journal = {Diamond and Related Materials},
volume = {15},
number = {4},
pages = {586-588},
year = {2006},
note = {Diamond 2005},
issn = {0925-9635},
doi = {https://doi.org/10.1016/j.diamond.2005.12.027},
url = {https://www.sciencedirect.com/science/article/pii/S0925963505006266},
author = {J. Harrison and M.J. Sellars and N.B. Manson},
keywords = {Diamond crystal, Optical properties, Impurities},
abstract = {The nitrogen-vacancy (N-V) colour centre in diamond has an electronic ground state with spin S=1. The axial crystal field lifts the degeneracy of the spin triplet and the ground state consists of a spin singlet (Sz=0) and a spin doublet (Sz=±1) separated by 2.88 GHz at zero field. Preferential population of the Sz=0 state results when the centre is optically excited from the ground state. Using EPR spectroscopy at low temperature with laser illumination of the sample, we have quantified the degree of spin polarisation. The relevance of these measurements to proposed quantum computing applications of the N-V centre are discussed.}
}



