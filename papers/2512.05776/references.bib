@InCollection{PeterBook,
author ="P. Blümler and F. Casanova",
title  ="CHAPTER 4 Hardware Developments: Single-Sided Magnets",
booktitle  ="Mobile NMR and MRI: Developments and Applications",
year  ="2016",
pages  ="110-132",
publisher  ="The Royal Society of Chemistry",
isbn  ="978-1-84973-915-3",
doi  ="10.1039/9781782628095-00110",
abstract  ="Various magnets and rf coil geometries for single sided NMR are compared with respect to their performance and use. The different designs are discussed in a very conceptual way to emphasize the principal ideas and to give a “hands-on” introduction to start new developments. Therefore{,} magnet arrangements are first characterized by the direction and depth dependence of the generated flux; starting from simple building blocks and construction tricks to realized devices. Two extremes are then compared in more detail: one is depth profiling by magnets with strong gradients and the other are magnets generating a relatively homogeneous flux over an extended volume (“sweet spot”). These designs are complemented by typical applications like spatial resolution for imaging and shimming for spectroscopy. Finally{,} the signal-to-noise is compared for both extremes together with gradiometer rf coils to reduce external noise."}

@article{Peter3,
author = {Soltner, H. and Blümler, P.},
title = {Dipolar Halbach magnet stacks made from identically shaped permanent magnets for magnetic resonance},
journal = {Concepts in Magnetic Resonance Part A},
volume = {36A},
number = {4},
pages = {211-222},
keywords = {homogeneity, NMR, MRI, EPR, ESR, Mandhala, magic ring, portable, mobile, permanent magnet},
doi = {10.1002/cmr.a.20165},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cmr.a.20165},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/cmr.a.20165},
abstract = {Abstract NMR Mandhalas (Magnetic Arrangement for Novel Discrete Halbach LAyout) are arrays of identically shaped magnets in a Halbach-type arrangement. They provide a simple and cost-effective way to generate high magnetic fields for mobile applications, for example, in magnetic resonance. Based on the introductory publication by Raich and Blümler (Concepts Magn Reson 2004;23B:16–25), we extend the notion of Mandhalas from cube-shaped magnets to polygonal and cylindrical ones and present construction guidelines for the stacking of such rings to generate homogeneous magnetic fields over larger volumes. For this purpose, we present formulas and numerical values based on a dipole approach to calculate the flux density of single rings and composed 3D systems and compare to corresponding results obtained by 3D boundary element method calculations. As an application of the approach presented here, we constructed prototypes. © 2010 Wiley Periodicals, Inc. Concepts Magn Reson Part A 36A: 211–222, 2010.},
year = {2010}
}

