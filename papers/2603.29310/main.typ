  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.12pt, 217.76pt, "), whereas motions in directions normal to this axis is hindered by an ")
  #line-at(90pt, 233.36pt, "enlarged cross-section (R")
  #set text(font: "Cambria Math", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(202.68pt, 234.32pt, "⊥")
