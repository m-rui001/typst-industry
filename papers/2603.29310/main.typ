  #line-at(90pt, 120.92pt, "particle diameter is 30 ")
  #line-at(198.72pt, 120.92pt, "m. ")
  #line-at(90pt, 155.36pt, "The anisotropic morphology of the ‘porcupine-like’ particle—considering a spherical core ")
  #line-at(90pt, 170.96pt, "coated with elongated conical scales—induces a marked imbalance between diffusion parallel ")
  #line-at(90pt, 186.56pt, "and perpendicular to the particle’s symmetry axis. Because translation along the axis ")
  #line-at(90pt, 202.16pt, "encounters a smaller effective hydrodynamic radius (R")
