  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(235.08pt, 482.96pt, " - modulates microscale stochastic transport in water. ")
  #line-at(90pt, 498.56pt, "The figure 10 shows a direct comparison between the Brownian motion of a porcupine-like ")
  #line-at(90pt, 514.16pt, "particle (spherical core + outward filaments, anisotropic diffusion), and a smooth sphere of ")
