#original-page(595pt, 842pt, (image("graphics/page-05.png", width: 449.5pt), 90pt, 76pt))[
  #set text(font: "Calibri", size: 10.923pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 291.44pt, "Fig. 1: Fabrication of PMMA spheres with compartmentalized layer as patch of azopolymer on ")
  #line-at(90pt, 309.44pt, "the external surface. ")
  #line-at(90pt, 341.36pt, "Due to directional photo-fluidization of azopolymers, shell compartimentalized layer of ")
  #line-at(90pt, 359.24pt, "azopolymer can be light manipulated to obtain unique shapes, which can hardly be obtained ")
  #line-at(90pt, 377.24pt, "by other methods [17]. To investigate this possibility, azospheres were subjected to laser ")
  #line-at(90pt, 395.12pt, "irradiation.  Upon laser illumination, ")
  #set text(font: "Calibri", size: 10.923pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(256.92pt, 395.12pt, "trans-cis")
  #set text(font: "Calibri", size: 10.923pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.72pt, 395.12pt, " photoisomerization occur at each fragment of ")
  #line-at(90pt, 413.12pt, "the azopolymer on the surface of the core PMMA. The photo-fluidization of azopolymer leads ")
  #line-at(90pt, 431pt, "to isomerization results in a mass transport of azopolymers in the direction of the polarization ")
  #line-at(90pt, 449pt, "of the laser [18]. A TM polarization (vertical polarization) of the laser was first sent to ")
  #line-at(90pt, 466.88pt, "illuminate the new nanoparticles (fig. 2a). The photo-deformation occurs at each fragment of ")
