  #set text(font: "Times New Roman", size: 12.786pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(333.855pt, 642.072pt, "0")
  #set text(font: "Times New Roman", size: 12.786pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(309.086pt, 642.072pt, "M")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(342.31pt, 641.98pt, "is known as the mobility or Onsager ")
  #line-at(72.024pt, 662.98pt, "coefficient, which regulates the diffusion across the interface. The chemical potential,")
  #line-at(508.06pt, 662.98pt, ", is ")
