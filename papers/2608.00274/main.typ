  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 82.92pt, "During the breakup process, as the system approaches the Newtonian pinch-off time, the ")
  #line-at(72.024pt, 103.58pt, "polymer chains undergo rapid stretching, leading to a substantial increase in elastic stress, ")
  #line-at(72.024pt, 124.34pt, "which becomes sufficient to balance the diverging capillary pressure in the elasto-capillary ")
  #line-at(72.024pt, 144.98pt, "regime. Consequently, the minimum neck radius decays exponentially with time, a behavior ")
  #line-at(72.024pt, 165.74pt, "that has been observed both experimentally (Bazilevsky ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
