  #line-at(72.024pt, 657.82pt, "lubrication approximation, coupled with constitutive equation of the viscoelastic model ")
  #line-at(72.024pt, 678.58pt, "(Eggers & Villermaux 2008; Clasen ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(250.49pt, 678.58pt, "et al. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(278.69pt, 678.58pt, "2006). This approximation reduces the problem to ")
  #line-at(72.024pt, 699.22pt, "a one-dimensional description of the jet radius, axial velocity, and polymeric stresses. The ")
  #line-at(72.024pt, 719.98pt, "self-similar profiles of a viscoelastic filament undergoing thinning have been computed using ")
  #line-at(72.024pt, 740.62pt, "direct numerical simulations (Turkoz ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
