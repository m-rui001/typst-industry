  #line-at(316.27pt, 380.69pt, "2024).  ")
  #line-at(108.02pt, 409.49pt, "As a closure to this section, the dynamics of cavity formation, its growth, stall, and ")
  #line-at(72.024pt, 430.15pt, "collapse, the consequent Worthington jet-stretching, filament formation, and eventual ")
