  #line-at(245.175pt, 610.043pt, "t")
  #set text(font: "Times New Roman", size: 12.036pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(286.868pt, 600.769pt, "V")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(500.02pt, 600.7pt, "(2.2) ")
  #line-at(72.024pt, 641.98pt, "Here, ")
