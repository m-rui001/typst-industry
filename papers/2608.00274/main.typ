  #line-at(372.55pt, 541.27pt, ", minimizing the free-energy at ")
  #line-at(72.024pt, 564.19pt, "the interface of two bulk phases, is expressed as ")
  #set text(font: "Times New Roman", size: 6.963pt, weight: "regular", style: "normal", fill: rgb("#000000"))
