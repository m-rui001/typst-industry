  #line-at(201.53pt, 104.06pt, " corresponding to the 0D-0P case, with those of the other droplet-")
  #line-at(72.024pt, 126.98pt, "pool combinations, we quantify the amount of elastic energy stored by the stretching of the ")
  #line-at(72.024pt, 147.74pt, "long-chain polymer molecules during cavity formation. In the 0D-0P combination, we obtain ")
  #set text(font: "Times New Roman", size: 12.745pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(94.966pt, 168.975pt, "0.80")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(118.46pt, 168.86pt, ", i.e., ~80% of the initial kinetic energy of the impacting droplet contributes to the ")
  #line-at(72.024pt, 192.26pt, "cavity expansion process. In contrast, for the 500D-500P combination, we obtain ")
  #set text(font: "Times New Roman", size: 12.738pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(496.841pt, 192.375pt, "0.45")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(520.42pt, 192.26pt, ", ")
