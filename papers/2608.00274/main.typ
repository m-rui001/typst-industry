  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(179.45pt, 360.05pt, "2005). The thinning, breakup, and subsequent formation of satellite ")
  #line-at(72.024pt, 380.69pt, "droplets in polymeric liquid filaments have been investigated in canonical configurations, ")
