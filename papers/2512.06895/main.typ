  #line-at(313.2pt, 94.2pt, "value is loaded into the TFF chain, which starts from ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(556.56pt, 94.2pt, "P")
