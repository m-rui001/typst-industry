  #line-at(56.88pt, 390.6pt, "Figs. 2 and 3 show temperature dependences for HKIL NbN ")
  #line-at(46.8pt, 402pt, "and other two Nb layers used to fabricate [23] our ERSFQ ")
  #line-at(46.8pt, 413.52pt, "circuits. Due to pad number limitation on the PCM chip, only ")
  #line-at(46.8pt, 425.04pt, "one SQUID inductance structure was designed for each the ")
  #line-at(46.8pt, 436.56pt, "M1 & M2 Nb layers [23] used for small circuit inductors, ")
  #line-at(46.8pt, 448.08pt, "while multiple structures were designed for HKIL NbN layer ")
  #line-at(46.8pt, 459.48pt, "MN1 used for large circuit and bias inductors. This allows us ")
  #line-at(46.8pt, 471pt, "to extract a sheet inductance (per square) for HKIL NbN layer ")
  #line-at(46.8pt, 482.52pt, "in Fig. 2 and only specific inductances (per length) for M1 and ")
  #line-at(46.8pt, 494.04pt, "M2 Nb layers in Fig. 3 [24]. These SQUIDs have an additional ")
  #line-at(46.8pt, 505.56pt, "inside lead to allow extraction of 3 inductances from the ")
  #line-at(46.8pt, 517.08pt, "measured ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
