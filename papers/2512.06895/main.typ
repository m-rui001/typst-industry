  #line-at(313.2pt, 348.72pt, "increase in the normalized center bias by ~15% as temperature ")
  #line-at(313.2pt, 360.24pt, "decreases from 4.2 K to 100 mK, very similar to that observed ")
  #line-at(313.2pt, 371.64pt, "in Fig. 1 for ")
