#original-page(612pt, 792pt, (image("graphics/page-01.png", width: 1pt), 48.5pt, 179pt))[
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(560.16pt, 30.96pt, "1 ")
  #set text(font: "Times New Roman", size: 23.955pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(103.68pt, 72.84pt, "Single Flux Quantum Circuit Operation at ")
  #line-at(184.08pt, 101.76pt, "Millikelvin Temperatures ")
  #set text(font: "Times New Roman", size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(48.96pt, 129.48pt, "Jason Walter, Adam C. Weis, Kan-Ting Tsai, Meng-Ju Yu, Naveen Katam, Alex F. Kirichenko, Oleg A. Mukhanov, ")
  #line-at(234.48pt, 142.08pt, "Shu-Jen Han and Igor V. Vernik ")
  #set text(font: "Times New Roman", size: 8.983pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(49.08pt, 179.88pt, "Abstract")
  #set text(font: "Times New Roman", size: 8.983pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(80.16pt, 179.88pt, "—As quantum computing processors increase in size, ")
  #line-at(46.8pt, 190.92pt, "there is growing interest in developing cryogenic electronics to ")
  #line-at(46.8pt, 201.84pt, "overcome significant challenges to system scaling. Single flux-")
  #line-at(46.8pt, 212.64pt, "quantum (SFQ) circuits offer a promising alternative to remote, ")
  #line-at(46.8pt, 223.56pt, "bulky, and power-hungry room temperature electronics. To meet ")
  #line-at(46.8pt, 234.48pt, "the need for digital qubit control, readout, and co-processing, ")
  #line-at(46.8pt, 245.28pt, "SFQ circuits must be adapted to operate at millikelvin ")
  #line-at(46.8pt, 256.2pt, "temperatures near quantum processors. SEEQC's SFQuClass ")
  #line-at(46.8pt, 267pt, "digital quantum management approach proximally places ")
  #line-at(46.8pt, 277.92pt, "energy-efficient SFQ (ERSFQ) circuits and qubits in a multi-chip ")
  #line-at(46.8pt, 288.72pt, "module. ")
  #line-at(87.114pt, 288.72pt, "This ")
  #line-at(113.478pt, 288.72pt, "enables ")
  #line-at(151.401pt, 288.72pt, "extremely ")
  #line-at(198.7pt, 288.72pt, "low ")
  #line-at(221.626pt, 288.72pt, "power ")
  #line-at(254.987pt, 288.72pt, "dissipation, ")
  #line-at(46.8pt, 299.64pt, "compatible with a typical dilution cryostat’s limited cooling ")
  #line-at(46.8pt, 310.44pt, "power, while maintaining high processing speed and low error ")
  #line-at(46.8pt, 321.36pt, "rates. We report on systematic testing from 4 K to 10 mK of a ")
  #line-at(46.8pt, 332.28pt, "comprehensive set of ERSFQ cells, as well as more complex ")
  #line-at(46.8pt, 343.08pt, "circuits such as programmable counters and demultiplexers used ")
  #line-at(46.8pt, 354pt, "in digital qubit control. We compare the operating margins and ")
  #line-at(46.8pt, 364.8pt, "error rates of these circuits and find that, at millikelvin, bias ")
  #line-at(46.8pt, 375.72pt, "margins decrease and the center of the margins (i.e., the optimal ")
  #line-at(46.8pt, 386.52pt, "bias current value) increases by ~15%, compared to 4.2 K. The ")
  #line-at(46.8pt, 397.44pt, "margins can be restored by thermal annealing by reducing ")
  #line-at(46.8pt, 408.24pt, "Josephson junction (JJ) critical current ")
  #set text(font: "Times New Roman", size: 8.983pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(205.92pt, 408.24pt, "I")
  #set text(font: "Times New Roman", size: 5.989pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(209.4pt, 408.72pt, "c")
  #set text(font: "Times New Roman", size: 8.983pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(212.04pt, 408.24pt, ". To provide guidance ")
  #line-at(46.8pt, 419.16pt, "for how circuit parameters vary from 4.2 K to millikelvin, ")
  #line-at(46.8pt, 430.08pt, "relevant analog process control monitors (PCMs) were tested in ")
  #line-at(46.8pt, 440.88pt, "the temperature range of interest. The measured JJ critical ")
  #line-at(46.8pt, 451.8pt, "current (of the PCM JJ arrays) increases by ~15% when ")
  #line-at(46.8pt, 462.6pt, "decreasing temperature from 4.2 K to millikelvin, in good ")
  #line-at(46.8pt, 473.52pt, "agreement with both theory and the empirically measured ")
  #line-at(46.8pt, 484.32pt, "change in the center of bias margins for the tested digital circuits.  ")
  #set text(font: "Times New Roman", size: 8.983pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(46.8pt, 506.64pt, "Index Terms")
  #set text(font: "Times New Roman", size: 8.983pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(94.08pt, 506.64pt, "—")
  #line-at(105.72pt, 506.64pt, "superconducting qubit, energy-efficient single flux ")
  #line-at(46.8pt, 516.96pt, "quantum, cryogenic qubit control, cryogenic qubit read-out. ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(146.28pt, 540.24pt, "I.")
  #line-at(154.2pt, 540.24pt, "I")
  #set text(font: "Times New Roman", size: 8.025pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(157.56pt, 540.24pt, "NTRODUCTION")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(62.64pt, 555.72pt, "N the quest to build fault-tolerant quantum computing ")
  #line-at(62.64pt, 567.24pt, "(FTQC) that executes useful quantum algorithms, millions ")
  #line-at(62.64pt, 578.76pt, "of physical qubits need to be integrated [1,2]. Since each ")
  #line-at(62.64pt, 590.28pt, "qubit requires multiple control lines, this leads to ")
  #line-at(46.8pt, 601.8pt, "fundamental scaling problems in both physical system ")
  #line-at(46.8pt, 613.2pt, "integration and data communication. First, connecting ")
  #line-at(46.8pt, 624.72pt, "cryogenic qubits to their room temperature control and readout ")
  #line-at(46.8pt, 636.24pt, "electronics ")
  #line-at(102.371pt, 636.24pt, "via ")
  #line-at(126.804pt, 636.24pt, "coaxial ")
  #line-at(167.696pt, 636.24pt, "cables ")
  #line-at(204.884pt, 636.24pt, "leads ")
  #line-at(237.582pt, 636.24pt, "to ")
  #line-at(257.641pt, 636.24pt, "unfeasible ")
  #line-at(46.8pt, 647.76pt, "cable/connector densities and heat loads [3]. The associated ")
  #line-at(46.8pt, 659.28pt, "signal distortions, noise, crosstalk, and long latencies need to ")
  #line-at(46.8pt, 670.68pt, "be mitigated. Second, the active quantum error correction ")
  #line-at(46.8pt, 682.2pt, "(QEC) protocols for non-Clifford gates would produce ")
  #line-at(46.8pt, 693.72pt, "syndrome data at rates of terabits/second, which would then ")
  #set text(font: "Times New Roman", size: 8.025pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 721.56pt, "All authors are with SEEQC, 150 Clearbrook Road, Elmsford, NY 10523 ")
  #line-at(46.8pt, 730.68pt, "USA (email: ivernik@seeqc.com) ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.2pt, 180.24pt, "need to be transmitted to a room-temperature processor to ")
  #line-at(313.2pt, 191.76pt, "perform recovery operations at time scales comparable to the ")
  #line-at(313.2pt, 203.16pt, "coherence time of the qubits. This would require an extremely ")
  #line-at(313.2pt, 214.68pt, "high-bandwidth, low latency cryo-to-room temperature data ")
  #line-at(313.2pt, 226.2pt, "link for fast digitization and digital processing [4,5].  ")
  #line-at(323.28pt, 237.72pt, "These problems can potentially be addressed if fast, low ")
  #line-at(313.2pt, 249.24pt, "power cryogenic classical control/readout and data processing ")
  #line-at(313.2pt, 260.76pt, "electronics can be situated in the same cryostat as the quantum ")
  #line-at(313.2pt, 272.16pt, "processors, obviating the need for coaxial cables, and ")
  #line-at(313.2pt, 283.68pt, "providing the capability of performing pre-processing to ")
  #line-at(313.2pt, 295.2pt, "reduce output data bandwidth.  The cryoCMOS circuits are ")
  #line-at(313.2pt, 306.72pt, "being developed to integrate control electronics at a 3 K stage ")
  #line-at(313.2pt, 318.24pt, "of a dilution refrigerator [6,7]. Still, these electronics are at ")
  #line-at(313.2pt, 329.64pt, "some nontrivial distance away from the qubit plane at the ")
  #line-at(313.2pt, 341.16pt, "~20 mK stage and can only partially address the problems ")
  #line-at(313.2pt, 352.68pt, "listed above.  In contrast, fast and low power superconducting ")
  #line-at(313.2pt, 364.2pt, "electronics can be integrated much closer to the qubits at the ")
  #line-at(313.2pt, 375.72pt, "millikelvin stage without overheating [8,9] and could ")
  #line-at(313.2pt, 387.24pt, "potentially resolve these scaling challenges. ")
  #line-at(323.28pt, 398.64pt, "Multiple versions of superconducting circuits are being ")
  #line-at(313.2pt, 410.16pt, "considered for the implementation of integrated qubit control ")
  #line-at(313.2pt, 421.68pt, "and readout [9-16]. All are based on superconducting circuit ")
  #line-at(313.2pt, 433.2pt, "approaches developed for 4.2 K and thus need to be ")
  #line-at(313.2pt, 444.72pt, "reoptimized for millikelvin operation to minimize power ")
  #line-at(313.2pt, 456.24pt, "dissipation, circuit size, and potential adverse effects on ")
  #line-at(313.2pt, 467.64pt, "qubits. The first successful experiments using integrated ")
  #line-at(313.2pt, 479.16pt, "superconducting circuits at a millikelvin stage demonstrated ")
  #line-at(313.2pt, 490.68pt, "the validity of this approach [17-20]. However, no systematic ")
  #line-at(313.2pt, 502.2pt, "study of classical superconducting circuits operating at mK ")
  #line-at(313.2pt, 513.72pt, "temperatures was performed, leaving many questions ")
  #line-at(313.2pt, 525.12pt, "unanswered. ")
  #line-at(323.28pt, 536.64pt, "This paper reports on the results of comprehensive testing, ")
  #line-at(313.2pt, 548.16pt, "in the temperature range from 4.2 K to 10 mK, of ERSFQ [21] ")
  #line-at(313.2pt, 559.68pt, "cells and more complex circuits, including pulse counters and ")
  #line-at(313.2pt, 571.2pt, "demultiplexers, typically used in digital qubit control circuits. ")
  #line-at(379.2pt, 594.72pt, "II.")
  #line-at(390.48pt, 594.72pt, "E")
  #set text(font: "Times New Roman", size: 8.025pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(396.6pt, 594.72pt, "XPERIMENTAL ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(455.04pt, 594.72pt, "A")
  #set text(font: "Times New Roman", size: 8.025pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(462.24pt, 594.72pt, "PPROACH ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.28pt, 610.2pt, "We use energy efficient SFQ (ERSFQ) circuits [21] at mK ")
  #line-at(313.2pt, 621.72pt, "temperatures which are proximally placed in multi-chip ")
  #line-at(313.2pt, 633.12pt, "modules (MCM) [22] to provide digital control and readout ")
  #line-at(313.2pt, 644.64pt, "for superconducting qubits. We consistently observe that the ")
  #line-at(313.2pt, 656.16pt, "performance of circuits designed with the library optimized ")
  #line-at(313.2pt, 667.68pt, "for a liquid helium (4.2 K) operation significantly changes ")
  #line-at(313.2pt, 679.2pt, "from 4.2 K to mK temperatures (e.g., optimal bias point and ")
  #line-at(313.2pt, 690.72pt, "bias margins).  To understand the reasons for this change, we ")
  #line-at(313.2pt, 702.12pt, "designed, fabricated, and tested chips comprised of analog and ")
  #line-at(313.2pt, 713.64pt, "digital process control monitors (PCMs) and digital ERSFQ ")
  #line-at(313.2pt, 725.16pt, "circuits of varying complexity across temperature range of ")
  #line-at(313.2pt, 736.68pt, "interest. Additionally, we studied the ERSFQ demultiplexers ")
  #set text(font: "Times New Roman", size: 48.388pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(46.44pt, 581.52pt, "I")
]

