  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.88pt, 574.56pt, ". Microwave spectroscopy of NbN ")
  #line-at(46.8pt, 586.08pt, "resonators performed in [35] in the temperature range of ")
  #line-at(46.8pt, 597.48pt, "interest revealed a resonance frequency change of less than ")
  #line-at(46.8pt, 609pt, "0.1% which is caused by the change in inductance. Indeed, the ")
  #line-at(46.8pt, 620.52pt, "results in Fig. 2 confirm a nearly constant sheet inductance of ")
  #line-at(46.8pt, 632.04pt, "HKIL NbN film.  ")
  #line-at(56.88pt, 643.56pt, "Similarly to HKIL layer, Fig. 3 did not show any ")
  #line-at(46.8pt, 654.96pt, "appreciable temperature variation in the specific inductance ")
  #line-at(46.8pt, 666.48pt, "for M1 and M2 layers, except for a few outliers. This can be ")
  #line-at(46.8pt, 678pt, "explained by the fact that both M1 and M2 layers are thicker ")
  #line-at(46.8pt, 689.52pt, "than the Nb London penetration depth [23], and their ")
  #line-at(46.8pt, 701.04pt, "inductances are mostly determined by geometric inductance.  ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "bold", style: "normal", fill: rgb("#000000"))
