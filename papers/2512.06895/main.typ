  #line-at(313.2pt, 256.68pt, "PCMs, with each having a shared bias line for its cell and the ")
  #line-at(313.2pt, 268.2pt, "input/output monitors. Additional 4.2 K data was also ")
  #line-at(313.2pt, 279.72pt, "measured in liquid helium and is labelled “He.” Fig. 4 displays ")
  #line-at(313.2pt, 291.24pt, "the normalized center of bias margins (i.e., the optimal bias ")
