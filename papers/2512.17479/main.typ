#original-page(612pt, 792pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(534.1pt, 779.52pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(82.104pt, 83.18pt, "Abstract ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(82.104pt, 122.78pt, "Perovskite indoor photovoltaics (PIPVs) are emerging as a transformative technology for low-")
  #line-at(72.024pt, 150.38pt, "light intensity energy harvesting, owing to their high-power conversion efficiencies (PCEs), low-")
  #line-at(72.024pt, 177.98pt, "cost fabrication, solution-processability, and compositionally tunable band gaps. In this work, ")
  #line-at(72.024pt, 205.58pt, "methylammonium-free Cs")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(207.89pt, 206.54pt, "x")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(211.49pt, 205.58pt, "FA")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(226.73pt, 206.54pt, "1-x")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(237.41pt, 205.58pt, "Pb(I")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(257.93pt, 206.54pt, "1−")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(266.57pt, 206.54pt, "y")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(270.17pt, 205.58pt, "Br")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(282.17pt, 206.54pt, "y")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(285.77pt, 205.58pt, ")")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(289.73pt, 206.54pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(293.69pt, 205.58pt, " perovskite absorbers were compositionally ")
  #line-at(72.024pt, 233.18pt, "engineered to achieve band gaps of 1.55, 1.72, and 1.88 eV, enabling matching the spectral ")
  #line-at(72.024pt, 260.81pt, "photoresponse with the indoor lighting. Devices based on a scalable mesoscopic n-i-p architecture ")
  #line-at(72.024pt, 288.41pt, "were systematically evaluated under white LED illumination across correlated color temperatures ")
  #line-at(72.024pt, 316.01pt, "(3000-5500 K) and light intensities from 250 to 1000 lux with active area of 1 cm")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(469.42pt, 311.45pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(473.5pt, 316.01pt, ". The 1.72 eV ")
  #line-at(72.024pt, 343.61pt, "composition exhibited the most promising performance across different light intensities and colors, ")
  #line-at(72.024pt, 371.21pt, "achieving PCEs of 35.04% at 1000 lux and 36.6% at 250 lux, with a stable device operation of ")
  #line-at(72.024pt, 398.81pt, "over 2000 hours. On the other hand, the 1.88 eV band-gap variant reached a peak PCE of 37.4% ")
  #line-at(72.024pt, 426.43pt, "under 250 lux (5500 K), however performance trade-offs were observed across the different color ")
  #line-at(72.024pt, 454.03pt, "lights LEDs. Our combined experimental and theoretical optical-electrical simulations suggest that ")
  #line-at(72.024pt, 481.63pt, "decreasing trap-assisted recombination in wide-bandgap compositions may further improve PIPV ")
  #line-at(72.024pt, 509.23pt, "performance across the different illumination conditions. In contrast, devices with 1.55 eV band ")
  #line-at(72.024pt, 536.83pt, "gap underperformed in such conditions due to suboptimal spectral overlap and utilization. These ")
  #line-at(72.024pt, 564.43pt, "findings establish bandgap optimization and device architecture as key design principles for high-")
  #line-at(72.024pt, 592.06pt, "efficiency, stable PIPVs, advancing their integration into self-powered electronic systems and ")
  #line-at(72.024pt, 619.66pt, "innovative indoor environments. ")
]

