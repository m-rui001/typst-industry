#original-page(612pt, 792pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(534.1pt, 779.52pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 83.18pt, "Introduction")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(82.104pt, 122.78pt, "Perovskite solar cells (PSCs) are emerging as a transformative technology within the field of ")
  #line-at(72.024pt, 150.38pt, "photovoltaics, attracting substantial interest due to their impressive advancement in power ")
  #line-at(72.024pt, 177.98pt, "conversion efficiency (PCE), which has reached 27% under standard outdoor solar illumination.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(532.06pt, 173.42pt, "1–")
  #line-at(72.024pt, 201.02pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(76.104pt, 205.58pt, " Beyond outdoor applications, PSCs are increasingly recognized as a viable candidate for indoor ")
  #line-at(72.024pt, 233.18pt, "photovoltaics (IPVs), owing to their tunable energy bandgap (")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(367.99pt, 233.18pt, "E")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(375.31pt, 234.14pt, "g")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(379.39pt, 233.18pt, "), high specific power output, and ")
  #line-at(72.024pt, 260.81pt, "exceptionally  high absorption coefficients.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(277.13pt, 256.25pt, "4,6")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(287.33pt, 260.81pt, " This adaptability enables effective energy harvesting ")
  #line-at(72.024pt, 288.41pt, "under various indoor lighting conditions, including light-emitting diode (LED) lamps  and compact ")
  #line-at(72.024pt, 316.01pt, "fluorescent lamps (CFLs).")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(198.29pt, 311.45pt, "3-6")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(209.09pt, 316.01pt, " Nevertheless, it is essential to note that the Shockley-Queisser (SQ) ")
  #line-at(72.024pt, 343.61pt, "limit applicable under indoor lighting conditions diverges from the outdoor limit of approximately ")
  #line-at(72.024pt, 371.21pt, "33% for a bandgap of 1.34 eV. For IPVs, the SQ limit exceeds 50%, requiring ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(455.02pt, 371.21pt, "E")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(462.34pt, 372.17pt, "g")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(466.42pt, 371.21pt, " in the range of ")
  #line-at(72.024pt, 398.81pt, "1.7-2.0 eV to align with the narrowband emission spectrum (400-700 nm),a characteristic of indoor ")
  #line-at(72.024pt, 426.43pt, "lighting.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(112.34pt, 421.87pt, "9-10,26 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(139.1pt, 426.43pt, "Perovskite indoor photovoltaics (PIPVs) due to their high PCE in such illumination ")
  #line-at(72.024pt, 454.03pt, "conditions offer opportunities for a wide range of applications, including powering internet of ")
