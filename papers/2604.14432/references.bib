@inproceedings{kunzler_design_2022,
	address = {Long Beach, United States},
	title = {Design, construction and simulation of a shape memory alloy based morphing airfoil demonstrator based on the agonist-antagonist principle},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/12043/2612916/Design-construction-and-simulation-of-a-shape-memory-alloy-based/10.1117/12.2612916.full},
	doi = {10.1117/12.2612916},
	abstract = {To reduce installation space as well as weight, the use of shape memory alloys (SMA) is advantageous in the field of actuator technology. A big challenge using SMAs in for actuation is their high energy consumption due to Joule heating. To overcome this, an actuator system based on the agonist-antagonist principle, using SMA wire actuators was developed. Main advantage is the possibility of an energy-free holding of the position without the use of special locking components. A prototype made of CFRP and SMA wires was developed and built. The structure consists of a CFRP laminate on which SMA wires are anchored on the upper and lower side. This work also contents a simulation approach of the actuating structure in ABAQUS® using a simplified phenomenological model.},
