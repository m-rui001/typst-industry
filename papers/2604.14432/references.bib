@inproceedings{wang_experimental_2023,
	address = {Patras, Greece},
	title = {{EXPERIMENTAL} {AND} {NUMERICAL} {INVESTIGATION} {OF} {3D} {PRINTED} {ELASTOMERIC} {COMPOSITE} {WITH} {INTEGRATED} {SMA} {ACTUATOR}},
