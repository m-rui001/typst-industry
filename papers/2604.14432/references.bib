}

@article{poulin_development_2017,
	title = {Development of a morphing wing extrados made of composite materials and actuated by shape memory alloys},
	volume = {28},
	issn = {1045-389X, 1530-8138},
	url = {https://journals.sagepub.com/doi/10.1177/1045389X16672565},
	doi = {10.1177/1045389X16672565},
	abstract = {This article focuses on the development of a shape morphing composite skin representing a wing extrados. The objective is to design and manufacture a skin capable of changing its geometry in order to improve its aerodynamic efficiency. One geometry is considered to be the nominal geometry and a deformed geometry is identified. It is obtained upon application of a displacement at the aftmost boundary of the active portion of the wing profile. The displacement is imposed on the skin by shape memory alloy wires. These actuators are combined with a self-locking transmission mechanism that maintains the deformed geometry without any further energy consumption. The lay-up of the composite skin is optimised such that the deformed profile approaches the desired geometry as closely as possible. This lay-up selection routine is done through an ANSYS Parametric Design Language sub-routine. The finite element model is validated experimentally by conducting mechanical testing on the composite skin.},
	language = {en},
	number = {11},
	urldate = {2025-09-26},
	journal = {Journal of Intelligent Material Systems and Structures},
	author = {Poulin, Jean-René and Terriault, Patrick and Dubé, Martine and Vachon, Pierre-Luc},
	month = jul,
	year = {2017},
	pages = {1437--1453},
	file = {Poulin et al. - 2017 - Development of a morphing wing extrados made of co.pdf:C\:\\Users\\kunzler\\Zotero\\storage\\963JRJMV\\Poulin et al. - 2017 - Development of a morphing wing extrados made of co.pdf:application/pdf},
}

@incollection{breuer_chapter_2026,
	edition = {Second Edition},
	series = {Plastics {Design} {Library}},
	title = {Chapter 23 - {Active} hybrid structures made of shape memory alloys and fiber-reinforced composites},
	isbn = {978-0-443-28872-2},
	url = {https://www.sciencedirect.com/science/article/pii/B9780443288722000267},
	abstract = {The combination of shape memory alloys (SMAs) and fiber-reinforced composites leads to so-called shape memory alloy hybrid composites (SMAHC). A new class of composites is able to change their material properties, such as shape, stiffness, and electric resistivity, due to an external stimulus. This chapter concentrates on important properties of the involved materials, their characterization for effective design of SMAHC tailored to specific applications and on aspects of their combination on material level. An overview of modeling and simulation of SMA and SMAHC is complemented by a detailed presentation of the latest approach—a fully coupled electrothermomechanical model for the prediction of the transient behavior of SMAHC under different mechanical and ambient loading scenarios. While its implementation is based on open-source software, it is an excellent tool for the development of new applications. Particular attention is paid to the achievable activation speeds under different loads and ambient temperatures and the resulting energy consumption. Three exemplary applications from aeronautics and automotive industry finally demonstrate the broad potential of SMAHC used for shape morphing structures.},
	booktitle = {Multifunctionality of {Polymer} {Composites} ({Second} {Edition})},
	publisher = {William Andrew Publishing},
	author = {Kaiser, Max and Gurka, Martin},
	editor = {Breuer, Ulf and Wetzel, Bernd and Gurka, Martin},
	year = {2026},
	doi = {https://doi.org/10.1016/B978-0-443-28872-2.00026-7},
	keywords = {Actuation, Smart composite, Shape memory alloy hybrid composite, Shape control, Mechanical engineering, Multiphysical modeling, Sensing, Thermomechanic coupling},
	pages = {851--878},
}
