	year = {2016},
	pages = {467--472},
	file = {Baytekin-Gerngross et al. - 2016 - Making metal surfaces strong, resistant, and multi.pdf:C\:\\Users\\kunzler\\Zotero\\storage\\3PX6T9IC\\Baytekin-Gerngross et al. - 2016 - Making metal surfaces strong, resistant, and multi.pdf:application/pdf},
}

@article{barbarino_wing_2009,
