@phdthesis{huber_control_2013,
	title = {Control of {Spin} {Waves} on the {Nanoscale} in {One}-{Dimensional} {Magnonic} {Crystals} and {Atomic} {Layer} {Deposition} of {Metallic} {Ferromagnets} for {Second} {Generation} of {Nanomaterials}},
	url = {https://mediatum.ub.tum.de/node?id=1174959},
	abstract = {Spin waves (SWs) in arrays of ferromagnetic nanowires, so called one-dimensional magnonic crystals have been studied. Propagating SWs in magnonic crystals were investigated by all electrical spectroscopy in the GHz regime. In artificial magnetic configurations SW excitation was controlled and SW propagation was reprogrammed. Atomic layer deposition of metallic ferromagnets has been investigated and improved regarding the magnetic parameters for the second generation of nanomaterials.},
	urldate = {2024-09-13},
	school = {Technische Universität München},
	author = {Huber, Rupert},
	year = {2013},
}

