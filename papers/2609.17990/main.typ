  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(223.72pt, 207.44pt, " Measurements of ultrathin Pt and Au structures have also reported unequal ")
  #line-at(182pt, 228.14pt, "reductions in thermal and electrical transport, as well as both enhanced and suppressed ")
  #line-at(182pt, 248.84pt, "Lorenz numbers.")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(263.68pt, 244.34pt, "26, 27")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.84pt, 248.84pt, " In addition, phonons can carry an appreciable fraction of heat in ")
  #line-at(182pt, 269.54pt, "some transition metals, such as Ru and W, further complicating the use of an electron-")
  #line-at(182pt, 290.24pt, "only WF estimate.")
