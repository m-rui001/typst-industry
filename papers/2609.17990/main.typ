  #line-at(480.24pt, 192.74pt, " However, the thermal ")
  #line-at(182pt, 213.44pt, "transport properties of metal films can differ substantially from those of their bulk ")
  #line-at(182pt, 234.14pt, "counterparts because of grain boundaries, surface scattering, deposition-induced ")
  #line-at(182pt, 254.84pt, "defects, and metastable phases.")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
