  #line-at(537.6pt, 140.82pt, "5, 23, 24")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(565.02pt, 145.32pt, " Direct ")
  #line-at(182pt, 166.02pt, "thermal and electrical measurements of suspended Pt nanofilms have revealed ")
  #line-at(182pt, 186.74pt, "substantial reductions in both conductivities and Lorenz numbers relative to bulk ")
