  #line-at(473.16pt, 314.36pt, " contains both electronic ")
  #line-at(182pt, 336.98pt, "and non-electronic contributions to heat transport, its deviation from ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(531.06pt, 336.98pt, "𝐿")
  #set text(font: "Cambria Math", size: 8.52pt, weight: "regular", style: "normal", fill: rgb("#000000"))
