  #line-at(543.36pt, 336.98pt, " should be ")
  #line-at(182pt, 357.86pt, "interpreted as an experimental measure of the overall heat–charge transport relationship ")
  #line-at(182pt, 378.56pt, "rather than as a direct measurement of the intrinsic electronic Lorenz number.  ")
  #line-at(206pt, 399.26pt, "These results provide practical guidance for the use of WF-based thermal-")
  #line-at(182pt, 419.96pt, "conductivity estimates in deposited metal films. For relatively low-resistivity, weakly ")
  #line-at(182pt, 440.66pt, "disordered films, the WF law can provide a useful first approximation when an ")
  #line-at(182pt, 461.36pt, "uncertainty on the order of 10–20% is acceptable. For highly resistive or strongly ")
  #line-at(182pt, 482.06pt, "disordered films, direct thermal characterization is preferable to avoid substantial ")
  #line-at(182pt, 503pt, "systematic errors. The directly measured ")
