#original-page(687.44pt, 841.68pt, (image("graphics/page-04.png", width: 552pt), 22pt, 35.5pt))[
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(387.46pt, 808.6pt, "4 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(182pt, 83.22pt, "thermal-conductivity estimates for deposited metal films and provides practical ")
  #line-at(182pt, 103.92pt, "transport data for microelectronic thermal modeling and thermoreflectance analysis. ")
  #set text(font: "Arial", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(182pt, 130.68pt, "II. METHODOLOGY ")
  #line-at(182pt, 151.38pt, "A. Square-pulsed source thermoreflectance ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(206pt, 178.02pt, "Thermal property measurements were performed using the square-pulsed source ")
  #line-at(182pt, 198.74pt, "(SPS) thermoreflectance technique, schematically illustrated in Fig. 1(a). In this pump-")
  #line-at(182pt, 219.44pt, "probe configuration, the pump laser is modulated with a square waveform to generate ")
  #line-at(182pt, 240.14pt, "periodic heating, while the probe laser monitors the resulting time-resolved surface ")
  #line-at(182pt, 260.84pt, "temperature through reflectance changes. Compared with phase-sensitive TDTR/FDTR ")
  #line-at(182pt, 281.54pt, "implementations, SPS relies on amplitude signals, enabling robust measurements with ")
  #line-at(182pt, 302.24pt, "high signal-to-noise ratios across a wide modulation frequency range extending down ")
  #line-at(182pt, 322.94pt, "to 1 Hz. The full periodic waveform is acquired at each modulation frequency and ")
  #line-at(182pt, 343.64pt, "normalized to yield a time-domain thermal response curve. The experimentally ")
  #line-at(182pt, 364.34pt, "measured SPS amplitude signal was normalized by its maximum amplitude prior to ")
  #line-at(182pt, 385.04pt, "fitting. This amplitude normalization does not affect the calculated sensitivity ")
  #line-at(182pt, 405.74pt, "coefficients.  ")
  #set text(font: "Arial", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(182pt, 739.36pt, "FIG. 1.")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(217.78pt, 739.36pt, " (a) Schematic of the SPS experimental setup. (b) Two-layered sample structure ")
  #line-at(182pt, 753.16pt, "with key parameters involved in thermal measurements. ")
  #set text(font: "Arial", size: 10pt, weight: "regular", style: "normal", fill: rgb("#bbbbbb"))
  #line-at(99pt, 666.9pt, "This is the author’s peer reviewed, accepted manuscript. However, the online version of record will be different from this version once it has been copyedited and typeset.", angle: -90deg)
  #set text(font: "Arial", size: 10pt, weight: "bold", style: "normal", fill: rgb("#bbbbbb"))
  #line-at(111pt, 504.27pt, "PLEASE CITE THIS ARTICLE AS DOI: 10.1063/5.0341686", angle: -90deg)
]

