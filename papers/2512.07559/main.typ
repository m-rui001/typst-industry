  #line-at(137.42pt, 281.69pt, "[23]")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.22pt, 285.65pt, ". The ST component is more clearly observed in the B")
