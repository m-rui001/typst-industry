  #line-at(57.36pt, 346.01pt, "enabling spin textures to persist alongside the conventional single magnetic domains (see more detailed ")
  #line-at(57.36pt, 366.17pt, "discussion on the difference between SD and ST components in Supplementary Note 2).")
  #line-at(57.36pt, 392.33pt, "Compared with FGT")
