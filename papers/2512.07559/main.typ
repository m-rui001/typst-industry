  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.31pt, 411.89pt, " or racetrack memory")
  #set text(font: "Calibri", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(495.34pt, 407.93pt, "[68]")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(506.14pt, 411.89pt, " techniques ")
  #line-at(57.36pt, 432.07pt, "developed for conventional magnetic layers, offering a simpler and fully 2D architecture with direct electrical ")
  #line-at(57.36pt, 452.23pt, "access to spin textures. Looking forward, this methodology can be extended to investigate dynamics of ")
  #line-at(57.36pt, 472.39pt, "nanoscale skyrmions, other topological textures and could form the basis of neuromorphic computing ")
  #line-at(57.36pt, 492.55pt, "architectures and unconventional memory elements that capitalize on the rich spin landscape of 2D ")
  #line-at(57.36pt, 512.71pt, "quantum materials. ")
