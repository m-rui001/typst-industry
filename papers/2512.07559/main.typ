  #line-at(408.07pt, 286.61pt, "y")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(410.95pt, 285.65pt, " spin valve and magnetization ")
