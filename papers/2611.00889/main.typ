// arXiv source page 44
#original-page(612pt, 792pt, (image("graphics/page-44.png", width: 67.5pt), 283pt, 629pt))[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.73pt, 753.72pt, "22 ")
  #set text(font: "Times New Roman", size: 12.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 74.52pt, "Quantification of Spurious-Mode Suppression Using Valley-to-Peak Residual Energy ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 108.62pt, "Main focus ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 133.94pt, "Spurious modes appear as narrow resistance fluctuations superimposed on the broad main valley-to-peak ")
  #line-at(70.824pt, 159.14pt, "response of a piezoelectric resonator. Direct visual comparison is useful but subjective, especially when ")
  #line-at(70.824pt, 184.46pt, "different devices operate at different frequencies. The analysis below converts each resistance spectrum to ")
  #line-at(70.824pt, 209.78pt, "log scale, extracts only the main valley-to-peak region, fits a smooth one-valley-to-one-peak main-mode ")
  #line-at(70.824pt, 235.1pt, "curve, and quantifies the residual fluctuations around that curve. ")
  #line-at(70.824pt, 260.45pt, "The method is intended to compare the smoothness of resistance spectra, not to refit the full ")
  #line-at(70.824pt, 285.65pt, "electromechanical equivalent circuit. Equivalent-network descriptions of piezoelectric resonators provide ")
  #line-at(70.824pt, 310.97pt, "the physical motivation that the principal resonant response should be smooth at the main-mode level")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(543.58pt, 307.01pt, "2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(547.06pt, 310.97pt, ", ")
  #line-at(70.824pt, 336.29pt, "while narrow residual features are treated as spurious-mode contributions. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 361.61pt, "Input data and preprocessing ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 386.93pt, "The resistance is analyzed on a logarithmic scale: ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.9pt, 412.49pt, "                                                                      𝑦")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.25pt, 414.79pt, "𝑖")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(289.97pt, 412.49pt, "= log")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(315.77pt, 414.79pt, "10")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.51pt, 412.49pt, " (𝑅")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(339.31pt, 414.79pt, "𝑖")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(342.79pt, 412.49pt, ")                                                                           (S4)")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 437.95pt, "The log transformation prevents high resistance regions from dominating the residual calculation solely ")
  #line-at(70.824pt, 463.27pt, "because the resistance spans several orders of magnitude. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 488.59pt, "Valley-to-peak analysis window ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 513.91pt, "For each device, the user specifies a frequency window around the main resistance valley and a second ")
  #line-at(70.824pt, 539.23pt, "window around the main resistance peak. The code identifies the lowest log-resistance point in the valley ")
  #line-at(70.824pt, 564.55pt, "window and the highest log-resistance point in the peak window. Only the interval between these two ")
  #line-at(70.824pt, 589.78pt, "detected frequencies is analyzed: ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.264pt, 632.74pt, "                                                                      𝑥")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(265.61pt, 635.02pt, "𝑖")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(272.09pt, 632.74pt, "=")
  #line-at(291.65pt, 623.98pt, "𝑓")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(296.09pt, 626.26pt, "𝑖")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(301.97pt, 623.98pt, "−𝑓")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(316.97pt, 626.26pt, "𝑣𝑎𝑙𝑙𝑒𝑦")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.37pt, 640.18pt, "𝑓")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(287.81pt, 642.46pt, "𝑝𝑒𝑎𝑘")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(310.13pt, 640.18pt, "−𝑓")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.27pt, 642.46pt, "𝑣𝑎𝑙𝑙𝑒𝑦")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(351.19pt, 632.74pt, "                                                                         (S5)")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 677.14pt, "This normalization maps the valley to 0 and the peak to 1, allowing residual curves from devices with ")
  #line-at(70.824pt, 702.456pt, "different operating frequencies to be compared on the same horizontal scale. ")
]

