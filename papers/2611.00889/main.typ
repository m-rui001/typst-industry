  #line-at(70.824pt, 72.6pt, "Table S2.")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(115.34pt, 72.6pt, " Boundary coordinates and segment-level dimensions extracted from the supplied CAD files. A ")
