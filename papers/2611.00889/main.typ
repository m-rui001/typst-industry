  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(421.27pt, 558.31pt, "R")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(427.87pt, 558.31pt, ") as the control value. The ")
  #line-at(70.824pt, 583.66pt, "median reduces the influence of narrow upward or downward spurious features. ")
  #line-at(70.824pt, 611.86pt, "4. Apply light median smoothing to the interior control values while preserving the valley and peak ")
  #line-at(70.824pt, 637.18pt, "endpoints. ")
  #line-at(70.824pt, 665.5pt, "5. Enforce a monotonic rise from valley to peak so that the fitted main-mode curve contains only one valley ")
  #line-at(70.824pt, 690.82pt, "and one peak. ")
]

