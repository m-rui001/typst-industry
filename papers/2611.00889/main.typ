  #line-at(356.35pt, 498.79pt, "19,20")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(372.07pt, 502.75pt, ". These advances show rapid progress in ")
  #line-at(70.824pt, 528.07pt, "acoustic resonator design for power conversion, but they mainly rely on electrode patterning, crystal-")
  #line-at(70.824pt, 553.39pt, "orientation selection, or multilayer polarization engineering")
