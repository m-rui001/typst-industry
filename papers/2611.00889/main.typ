  #line-at(70.824pt, 415.75pt, "Smooth main-mode fitting curve ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 441.07pt, "The smooth fitting curve is designed to retain only the broad main-mode evolution from the valley to the ")
  #line-at(70.824pt, 466.39pt, "peak. It should not follow the narrow spurious ripples. The implemented procedure is: ")
  #line-at(70.824pt, 501.67pt, "1. Generate evenly spaced control frequencies between the detected valley and the detected peak. ")
  #line-at(70.824pt, 529.99pt, "2. Fix the first control point at the detected valley and the last control point at the detected peak. ")
  #line-at(70.824pt, 558.31pt, "3. For each interior control-frequency bin, assign the local median of log")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.39pt, 559.27pt, "10")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
