  #line-at(333.07pt, 549.43pt, "21,22")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.79pt, 553.39pt, ". ")
  #line-at(85.224pt, 578.71pt, "TS modes in LiNbO₃ remain especially compelling because they can provide very large coupling at ")
  #line-at(70.824pt, 604.06pt, "megahertz frequencies while retaining a mechanically robust bulk-plate geometry. Nevertheless, plate-shaped ")
  #line-at(70.824pt, 629.38pt, "TS resonators are vulnerable to lateral standing waves and Lamb-wave-like parasitic modes generated by ")
  #line-at(70.824pt, 654.58pt, "finite lateral dimensions and discontinuous electrical or mechanical boundary conditions. The present work ")
  #line-at(70.824pt, 679.9pt, "applies the established principle of apodization to the lateral plate boundary of the resonator. We demonstrate ")
  #line-at(70.824pt, 705.216pt, "a lithography-free, apodized TS-mode LiNbO₃ resonator in which the resonator outline is defined by laser ")
]

