  #line-at(231.05pt, 182.06pt, "𝑦̂(𝑓) = PCHIP({(𝑓ₖ, ỹₖ)}")
  #set text(font: "Cambria Math", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(343.63pt, 185.42pt, "𝑘=1")
  #line-at(343.63pt, 176.3pt, "𝑁")
  #set text(font: "Cambria Math", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
