  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 116.66pt, "Electrode, attachment, and interconnection information ")
  #line-at(70.824pt, 141.98pt, "Electrode coverage: ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(175.82pt, 141.98pt, "The devices are fabricated from 0.5-mm-thick LiNbO₃ with nominal 1.0-µm ")
