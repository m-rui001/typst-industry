  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 194.8pt, "Abstract: ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 223.58pt, "We demonstrate in this work, that expanded graphite (EG) can lead to a very large enhancement ")
  #line-at(72.025pt, 244.33pt, "in thermal conductivity of polyetherimide-graphene and epoxy-graphene nanocomposites ")
  #line-at(72.025pt, 264.82pt, "prepared via solvent casting technique. A ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(278.13pt, 264.82pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.38pt, 264.82pt, " value of 6.56 Wm")
  #set text(font: "Times New Roman", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(376.15pt, 260.83pt, "-1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(382.9pt, 264.82pt, "K")
  #set text(font: "Times New Roman", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(391.67pt, 260.83pt, "-1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(398.42pt, 264.82pt, " is achieved for 10 weight % ")
  #line-at(72.025pt, 285.6pt, "composition sample, representing an enhancement of ~2770% over pristine polyetherimide (")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(524.22pt, 285.6pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(529.72pt, 285.6pt, " ~ ")
  #line-at(72.025pt, 306.35pt, "0.23 Wm")
  #set text(font: "Times New Roman", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.05pt, 302.35pt, "-1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(123.8pt, 306.35pt, "K")
  #set text(font: "Times New Roman", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(132.55pt, 302.35pt, "-1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(139.3pt, 306.35pt, "). This extraordinary enhancement in thermal conductivity is shown to be due to a ")
  #line-at(72.025pt, 327.1pt, "network of continuous graphene sheets over long length scales, resulting in low thermal contact ")
  #line-at(72.025pt, 347.85pt, "resistance at bends/turns due to the graphene sheets being covalently bonded at such junctions. ")
  #line-at(72.025pt, 368.37pt, "Solvent casting offers the advantage of preserving the porous structure of expanded graphite in the ")
  #line-at(72.025pt, 389.12pt, "composite, resulting in the above highly thermally conductive interpenetrating network of ")
  #line-at(72.025pt, 409.87pt, "graphene and polymer. Solvent casting also does not break down the expanded graphite particles, ")
  #line-at(72.025pt, 430.62pt, "due to minimal forces involved, allowing for efficient heat transfer over long length scales, further ")
  #line-at(72.025pt, 451.15pt, "enhancing overall composite thermal conductivity. Comparisons with a recently introduced ")
  #line-at(72.025pt, 471.9pt, "effective medium model shows a very high value of predicted particle-particle interfacial ")
  #line-at(72.025pt, 492.65pt, "conductance, providing evidence for efficient interfacial thermal transport in expanded graphite ")
  #line-at(72.025pt, 513.42pt, "composites.  Field Emission Environmental Scanning Electron Microscopy (FE-ESEM) is used to ")
  #line-at(72.025pt, 534.17pt, "provide detailed understanding of interpenetrating graphene-polymer structure in the expanded ")
  #line-at(72.025pt, 554.67pt, "graphite composite. These results open up novel avenues for achieving high thermal conductivity ")
  #line-at(72.025pt, 575.42pt, "polymer composites.  ")
  #line-at(72.025pt, 624.95pt, "Keywords: Thermal conductivity, expanded graphite, porous, effective medium model ")
]

