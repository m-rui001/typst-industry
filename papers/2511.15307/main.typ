  #line-at(72pt, 364.8pt, "perfectly with the conclusions drawn from previous MOKE measurements of orbital current ")
  #line-at(72pt, 385.68pt, "accumulation. The significant spin-mixing conductance indicates that the orbital current is less ")
  #line-at(72pt, 406.32pt, "affected by the interface, making it more easily transmissible across the interface. This not only ")
  #line-at(72pt, 426.96pt, "provides insights for optimizing and improving orbital torque devices in the future but also serves ")
  #line-at(72pt, 447.6pt, "as a reference for enhancing spin-orbit torque efficiency in the future. ")
]

