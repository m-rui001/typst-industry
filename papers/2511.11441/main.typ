  #line-at(72.024pt, 565.27pt, "In order to estimate SUEX transparency to 8 KeV X-rays, we therefore determined the attenuation ")
  #line-at(72.024pt, 578.71pt, "length of these two components.  ")
  #line-at(72.024pt, 592.15pt, "X-ray wavelength, chemical formula and density were inserted in the calculation sheet prepared by ")
  #line-at(72.024pt, 605.47pt, "the Center for X-ray Optics (CXRO) of Lawrence Berkeley National Laboratory's (LBNL): ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
