  #set text(font: "Calibri", size: 10.302pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 81.6pt, "with dots line) with corresponding fit (continuous black line) in the microchannel. The scattering curves ")
