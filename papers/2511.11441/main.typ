  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 632.35pt, "The resulting attenuation lengths are 1.642 mm for BPA, and 1.587 for DGEBA. The attenuation length ")
  #line-at(72.024pt, 645.79pt, "of the mixture is expected to be an intermediate between these two values. ")
  #line-at(72.024pt, 659.26pt, "Transmission can also be calculated in the same website, considering the thickness of the material. ")
  #line-at(72.024pt, 672.7pt, "For SUEX of 0.5 mm the value of transmission is similar for the two epoxy resins and approximately ")
