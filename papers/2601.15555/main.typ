  #line-at(57pt, 152.54pt, "Abstract")
  #set text(font: "Arial", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(93.624pt, 152.54pt, "— Photoconductive devices, based on ultra-")
  #line-at(46.8pt, 162.86pt, "wide-bandgap (UWBG) materials, offer a promising ")
  #line-at(46.8pt, 173.3pt, "pathway toward compact, high-voltage (HV) optoelectronic ")
  #line-at(46.8pt, 183.62pt, "and optical sensing in harsh environments. In this Letter, ")
  #line-at(46.8pt, 193.94pt, "we report field-tunable nonlinear photoconductive gain in ")
  #line-at(46.8pt, 204.38pt, "vertical β-Ga")
  #set text(font: "Cambria Math", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.1pt, 204.38pt, "₂")
