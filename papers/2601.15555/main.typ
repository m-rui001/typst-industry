  #line-at(374.47pt, 233.18pt, "m continuous-wave (CW) laser, revealing a ")
  #line-at(313.25pt, 244.58pt, "distinct transition from linear photoconductive regime to a ")
  #line-at(313.25pt, 256.13pt, "nonlinear high-field transport regime involving trap-assisted ")
  #line-at(313.25pt, 267.65pt, "carrier release and impact-ionization effects at a threshold ")
  #line-at(313.25pt, 279.17pt, "electric field of approximately 0.67 MV/cm. By leveraging ")
  #line-at(313.25pt, 290.69pt, "deep-level trap states activated under sub-bandgap illumination, ")
  #line-at(313.25pt, 302.09pt, "a current multiplication factor of ~20 and peak photocurrents of ")
