  #line-at(335.95pt, 94.22pt, "A at 445 V in device 2. Using 325 V as the linear-regime ")
  #line-at(313.25pt, 105.74pt, "reference, the total photocurrent increases from approximately ")
  #line-at(313.25pt, 117.26pt, "20 ")
