  #line-at(46.8pt, 726.576pt, "linear high-gain transport regime at 0.67 MV/cm ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.25pt, 59.76pt, " Above approximately 325–350 V, a pronounced nonlinear ")
  #line-at(313.25pt, 71.28pt, "increase in photocurrent is observed, reaching peak values of ")
  #line-at(313.25pt, 82.7pt, "approximately 475 ")
