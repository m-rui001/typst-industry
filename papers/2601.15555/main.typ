  #set text(font: "Arial", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.49pt, 356.33pt, "ISCUSSION")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 371.81pt, "Fig. 3 shows the dark current and photocurrent characteristics ")
  #line-at(46.8pt, 383.33pt, "of two vertical β-Ga₂O₃ devices. In Fig. 3(a), both devices ")
  #line-at(46.8pt, 394.85pt, "exhibit a low dark current in the sub-µA range up to ~300 V, ")
  #line-at(46.8pt, 406.25pt, "followed by a gradual increase at higher bias voltages. Under ")
  #line-at(46.8pt, 417.79pt, "optical excitation, the photocurrent initially scales linearly with ")
  #line-at(46.8pt, 429.31pt, "bias, corresponding to the linear photoconductive regime. ")
