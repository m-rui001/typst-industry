  #set text(font: "Arial", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(120.5pt, 204.38pt, " photoconductive devices under sub-")
  #line-at(46.8pt, 214.82pt, "bandgap visible-light excitation. Devices fabricated on a ")
  #line-at(46.8pt, 225.26pt, "5.6-µm-thick ")
  #line-at(110.394pt, 225.26pt, "nitrogen-doped ")
  #line-at(187.193pt, 225.26pt, "semi-insulating ")
  #line-at(264.134pt, 225.26pt, "β-Ga")
