  #line-at(46.8pt, 235.7pt, "epilayer grown on a conductive Sn-doped substrate were ")
  #line-at(46.8pt, 246.17pt, "characterized under 445-nm continuous-wave illumination.  ")
  #line-at(46.8pt, 256.49pt, "A distinct transition from linear to nonlinear gain ")
  #line-at(46.8pt, 266.81pt, "photoconductive behavior is observed at a threshold ")
  #line-at(46.8pt, 277.13pt, "electric field of approximately 0.67 MV/cm, resulting in ")
  #line-at(46.8pt, 287.57pt, "approximately 20 times enhancement in photocurrent. ")
  #line-at(46.8pt, 297.89pt, "Complementary TCAD simulations indicate strong electric-")
  #line-at(46.8pt, 308.21pt, "field localization and a rapid increase in impact-ionization ")
  #line-at(46.8pt, 318.53pt, "generation at high bias, suggesting that impact-ionization–")
  #line-at(46.8pt, 328.97pt, "assisted carrier multiplication contributes to the observed ")
  #line-at(46.8pt, 339.29pt, "gain. These results demonstrate a high-field visible-light ")
  #line-at(46.8pt, 349.73pt, "photoconductive detection mode in β-Ga")
