  #line-at(216.306pt, 328.13pt, "without ")
  #line-at(266.549pt, 328.13pt, "the ")
  #line-at(72.024pt, 341.69pt, "formation of grain-boundaries. In this scenario, ")
  #line-at(72.024pt, 355.37pt, "the non-radiative edges of the islands could ")
  #line-at(72.024pt, 369.05pt, "correspond to regions where the misorientation ")
  #line-at(72.024pt, 382.73pt, "between coalescing pyramids is sufficiently ")
  #line-at(72.024pt, 396.29pt, "large to induce defect nucleation at the ")
  #line-at(72.024pt, 409.97pt, "boundaries, thereby creating efficient non-")
  #line-at(72.024pt, 423.65pt, "radiative recombination centers.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(213.53pt, 419.69pt, "40")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(80.544pt, 445.27pt, "An alternative hypothesis for the dark regions ")
  #line-at(72.024pt, 458.95pt, "involves the incorporation of impurities, such ")
  #line-at(72.024pt, 472.63pt, "as Ca, stemming from the deionized water used ")
  #line-at(72.024pt, 486.31pt, "during substrate cleaning.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(188.81pt, 482.35pt, "36,37")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(204.53pt, 486.31pt, " Such impurities ")
  #line-at(72.024pt, 499.87pt, "can act as deep-level acceptors and show a ")
  #line-at(72.024pt, 513.55pt, "strong affinity for In atoms, in particular at the ")
  #line-at(72.024pt, 527.23pt, "low substrate temperatures employed here. ")
  #line-at(72.024pt, 540.91pt, "Nevertheless, they are sufficiently mobile to ")
  #line-at(72.024pt, 554.47pt, "migrate along the growth direction and ")
  #line-at(72.024pt, 568.15pt, "segregate to the surface.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.86pt, 564.19pt, "41")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(184.82pt, 568.15pt, " Ultimately, they may ")
  #line-at(72.024pt, 581.83pt, "accumulate at the coalescence boundaries ")
  #line-at(72.024pt, 595.51pt, "where adjacent nano-pyramids merge and ")
  #line-at(72.024pt, 609.07pt, "defects form. This process would be analogous ")
  #line-at(72.024pt, 622.78pt, "to grain-boundary segregation observed in ")
  #line-at(72.024pt, 636.46pt, "other material systems")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(179.18pt, 632.5pt, "42")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(186.14pt, 636.46pt, " and would further ")
  #line-at(72.024pt, 650.14pt, "enhance non-radiative recombination at these ")
  #line-at(72.024pt, 663.7pt, "boundaries. Similar processes would also be ")
  #line-at(72.024pt, 677.38pt, "relevant for sample #R grown at the same low ")
  #line-at(72.024pt, 691.06pt, "substrate temperature. At the same time, in ")
  #line-at(72.024pt, 704.74pt, "sample #B segregation to the sidewall surfaces ")
  #line-at(72.024pt, 718.3pt, "of the intermediate (In,Ga)N nanowalls may ")
  #line-at(72.024pt, 731.98pt, "play an additional role. ")
  #line-at(80.544pt, 753.576pt, "In order to investigate more deeply the ")
  #line-at(72.024pt, 767.256pt, "phenomena ")
  #line-at(139.567pt, 767.256pt, "relevant ")
  #line-at(191.731pt, 767.256pt, "for ")
  #line-at(221.461pt, 767.256pt, "non-radiative ")
  #line-at(315.43pt, 82.32pt, "recombination and further improve the crystal ")
  #line-at(315.43pt, 96.02pt, "quality of our pseudo-substrates, we will pursue ")
  #line-at(315.43pt, 109.7pt, "two different approaches in the follow-up ")
  #line-at(315.43pt, 123.26pt, "studies: (i) Variation ")
  #line-at(427.006pt, 123.26pt, "of ")
  #line-at(456.395pt, 123.26pt, "the ")
  #line-at(490.42pt, 123.26pt, "starting ")
  #line-at(315.43pt, 136.94pt, "configuration for coalescence by changing the ")
  #line-at(315.43pt, 150.62pt, "growth conditions for steps 1 and 2 to influence ")
  #line-at(315.43pt, 164.3pt, "the intermediate surface morphology of both ")
  #line-at(315.43pt, 177.86pt, "the rough GaN layer and the (In,Ga)N ")
  #line-at(315.43pt, 191.54pt, "nanowalls. (ii) Introduction of an (In,Ga)N ")
  #line-at(315.43pt, 205.22pt, "underlayer to block impurity segregation from ")
  #line-at(315.43pt, 218.9pt, "the GaN template surface.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(443.98pt, 214.94pt, "41")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(450.94pt, 218.9pt, " We note that ")
  #line-at(315.43pt, 232.46pt, "impurity segregation is likely less problematic ")
  #line-at(315.43pt, 246.14pt, "for the eventual growth of an LED structure on ")
  #line-at(315.43pt, 259.82pt, "top of the pseudo-substrate. In particular, such ")
  #line-at(315.43pt, 273.53pt, "devices are typically grown by metal-organic ")
  #line-at(315.43pt, 287.09pt, "vapor phase epitaxy (MOVPE) at a higher ")
  #line-at(315.43pt, 301.13pt, "substrate temperature (700-850 ")
  #set text(font: "DengXian", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(458.02pt, 301.13pt, "°")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(462.22pt, 301.13pt, "C), compared ")
  #line-at(315.43pt, 316.85pt, "to that used for pseudo-substrate growth in ")
  #line-at(315.43pt, 330.89pt, "PAMBE (500-600 ")
  #set text(font: "DengXian", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.15pt, 330.89pt, "°")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(410.356pt, 330.89pt, " C). Thus, the impurity ")
  #line-at(315.43pt, 346.61pt, "incorporation rate is much lower.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.94pt, 342.65pt, "36")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(475.9pt, 346.61pt, " However, ")
  #line-at(315.43pt, 360.29pt, "threading dislocations from the underlying ")
  #line-at(315.43pt, 373.85pt, "layers are likely to propagate into the active ")
  #line-at(315.43pt, 387.53pt, "region, ")
  #line-at(366.28pt, 387.53pt, "ultimately ")
  #line-at(430.677pt, 387.53pt, "degrading ")
  #line-at(494.598pt, 387.53pt, "device ")
  #line-at(315.43pt, 401.21pt, "performance. ")
  #line-at(386.71pt, 401.21pt, "Therefore, ")
  #line-at(445.719pt, 401.21pt, "quantifying—and ")
  #line-at(315.43pt, 414.89pt, "reducing, if needed—the dislocation density ")
  #line-at(315.43pt, 428.45pt, "will be a primary focus of future work.        ")
  #line-at(323.95pt, 450.19pt, "In comparison to other approaches for the ")
  #line-at(315.43pt, 463.75pt, "fabrication of (In,Ga)N pseudosubstrates, the ")
  #line-at(315.43pt, 477.43pt, "RMS surface roughness of ≈2 nm is similar or ")
  #line-at(315.43pt, 491.11pt, "better than published data for InGaNOS (2.7-")
  #line-at(315.43pt, 504.79pt, "3.7 nm),")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(358.39pt, 500.83pt, "43")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(365.35pt, 504.79pt, " porous nitride underlayers (2-")
  #line-at(315.43pt, 518.35pt, "5 nm),")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(344.11pt, 514.39pt, "16")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(351.07pt, 518.35pt, " and (In,Ga)N layers grown on an ")
  #line-at(315.43pt, 532.03pt, "(Al,Sc)N ")
  #line-at(369.736pt, 532.03pt, "buffer ")
  #line-at(410.738pt, 532.03pt, "(1.6 nm)")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(448.66pt, 528.07pt, "44")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(455.62pt, 532.03pt, ". ")
  #line-at(472.66pt, 532.03pt, "Dislocation ")
  #line-at(315.43pt, 545.71pt, "densities or CL maps are barely available for ")
  #line-at(315.43pt, 559.39pt, "other ")
  #line-at(351.763pt, 559.39pt, "types ")
  #line-at(388.691pt, 559.39pt, "of ")
  #line-at(411.588pt, 559.39pt, "pseudo-substrates. ")
  #line-at(506.207pt, 559.39pt, "The ")
  #line-at(315.43pt, 573.07pt, "combination of an In content of ≈30%  with a ")
  #line-at(315.43pt, 586.63pt, "strain relaxation degree of ≈80% achieved here ")
  #line-at(315.43pt, 600.31pt, "exceeds the values reported for porous nitride ")
  #line-at(315.43pt, 613.99pt, "underlayers (In≈0.18, R≈82%),")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(464.26pt, 610.03pt, "16")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(471.22pt, 613.99pt, " InGaNOS ")
  #line-at(315.43pt, 627.7pt, "(In≈0.09, R≈55%),")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(403.75pt, 623.74pt, "17")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(410.71pt, 627.7pt, " and (In,Ga)N pseudo-")
  #line-at(315.43pt, 641.26pt, "substrates grown on (Al,Sc)N buffer layers ")
  #line-at(315.43pt, 654.94pt, "(In≈0.28, R≈20%).")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(400.39pt, 650.98pt, "44")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407.35pt, 654.94pt, " Therefore, our three-step ")
  #line-at(315.43pt, 668.62pt, "(In,Ga)N growth protocol is currently the most ")
  #line-at(315.43pt, 682.3pt, "promising option to provide the in-plane lattice ")
  #line-at(315.43pt, 695.86pt, "constant desired for overgrowth of a red ")
  #line-at(315.43pt, 709.54pt, "(In,Ga)N LED. ")
  #line-at(323.95pt, 731.14pt, "In conclusion, we have demonstrated the in-")
  #line-at(315.43pt, 744.816pt, "situ fabrication of (In,Ga)N pseudo-substrates ")
  #line-at(315.43pt, 758.496pt, "exhibiting the target in-plane lattice constant of ")
]

