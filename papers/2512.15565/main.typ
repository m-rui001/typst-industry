#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.89pt, 791.496pt, "1 ")
  #set text(font: "Times New Roman", size: 14.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 85.1pt, "Fabrication of (In,Ga)N pseudo-substrates by a three-step growth protocol ")
  #line-at(72.024pt, 102.5pt, "without ex-situ processing")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 125.06pt, "Huaide Zhang, Aidan F. Campbell, Jingxuan Kang, Jonas Lähnemann, Oliver Brandt, Lutz Geelhaar ")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(517.9pt, 121.1pt, "a)")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(72.024pt, 146.78pt, "Paul-Drude-Institut für Festkörperelektronik, Leibniz-Institut im Forschungsverbund Berlin e.V., ")
  #line-at(72.024pt, 160.34pt, "Hausvogteiplatz 5-7, 10117 Berlin, Germany ")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 178.1pt, "a)")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(77.424pt, 182.06pt, " Corresponding author: geelhaar@pdi-berlin.de ")
  #line-at(80.544pt, 203.66pt, " We fabricate (In,Ga)N pseudo-substrates with a total thickness of ≈1 µm grown on GaN templates ")
  #line-at(72.024pt, 217.34pt, "using plasma-assisted molecular beam epitaxy. In a three-step process, we change growth conditions ")
  #line-at(72.024pt, 231.02pt, "from N-rich to metal-rich in order to sequentially form a roughened GaN layer, relaxed (In,Ga)N ")
  #line-at(72.024pt, 244.58pt, "nanostructures, and a coalesced, smooth (In,Ga)N layer. Samples are analyzed by scanning electron and ")
  #line-at(72.024pt, 258.26pt, "atomic force microscopy, X-ray diffraction, as well as photo- and cathodoluminescence spectroscopy.  ")
  #line-at(72.024pt, 271.97pt, "Compared to a reference layer grown directly on GaN, the pseudo-substrate exhibits a higher In content ")
  #line-at(72.024pt, 285.65pt, "(≈0.3), strain relaxation degree (≈80%), narrower photoluminescence linewidth, and larger area fraction ")
  #line-at(72.024pt, 299.33pt, "of bright regions in cathodoluminescence maps, showing the benefits of the three-step growth protocol. ")
  #line-at(72.024pt, 312.89pt, "This straightforward approach does not necessitate any ex-situ processing and could enable the scalable ")
  #line-at(72.024pt, 326.57pt, "fabrication of (In,Ga)N pseudo-substrates for high-efficiency red-emitting (In,Ga)N devices. ")
  #line-at(80.544pt, 348.17pt, "The development of micro light-emitting ")
  #line-at(72.024pt, 361.85pt, "diode (µLED) displays requires integrated red, ")
  #line-at(72.024pt, 375.53pt, "green, ")
  #line-at(118.694pt, 375.53pt, "and ")
  #line-at(154.1pt, 375.53pt, "blue ")
  #line-at(192.365pt, 375.53pt, "(RGB) ")
  #line-at(241.769pt, 375.53pt, "emitters. ")
  #line-at(72.024pt, 389.21pt, "Conventionally sized blue and green LEDs are ")
  #line-at(72.024pt, 402.77pt, "based on (In,Ga)N and their red counterparts on ")
  #line-at(72.024pt, 416.45pt, "(Al,Ga,In)P. All of them are very efficient, but ")
  #line-at(72.024pt, 430.13pt, "device miniaturization typically degrades ")
  #line-at(72.024pt, 443.83pt, "performance. Blue and green (In,Ga)N µLEDs ")
  #line-at(72.024pt, 457.39pt, "retain an external quantum efficiency of 20-")
  #line-at(72.024pt, 471.07pt, "35%,")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(95.064pt, 467.11pt, "1,2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(103.82pt, 471.07pt, " whereas the one of red (Al,Ga,In)P ")
  #line-at(72.024pt, 484.75pt, "µLEDs drops to ≈10%.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(180.86pt, 480.79pt, "3,4")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(189.65pt, 484.75pt, " The latter value is ")
  #line-at(72.024pt, 498.43pt, "comparable to what can be achieved for red ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(72.024pt, 511.99pt, "(In,Ga)N")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(111.98pt, 511.99pt, " µLEDs.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.94pt, 508.03pt, "5")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(152.42pt, 511.99pt, " Since the efficiency of LEDs ")
  #line-at(72.024pt, 525.67pt, "based on this material is less sensitive to size ")
  #line-at(72.024pt, 539.35pt, "reduction, research aimed at improving red ")
  #line-at(72.024pt, 553.03pt, "(In,Ga)N LEDs recently intensified.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(230.69pt, 549.07pt, "6")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(80.544pt, 574.63pt, "Efficient ")
  #line-at(134.154pt, 574.63pt, "red ")
  #line-at(163.289pt, 574.63pt, "(In,Ga)N ")
  #line-at(218.334pt, 574.63pt, "emission ")
  #line-at(272.69pt, 574.63pt, "is ")
  #line-at(72.024pt, 588.31pt, "challenging due to the large lattice mismatch ")
  #line-at(72.024pt, 601.99pt, "between the quantum wells (QWs) and the GaN ")
  #line-at(72.024pt, 615.55pt, "typically used as substrate. On the one hand, the ")
  #line-at(72.024pt, 629.26pt, "high ")
  #line-at(108.489pt, 629.26pt, "compressive ")
  #line-at(180.326pt, 629.26pt, "strain ")
  #line-at(221.572pt, 629.26pt, "hinders ")
  #line-at(270.876pt, 629.26pt, "In ")
  #line-at(72.024pt, 642.94pt, "incorporation, thus, achieving 30-40% In ")
  #line-at(72.024pt, 656.62pt, "content necessary for red emission is difficult.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(276.65pt, 652.66pt, "7")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 670.18pt, "On the other hand, the strain gives rise to strong ")
  #line-at(72.024pt, 683.86pt, "polarization fields. The resulting quantum-")
  #line-at(72.024pt, 697.54pt, "confined Stark effect spatially separates carriers, ")
  #line-at(72.024pt, 711.22pt, "thus reducing radiative recombination and ")
  #line-at(72.024pt, 724.78pt, "internal quantum efficiency.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(205.49pt, 720.82pt, "8,9")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(214.25pt, 724.78pt, " Additionally, ")
  #line-at(72.024pt, 738.46pt, "strain induces initially point and eventually ")
  #line-at(72.024pt, 752.136pt, "structural defects,")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(150.26pt, 748.176pt, "10–12")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(167.66pt, 752.136pt, " both of which may act as ")
  #line-at(72.024pt, 765.816pt, "non-radiative recombination centers. ")
  #line-at(323.95pt, 348.17pt, "The root cause for these challenges is the ")
  #line-at(315.43pt, 361.85pt, "large lattice mismatch, which would be reduced ")
  #line-at(315.43pt, 375.53pt, "if the LED structure were grown on a relaxed ")
  #line-at(315.43pt, 389.21pt, "(In,Ga)N pseudo-substrate instead of GaN. In ")
  #line-at(315.43pt, 402.77pt, "analogy to blue (In,Ga)N LEDs with about 15% ")
  #line-at(315.43pt, 416.45pt, "In")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(324.55pt, 412.49pt, "13")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(331.51pt, 416.45pt, " in QWs grown on GaN templates, for red ")
  #line-at(315.43pt, 430.13pt, "LEDs a fully relaxed (In,Ga)N layer with 15-25% ")
  #line-at(315.43pt, 443.83pt, "In would be desirable as pseudo-substrate, ")
  #line-at(315.43pt, 457.39pt, "corresponding to an in-plane lattice constant of ")
  #line-at(315.43pt, 471.07pt, "3.24-3.27 Å. Various strategies have been ")
  #line-at(315.43pt, 484.75pt, "pursued to fabricate such pseudo-substrates for ")
  #line-at(315.43pt, 498.43pt, "the growth of red LEDs. Partial strain release ")
  #line-at(315.43pt, 511.99pt, "has been achieved by porosification via ")
  #line-at(315.43pt, 525.67pt, "(electro)chemical etching but this approach ")
  #line-at(315.43pt, 539.35pt, "suffers from rough surface with a high density ")
  #line-at(315.43pt, 553.03pt, "of pits.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(349.99pt, 549.07pt, "14–16")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(367.39pt, 553.03pt, " As  another strategy, (In,Ga)N ")
  #line-at(315.43pt, 566.59pt, "layers are transferred to a different carrier ")
  #line-at(315.43pt, 580.27pt, "substrate, a process coined InGaNOS, but the ")
  #line-at(315.43pt, 593.95pt, "level of strain relaxation is limited.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(482.5pt, 589.99pt, "17")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(489.46pt, 593.95pt, " All of ")
  #line-at(315.43pt, 607.63pt, "these efforts involve intricate processing steps ")
  #line-at(315.43pt, 621.22pt, "that increase fabrication complexity and cost.  ")
  #line-at(323.95pt, 642.94pt, "In this work, we present a straightforward ")
  #line-at(315.43pt, 656.62pt, "three-step growth protocol to fabricate relaxed ")
  #line-at(315.43pt, 670.18pt, "(In,Ga)N pseudo-substrates without the need of ")
  #line-at(315.43pt, 683.86pt, "ex-situ processing. The underlying idea is to ")
  #line-at(315.43pt, 697.54pt, "adjust the growth conditions in plasma-assisted ")
  #line-at(315.43pt, 711.22pt, "molecular beam epitaxy (PAMBE) in such a ")
  #line-at(315.43pt, 724.78pt, "way that initially a nanostructured surface ")
  #line-at(315.43pt, 738.46pt, "forms that is subsequently smoothened. The ")
  #line-at(315.43pt, 752.136pt, "growth sequence is illustrated by the schematics ")
  #line-at(315.43pt, 765.816pt, "in Fig. 1(a) and 1(a’). As step 1, GaN is grown ")
]

