  #line-at(72.024pt, 383.81pt, "the 101")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.1pt, 383.81pt, "̅")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.1pt, 383.81pt, "5 reflection). This broadening can be ")
  #line-at(72.024pt, 397.61pt, "attributed to an intentionally introduced ")
  #line-at(72.024pt, 411.17pt, "gradient in In content along the growth ")
  #line-at(72.024pt, 424.85pt, "direction, suggesting a potential slight lattice ")
  #line-at(72.024pt, 438.53pt, "misalignment between the (In,Ga)N nanowalls ")
