  #line-at(72.024pt, 465.79pt, "observations are consistent with the diffusive ")
  #line-at(72.024pt, 479.47pt, "features observed in the RSM for Sample #A ")
  #line-at(72.024pt, 493.15pt, "(see Fig. S1 in the supporting information). ")
  #line-at(72.024pt, 506.83pt, "Nevertheless, the nanowalls are still single ")
  #line-at(72.024pt, 520.39pt, "crystalline, as verified by the transmission ")
  #line-at(72.024pt, 534.07pt, "RHEED pattern [cf. Fig. 1(b)].           ")
  #line-at(80.544pt, 555.79pt, "The PL spectra of samples #A, #B, and #R are ")
  #line-at(72.024pt, 569.35pt, "presented in Fig. 2(d). The peak wavelength for ")
  #line-at(72.024pt, 583.03pt, "sample #A is about 610 nm, which is consistent ")
  #line-at(72.024pt, 596.71pt, "with the In content of around 0.35 estimated ")
  #line-at(72.024pt, 610.39pt, "from the In/(Ga+In) flux ratio in step 2. The PL ")
  #line-at(72.024pt, 623.98pt, "band of sample #B peaks at 571 nm, ")
  #line-at(72.024pt, 637.66pt, "representing a significant blue-shift compared ")
  #line-at(72.024pt, 651.34pt, "to sample #A and a slightly smaller red-shift ")
  #line-at(72.024pt, 665.02pt, "compared to the 541-nm peak of sample #R. ")
  #line-at(72.024pt, 678.58pt, "These wavelengths are in line with the In ")
  #line-at(72.024pt, 692.26pt, "content ")
  #line-at(119.75pt, 692.26pt, "determined ")
  #line-at(184.389pt, 692.26pt, "from ")
  #line-at(220.733pt, 692.26pt, "the ")
  #line-at(249.514pt, 692.26pt, "RSMs. ")
  #line-at(72.024pt, 705.94pt, "Furthermore, the full width at half maximum ")
  #line-at(72.024pt, 719.62pt, "(FWHM) of sample #B is smaller than that of ")
  #line-at(72.024pt, 733.18pt, "both other samples (172 meV/45 nm vs. ")
  #line-at(72.024pt, 746.856pt, "195 meV/46 nm ")
  #line-at(159.5pt, 746.856pt, "for ")
  #line-at(188.33pt, 746.856pt, "sample ")
  #line-at(235.349pt, 746.856pt, "#R ")
  #line-at(264.162pt, 746.856pt, "and ")
  #line-at(72.024pt, 760.536pt, "311 meV/93 nm for sample #A). Moreover, ")
  #line-at(315.43pt, 306.53pt, "sample #C grown under identical conditions as ")
  #line-at(315.43pt, 320.09pt, "sample #B but without growth interruption ")
  #line-at(315.43pt, 333.77pt, "shows a very similar PL peak wavelength of ")
  #line-at(315.43pt, 347.45pt, "576 nm with an even smaller FWHM of ")
  #line-at(315.43pt, 361.13pt, "140 meV/37 nm (see Fig. S2 in supporting ")
  #line-at(315.43pt, 374.69pt, "information). We note that the In content and ")
  #line-at(315.43pt, 388.37pt, "strain relaxation degree of sample #C are 0.32 ")
  #line-at(315.43pt, 402.05pt, "and 75%, respectively (cf. RSM in Fig. S3 in ")
  #line-at(315.43pt, 415.73pt, "supporting information), i.e. slightly different ")
  #line-at(315.43pt, 429.29pt, "from sample #B. All details including XRD and ")
  #line-at(315.43pt, 442.99pt, "PL measurements are listed in Table 1.   ")
  #line-at(323.95pt, 464.59pt, "The red-shift in the PL spectrum of sample ")
  #line-at(315.43pt, 478.27pt, "#A compared to sample #B is consistent with ")
  #line-at(315.43pt, 491.95pt, "the higher In content and full strain relaxation ")
  #line-at(315.43pt, 505.63pt, "expected for the former sample. Likewise, the ")
  #line-at(315.43pt, 519.19pt, "red-shift in the PL spectrum of sample #B ")
  #line-at(315.43pt, 532.87pt, "compared to sample #R is a consequence of the ")
  #line-at(315.43pt, 546.55pt, "higher In content and strain relaxation degree of ")
  #line-at(315.43pt, 560.23pt, "the former sample.  This difference between the ")
  #line-at(315.43pt, 573.79pt, "two samples is very interesting because it ")
  #line-at(315.43pt, 587.47pt, "demonstrates that the rough, nanostructured ")
  #line-at(315.43pt, 601.15pt, "morphology and increased lattice constant after ")
  #line-at(315.43pt, 614.83pt, "step 2 leads to enhanced In incorporation and ")
  #line-at(315.43pt, 628.42pt, "strain relaxation compared to direct growth on ")
  #line-at(315.43pt, 642.1pt, "a GaN template. Moreover, the narrower PL ")
  #line-at(315.43pt, 655.78pt, "linewidth of the pseudo-substrates, samples #B ")
  #line-at(315.43pt, 669.46pt, "and #C, indicates a substantial reduction in ")
  #line-at(315.43pt, 683.14pt, "alloy disorder. This holds in particular for ")
  #line-at(315.43pt, 696.7pt, "sample #C grown without interruption, whereas ")
