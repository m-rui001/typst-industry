  #line-at(70.887pt, 554.36pt, "Sample thickness estimation ")
  #set text(font: "Calibri", size: 10.902pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.887pt, 576.84pt, "The sample thickness was measured after drop casting gold nanoparticle solution on both outer sides ")
  #line-at(70.887pt, 591.38pt, "of the carbon/LC/carbon sandwich liquid cell. After the sample dried, micrographs were taken at ")
  #line-at(70.887pt, 605.91pt, "sample tilts of approximately -20°, 0°, and 20° for the areas where the phase transition could be ")
  #line-at(70.887pt, 620.47pt, "observed, and the parallax method was used to calculate the thickness. The images were ")
  #line-at(70.887pt, 634.78pt, "superimposed in pairs of -20°/0° (fig. S3a) and 0°/20° (fig. S3b). For each pair, families of particles ")
  #line-at(70.887pt, 649.32pt, "belonging to the upper and lower surfaces were observed. Knowing the difference in distance ")
  #line-at(70.887pt, 663.86pt, "between the nanoparticle families located on both sides and the rotation angle, the local distance ")
  #line-at(70.887pt, 678.39pt, "between the surfaces (and therefore the total sample thickness in the field of view) was determined ")
  #line-at(70.887pt, 692.93pt, "to be 85 ± 27 nm . However, this thickness additionally includes the thicknesses of the two carbon ")
  #line-at(70.887pt, 707.26pt, "films.  ")
]

