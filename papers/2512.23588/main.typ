  #line-at(70.887pt, 316.03pt, "dose conditions  ")
  #set text(font: "Calibri", size: 10.902pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.887pt, 338.52pt, "Figure 1 illustrates the temperature-dependent structures of 8CB, along with the results of imaging the ")
  #line-at(70.887pt, 353.05pt, "material using electrons at various dose rates. The LC sample was prepared by sandwiching 8CB ")
  #line-at(70.887pt, 367.59pt, "between two standard TEM Cu grids coated with approximately 25 nm thick amorphous carbon film")
  #set text(font: "Calibri", size: 7.041pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(513.72pt, 364.18pt, "72–")
