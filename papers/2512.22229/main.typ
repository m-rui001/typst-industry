#original-page(612pt, 792pt, (image("graphics/page-17.png", width: 109pt), 299.5pt, 446pt))[
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 82.28pt, "2.5.4 Scope and interpretation ")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 108.78pt, "We emphasize that the above bound does not claim device-independent nonlocality in the strict sense of ")
  #line-at(72.025pt, 121.55pt, "loophole-free Bell tests. Rather, it establishes a rigorous classical benchmark for a well-defined class of ")
  #line-at(72.025pt, 134.05pt, "continuous-record estimators under explicit physical and statistical assumptions. Within this regime, ")
  #line-at(72.025pt, 146.8pt, "violations of the bound unambiguously signal correlations that cannot be reproduced by local classical ")
  #line-at(72.025pt, 159.55pt, "stochastic processes processed through the same measurement and analysis pipeline. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 190.3pt, "2.6 Operational algorithm for Bell–CHSH analysis from continuous records")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 216.83pt, "We summarize here a practical and reproducible procedure for evaluating Bell–CHSH correlations from ")
  #line-at(72.025pt, 229.33pt, "continuous measurement records within the framework developed above. The steps below define a fixed ")
  #line-at(72.025pt, 242.08pt, "estimator whose classical bound is established in Section 2.5 and whose quantum behavior is ")
  #line-at(72.025pt, 255.08pt, "characterized by the parameters ")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(214.35pt, 255.08pt, "𝜅(𝑃)")
