  #line-at(255.6pt, 255.08pt, "𝛾")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(261.6pt, 255.08pt, ". ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 281.6pt, "(i) Phase extraction.")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 294.6pt, "From the raw time-resolved measurement record of each subsystem, extract a phase variable ")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(481.95pt, 294.6pt, "𝜙")
  #set text(font: "Cambria Math", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(489.45pt, 296.85pt, "𝑘")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(494.95pt, 294.6pt, "(𝑡) ∈")
  #line-at(72.025pt, 307.35pt, "[0,2𝜋)")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(101.55pt, 307.35pt, "using a fixed and predetermined signal-processing protocol (for example, demodulation relative to ")
  #line-at(72.025pt, 320.1pt, "an external reference). The extraction procedure must be identical for all runs and independent of ")
  #line-at(72.025pt, 332.85pt, "subsequent choices of measurement settings. ")
