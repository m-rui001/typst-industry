  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(331.44pt, 244.8pt, "Fig. 2")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(363.6pt, 244.8pt, ") was constructed by orthogonally ")
  #line-at(72pt, 265.56pt, "stacking two identical 1D lenses. Specifically, one 1D lens (row) was rotated by 90° and aligned ")
  #line-at(72pt, 286.2pt, "with a second 1D lens (column), followed by PDMS-mediated bonding. The cylindrical lens ")
  #line-at(72pt, 306.96pt, "(")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(75.96pt, 306.96pt, "Supplementary Fig. S2")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(194.28pt, 306.96pt, ") was formed by conforming the 1D lens to a predefined curvature and ")
  #line-at(72pt, 327.6pt, "the edges were then sealed with PDMS to maintain the cylindrical shape.  ")
  #line-at(96pt, 348.36pt, "As illustrated in ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(173.52pt, 348.36pt, "Supplementary Fig. S3a")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.2pt, 348.36pt, ", micropumps (NKP‑DC‑S10B, Kamoer) were used ")
  #line-at(72pt, 369pt, "to drive liquid flow. Individual micropumps were selectively activated to fill the target ")
  #line-at(72pt, 389.76pt, "microfluidic channel with the desired liquid. All lenses were connected to the liquid pumping ")
  #line-at(72pt, 410.4pt, "system via silicone tubing with an inner diameter (ID) of 0.5 mm and an outer diameter (OD) of ")
  #line-at(72pt, 431.16pt, "1.5 mm. The tubing connections at the lens inlets were mechanically reinforced and hermetically ")
  #line-at(72pt, 451.8pt, "sealed with PDMS elastomer, followed by baking to fully cure the PDMS. The 0.5 mm ID/1.5 mm ")
  #line-at(72pt, 472.56pt, "OD tubing connected to the microfluidic lens inlets was then coupled to the micropump tubing ")
  #line-at(72pt, 493.2pt, "(3 mm ID, 5 mm OD) using heat‑shrink sleeves, as shown in ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(365.52pt, 493.2pt, "Supplementary Fig. S4a")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(488.64pt, 493.2pt, ". ")
  #line-at(96pt, 513.96pt, "Because each microfluidic channel within the lens requires alternating filling with two ")
  #line-at(72pt, 534.6pt, "distinct liquids to achieve an acoustic phase shift, Y‑shaped three‑way polypropylene connectors ")
  #line-at(72pt, 555.36pt, "(1.59 mm ID, 2.3 mm OD) were employed to merge the outputs from two individual micropumps ")
  #line-at(72pt, 576pt, "into a single lens channel. These connectors were installed within the 3 mm OD tubing segments. ")
  #line-at(72pt, 596.76pt, "By selectively activating one of the two micropumps, the corresponding liquid was introduced into ")
  #line-at(72pt, 617.4pt, "the channel, thereby modulating the acoustic response (see ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(360.96pt, 617.4pt, "Supplementary Fig. S4b ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(489.24pt, 617.4pt, "and ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(510pt, 617.4pt, "Video ")
  #line-at(72pt, 638.16pt, "3")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(78pt, 638.16pt, ").  ")
]

