#original-page(612pt, 792pt, (image("graphics/page-23.png", width: 426pt), 91.5pt, 124pt))[
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(303.48pt, 742.32pt, "4 ")
  #set text(font: "Times New Roman", size: 14.013pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 85.2pt, "Supplementary Note 1: Microfluidic Lenses Fabrication and Pumping System ")
  #line-at(72pt, 109.32pt, "Assembly ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#0e2841"))
  #line-at(72pt, 243.48pt, "Supplementary Fig. S1 Fabrication process of the 1D microfluidic lenses. ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(96pt, 277.92pt, "The 1D microfluidic lenses were fabricated by bonding a structured PDMS layer with a planar ")
  #line-at(72pt, 298.56pt, "base layer. The top structured layer was cast using a mold containing the liquid channel structure. ")
  #line-at(72pt, 319.32pt, "This mold was designed via 3D modelling software and fabricated using a high-resolution 3D ")
  #line-at(72pt, 339.96pt, "printer (Form 4, Formlabs). For the row-column lens arrays in this work, the mold was configured ")
  #line-at(72pt, 360.72pt, "to produce 20 parallel aligned channels, each measuring 2.5 mm in width, 1.5 mm in height, and ")
  #line-at(72pt, 381.36pt, "70 mm in length, separated by 0.5 mm thick walls. At the inlet and outlet of the channels, we also ")
  #line-at(72pt, 402.12pt, "designed the narrow ends to insert and fix the liquid changing tubes. The structured layer was ")
  #line-at(72pt, 422.76pt, "made of polydimethylsiloxane (PDMS, Sylgard 184, Dow Corning) with a 10:1 agent ratio ")
  #line-at(72pt, 443.52pt, "between base and curing. The mixture was cured at 60 °C for 30–40 min. Prior to bonding, both ")
  #line-at(72pt, 464.16pt, "the structured and flat layers underwent oxygen plasma treatment (downstream Asher, YES) to ")
  #line-at(72pt, 484.92pt, "mitigate potential PDMS swelling in silicone oil. Details of the procedures to overcome PDMS ")
  #line-at(72pt, 505.56pt, "swelling are provided in ")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(191.28pt, 505.56pt, "Supplementary Note 3")
  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(305.88pt, 505.56pt, "). ")
  #line-at(96pt, 526.32pt, "The bottom flat layer was fabricated separately on a glass wafer. The wafer surface was first ")
  #line-at(72pt, 546.96pt, "rendered hydrophilic via plasma treatment. Subsequently, a 5 wt% poly acrylic acid (PAA) ")
  #line-at(72pt, 567.72pt, "sacrificial layer was deposited on the top by spin-coated the liquid at 500 rpm for 40 s and cured ")
  #line-at(72pt, 588.36pt, "at 90 °C for 1 h. A PDMS elastomer solution (15:1 ratio) was then spin-coated onto the PAA layer ")
  #line-at(72pt, 609.12pt, "at 500 rpm for 40 s, yielding a uniform thickness of approximately 250 µm. After precise alignment, ")
  #line-at(72pt, 629.76pt, "we placed the structured layer onto the flat layer and bonded them together with uncured PDMS ")
  #line-at(72pt, 650.52pt, "as adhesive. The combined structure was then cured at 90 °C for 1 h to ensure strong adhesion, ")
  #line-at(72pt, 671.16pt, "after which it was released them from the glass wafer by dissolving the PAA sacrificial layer in ")
  #line-at(72pt, 691.92pt, "deionized water at 90 °C for 10 min. Finally, the fabricated lenses were baked at 130 °C overnight ")
  #line-at(72pt, 712.56pt, "to stabilize the polymer network and suppress subsequent swelling of PDMS")
  #line-at(443.16pt, 712.56pt, "in silicone oil. ")
]

