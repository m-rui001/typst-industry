#original-page(595.32pt, 841.92pt, (image("graphics/page-17.png", width: 526.5pt), 34.5pt, 67.5pt))[
  #set text(font: "Arial", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(36pt, 59.4pt, "Appl. Sci. ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(69.96pt, 59.4pt, "2023")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.04pt, 59.4pt, ",")
  #set text(font: "Arial", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(87.96pt, 59.4pt, " 13")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(98.04pt, 59.4pt, ", x FOR PEER REVIEW ")
  #line-at(528.219pt, 59.4pt, "17 of 19 ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(166.44pt, 102.24pt, "connection of the PRV with the critical point of the system. Sometimes, these two issues ")
  #line-at(166.44pt, 115.08pt, "are not possible from a technical point of view or imply massive cost. ")
  #line-at(187.68pt, 127.92pt, "In this work, a time series of a ratio of pressures measured downstream of the PRV ")
  #line-at(166.44pt, 140.64pt, "and the critical point on a real location in Noja village was modeled to create and validate ")
  #line-at(166.44pt, 153.48pt, "a new open-loop control scheme for CPC based on time. Hourly pressure values were ")
  #line-at(166.44pt, 166.32pt, "taken from February to December 2021. Due to the influence in the demand of the holiday ")
  #line-at(166.44pt, 179.16pt, "periods in the area, it is considered to estimate, for the modeling, data from three months ")
  #line-at(166.44pt, 192pt, "of a non-holiday season, with lower consumption (April, May, June), and another three ")
  #line-at(166.44pt, 204.72pt, "months of a holiday period, with higher consumption (July, August, September), in order ")
  #line-at(166.44pt, 217.56pt, "to obtain a useful model regardless of the time of the year. In this way, 4392 observations ")
  #line-at(166.44pt, 230.4pt, "were considered to estimate the model. The data from 1 October to 31 December, precisely ")
  #line-at(166.44pt, 243.24pt, "2208 observations, were used to validate the model.")
  #line-at(187.68pt, 256.08pt, "A SARIMA model has been built and implemented as an alternative to the current ")
  #line-at(166.44pt, 268.8pt, "PM model based on the flow reading that the Noja utility is using. The SARIMA model ")
  #line-at(166.44pt, 281.64pt, "has been validated by comparing the values predicted by the model with the data taken ")
  #line-at(166.44pt, 294.48pt, "between October and December 2021. The first test was conducted by calculating the ")
  #line-at(166.44pt, 307.32pt, "RMSE, giving a value of 0.018. The coefficient of determination of the comparison was also ")
  #line-at(166.44pt, 320.16pt, "calculated, giving a value of 0.9648. Both tests support the goodness of fit of the model to ")
  #line-at(166.44pt, 332.88pt, "predict pressure values at the valve outlet and at the critical point of the zone. The ")
  #line-at(166.44pt, 345.72pt, "SARIMA model was also tested in real field conditions for eleven days in December 2022. ")
  #line-at(166.44pt, 358.56pt, "The hydraulic variables of the area were analyzed, showing that there is no difference ")
  #line-at(166.44pt, 371.4pt, "when working under the previous model and that the PRV is under the SARIMA model ")
  #line-at(166.44pt, 384.24pt, "control. The real field measurements at the critical point obtained when applying the ")
  #line-at(166.44pt, 396.96pt, "SARIMA model were compared with the critical point target pressure by means of an ")
  #line-at(166.44pt, 409.8pt, "ANOVA analysis with a ")
  #set text(font: "Arial", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(282.6pt, 409.8pt, "p")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(287.64pt, 409.8pt, " value of 0.412, greater than 0.05, thus confirming the null ")
  #line-at(166.44pt, 422.64pt, "hypothesis of this analysis and that there is no statistical difference between the values ")
  #line-at(166.44pt, 435.48pt, "compared.")
  #line-at(187.68pt, 448.32pt, "The result of the field test and the statistical analysis performed concludes that ")
  #line-at(166.44pt, 461.04pt, "SARIMA is a useful tool to modulate pressure at a PRV outlet to achieve a target value at ")
  #line-at(166.44pt, 473.88pt, "the critical point of the area supplied. The new model can be implemented as an ")
  #line-at(166.44pt, 486.72pt, "alternative for CPC in situations where no flow signal is available or where it is not ")
  #line-at(166.44pt, 499.56pt, "possible to establish real-time communication between the critical point and the PRV.")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
