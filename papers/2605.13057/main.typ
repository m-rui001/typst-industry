  #line-at(38.835pt, 634.285pt, "Although the two parameter directions remain locally distinguishable, the weaker direction is expressed less strongly in")
  #line-at(38.835pt, 646.24pt, "the observables than the dominant one, so the inverse problem is already anisotropic. If the sensitivity along this weaker")
  #line-at(38.835pt, 658.195pt, "direction")
  #line-at(77.301pt, 658.195pt, "becomes")
  #line-at(115.228pt, 658.195pt, "comparable")
  #line-at(164.722pt, 658.195pt, "to")
  #line-at(175.512pt, 658.195pt, "measurement")
  #line-at(231.681pt, 658.195pt, "uncertainty")
  #line-at(279.9pt, 658.195pt, "or")
  #line-at(291.267pt, 658.195pt, "microstructural")
  #line-at(355.287pt, 658.195pt, "variability,")
  #line-at(401.264pt, 658.195pt, "it")
  #line-at(409.872pt, 658.195pt, "may")
  #line-at(429.817pt, 658.195pt, "become")
  #line-at(463.869pt, 658.195pt, "effectively")
  #line-at(38.835pt, 670.151pt, "unrecoverable. This motivates the next step of the analysis, where the Jacobian is interpreted relative to the variability")
  #line-at(38.835pt, 682.106pt, "of the observables through a practical identifiability framework.")
  #line-at(267.145pt, 700.774pt, "12")
