#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(518.14pt, 788.616pt, "1 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(75.864pt, 81.96pt, "Determination of the mass transport parameters in thin membranes by phase-sensitive ")
  #line-at(138.98pt, 98.06pt, "photoacoustics in the optically transparent and mixed regimes ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 121.94pt, "Pawel Rochowski ")
  #line-at(70.824pt, 145.94pt, "Institute of Experimental Physics, Faculty of Mathematics, Physics and Informatics, ")
  #line-at(70.824pt, 162.02pt, "Universityof Gdańsk, Wita Stwosza 57, 80-308 Gdańsk, Poland ")
  #line-at(70.824pt, 185.9pt, "Correspondence: pawel.rochowski@ug.edu.pl ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 209.9pt, "Abstract ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 233.9pt, "The research complements and extends the scope of the work reported in the article ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(491.14pt, 233.9pt, "“LED-")
  #line-at(70.824pt, 249.86pt, "based multibeam photoacoustics combined with electrical circuit-based modelling for the ")
  #line-at(70.824pt, 265.97pt, "analysis of multispecies mass transport through thin membranes”")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(404.59pt, 265.97pt, " (arXiv:2602.20902). In ")
  #line-at(70.824pt, 281.93pt, "particular, this work investigates the impact of the sample’s absorption properties on the ability ")
  #line-at(70.824pt, 297.89pt, "to quantify slow mass transport processes in thin membranes under optically transparent and ")
  #line-at(70.824pt, 313.85pt, "semi-opaque conditions. The theoretical framework is based on the Green’s function approach ")
  #line-at(70.824pt, 329.81pt, "as formalized by Mandelis. Owing to the separation of photoacoustic and mass transport ")
  #line-at(70.824pt, 345.89pt, "timescales, the heat distributions are assumed to follow the temporal mass concentration ")
  #line-at(70.824pt, 361.85pt, "profiles predicted by a Fickian diffusion process. The approach is further examined and ")
  #line-at(70.824pt, 377.81pt, "validated using experimental data on pigment transport into a thin porous membrane. Detailed ")
  #line-at(70.824pt, 393.77pt, "experimental results are provided in the referenced paper. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(88.824pt, 417.77pt, "1.")
  #line-at(106.82pt, 417.77pt, "Introduction ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 441.79pt, "The work demonstrates the potential of the phase-sensitive photoacoustic technique for ")
  #line-at(70.824pt, 457.75pt, "measuring the dynamics of pigment transport through thin membranes. As will be shown, ")
  #line-at(70.824pt, 473.71pt, "investigating the evolution of the signal phase over a broad range of sample transmissivities ")
  #line-at(70.824pt, 489.67pt, "enables direct and accurate determination of transport constants, even when relatively simple ")
  #line-at(70.824pt, 505.75pt, "models for the mass transport analyses are used. On the other hand, the amplitude signal ")
  #line-at(70.824pt, 521.71pt, "analysis provides a substantially more distorted picture of membrane transport, influenced by ")
  #line-at(70.824pt, 537.67pt, "the optical evolution of the sample. Despite of the distortion the estimation of the transport ")
  #line-at(70.824pt, 553.63pt, "parameters and the equilibrium light transmission are still possible, at least in terms of their ")
  #line-at(70.824pt, 569.59pt, "order of magnitude, over a similarly wide range of sample transmissivities. ")
  #line-at(70.824pt, 593.59pt, "To proceed, we consider a problem of mass transport characterization by means of the frequency ")
  #line-at(70.824pt, 609.55pt, "domain photoacoustics with the front-side detection, with a symmetry similar as in the ")
  #line-at(70.824pt, 625.66pt, "Rosencwaig-Gersho problem [1].  ")
  #line-at(70.824pt, 649.66pt, "For the thermal response we assume the following geometry: the system is one-dimensional ")
  #line-at(70.824pt, 665.62pt, "along x-axis and comprises of three subsystems: a gas (x < 0), a sample (0 ≤ x ≤ l) and a backing ")
  #line-at(70.824pt, 681.58pt, "(x > l); the subsystems are later denoted with subscripts ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(341.11pt, 681.58pt, "g")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(347.11pt, 681.58pt, ", ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(353.11pt, 681.58pt, "s")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(357.79pt, 681.58pt, " and ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(381.07pt, 681.58pt, "b")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(387.07pt, 681.58pt, ", respectively. The interfaces ")
  #line-at(70.824pt, 697.78pt, "of interest are located at ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(186.65pt, 697.78pt, "𝑥= 0")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(215.69pt, 697.78pt, " (gas/sample) and ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(301.85pt, 697.78pt, "𝑥= 𝑙")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(328.39pt, 697.78pt, " (sample/backing). As such, the PA signal ")
  #line-at(70.824pt, 714.1pt, "is directly related to the temperature at the interface, ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(324.79pt, 714.1pt, "Θ(0)")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(349.27pt, 714.1pt, ". ")
  #line-at(70.824pt, 738.1pt, "For the mass transport problem we assume, that the system consists of a mass donor (")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(477.94pt, 738.1pt, "x > l")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(500.26pt, 738.1pt, ") and ")
  #line-at(70.824pt, 754.176pt, "a mass acceptor (")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(153.26pt, 754.176pt, "0 ≤ x ≤ l")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(192.65pt, 754.176pt, "). The donor and acceptor domains coincide with the thermal backing ")
]

