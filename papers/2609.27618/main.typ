  #line-at(308.35pt, 317.93pt, "虽然增加了反演约束，但并不能从根本上消除参数相")
  #line-at(308.35pt, 333.53pt, "关性。当多个参数在所选频率和时间区间内仍表现出")
  #line-at(308.35pt, 349.13pt, "相似的敏感性特征时，仍需结合先验参数、敏感性分")
  #line-at(308.35pt, 364.73pt, "析和不确定度评估确定可以可靠反演的参数组合。")
  #line-at(329.35pt, 380.33pt, "总体而言，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(378.67pt, 380.33pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(396.179pt, 380.33pt, " 通过宽频方波调制和全周期温度")
  #line-at(308.35pt, 395.93pt, "波形采集，在频率调控热扩散尺度的基础上进一步引")
  #line-at(308.35pt, 411.55pt, "入周期内时序信息，为复杂材料体系的多参数热物性")
  #line-at(308.35pt, 427.15pt, "反演提供了更多独立约束。与")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(445.42pt, 427.15pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(472.844pt, 427.15pt, " 相比，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.82pt, 427.15pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(522.318pt, 427.15pt, " 更侧")
  #line-at(308.35pt, 442.75pt, "重较宽时间尺度下的周期热响应，而")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(481.78pt, 442.75pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(514.42pt, 442.75pt, "在皮秒")
  #line-at(308.35pt, 458.35pt, "至纳秒尺度超快热过程及纳米薄膜界面输运表征方")
  #line-at(308.35pt, 473.95pt, "面仍具有明显优势，两者在适用时间尺度和参数敏感")
  #line-at(308.35pt, 489.55pt, "性方面具有互补性。需要指出的是，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(479.38pt, 489.55pt, "SSTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.58pt, 489.55pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(515.26pt, 489.55pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(535.3pt, 489.55pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 505.15pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.23pt, 505.15pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(345.79pt, 505.15pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(373.109pt, 505.15pt, " 及")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(389.11pt, 505.15pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.618pt, 505.15pt, " 主要通过时间或频率变量改变")
  #line-at(308.35pt, 520.75pt, "热扩散响应；对于面内热输运及热导率各向异性的辨")
  #line-at(308.35pt, 536.35pt, "识，还需要进一步引入空间位置这一独立观测维度，")
  #line-at(308.35pt, 551.95pt, "由此形成下一节讨论的空间域热反射方法。")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 583.3pt, "2.6 ")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 583.3pt, "空间域响应：")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(395.71pt, 583.3pt, "SDTR")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(425.043pt, 583.3pt, " 及光斑偏移方法")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 606.58pt, "空间域热反射")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(393.55pt, 606.58pt, "(SDTR)")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(427.42pt, 603.1pt, "[39]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(439.06pt, 606.58pt, "通过改变探测光相对于")
  #line-at(308.35pt, 622.18pt, "泵浦光的横向位置，测量热反射信号随空间偏移距离")
  #line-at(308.35pt, 637.78pt, "的变化，从而表征样品表面温度场的横向扩散特征。")
  #line-at(308.35pt, 653.38pt, "不同于前述主要以时间、频率或周期波形作为观测变")
  #line-at(308.35pt, 668.98pt, "量的热反射方法，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.43pt, 668.98pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(417.147pt, 668.98pt, " 将横向空间位置作为独立观")
  #line-at(308.35pt, 684.58pt, "测维度，使面内热扩散直接参与热物性参数反演。由")
  #line-at(308.35pt, 700.18pt, "于空间温度场对横向热输运具有较强响应，该方法特")
  #line-at(308.35pt, 715.78pt, "别适用于各向异性晶体、取向薄膜以及其他具有显著")
  #line-at(308.35pt, 731.38pt, "面内热输运特征材料的表征。")
  #line-at(329.35pt, 747pt, "在典型")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(363.55pt, 747pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.372pt, 747pt, " 实验中，调制泵浦光在样品表面形")
  #line-at(308.35pt, 762.6pt, "成局部周期性热源，探测光相对于泵浦中心沿横向方")
  #line-at(308.35pt, 778.2pt, "向逐点扫描，并记录不同偏移位置处的热反射响应。")
]

