  #line-at(308.35pt, 193.1pt, "的时间尺度与形状特征。")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 208.7pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(349.353pt, 208.7pt, " 的优势在于物理图像清晰，能够直接观测脉")
  #line-at(308.35pt, 224.3pt, "冲加热后热扰动的弛豫与扩散过程，尤其适用于较厚")
  #line-at(308.35pt, 239.9pt, "薄膜、块体材料以及特征热弛豫时间处于仪器可分辨")
  #line-at(308.35pt, 255.53pt, "时间范围内的样品。然而，对于多层异质结构、低热")
  #line-at(308.35pt, 271.13pt, "导率材料以及界面热阻显著的体系，瞬态温度衰减曲")
  #line-at(308.35pt, 286.73pt, "线通常同时受到薄膜热导率、体积热容、界面热导和")
  #line-at(308.35pt, 302.33pt, "衬底热物性等多个参数影响，不同参数的敏感性容易")
  #line-at(308.35pt, 317.93pt, "发生耦合，仅依靠单一衰减曲线往往难以实现多参数")
  #line-at(308.35pt, 333.53pt, "独立反演。此外，受探测带宽、信噪比及温升幅值衰")
  #line-at(308.35pt, 349.13pt, "减等因素限制，脉冲激励后期的长时间尺度信号较弱，")
  #line-at(308.35pt, 364.73pt, "容易受到实验噪声影响，从而限制对较慢热扩散过程")
  #line-at(308.35pt, 380.33pt, "的有效表征。")
  #line-at(329.35pt, 395.93pt, "总体而言，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(376.63pt, 395.93pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(396.514pt, 395.93pt, " 建立了以瞬态温度衰减为核心的")
  #line-at(308.35pt, 411.55pt, "基本时域观测框架，但单一时间响应在热穿透尺度主")
  #line-at(308.35pt, 427.15pt, "动调控和多参数解耦方面仍存在局限。为获得额外的")
