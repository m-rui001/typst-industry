  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(276.65pt, 536.35pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 551.95pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(76.499pt, 551.95pt, " 及")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(92.304pt, 551.95pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(109.802pt, 551.95pt, " 等典型热反射方法的物理原理、实验构")
  #line-at(49.56pt, 567.55pt, "型和参数敏感特性，并在统一的热扩散分析框架下厘")
  #line-at(49.56pt, 583.18pt, "清不同技术路线之间的内在联系与核心差异。进一步")
  #line-at(49.56pt, 598.78pt, "地，本文从热扩散特征尺度、观测变量与调控方式、")
  #line-at(49.56pt, 614.38pt, "面内和面外热输运的辨识能力以及多参数联合反演")
  #line-at(49.56pt, 629.98pt, "的稳定性四个维度，比较各类方法的性能特点与适用")
  #line-at(49.56pt, 645.58pt, "范围；同时，以低热导率聚合物、各向异性薄膜、晶")
  #line-at(49.56pt, 661.18pt, "体材料及")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(94.824pt, 661.18pt, "GaN/Si")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.409pt, 661.18pt, " 异质结构为典型案例，分析热反射")
  #line-at(49.56pt, 676.78pt, "技术在复杂材料与器件热物性表征中的应用特征。最")
  #line-at(49.56pt, 692.38pt, "后，本文展望热反射测量技术在更高时空分辨率、原")
  #line-at(49.56pt, 707.98pt, "位多物理场表征、快速参数反演、工业在线无损检测")
  #line-at(49.56pt, 723.58pt, "及自然语言驱动的智能数据分析与自适应实验等方")
  #line-at(49.56pt, 739.18pt, "向的发展趋势，以期为微纳尺度热输运研究和新一代")
  #line-at(49.56pt, 754.8pt, "微电子器件热管理提供理论与实验参考。")
