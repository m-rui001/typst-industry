  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(70.704pt, 189.62pt, "[39]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(82.224pt, 193.1pt, "。")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(92.184pt, 193.1pt, "近年来发展的方脉冲热源法（")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(228.17pt, 193.1pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(245.69pt, 193.1pt, "）采用方")
  #line-at(49.56pt, 208.7pt, "波调制和全周期温升波形分析，同时利用加热与冷却")
  #line-at(49.56pt, 224.3pt, "阶段的热响应信息，为热导率、体积热容及相关界面")
  #line-at(49.56pt, 239.9pt, "参数的协同反演提供了新的测量维度，并逐步拓展至")
  #line-at(49.56pt, 255.53pt, "低热导材料和多层异质结构的热物性表征")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(238.85pt, 252.05pt, "[40-43]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(259.61pt, 255.53pt, "。")
  #line-at(70.584pt, 271.13pt, "尽管热反射技术已广泛应用于微纳尺度热物性")
  #line-at(49.56pt, 286.73pt, "的定量测量，现有综述与研究大多聚焦于单一技术路")
  #line-at(49.56pt, 302.33pt, "线或特定材料体系")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(133.7pt, 298.85pt, "[44-46]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(154.46pt, 302.33pt, "，仍缺乏对不同方法内在物理")
  #line-at(49.56pt, 317.93pt, "关联、性能边界及适用场景的系统比较。由于各类热")
  #line-at(49.56pt, 333.53pt, "反射方法在激励方式、实验构型和信号采集形式上存")
  #line-at(49.56pt, 349.13pt, "在明显差异，它们往往被视为彼此独立的测量技术。")
  #line-at(49.56pt, 364.73pt, "然而，这些方法均遵循相同的基本物理过程，即通过")
  #line-at(49.56pt, 380.33pt, "光热激励在样品中产生温度场，并利用反射率对温度")
  #line-at(49.56pt, 395.93pt, "变化的响应获取热学信号，再结合热扩散模型反演相")
  #line-at(49.56pt, 411.55pt, "关热物性参数。不同技术路线的主要差异在于对时间")
  #line-at(49.56pt, 427.15pt, "延迟、调制频率、稳态温升或空间位置等观测变量的")
  #line-at(49.56pt, 442.75pt, "选择，以及相应的信号处理和参数反演策略。若缺乏")
  #line-at(49.56pt, 458.35pt, "统一的热扩散分析框架，研究人员在面对多层薄膜、")
  #line-at(49.56pt, 473.95pt, "异质界面、低热导率材料和各向异性晶体等复杂体系")
  #line-at(49.56pt, 489.55pt, "时，往往难以合理选择测量方法与实验参数，也难以")
  #line-at(49.56pt, 505.15pt, "系统评估参数敏感性、反演稳定性及测量不确定度。")
  #line-at(70.584pt, 520.75pt, "基于上述研究现状，本文从热反射效应与热扩散")
  #line-at(49.56pt, 536.35pt, "基本方程出发，系统梳理")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(161.66pt, 536.35pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(181.61pt, 536.35pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
