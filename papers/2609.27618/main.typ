  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(165.26pt, 629.98pt, "利用脉冲激光在样品表面")
  #line-at(49.56pt, 645.58pt, "产生瞬时热扰动，并记录随后表面温度随时间的衰减")
  #line-at(49.56pt, 661.18pt, "过程，是最直接的时域热反射测量方法之一。与")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(262.01pt, 661.18pt, "SSTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 676.78pt, "主要利用准稳态温升幅值不同，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(191.45pt, 676.78pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(211.334pt, 676.78pt, " 的热物性信息主")
  #line-at(49.56pt, 692.38pt, "要包含在瞬态温度衰减曲线的时间尺度和形状之中：")
