  #line-at(53.76pt, 275.57pt, "摘要")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(81.624pt, 275.57pt, "随着半导体器件特征尺寸持续缩小至纳米尺度")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(299.83pt, 275.57pt, ", ")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(307.39pt, 275.57pt, "材料与界面的热输运及热储能行为呈现出日益显著的")
  #line-at(53.76pt, 291.17pt, "尺度、结构和界面依赖性，对热导率、界面热导和体积热容等关键热物性参数的准确表征，已成为功能材")
  #line-at(53.76pt, 306.77pt, "料设计与先进电子器件热管理中的重要基础问题。基于光热效应的热反射测量技术具有非接触、高时空分")
  #line-at(53.76pt, 322.37pt, "辨率和宽测量范围等优势，已成为微纳尺度热物性表征的重要方法。本文系统梳理了瞬态热反射")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.22pt, 322.37pt, "(TTR)")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(530.98pt, 322.37pt, "、")
  #line-at(53.76pt, 337.97pt, "时域热反射")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.18pt, 337.97pt, "(TDTR)")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(141.38pt, 337.97pt, "、频域热反射")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(205.13pt, 337.97pt, "(FDTR)")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(238.73pt, 337.97pt, "、稳态热反射")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(302.47pt, 337.97pt, "(SSTR)")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(334.39pt, 337.97pt, "、空间域热反射")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(408.67pt, 337.97pt, "(SDTR)")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(442.42pt, 337.97pt, "及方脉冲热源法")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(517.3pt, 337.97pt, "(SPS)")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(53.76pt, 353.57pt, "的物理原理与技术特征，建立了统一的热扩散分析框架，并比较了不同方法在参数敏感性、测量不确定度")
  #line-at(53.76pt, 369.17pt, "及适用范围方面的差异。结合典型应用案例，本文进一步分析了热反射技术在低导热材料、各向异性薄膜、")
  #line-at(53.76pt, 384.77pt, "晶体材料及多层异质结构热物性测量中的适用条件，阐明了不同方法在薄膜热导率、界面热导和面内")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(528.1pt, 384.77pt, "/")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(531.22pt, 384.77pt, "面")
  #line-at(53.76pt, 400.37pt, "外热输运表征中的互补作用。最后，本文展望了热反射测量在超高时空分辨、多物理场耦合、工业在线检")
  #line-at(53.76pt, 415.99pt, "测及智能化数据处理与自然语言驱动分析等方向的发展趋势，以期为微纳尺度热输运研究和先进器件热管")
  #line-at(53.76pt, 431.59pt, "理提供参考。")
  #set text(font: "SimSun", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
