  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(82.944pt, 310.13pt, "。泵浦光在样品表面或金属传感层中产生局")
  #line-at(49.56pt, 325.73pt, "部温升，探测光通过检测温度变化引起的反射率变化")
  #line-at(49.56pt, 341.33pt, "获取热学响应。数据分析时，可通过比较待测样品与")
  #line-at(49.56pt, 356.93pt, "参考样品在相同加热条件下的温升差异，或结合吸收")
