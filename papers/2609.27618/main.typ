  #line-at(262.01pt, 154.1pt, "SSTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 169.7pt, "视为热扩散过程在长时间尺度下的极限情形。该方法")
  #line-at(49.56pt, 185.3pt, "关注的核心并非脉冲激励后的瞬态温度衰减，而是在")
