  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(400.87pt, 473.95pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(418.379pt, 473.95pt, " 等时间域、频率域和全周期")
  #line-at(308.35pt, 489.55pt, "响应方法形成互补，从而获得更加可靠的多维热物性")
