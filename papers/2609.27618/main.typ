  #line-at(49.56pt, 216.5pt, "其基本物理图像较为直观：在相同加热条件下，热导")
  #line-at(49.56pt, 232.1pt, "率较高的材料能够更快地将热量输运至周围区域，因")
  #line-at(49.56pt, 247.73pt, "而表面温升较低；热导率较低的材料散热能力较弱，")
  #line-at(49.56pt, 263.33pt, "热量更易在加热区域积聚，对应较高的准稳态温升。")
  #line-at(70.584pt, 278.93pt, "如")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(81.144pt, 278.93pt, "图")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(95.904pt, 278.93pt, "3d")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.66pt, 278.93pt, "所示，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(142.22pt, 278.93pt, "SSTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(171.5pt, 278.93pt, "实验系统通常由低频调制")
  #line-at(49.56pt, 294.53pt, "的连续波泵浦光、连续探测光以及反射信号采集模块")
  #line-at(49.56pt, 310.13pt, "组成")
