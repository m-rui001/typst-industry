  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(417.033pt, 68.28pt, " 通常采用纳秒或皮秒脉冲激")
  #line-at(308.35pt, 83.9pt, "光作为泵浦光")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(371.47pt, 80.42pt, "[27, 62]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(393.07pt, 83.9pt, "，在样品表面或金属传感层中诱发")
  #line-at(308.35pt, 99.5pt, "快速温升，同时采用连续波激光作为探测光照射同一")
  #line-at(308.35pt, 115.1pt, "区域。温度变化引起的探测光反射率变化由高速光电")
  #line-at(308.35pt, 130.7pt, "探测器采集，从而获得表面热响应随时间的演化曲线。")
  #line-at(308.35pt, 146.3pt, "在数据解析过程中，常对瞬态温升信号进行峰值归一")
