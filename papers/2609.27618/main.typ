  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.224pt, 707.98pt, "Si")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(98.064pt, 707.98pt, "衬底的热导率和体积热容等参数。与直接")
  #line-at(49.56pt, 723.58pt, "拟合大量单一物理参数相比，这种策略的优势在于先")
  #line-at(49.56pt, 739.18pt, "通过无量纲组合参数确定信号真正敏感的对象，再将")
  #line-at(49.56pt, 754.8pt, "可测组合参数反演为具有物理意义的单层热导率、体")
  #line-at(49.56pt, 770.4pt, "积热容或界面热导。")
  #line-at(329.35pt, 68.28pt, "这一案例更重要的意义在于展示“先判断什么可")
  #line-at(308.35pt, 83.9pt, "测，再进行物性反演”的思路。对于多层异质体系，")
  #line-at(308.35pt, 99.5pt, "热反射信号往往首先约束由热扩散特征时间、热阻和")
  #line-at(308.35pt, 115.1pt, "面积热容形成的组合参数，而不是独立约束所有单层")
  #line-at(308.35pt, 130.7pt, "物性。在该具体研究中，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(420.7pt, 130.7pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.198pt, 130.7pt, " 利用不同频率和周期波")
  #line-at(308.35pt, 146.3pt, "形构建了多组互补条件；但组合参数先行、通过多工")
  #line-at(308.35pt, 161.9pt, "况降低相关性的思想并不依赖于某一特定平台，也可")
  #line-at(308.35pt, 177.5pt, "用于")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(331.99pt, 177.5pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(359.47pt, 177.5pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(369.67pt, 177.5pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(396.492pt, 177.5pt, " 及其他可改变时间、频率或空间")
  #line-at(308.35pt, 193.1pt, "观测条件的方法。")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 224.42pt, "4.5 ")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 224.42pt, "从案例到方法选择：观测信息优先于方法标签")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 247.73pt, "综合上述案例，复杂热反射测量的关键并不是优")
  #line-at(308.35pt, 263.33pt, "先选择某一特定技术，而是先明确需要区分哪些热物")
  #line-at(308.35pt, 278.93pt, "性参数，再判断现有实验能够提供哪些相互独立的时")
  #line-at(308.35pt, 294.53pt, "间、频率、空间或波形信息。本节中")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(476.62pt, 294.53pt, "SPS/BO-SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(532.771pt, 294.53pt, " 案")
  #line-at(308.35pt, 310.13pt, "例出现较多，反映的是近年来相关工作的代表性和图")
  #line-at(308.35pt, 325.73pt, "例可用性，而不构成方法性能排序。对于同一科学问")
  #line-at(308.35pt, 341.33pt, "题，多频")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.67pt, 341.33pt, "TDTR/FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.91pt, 341.33pt, "、变光斑或光斑偏移测量、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(523.06pt, 341.33pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(540.48pt, 341.33pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 356.93pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.289pt, 356.93pt, " 以及跨平台联合方案都可能成立；最终应以参")
  #line-at(308.35pt, 372.53pt, "数可辨识性、测量不确定度、实验复杂度和可复现性")
  #line-at(308.35pt, 388.13pt, "作为评价依据。")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 419.83pt, "5 ")
  #set text(font: "SimSun", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 419.83pt, "挑战、趋势与展望")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 450.67pt, "5.1 ")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 450.67pt, "反演不适定性与不确定度量化")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 473.95pt, "第")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(342.79pt, 473.95pt, "1.4")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(355.99pt, 473.95pt, " 节和第")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(393.31pt, 473.95pt, "3.2")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.51pt, 473.95pt, " 节已从局部敏感性和参数相关")
  #line-at(308.35pt, 489.55pt, "性的角度讨论了热反射参数反演中的可辨识性问题。")
  #line-at(308.35pt, 505.15pt, "对于多层异质结构、各向异性材料和复杂器件，仅依")
  #line-at(308.35pt, 520.75pt, "靠局部敏感性分析仍难以充分判断反演结果的可靠")
  #line-at(308.35pt, 536.35pt, "性。即使实验信号能够与热扩散模型良好拟合，目标")
  #line-at(308.35pt, 551.95pt, "函数仍可能存在多个可接受的参数组合；参数间的强")
  #line-at(308.35pt, 567.55pt, "相关性、初值选择以及固定输入参数的不确定度也会")
  #line-at(308.35pt, 583.18pt, "影响反演结果。因此，复杂体系中的关键问题不再只")
  #line-at(308.35pt, 598.78pt, "是获得最优拟合值，而是判断哪些参数能够被实验数")
  #line-at(308.35pt, 614.38pt, "据有效约束，并给出相应的不确定范围。")
  #line-at(329.35pt, 629.98pt, "目前，误差传播和")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(416.11pt, 629.98pt, "Monte Carlo")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(469.734pt, 629.98pt, " 采样已用于热反")
  #line-at(308.35pt, 645.58pt, "射测量中的参数不确定度评估，贝叶斯反演也为多参")
  #line-at(308.35pt, 661.18pt, "数问题提供了更完整的概率描述。贝叶斯方法可将先")
  #line-at(308.35pt, 676.78pt, "验信息、实验数据和测量噪声统一到概率框架中，通")
  #line-at(308.35pt, 692.38pt, "过后验分布给出参数的可能取值范围及其相关性")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(534.1pt, 688.9pt, "[91]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(545.88pt, 692.38pt, "。")
  #line-at(308.35pt, 707.98pt, "相比单一最优值及标准差，这类方法能够更直接地反")
  #line-at(308.35pt, 723.58pt, "映参数是否受到数据约束，以及不同参数之间是否存")
  #line-at(308.35pt, 739.18pt, "在较强耦合。热反射参数反演也正由单一最优值估计")
  #line-at(308.35pt, 754.8pt, "逐步向概率化参数推断拓展。")
  #line-at(329.35pt, 770.4pt, "参数不确定度并不能完全代表测量结果的可信")
]

