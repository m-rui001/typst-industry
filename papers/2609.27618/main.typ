  #line-at(308.35pt, 146.3pt, "敏感性权重。对于多层结构，不同功能层或界面的参")
  #line-at(308.35pt, 161.9pt, "数敏感频区可能发生重叠，因此单纯扩大频率扫描范")
  #line-at(308.35pt, 177.5pt, "围并不必然实现多参数独立辨识，仍需结合敏感性分")
  #line-at(308.35pt, 193.1pt, "析确定有效频率窗口")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(403.03pt, 189.62pt, "[68]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(414.55pt, 193.1pt, "。")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 208.7pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(362.23pt, 208.7pt, "主要通过泵浦–探测延迟时间扫描获取")
  #line-at(308.35pt, 224.3pt, "皮秒至纳秒尺度的瞬态热演化信息；泵浦调制频率则")
  #line-at(308.35pt, 239.9pt, "影响脉冲间热积累和周期热扩散背景，因而可作为改")
  #line-at(308.35pt, 255.53pt, "变参数敏感性的实验控制量。通过在不同调制频率、")
  #line-at(308.35pt, 271.13pt, "光斑尺寸或延迟窗口下重复测量，可以构建多组互补")
  #line-at(308.35pt, 286.73pt, "的时域约束。其可用范围仍受到激光重复频率、机械")
  #line-at(308.35pt, 302.33pt, "延迟范围、热积累效应以及调制和探测带宽等条件限")
  #line-at(308.35pt, 317.93pt, "制。")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 333.53pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(352.27pt, 333.53pt, "进一步拓展了可利用的频率范围和周期内")
  #line-at(308.35pt, 349.13pt, "时间信息。通过方波调制和全周期温度波形采集，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 364.73pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.981pt, 364.73pt, " 不仅利用调制频率改变热扩散尺度，还同时保留")
  #line-at(308.35pt, 380.33pt, "不同加热与冷却时刻的热响应。在较宽频率范围内改")
  #line-at(308.35pt, 395.93pt, "变调制条件，可以使近表面区域、深层结构及整体热")
  #line-at(308.35pt, 411.55pt, "阻网络在不同程度上参与测量响应；周期内部的不同")
  #line-at(308.35pt, 427.15pt, "时序阶段又提供额外的参数敏感性差异。因此，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(528.46pt, 427.15pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 442.75pt, "能够在同一实验构型下利用多频率、多时间尺度热响")
  #line-at(308.35pt, 458.35pt, "应约束参数反演。但这种尺度扩展并不意味着不同频")
  #line-at(308.35pt, 473.95pt, "率或时间阶段与特定材料层之间存在严格的一一对")
  #line-at(308.35pt, 489.55pt, "应关系，实际有效敏感区间仍需结合样品结构和敏感")
  #line-at(308.35pt, 505.15pt, "性分析确定。")
  #line-at(329.35pt, 520.75pt, "与上述主要沿时间或频率方向调节热扩散尺度")
  #line-at(308.35pt, 536.35pt, "的方法不同，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(369.43pt, 536.35pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(396.147pt, 536.35pt, " 及空间扫描类方法进一步引入了")
  #line-at(308.35pt, 551.95pt, "横向空间尺度。通过协同选择调制频率、光斑尺寸及")
  #line-at(308.35pt, 567.55pt, "空间扫描范围，可以使横向热扩散尺度与泵浦")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(519.46pt, 567.55pt, "–")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(524.74pt, 567.55pt, "探测")
  #line-at(308.35pt, 583.18pt, "几何尺寸相匹配，从而增强测量信号对面内热输运的")
  #line-at(308.35pt, 598.78pt, "敏感性。当横向热扩散尺度远小于光斑尺寸时，空间")
  #line-at(308.35pt, 614.38pt, "响应更容易受到局部光斑分布和纵向热扩散的影响；")
  #line-at(308.35pt, 629.98pt, "当二者处于可比尺度时，横向温度场的展宽和衰减能")
  #line-at(308.35pt, 645.58pt, "够提供更明显的面内热输运信息。因此，空间域方法")
  #line-at(308.35pt, 661.18pt, "的主要特点并不是简单扩大热扩散长度，而是通过引")
  #line-at(308.35pt, 676.78pt, "入横向位置这一独立观测维度，使尺度分析由纵向热")
  #line-at(308.35pt, 692.38pt, "穿透进一步扩展到面内热扩散。")
  #line-at(329.35pt, 707.98pt, "总体而言，不同热反射技术对有效热扩散尺度的")
  #line-at(308.35pt, 723.58pt, "调控方式各有侧重：")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(402.07pt, 723.58pt, "SSTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(427.108pt, 723.58pt, " 利用准稳态热场；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(512.86pt, 723.58pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(532.744pt, 723.58pt, " 通")
  #line-at(308.35pt, 739.18pt, "过观测时间窗口选择瞬态扩散尺度；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(474.46pt, 739.18pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(501.282pt, 739.18pt, " 通过调制")
  #line-at(308.35pt, 754.8pt, "频率扫描改变周期热穿透深度；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.86pt, 754.8pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(480.284pt, 754.8pt, " 以延迟时间解")
  #line-at(308.35pt, 770.4pt, "析超快瞬态过程，并可借助调制频率和光斑尺寸改变")
]

