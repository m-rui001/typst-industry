  #line-at(293.93pt, 454.99pt, "界面热导")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(333.91pt, 454.99pt, ", ")
  #set text(font: "FangSong", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(342.55pt, 454.99pt, "光热技术，智能实验")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 495.91pt, "随着功能材料与高性能电子器件的快速发展，微")
  #line-at(49.56pt, 511.51pt, "纳尺度热输运行为的准确表征已成为揭示材料热输")
  #line-at(49.56pt, 527.11pt, "运机制、优化器件热管理及评估服役可靠性的重要基")
  #line-at(49.56pt, 542.71pt, "础")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(60.144pt, 539.23pt, "[1, 2]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(76.104pt, 542.71pt, "。")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.664pt, 542.71pt, "在材料层面，低维材料、各向异性晶体、聚")
  #line-at(49.56pt, 558.31pt, "合物薄膜、多层异质结构及热功能材料中的热输运行")
  #line-at(49.56pt, 573.91pt, "为通常呈现明显的尺度、界面与微结构依赖性。其中，")
  #line-at(49.56pt, 589.54pt, "热导率")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(81.264pt, 589.54pt, "(")
  #set text(font: "Cambria Math", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(84.624pt, 589.54pt, "𝑘")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.744pt, 589.54pt, ")")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(94.224pt, 589.54pt, "和界面热导")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(146.9pt, 589.54pt, "(")
  #set text(font: "Cambria Math", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(150.26pt, 589.54pt, "𝐺")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(157.34pt, 589.54pt, ")")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(160.82pt, 589.54pt, "等输运参数易受边界与界面")
  #line-at(49.56pt, 605.14pt, "散射、晶体取向及加工工艺等因素影响；体积热容")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(273.53pt, 605.14pt, "(")
  #set text(font: "Cambria Math", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(276.89pt, 605.14pt, "𝐶")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.61pt, 605.14pt, ")")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 620.74pt, "也可能随材料组成、相态和结晶度等发生变化。因此，")
  #line-at(49.56pt, 636.34pt, "传统宏观热物性参数往往难以直接反映微纳结构中")
  #line-at(49.56pt, 651.94pt, "的实际热响应")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(112.7pt, 648.46pt, "[3-5]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.5pt, 651.94pt, "。在器件层面，随着")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(219.17pt, 651.94pt, "5G")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(231.954pt, 651.94pt, " 通信和氮化")
  #line-at(49.56pt, 667.54pt, "镓")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(60.144pt, 667.54pt, "(GaN)")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(87.024pt, 667.54pt, "高电子迁移率晶体管")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(181.49pt, 667.54pt, "(HEMT)")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(218.21pt, 667.54pt, "等高功率、高频")
  #line-at(49.56pt, 683.14pt, "技术的发展，器件局部功率密度与热流密度不断升高，")
  #line-at(49.56pt, 698.74pt, "沟道热点、薄膜热阻及异质界面热阻已成为制约器件")
  #line-at(49.56pt, 714.34pt, "性能与寿命的重要因素")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(154.7pt, 710.86pt, "[6]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(162.74pt, 714.34pt, "。尤其当材料或器件的特征")
  #line-at(49.56pt, 729.94pt, "尺寸与声子平均自由程相当时，边界散射、界面热阻")
  #line-at(49.56pt, 745.56pt, "及各向异性热扩散等效应更加突出")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(207.77pt, 742.08pt, "[7, 8]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(223.73pt, 745.56pt, "，传统宏观测")
  #line-at(49.56pt, 761.16pt, "量方法与均匀介质假设面临局限，从而对微纳尺度热")
  #line-at(49.56pt, 776.76pt, "物性参数的准确测量提出了更高要求")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(217.85pt, 773.28pt, "[1, 9]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(232.85pt, 776.76pt, "。")
  #line-at(329.35pt, 495.91pt, "与宏观尺度测量相比，微纳尺度热物性参数的实")
  #line-at(308.35pt, 511.51pt, "验获取并非测量尺度的简单缩小，而是同时受到空间")
  #line-at(308.35pt, 527.11pt, "分辨率、时间分辨率及多参数耦合反演等因素的制约。")
  #line-at(308.35pt, 542.71pt, "首先，微纳材料与器件中的温升和热流分布往往具有")
  #line-at(308.35pt, 558.31pt, "显著的空间局域性，热点可集中于薄膜、异质界面、")
  #line-at(308.35pt, 573.91pt, "晶体管沟道或微区缺陷附近，因此，测量技术需要具")
  #line-at(308.35pt, 589.54pt, "备微米级乃至亚微米级空间分辨率，才能有效分辨目")
  #line-at(308.35pt, 605.14pt, "标区域的局部热响应。其次，声子弛豫、界面能量传")
  #line-at(308.35pt, 620.74pt, "递和薄膜瞬态热扩散等过程可跨越皮秒至毫秒的宽")
  #line-at(308.35pt, 636.34pt, "时间尺度，要求探测手段兼具足够的时间分辨率和动")
  #line-at(308.35pt, 651.94pt, "态响应范围。更为关键的是，实验信号通常由热导率、")
  #line-at(308.35pt, 667.54pt, "体积热容和界面热导等待测参数，以及薄膜厚度、光")
  #line-at(308.35pt, 683.14pt, "斑尺寸等结构与实验参数共同决定。不同参数之间的")
  #line-at(308.35pt, 698.74pt, "敏感性相关可能导致反演问题不适定，使实验噪声、")
  #line-at(308.35pt, 714.34pt, "模型简化及先验参数误差被显著放大，进而降低测量")
  #line-at(308.35pt, 729.94pt, "结果的准确性与可靠性")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(413.47pt, 726.46pt, "[10, 11]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(434.74pt, 729.94pt, "。因此，亟需发展兼具高")
  #line-at(308.35pt, 745.56pt, "时空分辨率、非接触探测能力和可靠参数反演方法的")
  #line-at(308.35pt, 761.16pt, "微纳尺度热物性测量技术，以满足复杂材料热输运研")
  #line-at(308.35pt, 776.76pt, "究和先进电子器件热设计的需求。")
]

