  #line-at(49.56pt, 512.95pt, "于薄膜面外热导率和界面热导，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.49pt, 512.95pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(220.914pt, 512.95pt, " 与")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(236.69pt, 512.95pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(263.512pt, 512.95pt, " 具有")
  #line-at(49.56pt, 528.55pt, "成熟应用基础；对于面内各向异性，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(215.69pt, 528.55pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(242.407pt, 528.55pt, " 及多种光")
  #line-at(49.56pt, 544.15pt, "斑偏移方法可提供直接空间约束；对于低热导或强耦")
  #line-at(308.35pt, 68.28pt, "合体系，可根据所需时间尺度和信息维度采用低频")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 83.9pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.23pt, 83.9pt, "、多工况")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(378.19pt, 83.9pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.67pt, 83.9pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(414.43pt, 83.9pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(431.98pt, 83.9pt, "、扩展瞬态测量或跨平台")
  #line-at(308.35pt, 99.5pt, "联合方案。无论采用哪种方法，测量可信度都依赖合")
  #line-at(308.35pt, 115.1pt, "理的热扩散模型、准确的结构参数、敏感性分析和不")
  #line-at(308.35pt, 130.7pt, "确定度评估，因此不宜将某一方法简单视为复杂参数")
  #line-at(308.35pt, 146.3pt, "反演的通用最优解。")
  #line-at(329.35pt, 161.9pt, "未来热反射技术的发展可概括为四个相互关联")
  #line-at(308.35pt, 177.5pt, "的方向。第一，继续拓展时间和空间分辨率，以研究")
  #line-at(308.35pt, 193.1pt, "超快热弛豫、准弹道声子输运和局部微纳结构中的热")
  #line-at(308.35pt, 208.7pt, "扩散行为。第二，加强与电学偏置、力学加载、近场")
  #line-at(308.35pt, 224.3pt, "光学和器件原位测试的结合，使热反射测量更贴近真")
  #line-at(308.35pt, 239.9pt, "实工作状态。第三，数据分析将从单一最优参数拟合")
  #line-at(308.35pt, 255.53pt, "进一步转向包含敏感性分析、全局可辨识性评估、不")
  #line-at(308.35pt, 271.13pt, "确定度量化和物理约束的可信反演框架。第四，人机")
  #line-at(308.35pt, 286.73pt, "交互方式有望由源代码和专用软件进一步发展为自")
  #line-at(308.35pt, 302.33pt, "然语言驱动的智能体接口，由")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(442.9pt, 302.33pt, "AI")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(454.096pt, 302.33pt, " 负责理解实验意图、")
  #line-at(308.35pt, 317.93pt, "编排分析流程和调用工具，而关键数值计算和高风险")
  #line-at(308.35pt, 333.53pt, "仪器动作仍由经过验证的确定性程序与明确的安全")
  #line-at(308.35pt, 349.13pt, "约束执行。在此基础上，敏感性和不确定度评估还可")
  #line-at(308.35pt, 364.73pt, "与数据采集形成闭环，推动热反射实验向可对话、可")
  #line-at(308.35pt, 380.33pt, "追溯和自适应的智能实验发展。")
  #line-at(329.35pt, 395.93pt, "总体而言，热反射表征技术已经成为微纳尺度热")
  #line-at(308.35pt, 411.55pt, "物性研究的重要工具。其核心优势不仅在于非接触、")
  #line-at(308.35pt, 427.15pt, "高时间分辨率和微区测量能力，也在于能够利用调制")
  #line-at(308.35pt, 442.75pt, "频率、延迟时间、光斑尺寸和空间位置等实验变量主")
  #line-at(308.35pt, 458.35pt, "动改变热扩散路径和参数敏感性。随着实验系统、标")
  #line-at(308.35pt, 473.95pt, "定方法、可信反演模型以及自然语言交互和自动化控")
  #line-at(308.35pt, 489.55pt, "制逐步融合，热反射测量有望从依赖少数专业人员操")
  #line-at(308.35pt, 505.15pt, "作的实验技术进一步发展为更加开放、可复现、可追")
  #line-at(308.35pt, 520.75pt, "溯和自适应的热计量平台，并在功能薄膜、异质界面、")
  #line-at(308.35pt, 536.35pt, "功率器件、先进封装和半导体工艺监测中发挥更重要")
  #line-at(308.35pt, 551.95pt, "的作用。")
  #set text(font: "SimSun", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
