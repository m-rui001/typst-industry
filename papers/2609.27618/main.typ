#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "DengXian", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(292.85pt, 803.64pt, "69 ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 68.28pt, "度。多数反演方法默认所采用的热扩散模型能够充分")
  #line-at(49.56pt, 83.9pt, "描述实际传热过程，但当实验尺度接近非扩散输运特")
  #line-at(49.56pt, 99.5pt, "征尺度，或体系中存在复杂界面和非平衡效应时，模")
  #line-at(49.56pt, 115.1pt, "型本身也可能引入系统偏差。此时，较小的拟合残差")
  #line-at(49.56pt, 130.7pt, "并不意味着模型误差可以忽略。对于复杂体系，不确")
  #line-at(49.56pt, 146.3pt, "定度分析还应区分参数不确定度与模型失配，并评估")
  #line-at(49.56pt, 161.9pt, "当前模型的适用范围，避免利用待测参数补偿模型本")
  #line-at(49.56pt, 177.5pt, "身的偏差。")
  #line-at(70.584pt, 193.1pt, "实验设计也应与不确定度分析结合。传统做法通")
  #line-at(49.56pt, 208.7pt, "常预先设定调制频率、延迟时间、光斑尺寸或空间偏")
  #line-at(49.56pt, 224.3pt, "移量，再对获得的数据进行统一拟合。对于参数耦合")
  #line-at(49.56pt, 239.9pt, "较强的体系，增加相似测量条件下的数据未必能够有")
  #line-at(49.56pt, 255.53pt, "效提高参数可辨识性。利用敏感性矩阵、参数相关性")
  #line-at(49.56pt, 271.13pt, "或")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(62.784pt, 271.13pt, "Fisher")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(89.11pt, 271.13pt, " 信息矩阵，可以在实验前评估不同测量条件")
  #line-at(49.56pt, 286.73pt, "对目标参数的约束能力")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(154.7pt, 283.25pt, "[92]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(166.22pt, 286.73pt, "；获得初步数据后，还可根")
  #line-at(49.56pt, 302.33pt, "据当前参数的不确定度进一步调整后续实验条件，使")
  #line-at(49.56pt, 317.93pt, "实验设计、数据采集、参数反演和不确定度更新形成")
  #line-at(49.56pt, 333.53pt, "闭环。相比单纯增加数据量，这种以信息增益为目标")
  #line-at(49.56pt, 349.13pt, "的实验策略更适合复杂多参数体系，也为机器学习辅")
  #line-at(49.56pt, 364.73pt, "助反演和自适应实验提供了物理基础。")
  #line-at(70.584pt, 380.33pt, "未来热反射数据分析的重点将更多集中于可信")
  #line-at(49.56pt, 395.93pt, "参数推断和实验条件的主动优化，而不仅是提高拟合")
  #line-at(49.56pt, 411.55pt, "速度或降低残差。将概率反演、模型可信度评估、快")
  #line-at(49.56pt, 427.15pt, "速代理模型与自适应实验设计相结合，可根据已有数")
  #line-at(49.56pt, 442.75pt, "据动态选择更有信息量的测量条件，在降低参数相关")
  #line-at(49.56pt, 458.35pt, "性和不确定度的同时提高实验效率。对于复杂材料和")
  #line-at(49.56pt, 473.95pt, "器件，这类方法有望推动热反射测量由离线参数拟合")
  #line-at(49.56pt, 489.55pt, "逐步发展为面向可信度和信息增益的闭环测量。")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 520.87pt, "5.2 ")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 520.87pt, "时空分辨率拓展中的尺度效应与模型边界")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 544.15pt, "热反射测量的有效时空分辨能力受到热穿透深")
  #line-at(49.56pt, 559.75pt, "度、声子平均自由程、光斑尺寸和金属传感层厚度等")
  #line-at(49.56pt, 575.38pt, "多重特征尺度的共同制约。调制频率、光斑尺寸和探")
  #line-at(49.56pt, 590.98pt, "测方式的改变不仅影响仪器分辨率，也会改变实验信")
  #line-at(49.56pt, 606.58pt, "号对应的主导热输运过程。因此，时空分辨率的进一")
  #line-at(49.56pt, 622.18pt, "步提升不能简单理解为向更高频率或更小光斑延伸，")
  #line-at(49.56pt, 637.78pt, "而应同时考虑信号来源、输运机制及热扩散模型的适")
  #line-at(49.56pt, 653.38pt, "用范围。")
  #line-at(70.584pt, 668.98pt, "在高频测量中，热穿透深度随调制频率升高而减")
  #line-at(49.56pt, 684.58pt, "小。当其降低至与")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(137.3pt, 684.58pt, "Al")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(151.46pt, 684.58pt, "或")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(165.5pt, 684.58pt, "Au")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(182.09pt, 684.58pt, "传感层厚度相当的尺度")
  #line-at(49.56pt, 700.18pt, "时，热量将更多局限于金属传感层及其邻近界面，测")
  #line-at(49.56pt, 715.78pt, "量信号对传感层热容和金属")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.53pt, 715.78pt, "/")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(180.53pt, 715.78pt, "样品界面热导的敏感性")
  #line-at(49.56pt, 731.38pt, "增强，而对待测材料本征热物性的敏感性可能下降")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(49.56pt, 743.52pt, "[94]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(61.104pt, 747pt, "。减小传感层厚度可以一定程度上缓解这一问题，")
  #line-at(49.56pt, 762.6pt, "但也会降低光吸收和热反射信号强度，并增加薄膜连")
  #line-at(49.56pt, 778.2pt, "续性、厚度和界面质量带来的不确定性。无传感层热")
  #line-at(308.35pt, 68.28pt, "反射技术则通过利用材料自身的光学或电子响应实")
  #line-at(308.35pt, 83.9pt, "现直接激励和探测")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(392.47pt, 80.42pt, "[95-98]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(413.23pt, 83.9pt, "，可避免金属传感层及其界面")
  #line-at(308.35pt, 99.5pt, "的附加影响，但对材料光学性质、表面状态和信号稳")
  #line-at(308.35pt, 115.1pt, "定性提出了更高要求。")
  #line-at(329.35pt, 130.7pt, "当热穿透深度或光斑尺寸接近主要载热声子的")
  #line-at(308.35pt, 146.3pt, "平均自由程时，经典扩散近似可能失效，热输运逐步")
  #line-at(308.35pt, 161.9pt, "进入准弹道甚至非扩散区间。在此条件下，实验获得")
  #line-at(308.35pt, 177.5pt, "的表观热导率可能随调制频率或光斑尺寸变化而发")
  #line-at(308.35pt, 193.1pt, "生系统性偏移")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(371.47pt, 189.62pt, "[99-101]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(395.71pt, 193.1pt, "。")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.27pt, 193.1pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(437.74pt, 193.1pt, "和")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.14pt, 193.1pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(482.86pt, 193.1pt, "已被用于分析")
  #line-at(308.35pt, 208.7pt, "声子平均自由程分布及重建累积热导贡献")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(497.62pt, 205.22pt, "[8, 102, 103]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(535.3pt, 208.7pt, "，")
  #line-at(308.35pt, 224.3pt, "但相关反演通常依赖灰体近似、单弛豫时间等模型假")
  #line-at(308.35pt, 239.9pt, "设。对于多层异质结构，界面处还同时存在模式失配、")
  #line-at(308.35pt, 255.53pt, "选择性透射和界面散射等过程，使体相声子谱与跨界")
  #line-at(308.35pt, 271.13pt, "面输运难以完全解耦")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(403.75pt, 267.65pt, "[104]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(418.78pt, 271.13pt, "。因此，进一步研究跨界面")
  #line-at(308.35pt, 286.73pt, "非平衡声子输运，需要将实验反演与非灰体")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 302.33pt, "Boltzmann")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(354.55pt, 302.33pt, " 输运模型以及第一性原理界面声子输运计")
  #line-at(308.35pt, 317.93pt, "算相结合")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(350.83pt, 314.45pt, "[105]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(365.83pt, 317.93pt, "，避免将复杂界面效应简单等效为体材")
  #line-at(308.35pt, 333.53pt, "料平均自由程的变化。")
  #line-at(329.35pt, 349.13pt, "低频端的限制则主要来自环境稳定性和信噪比。")
  #line-at(308.35pt, 364.73pt, "随着调制频率降低，单周期时间延长，环境温漂、激")
  #line-at(308.35pt, 380.33pt, "光功率波动、样品台热稳定性和低频噪声的影响逐渐")
  #line-at(308.35pt, 395.93pt, "增强。对于块体材料的低频或稳态绝对热导率测量，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 411.55pt, "3ω")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.27pt, 411.55pt, "法和稳态量热法等传统方法通常具有更好的稳定")
  #line-at(308.35pt, 427.15pt, "性")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(318.91pt, 423.67pt, "[106, 107]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(347.47pt, 427.15pt, "。因此，热反射技术在低频端更适合发挥其")
  #line-at(308.35pt, 442.75pt, "非接触、微区分辨和可调热扩散尺度的优势，与电学")
  #line-at(308.35pt, 458.35pt, "和量热方法形成互补，而非追求对所有频率区间的覆")
  #line-at(308.35pt, 473.95pt, "盖。")
  #line-at(329.35pt, 489.55pt, "空间分辨率的进一步提升则受到远场光学衍射")
  #line-at(308.35pt, 505.15pt, "极限的约束。近场光学方法为突破这一限制提供了可")
  #line-at(308.35pt, 520.75pt, "能")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(319.03pt, 517.27pt, "[108]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(334.03pt, 520.75pt, "，但当探针—样品间距进入近场范围后，局域")
  #line-at(308.35pt, 536.35pt, "电磁场、光子隧穿和局域态密度会显著影响能量沉积")
  #line-at(308.35pt, 551.95pt, "和探测信号")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(361.39pt, 548.47pt, "[109]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(376.39pt, 551.95pt, "。此时，热反射信号不再只由热扩散")
  #line-at(308.35pt, 567.55pt, "过程决定，而同时依赖探针形貌、探针—样品间距、")
  #line-at(308.35pt, 583.18pt, "材料介电函数及电磁边界条件。要从近场信号中可靠")
  #line-at(308.35pt, 598.78pt, "提取局部温升和热物性参数，需要建立电磁场与热输")
  #line-at(308.35pt, 614.38pt, "运相耦合的多物理场模型，并进一步评估探针扰动和")
  #line-at(308.35pt, 629.98pt, "局域光学响应对反演结果的影响。")
  #line-at(329.35pt, 645.58pt, "随着测量尺度继续缩小并逐步面向真实器件，样")
  #line-at(308.35pt, 661.18pt, "品几何本身也将成为限制模型适用性的关键因素。曲")
  #line-at(308.35pt, 676.78pt, "面结构、厚度非均匀薄膜、微纳器件和柔性电子等体")
  #line-at(308.35pt, 692.38pt, "系中的热流路径通常受到局部几何、材料分布和边界")
  #line-at(308.35pt, 707.98pt, "条件的共同控制，传统一维或轴对称多层模型难以完")
  #line-at(308.35pt, 723.58pt, "整描述其热响应。将有限元正演模型与参数反演相结")
  #line-at(308.35pt, 739.18pt, "合，可把实际几何、局部热源和边界条件直接纳入测")
  #line-at(308.35pt, 754.8pt, "量模型")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(340.27pt, 751.32pt, "[110]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(355.15pt, 754.8pt, "。这类数值反演框架有望把热反射技术从")
  #line-at(308.35pt, 770.4pt, "标准平面样品进一步拓展到复杂工程器件，并为高空")
]

