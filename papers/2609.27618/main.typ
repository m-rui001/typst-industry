  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(171.38pt, 637.78pt, "越大，说明实验信号对该")
  #line-at(49.56pt, 653.38pt, "参数的响应越明显，参数具有更高的潜在可辨识性；")
