  #line-at(49.56pt, 723.58pt, "力越弱，热扰动维持的时间越长。因此，瞬态温度衰")
  #line-at(49.56pt, 739.18pt, "减曲线能够为材料热扩散率及相关热物性参数提供")
  #line-at(49.56pt, 754.8pt, "直接的时域约束。")
  #line-at(329.35pt, 68.28pt, "如")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(339.91pt, 68.28pt, "图")
