  #line-at(474.46pt, 629.98pt, " (Fig. 7e). ")
  #line-at(70.584pt, 645.58pt, "The experimental results show that, in this case, a small set of offset directions and modulation-frequency ")
  #line-at(49.56pt, 661.18pt, "configurations with complementary sensitivities provides sufficient constraints for reconstructing the three-dimensional ")
  #line-at(49.56pt, 676.78pt, "conductivity tensor and jointly determining multiple tensor components in the experimental coordinate system. After ")
  #line-at(49.56pt, 692.38pt, "diagonalization, the principal thermal conductivities ")
