#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "DengXian", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(292.85pt, 803.64pt, "70 ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 68.28pt, "间分辨条件下的局部热物性表征提供更可靠的模型")
  #line-at(49.56pt, 83.9pt, "基础。")
  #line-at(70.584pt, 99.5pt, "总体而言，热反射技术的时空分辨率提升将越来")
  #line-at(49.56pt, 115.1pt, "越受到“仪器分辨率—输运尺度—模型有效性”三者")
  #line-at(49.56pt, 130.7pt, "之间匹配关系的制约。未来的发展重点不应只是追求")
  #line-at(49.56pt, 146.3pt, "更高频率或更小光斑，而是建立能够随尺度变化而切")
  #line-at(49.56pt, 161.9pt, "换或耦合的多尺度输运模型，并将传感层效应、非扩")
  #line-at(49.56pt, 177.5pt, "散输运、近场电磁耦合和复杂几何统一纳入参数反演")
  #line-at(49.56pt, 193.1pt, "框架。只有在分辨率提升与模型可信度同步推进的条")
  #line-at(49.56pt, 208.7pt, "件下，热反射测量才能进一步拓展到跨界面非平衡输")
  #line-at(49.56pt, 224.3pt, "运和真实微纳器件中的局域热传输问题。")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 255.65pt, "5.3 ")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 255.65pt, "器件工况下的多物理场测量与工程应用")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 278.93pt, "随着热反射测量对象由标准薄膜样品扩展至实")
  #line-at(49.56pt, 294.53pt, "际器件，实验条件也逐渐由静态表征转向真实工作状")
  #line-at(49.56pt, 310.13pt, "态下的原位动态测量。器件运行过程中通常同时存在")
  #line-at(49.56pt, 325.73pt, "电学激励、瞬态自热和结构形变等多种物理过程，不")
  #line-at(49.56pt, 341.33pt, "同场之间的耦合既会改变实际热输运行为，也可能对")
  #line-at(49.56pt, 356.93pt, "热反射信号产生附加影响。因此，面向实际器件的关")
  #line-at(49.56pt, 372.53pt, "键问题已不只是提高测量分辨率，而是如何在保持真")
  #line-at(49.56pt, 388.13pt, "实工况的同时，实现多物理场响应的有效区分与定量")
  #line-at(49.56pt, 403.73pt, "表征。")
  #line-at(70.584pt, 419.35pt, "在宽禁带半导体功率器件中，瞬态自热与载流子")
  #line-at(49.56pt, 434.95pt, "输运相互耦合，结温会随开关过程、电流分布和局部")
  #line-at(49.56pt, 450.55pt, "功耗动态变化。若测量过程中中断电学偏置，所得温")
  #line-at(49.56pt, 466.15pt, "度响应可能难以反映真实工作状态。近年来发展的")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 481.75pt, "on-the-fly ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(96.864pt, 481.75pt, "热反射技术通过同步电脉冲与光学探测脉")
  #line-at(49.56pt, 497.35pt, "冲，可在器件开关瞬态的特定时间窗口内获取原位结")
  #line-at(49.56pt, 512.95pt, "温演化")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(84.864pt, 509.47pt, "[111]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(100.58pt, 512.95pt, "。进一步地，热反射信号还可能包含")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 528.55pt, "Seebeck ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(89.904pt, 528.55pt, "效应等电输运过程引入的电致调制分量，通")
  #line-at(49.56pt, 544.15pt, "过区分光致热反射与电致热反射信号，有望同时获得")
  #line-at(49.56pt, 559.75pt, "温度场和电流密度分布信息")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(176.78pt, 556.27pt, "[112]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(191.69pt, 559.75pt, "。因此，热反射技术")
  #line-at(49.56pt, 575.38pt, "正在由单一温度测量向电–热耦合输运表征拓展，而")
  #line-at(49.56pt, 590.98pt, "不同物理机制对光学信号贡献的分离仍是需要解决")
  #line-at(49.56pt, 606.58pt, "的重要问题。")
  #line-at(70.584pt, 622.18pt, "在柔性电子、聚合物薄膜和先进封装结构中，热")
  #line-at(49.56pt, 637.78pt, "输运还常与力学响应耦合。热循环、机械弯折或外加")
  #line-at(49.56pt, 653.38pt, "应变会改变界面接触状态和局部结构，进而影响界面")
  #line-at(49.56pt, 668.98pt, "热导和面内热扩散；与此同时，热膨胀和热弹性形变")
  #line-at(49.56pt, 684.58pt, "也可能对光学信号产生干扰。光热膨胀法可利用表面")
  #line-at(49.56pt, 700.18pt, "位移或曲率变化反演热导率、热膨胀系数等参数")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(272.21pt, 696.7pt, "[113-")
  #line-at(49.56pt, 712.3pt, "115]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(62.064pt, 715.78pt, "。未来可进一步将热反射测温、光热形变测量与原")
  #line-at(49.56pt, 731.38pt, "位力学加载结合，在可控应变或热循环条件下同步分")
  #line-at(49.56pt, 747pt, "析温度、形变及界面状态变化，为柔性器件和先进封")
  #line-at(49.56pt, 762.6pt, "装中的热失效研究提供多物理场实验依据。")
  #line-at(70.584pt, 778.2pt, "从工程应用角度看，热反射技术进一步走向晶圆")
  #line-at(308.35pt, 68.28pt, "级扫描、高通量筛查和在线计量，还需要解决采样效")
  #line-at(308.35pt, 83.9pt, "率、工艺兼容性、快速反演和测量可靠性等问题。传")
  #line-at(308.35pt, 99.5pt, "统")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(318.91pt, 99.5pt, " TDTR ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(356.83pt, 99.5pt, "依赖机械延迟线扫描，异步光学采样和单")
  #line-at(308.35pt, 115.1pt, "发瞬态记录可减少机械扫描；对于")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(469.42pt, 115.1pt, " FDTR ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(506.74pt, 115.1pt, "和")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(517.54pt, 115.1pt, " SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(540.6pt, 115.1pt, "，")
  #line-at(308.35pt, 130.7pt, "多频并行激励和数字锁相检测可提高数据采集效率。")
  #line-at(308.35pt, 146.3pt, "另一方面，金属传感层在半导体产线和成品器件检测")
  #line-at(308.35pt, 161.9pt, "中可能带来附加界面及工艺兼容性问题，因此基于材")
  #line-at(308.35pt, 177.5pt, "料本征光学响应的无传感层测量具有重要潜力，但仍")
  #line-at(308.35pt, 193.1pt, "需解决表面状态、光学非均匀性及热反射系数标定等")
  #line-at(308.35pt, 208.7pt, "问题。与此同时，物理信息神经网络、代理模型和预")
  #line-at(308.35pt, 224.3pt, "训练数据库等方法有望加快复杂结构的参数反演，但")
  #line-at(308.35pt, 239.9pt, "仍需结合物理约束、不确定度评估和标准样品验证，")
  #line-at(308.35pt, 255.53pt, "以保证结果的可靠性。")
  #line-at(329.35pt, 271.13pt, "总体而言，面向实际器件的热反射测量正在经历")
  #line-at(308.35pt, 286.73pt, "由标准样品向真实工况、由单一热场向多物理场、由")
  #line-at(308.35pt, 302.33pt, "串行实验室测量向高通量工程表征的转变。未来发展")
  #line-at(308.35pt, 317.93pt, "的重点不仅在于提高时空分辨率，更在于实现真实工")
  #line-at(308.35pt, 333.53pt, "况下多物理场信号的可分离定量测量，并同步提升采")
  #line-at(308.35pt, 349.13pt, "样效率、工艺兼容性和参数反演可信度，从而推动热")
  #line-at(308.35pt, 364.73pt, "反射技术进一步服务于功率器件、柔性电子、先进封")
  #line-at(308.35pt, 380.33pt, "装及半导体制造过程中的在线热计量。")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(308.35pt, 411.67pt, "5.4 ")
  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 411.67pt, "自然语言驱动的数据分析与智能实验")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 434.95pt, "除测量分辨率和反演算法外，热反射技术的进一")
  #line-at(308.35pt, 450.55pt, "步推广还受到分析流程复杂和隐性专业知识依赖的")
  #line-at(308.35pt, 466.15pt, "限制。")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(336.07pt, 466.15pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(363.55pt, 466.15pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(370.27pt, 466.15pt, "FDTR ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(402.31pt, 466.15pt, "和")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(412.87pt, 466.15pt, " SPS ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(440.86pt, 466.15pt, "等方法通常涉及数据整")
  #line-at(308.35pt, 481.75pt, "理、样品层结构定义、参数设置、拟合区间选择、敏")
  #line-at(308.35pt, 497.35pt, "感性分析及不确定度传播等多个步骤。即使已有成熟")
  #line-at(308.35pt, 512.95pt, "代码或专用软件，复杂多层结构的分析仍较依赖使用")
  #line-at(308.35pt, 528.55pt, "者经验，不利于流程标准化、高通量处理和跨学科应")
  #line-at(308.35pt, 544.15pt, "用。")
  #line-at(329.35pt, 559.75pt, "基于")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(350.95pt, 559.75pt, " LLM ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(383.95pt, 559.75pt, "的")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(394.75pt, 559.75pt, " AI ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(416.59pt, 559.75pt, "智能体为这一问题提供了不")
  #line-at(308.35pt, 575.38pt, "同于传统机器学习反演的技术路径。已有研究表明，")
  #line-at(308.35pt, 590.98pt, "工具增强型")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(362.35pt, 590.98pt, " LLM ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(395.23pt, 590.98pt, "已开始应用于科学用户设施、自")
  #line-at(308.35pt, 606.58pt, "动化实验和复杂仪器操作")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(426.94pt, 603.1pt, "[116-119]")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(454.3pt, 606.58pt, "。对于热反射测量，")
  #line-at(308.35pt, 622.18pt, "更合理的定位并不是由")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(416.11pt, 622.18pt, " LLM ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.02pt, 622.18pt, "直接生成热物性数值，")
  #line-at(308.35pt, 637.78pt, "而是由其承担任务理解、流程编排和工具调用，再由")
  #line-at(308.35pt, 653.38pt, "经过验证的热扩散模型、拟合程序和不确定度模块完")
  #line-at(308.35pt, 668.98pt, "成具体计算。")
  #line-at(329.35pt, 684.58pt, "据此，可构建“自然语言交互层—")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.3pt, 684.58pt, "AI ")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(503.74pt, 684.58pt, "智能体编")
  #line-at(308.35pt, 700.18pt, "排层")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.47pt, 700.18pt, "—")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(340.15pt, 700.18pt, "确定性物理计算层")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(424.78pt, 700.18pt, "”")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(429.46pt, 700.18pt, "的分层架构。实验人员通")
  #line-at(308.35pt, 715.78pt, "过自然语言描述样品结构、已知参数、数据位置和分")
  #line-at(308.35pt, 731.38pt, "析目标，智能体将其转换为结构化配置，并依次调用")
  #line-at(308.35pt, 747pt, "数据预处理、模型计算、敏感性分析、参数拟合和不")
  #line-at(308.35pt, 762.6pt, "确定度评估模块，同时保留完整的配置与执行记录。")
  #line-at(308.35pt, 778.2pt, "由此，热反射数据分析可由依赖专业软件操作逐步转")
]

