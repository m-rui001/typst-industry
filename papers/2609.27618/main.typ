  #line-at(329.35pt, 349.13pt, "总体而言，")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(379.87pt, 349.13pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(406.692pt, 349.13pt, " 及相关空间扫描方法通过引入")
  #line-at(308.35pt, 364.73pt, "横向位置这一独立观测变量，将热反射测量由时间和")
  #line-at(308.35pt, 380.33pt, "频率维度进一步拓展至空间维度，为面内热导率及热")
  #line-at(308.35pt, 395.93pt, "输运各向异性的辨识提供了重要手段。然而，空间响")
  #line-at(308.35pt, 411.55pt, "应仍受到面外热扩散、界面热导、衬底热物性及光斑")
  #line-at(308.35pt, 427.15pt, "几何等因素的共同影响，增加空间维度并不意味着参")
  #line-at(308.35pt, 442.75pt, "数耦合可以被完全消除。对于复杂多层结构和多参数")
  #line-at(308.35pt, 458.35pt, "反演问题，仍需结合敏感性分析及先验参数约束，并")
  #line-at(308.35pt, 473.95pt, "与")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(321.55pt, 473.95pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.91pt, 473.95pt, "、")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
