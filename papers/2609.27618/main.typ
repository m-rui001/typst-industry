  #set text(font: "SimSun", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 536.47pt, "小结")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.35pt, 559.75pt, "综上，各类热反射测量方法均建立在相同的热反")
  #line-at(308.35pt, 575.38pt, "射效应与热扩散理论框架之上，其主要差异体现在热")
  #line-at(308.35pt, 590.98pt, "激励方式、主要观测变量和信号获取形式。")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(507.58pt, 590.98pt, "SSTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(532.744pt, 590.98pt, " 主")
  #line-at(308.35pt, 606.58pt, "要利用准稳态温升；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(397.63pt, 606.58pt, "TTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(417.514pt, 606.58pt, " 记录单脉冲加热后的瞬态温")
  #line-at(308.35pt, 622.18pt, "度衰减；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.31pt, 622.18pt, "FDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(375.154pt, 622.18pt, " 以调制频率为主要扫描变量获取幅值")
  #line-at(308.35pt, 637.78pt, "和相位响应；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(371.35pt, 637.78pt, "TDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(404.11pt, 637.78pt, "以泵浦")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(435.58pt, 637.78pt, "–")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(440.86pt, 637.78pt, "探测延迟时间为主要扫")
  #line-at(308.35pt, 653.38pt, "描变量，调制频率则作为锁相检测和敏感性调控的重")
  #line-at(308.35pt, 668.98pt, "要实验参数；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(368.23pt, 668.98pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(385.728pt, 668.98pt, " 记录周期方波激励下的完整温度波")
  #line-at(308.35pt, 684.58pt, "形，并可结合不同调制频率；")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(442.9pt, 684.58pt, "SDTR")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(469.722pt, 684.58pt, " 及相关空间扫描")
  #line-at(308.35pt, 700.18pt, "方法则以横向空间位置为主要观测变量。")
  #line-at(329.35pt, 715.78pt, "由此可见，不同热反射技术并非彼此替代的线性")
  #line-at(308.35pt, 731.38pt, "演进关系，而是围绕准稳态、瞬态时间、调制频率、")
  #line-at(308.35pt, 747pt, "超快延迟时间、周期波形和空间位置等不同观测方式")
  #line-at(308.35pt, 762.6pt, "形成的互补测量范式。这种分类强调“主要观测变量”，")
  #line-at(308.35pt, 778.2pt, "同时允许调制频率、光斑尺寸等实验控制参数跨方法")
]

