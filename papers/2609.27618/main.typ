  #line-at(49.56pt, 754.8pt, "analysis—as in BO-FDTR [68, 69] and BO-SPS [43]")
  #line-at(279.41pt, 754.8pt, "—the approach is more appropriately regarded as a frequency-")
  #line-at(49.56pt, 770.4pt, "domain or full-period waveform method incorporating a beam-offset geometry. The defining criterion is therefore not ")
]

