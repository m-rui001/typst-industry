  #line-at(308.35pt, 193.1pt, "演。")
  #line-at(329.35pt, 208.7pt, "尽管")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(355.39pt, 208.7pt, "SPS")
  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(377.83pt, 208.7pt, "能够在相对统一的实验构型中同时拓")
  #line-at(308.35pt, 224.3pt, "展热扩散尺度和时序信息维度，但其测量能力同样受")
  #line-at(308.35pt, 239.9pt, "到实验条件和参数耦合的限制。低频测量容易受到环")
  #line-at(308.35pt, 255.53pt, "境温漂、激光长期功率漂移及低频噪声影响；在高频")
  #line-at(308.35pt, 271.13pt, "条件下，调制器的上升和下降时间、探测器及采集系")
  #line-at(308.35pt, 286.73pt, "统带宽会影响方波及温度响应波形的保真度，实际热")
