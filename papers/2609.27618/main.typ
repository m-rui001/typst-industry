  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(49.56pt, 614.5pt, "4.3 Thermoreflectance Measurement of the Three-Dimensional Anisotropic Thermal-Conductivity Tensor")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 637.78pt, "For an anisotropic material, thermal conductivity is no longer a scalar but a second-rank tensor. In many layered ")
  #line-at(49.56pt, 653.38pt, "materials and oriented films, the dominant anisotropy appears as a difference between in-plane and cross-plane thermal ")
  #line-at(49.56pt, 668.98pt, "conductivity and can therefore often be approximated using ")
  #set text(font: "Cambria Math", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(305.59pt, 668.98pt, "𝑘")
  #set text(font: "Cambria Math", size: 7.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(311.47pt, 671.14pt, "𝑟")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(316.03pt, 668.98pt, " and ")
