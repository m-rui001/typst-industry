  #set text(font: "SimSun", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(362.47pt, 450.55pt, "。该金属层兼具光热转换与温度探测功")
  #line-at(308.35pt, 466.15pt, "能：一方面吸收泵浦光并在样品表面形成可控的局部")
  #line-at(308.35pt, 481.75pt, "热源，另一方面利用自身较强的热反射响应将温度变")
  #line-at(308.35pt, 497.35pt, "化转化为可测的光学信号。同时，光学性质相对明确")
  #line-at(308.35pt, 512.95pt, "的金属层有助于降低样品本征光学响应对测量信号")
