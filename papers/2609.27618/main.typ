  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.584pt, 668.98pt, "The fundamental physical basis of thermoreflectance measurement is the temperature dependence of the optical ")
  #line-at(49.56pt, 684.58pt, "reflectivity of a material surface. From an optical perspective, a temperature change modifies the complex refractive ")
  #line-at(49.56pt, 700.18pt, "index and, consequently, the optical response of the material, thereby changing its surface reflectivity. By expanding ")
  #line-at(49.56pt, 715.78pt, "the reflectivity (")
