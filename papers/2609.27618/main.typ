#original-page(595.32pt, 841.92pt, (image("graphics/page-25.png", width: 17.5pt), 399pt, 729.5pt))[
  #set text(font: "DengXian", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
