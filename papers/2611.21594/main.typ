  #line-at(163.484pt, 638.157pt, "dropout rate,")
  #line-at(218.978pt, 638.157pt, "and learning rate are selected with Keras Tuner,")
  #line-at(418.831pt, 638.157pt, "and training uses the")
  #set text(font: "Times New Roman", size: 9.963pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.641pt, 649.066pt, "Adam optimizer with an exponentially decaying learning rate.")
  #set text(font: "Times New Roman", size: 9.862pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108pt, 665.455pt, "In the second stage, an inverse network maps a measured I–V response to the seven model parameters.")
