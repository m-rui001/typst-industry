  #line-at(108pt, 605.43pt, "network.")
  #line-at(147.103pt, 605.43pt, "In the first stage, the forward surrogate is trained by supervised regression to map seven")
  #set text(font: "Times New Roman", size: 10.012pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108pt, 616.339pt, "SPICE model parameters to a 370-dimensional I–V response.")
