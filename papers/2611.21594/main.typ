  #set text(font: "Times New Roman", size: 9.862pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108pt, 687.273pt, "frozen forward surrogate, and the reconstructed I–V curve is compared with the input curve using the")
