  #line-at(108pt, 698.182pt, "mean squared error in log-current space.")
  #line-at(273.39pt, 698.182pt, "Gradients through the frozen surrogate update the inverse")
  #set text(font: "Times New Roman", size: 9.862pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108pt, 709.091pt, "network while the forward model stays fixed.")
  #line-at(287.577pt, 709.091pt, "The forward and inverse networks use the same general")
