  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(36pt, 311.28pt, "2.2. Description of the hydraulic control of the water supply in Noja ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(57.24pt, 336.6pt, "The water supply system in the town of Noja operates entirely by gravity from a distribution tank. The ")
  #line-at(36pt, 361.92pt, "total length of the water distribution network (WDN) is around 50 kilometres. The main pipe materials are ")
  #line-at(36pt, 387.24pt, "predominantly ductile iron (DI) and polyethylene (PE), accounting for approximately 90% of the total length. ")
  #line-at(36pt, 412.56pt, "Asbestos (AB) and polyvinyl chloride (PVC) pipes make up the remaining 10%. Larger sizes, from DN150 to ")
  #line-at(36pt, 437.88pt, "DN300, are constructed of metallic materials, while plastic materials are used for sizes below DN150. ")
  #line-at(61.56pt, 463.08pt, "Figure 4 shows the variations in flow (m")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
