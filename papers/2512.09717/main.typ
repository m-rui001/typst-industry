  #line-at(36pt, 654pt, "the non-stationarity of the values considered. Whether or not the null hypothesis is rejected depends on the ")
  #line-at(36pt, 679.2pt, "significance of the result obtained in the test. If the ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
