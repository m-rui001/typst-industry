#original-page(595.32pt, 841.92pt, (image("graphics/page-10.png", width: 470.5pt), 62.5pt, 79.5pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(292.68pt, 808.32pt, "10 ")
