  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#c00000"))
  #line-at(108.355pt, 507.967pt, "Fig.")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(127.07pt, 507.967pt, "5(a)")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(143.265pt, 507.967pt, " shows the optimized device structure, ")
  #line-at(46.782pt, 519.372pt, "namely the MIFHIHFIS structure. (ii) Reducing the charge ")
  #line-at(46.782pt, 530.895pt, "density at the GBL/FE interface. Therefore, we reduce the erase ")
  #line-at(46.782pt, 542.419pt, "pulse amplitude to decrease the charge density at the GBL/FE ")
  #line-at(46.772pt, 553.943pt, "interface. Using these methods, the RL can be reduced to 12% ")
  #line-at(46.772pt, 565.466pt, "and 0.2%, respectively, as shown in ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#c00000"))
  #line-at(192.694pt, 565.466pt, "Fig.")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(211.052pt, 565.466pt, "5(b)")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(227.735pt, 565.466pt, ". ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#c00000"))
  #line-at(56.852pt, 576.871pt, "Fig.")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(78.564pt, 576.871pt, "6")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(83.604pt, 576.871pt, " shows the benchmark of our work. Our device ")
  #line-at(46.762pt, 588.394pt, "demonstrates the ability to achieve both high MW and good ")
  #line-at(46.762pt, 599.918pt, "retention characteristics simultaneously. ")
  #set text(font: "Arial", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0070c0"))
  #line-at(135.566pt, 625.475pt, "IV. C")
  #set text(font: "Arial", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#0070c0"))
  #line-at(162.24pt, 625.44pt, "ONCLUSION")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.884pt, 640.918pt, "This work investigates the physical mechanism behind the ")
  #line-at(46.805pt, 652.442pt, "retention loss of the MIFIFIS-FeFET. This is attributed to the ")
  #line-at(46.795pt, 663.846pt, "direction of the electric field pointing towards the metal gate ")
  #line-at(46.795pt, 675.37pt, "across the TDL at Vg=0 V, which reduces the potential barrier ")
  #line-at(46.795pt, 686.893pt, "contributed by the ferroelectric near the silicon substrate, ")
  #line-at(46.795pt, 698.417pt, "resulting in a significant RL. By adopting the following ")
  #line-at(46.785pt, 709.941pt, "strategies: (i) inserting a CTL on both sides of the TDL and (ii) ")
  #line-at(46.775pt, 721.464pt, "reducing the erase pulse amplitude, RL can be reduced to 12% ")
  #line-at(46.765pt, 732.869pt, "and 0.2%, respectively. Our work contributes to a deeper ")
  #line-at(313.165pt, 199.829pt, "understanding of the physical mechanism behind the RL in ")
  #line-at(313.165pt, 211.353pt, "FeFETs with the MIFIFIS gate structure. ")
  #set text(font: "Arial", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
