  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.2pt, 393.36pt, "nonvolatile memory with low write voltage, high switching ")
  #line-at(313.2pt, 405.481pt, "speed, CMOS compatibility, and excellent scalability ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(537.838pt, 405.481pt, "[2-17]")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(562.788pt, 405.481pt, ". ")
  #line-at(313.19pt, 417.483pt, "For FeFETs with the MFIS gate structure, the large amount of ")
  #line-at(313.2pt, 429.604pt, "charge injected from the silicon channel shields the ")
  #line-at(313.22pt, 441.606pt, "spontaneous polarization of the ferroelectric ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(509.173pt, 441.606pt, "[18-21]")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(539.162pt, 441.606pt, ". This ")
  #line-at(313.2pt, 453.728pt, "results in a narrow memory window (MW), and the MW is ")
  #line-at(313.21pt, 465.849pt, "generally limited to less than 2 V ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(465.369pt, 465.849pt, "[22-25]")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(495.358pt, 465.849pt, ", which severely ")
  #line-at(313.2pt, 477.851pt, "restricts its application in multi-bit memory. ")
  #line-at(323.28pt, 489.972pt, "Recently, a Metal-Gate Blocking Layer (GBL)-Ferroelectric ")
  #line-at(313.18pt, 501.496pt, "-Tunnel ")
  #line-at(358.418pt, 501.496pt, "Dielectric ")
  #line-at(411.347pt, 501.496pt, "Layer ")
  #line-at(448.068pt, 501.496pt, "(TDL)-Ferroelectric-Channel ")
  #line-at(313.17pt, 512.9pt, "Insulator (Ch.IL)-Si (MIFIFIS) structure has been proposed to ")
  #line-at(313.17pt, 524.424pt, "achieve a larger MW ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(410.728pt, 524.424pt, "[26-28]")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(440.718pt, 524.424pt, ". Unfortunately, the retention ")
  #line-at(313.15pt, 535.947pt, "characteristics of the MIFIFIS gate structure exhibit a ")
  #line-at(313.16pt, 547.471pt, "significant degradation. The retention loss (RL) exceeds 25%, ")
  #line-at(313.15pt, 558.995pt, "which limits its application in Fe-NAND ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(484.741pt, 558.995pt, "[29, 30]")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(517.38pt, 558.995pt, ". Therefore, ")
  #line-at(313.14pt, 570.518pt, "we conducted a detailed study on the physical mechanism ")
  #line-at(313.14pt, 581.923pt, "behind the RL in the MIFIFIS gate structure. This mechanism is ")
  #line-at(313.15pt, 593.446pt, "attributed to the direction of the electric field across TDL ")
  #line-at(313.15pt, 604.97pt, "pointing towards the silicon substrate, which reduces the ")
  #line-at(313.14pt, 616.494pt, "potential barrier provided by the ferroelectric near the silicon ")
  #line-at(313.14pt, 628.017pt, "substrate. ")
  #line-at(323.28pt, 639.36pt, "In addition, to reverse the electric field direction across the ")
  #line-at(313.2pt, 650.884pt, "TDL (specifically, directing it toward the silicon substrate), we ")
  #line-at(313.2pt, 662.407pt, "propose the following strategies: (i) inserting a charge-trapping ")
  #line-at(313.2pt, 673.931pt, "layer (CTL) on both sides of the TDL to increase the charge ")
  #line-at(313.2pt, 685.455pt, "density at the TDL ends, or (ii) reducing the operating voltage ")
  #line-at(313.2pt, 696.979pt, "amplitude to decrease the charge density at the GBL/FE ")
  #line-at(313.2pt, 708.383pt, "interface. Using these methods, the RL can be reduced to 12% ")
  #line-at(313.2pt, 719.906pt, "and 0.2%, respectively. This study provides guidance for ")
  #line-at(313.18pt, 731.43pt, "improving FeFET reliability through gate stack engineering ")
  #set text(font: "Arial", size: 24pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(54pt, 84.6pt, "Investigation of the Physical Mechanism behind ")
  #line-at(68.52pt, 112.2pt, "Retention Loss in FeFETs with MIFIFIS Gate ")
  #line-at(257.28pt, 139.8pt, "Structure ")
