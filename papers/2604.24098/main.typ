  #line-at(406.481pt, 653.5pt, "curve, ")
  #line-at(445.706pt, 653.5pt, "photoshunts ")
  #line-at(511.074pt, 653.5pt, "are ")
  #line-at(70.824pt, 678.82pt, "phenomenologically indistinguishable from a dark shunt, which implies that we can use the same ")
  #line-at(70.824pt, 704.02pt, "framework created to study the effect of a dark shunt on the ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
