  #line-at(70.824pt, 341.93pt, "an entirely different magnitude than in the dark (shown in Figure S7c). These apparent photoshunts, ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 367.25pt, "𝑅")
