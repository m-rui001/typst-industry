  #line-at(107.42pt, 367.25pt, ", are recombination currents that appear linear with the external voltage and therefore resemble ")
  #line-at(70.824pt, 394.49pt, "a shunt. The linearity with external voltage seems to be entirely at odds with the fact that recombination ")
  #line-at(70.824pt, 419.71pt, "currents are generally exponentially dependent on quasi-Fermi level splitting. However, as shown in ")
  #line-at(70.824pt, 445.03pt, "ref")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
