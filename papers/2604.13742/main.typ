  #line-at(197.109pt, 103.44pt, ", even the thermal conductivity of the liquid is treated as a known ")
  #line-at(70.8pt, 124.08pt, "parameter to ensure accurate determination of ITC. As a result, the uncertainties of these ")
  #line-at(70.8pt, 144.72pt, "assumed parameters are fully propagated into the ITC calculation, inevitably leading to larger ")
  #line-at(70.8pt, 165.36pt, "errors in the extracted ITC values. Although our previously developed square-pulsed source ")
  #line-at(70.8pt, 186.24pt, "(SPS) method")
