  #line-at(70.8pt, 206.4pt, "liquid side, enhancing measurement sensitivity to the thermal properties of the liquid film.  ")
  #line-at(82.8pt, 227.04pt, "To minimize uncertainties associated with the Al layer, glass substrate, and the laser spot ")
