#original-page(612pt, 792pt, (image("graphics/page-03.png", width: 382.5pt), 118pt, 182pt))[
  #set text(font: "Times New Roman", size: 10.359pt, weight: "regular", style: "italic", fill: rgb("#0f4761"))
  #line-at(282.24pt, 86.64pt, "3.")
  #line-at(299.16pt, 86.64pt, "Results ")
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.2pt, 112.08pt, "Fig. 2 show topography micrographs obtained by the SEM analysis of the prepared samples. As can be seen, ")
  #line-at(79.2pt, 126.48pt, "the surface structure of each separators remains visible even after coating, indicating that the deposited film ")
  #line-at(79.2pt, 140.76pt, "may not fully block or close the physical pores within the fiber-like lattice of the PE material. Additionally, ")
  #line-at(79.2pt, 154.92pt, "the nanofilms appear homogeneous, with no noticeable micro-agglomeration or clustering of nanoparticles on ")
  #line-at(79.2pt, 169.32pt, "the surface.  ")
  #set text(font: "Times New Roman", size: 10.359pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(79.2pt, 504.12pt, "Figure 2 ")
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(118.92pt, 504.12pt, "SEM micrograph of the PE separator with LISICON coatings; a) shows the pristine surface of PE ")
  #line-at(79.2pt, 518.4pt, "separator, b) the surface coated with LAGP thin film, c) shows the combination of LAGP and Co bi-layer on ")
  #line-at(79.2pt, 532.68pt, "the surfaces d) shows the bi-layer of LAGP with Ni.                                                                                                                ")
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.2pt, 575.52pt, "Staircase voltammetry (SV) was performed on both pristine and modified PE separators to evaluate the ")
  #line-at(79.2pt, 589.68pt, "electrochemical behavior and performance improvements induced by the thin film coatings. The plot (Fig. 3) ")
  #line-at(79.2pt, 604.08pt, "represents a set of cycle curves, each representing the average of five cycles for each sample, providing a ")
  #line-at(79.2pt, 618.24pt, "reliable measure of stability and performance. ")
  #line-at(79.2pt, 638.28pt, "Stability and Performance: The stability over time was generally good for all the coated samples, except for ")
  #line-at(79.2pt, 652.44pt, "the Ni-deposited PE separator, which exhibited significant instability. In the plot is shown only the first cycle ")
  #line-at(79.2pt, 666.72pt, "for this sample due to its rapid degradation after initial cycling. This suggests that the Ni coating may not offer ")
  #line-at(79.2pt, 681pt, "long-term electrochemical stability, in contrast to the LAGP-based coatings. ")
  #line-at(79.2pt, 700.92pt, "Effect of LAGP and Co Coatings: The introduction of LAGP significantly improved the electrochemical ")
  #line-at(79.2pt, 715.2pt, "performance of the PE separator. More importantly, the combination of LAGP with Co further reduced the ")
  #line-at(79.2pt, 729.48pt, "slope of the cyclic voltammogram, indicating a decrease in the reaction rate at the electrodes. This is ")
]

