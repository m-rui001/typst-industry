#original-page(612pt, 792pt, (image("graphics/page-02.png", width: 316.5pt), 144pt, 243pt))[
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.2pt, 86.64pt, "the target for the deposition of ultrathin coatings onto the PE separators. The LAGP target was placed in the ")
  #line-at(79.2pt, 100.92pt, "high-vacuum chamber, mounted on a rotating target holder capable of accommodating up to six targets. For ")
  #line-at(79.2pt, 115.2pt, "metallic coatings, Ni and Co targets (purity 4N, from J.K. Lesker) were added to the holder. This setup allowed ")
  #line-at(79.2pt, 129.48pt, "for the deposition of Co and Ni on the LAGP-coated PE surface, providing insight into the effects of these ")
  #line-at(79.2pt, 143.64pt, "metals in combination with LAGP for polysulfide suppression. A total of three sets of samples were produced ")
  #line-at(79.2pt, 158.04pt, "for this study: PE/LAGP, PE/LAGP/Co, and PE/LAGP/Ni. These samples were fabricated to investigate the ")
  #line-at(79.2pt, 172.2pt, "contributions of Co and Ni, along with LAGP, to the suppression of polysulfide migration in Li-S batteries.  ")
  #line-at(79.2pt, 192.12pt, "For the sputtering of the targets, an intense argon (Ar) ion beam with an energy of 20 keV and a focused beam ")
  #line-at(79.2pt, 206.4pt, "area of 1 cm² was directed onto the target material. The PE separators were positioned (as substrates) 100 mm ")
  #line-at(79.2pt, 220.68pt, "away from the target surface. The entire sputtering process was conducted under a base pressure of 7.6 x 10")
  #set text(font: "Arial", size: 6.53pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(526.92pt, 216.96pt, "-6")
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.2pt, 234.96pt, "mbar. A schematic representation of the experimental setup is shown in Figure 1. ")
  #set text(font: "Times New Roman", size: 10.359pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(170.28pt, 450.12pt, "Figure 1 ")
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#222222"))
  #line-at(210pt, 450.12pt, "Sketch of thin films deposition by ion beam sputtering.")
  #set text(font: "Arial", size: 10.359pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.2pt, 475.56pt, "The surface morphology of the prepared samples was analyzed using Scanning Electron Microscopy (SEM) ")
  #line-at(79.2pt, 489.84pt, "(Hitachi TM4000 Plus). Electrochemical properties were studied using Staircase Voltammetry (SV) ")
  #line-at(79.2pt, 504.12pt, "measurements performed with an AutoLab potentiostat (PGSTAT 204). For the CV measurements, the ")
  #line-at(79.2pt, 518.4pt, "separators were assembled into a lab-made Teflon H-Cell. Each half-cell was filled with 7.5 mL of a 1M ")
  #line-at(79.2pt, 532.68pt, "LiTFSI/DOL+DME (1:1, v/v) electrolyte. Sulfur (Sigma-Aldrich) was used as the cathode material, and carbon ")
  #line-at(79.2pt, 546.96pt, "(MTI Corporation) as the anode material.  ")
]

