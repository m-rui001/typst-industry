// arXiv source page 5
#original-page(612pt, 792pt, (image("graphics/page-05.png", width: 369pt), 70.5pt, 370.5pt))[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.24pt, "Both systems allow variation of the incidence angle from 80° to normal incidence and offer temperature ")
  #line-at(70.824pt, 95.42pt, "control of the sample holder, from ")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(230.09pt, 95.42pt, "−")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(236.57pt, 95.42pt, "180 to +450°C for ALCHIMIE and from room temperature to +200°C ")
  #line-at(70.824pt, 109.46pt, "degrees for DEESSE. ")
  #line-at(70.824pt, 132.62pt, "Each system includes a hemispherical electron analyzer, SIGMA for ALCHIMIE (128 MCP detector) and ")
  #line-at(70.824pt, 146.66pt, "OMICRON EA125 (Cannelton detectors) for DEESSE, and both incorporate Faraday cups located on the ")
  #line-at(70.824pt, 160.82pt, "sample holder and at the electron gun output.  ")
  #line-at(70.824pt, 183.86pt, "The TEEY measurements and the surface characterizations (XPS or AES) were performed in the same ")
  #line-at(70.824pt, 198.02pt, "analysis chamber without breaking the ultra-high vacuum. ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 222.02pt, "TEEY Measurement Protocol ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 245.54pt, "To avoid conditioning effects")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(201.77pt, 243.02pt, "12")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(207.77pt, 245.54pt, ", that is electron-induced chemistry surface modifications, measurements ")
  #line-at(70.824pt, 259.58pt, "are systematically performed in pulsed mode rather than continuous mode. For conductive materials, the ")
  #line-at(70.824pt, 273.77pt, "pulse duration is on the order of one millisecond, whereas for dielectric materials it is on the order of one ")
  #line-at(70.824pt, 287.81pt, "microsecond. ")
  #line-at(70.824pt, 310.97pt, "For each incident energy, ten pulses are recorded, from which the mean value and standard deviation are ")
  #line-at(70.824pt, 325.01pt, "computed. If the standard deviation exceeds 3%, the measurement is discarded. The uncertainty increases ")
  #line-at(70.824pt, 339.05pt, "as the incident energy decreases. The standard deviation as a function of incident energy is presented in ")
  #line-at(70.824pt, 353.21pt, "Figure 4. ")
  #set text(font: "Calibri", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(144.02pt, 553.87pt, "Figure 4- Typical standard deviation of TEEY as function of the incident electron energy ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 576.19pt, "The measurement procedure consists of two steps. In the first step, the sample holder is positively biased. ")
  #line-at(70.824pt, 590.23pt, "The sample is then bombarded with electrons. Secondary electrons with energies equal to or below +27 ")
  #line-at(70.824pt, 604.39pt, "V, representing the majority of emitted electrons, are recollected by the surface. Time integration of the ")
  #line-at(70.824pt, 618.46pt, "current measured on the sample holder provides the total charge Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(374.83pt, 619.42pt, "0")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(378.31pt, 618.46pt, ". Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(391.15pt, 619.42pt, "0")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(394.63pt, 618.46pt, " is about few hundreds of pC per ")
  #line-at(70.824pt, 632.62pt, "pulse for metals (pulse ms) and few hundreds of fC for dielectrics (pulse µs). The variation of Q0 as function ")
  #line-at(70.824pt, 646.66pt, "of the incident electron energy is shown in Figure 5. ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 696.216pt, "12")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(79.344pt, 698.736pt, "V. Petit,*et al, Role of the different chemical components in the conditioning process of air exposed copper surfaces, Phys. Rev. ")
  #line-at(70.824pt, 710.376pt, "Accel. Beams 22, 083101 (2019).")
]

