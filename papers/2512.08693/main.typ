  #line-at(73.824pt, 672.1pt, " J. B. Johnson* and K. G. McKay, Secondary Electron Emission of Crystalline MgO, Phys. Rev. 91, 582 – Published 1 August, 1953 ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 681.1pt, "7")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(73.824pt, 683.62pt, " Jacques Cazaux, About the secondary electron yield and the sign of charging of electron irradiated insulators, Eur. Phys. J. AP 15, ")
  #line-at(70.824pt, 695.136pt, "167-172 (2001) ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 704.136pt, "8")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(73.824pt, 706.656pt, " Lin, Yinghong and Joy, David. (2005). A new examination of secondary electron yield data. Surface and Interface Analysis. 37. ")
  #line-at(70.824pt, 718.176pt, "895 - 900. 10.1002/sia.2107. ")
]

