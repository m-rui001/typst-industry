  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(421.27pt, 366.05pt, "E")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(424.63pt, 365.09pt, " associated with electron ")
  #line-at(70.824pt, 379.13pt, "emission through Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(158.66pt, 380.09pt, "E")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(162.02pt, 379.13pt, " = Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(179.9pt, 380.09pt, "0")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(185.9pt, 379.13pt, "−")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(192.26pt, 379.13pt, " Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(202.25pt, 380.09pt, "S")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(205.49pt, 379.13pt, ". Therefore, ")
  #line-at(70.824pt, 402.29pt, "TEEY = 1 ")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.9pt, 402.29pt, "−")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.26pt, 402.29pt, " Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.22pt, 403.25pt, "S")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(130.34pt, 402.29pt, "/Q")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(142.1pt, 403.25pt, "0")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.58pt, 402.29pt, ". ")
  #line-at(70.824pt, 425.33pt, "It should also be noted that measurements are generally performed with a constant focus setting of the ")
  #line-at(70.824pt, 439.51pt, "electron gun. The focal point therefore varies as a function of the incidence energy. This implies that the ")
  #line-at(70.824pt, 453.55pt, "analyzed area changes in a nonuniform manner with the incidence energy, typically from the millimeter ")
  #line-at(70.824pt, 467.71pt, "to the centimeter scale. ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 490.75pt, "XPS analyses Protocol ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 527.23pt, "X ray radiation was generated using a non-monochromatic Al Kα line (1486.6 eV), with an Al anode ")
  #line-at(70.824pt, 541.39pt, "polarization of 15 kV and an emission current of 20 mA. ")
  #line-at(70.824pt, 563.47pt, "The X ray source axis was set at 44° relative to the surface normal, and the electron energy analyzer angle ")
  #line-at(70.824pt, 577.51pt, "was fixed at 10° with respect to the same reference. ")
  #line-at(70.824pt, 599.59pt, "Survey spectra were acquired in constant analyzer energy mode at 200 eV, with a typical number of passes ")
  #line-at(70.824pt, 613.78pt, "ranging from 20 to 50. ")
  #line-at(70.824pt, 635.86pt, "High resolution spectra, when available, were collected in constant analyzer energy mode (20 eV), with a ")
  #line-at(70.824pt, 650.02pt, "dwell time of 0.5 s, six passes, and a measurement step of 0.1 eV. ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 715.056pt, "13")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(76.824pt, 717.576pt, " E")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(84.744pt, 717.576pt, "lectrons generated when BSEs and SEs electrons interact with the inner surfaces of the analysis chamber.")
]

