  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(199.61pt, 81.24pt, " results in a significant modification of the TEEY. In addition to chemical ")
  #line-at(70.824pt, 95.42pt, "composition, the TEEY also depends on surface morphology")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
