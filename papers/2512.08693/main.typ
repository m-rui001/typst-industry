#original-page(612pt, 792pt, (image("graphics/page-07.png", width: 144.5pt), 70.5pt, 645.5pt))[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 82.2pt, "Comment on Dielectric Samples ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 105.74pt, "Under electron irradiation, an insulator may acquire a positive charge when E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(425.47pt, 106.7pt, "C1")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(432.67pt, 105.74pt, " < E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(450.19pt, 106.7pt, "0")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(453.67pt, 105.74pt, " < E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(471.1pt, 106.7pt, "C2")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(478.3pt, 105.74pt, " or a negative ")
  #line-at(70.824pt, 119.78pt, "charge when E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.34pt, 120.74pt, "0")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(139.82pt, 119.78pt, " < E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(155.78pt, 120.74pt, "C1")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(162.98pt, 119.78pt, " or E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(183.02pt, 120.74pt, "0")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(186.5pt, 119.78pt, " > E")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(202.37pt, 120.74pt, "C2")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(209.57pt, 119.78pt, ". The resulting surface charging is a major source of artefacts. ")
  #line-at(70.824pt, 142.94pt, "Positive charging accelerates the incident electrons and may lead to the recapture of secondary electrons. ")
  #line-at(70.824pt, 156.98pt, "It also alters the transport of excited electrons within the material, reducing their mean free path due to ")
  #line-at(70.824pt, 171.14pt, "interactions with accumulated charge and consequently decreasing their probability of emission")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(500.26pt, 168.62pt, "14")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(506.26pt, 171.14pt, ". ")
  #line-at(70.824pt, 194.18pt, "Negative charging slows down or deflects incident electrons and similarly affects the transport of excited ")
  #line-at(70.824pt, 208.34pt, "electrons. Moreover, some dielectrics may be pre-charged prior to measurement through ")
  #line-at(70.824pt, 222.38pt, "triboelectrification. ")
  #line-at(70.824pt, 245.54pt, "These uncertainties, involving both the effective impact energy and the loss of secondary electrons, ")
  #line-at(70.824pt, 259.58pt, "represent significant sources of artefacts. ")
  #line-at(70.824pt, 282.77pt, "The sample current method described above can be applied to insulating materials provided that ")
  #line-at(70.824pt, 296.81pt, "appropriate adaptations are implemented. The electron dose delivered by the electron gun must be ")
  #line-at(70.824pt, 310.97pt, "minimized, using the shortest possible pulses, typically of the order of one microsecond or less. ")
  #line-at(70.824pt, 334.01pt, "In addition to the total charge, the current density is critical, as broader beams reduce internal charging ")
  #line-at(70.824pt, 348.05pt, "effects")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(101.18pt, 345.53pt, "15")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.18pt, 348.05pt, ". In the sample current method, the measured charge corresponds to the image charge induced ")
  #line-at(70.824pt, 362.21pt, "by trapped charges rather than to a true flowing current. This requires specific experimental and ")
  #line-at(70.824pt, 376.25pt, "geometrical conditions to ensure nearly complete electrostatic influence. ")
  #line-at(70.824pt, 399.41pt, "An alternative technique, known as the Kelvin Probe method")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(366.43pt, 396.89pt, "16")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(374.11pt, 399.41pt, ", has recently been developed and ")
  #line-at(70.824pt, 413.45pt, "improved. It consists of measuring the injected charge in situ using a surface potential probe and indirectly ")
  #line-at(70.824pt, 427.61pt, "deducing the TEEY. This method provides a better evaluation of the injected charge and improved control ")
  #line-at(70.824pt, 441.67pt, "of discharge processes")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(171.62pt, 439.15pt, "17")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.62pt, 441.67pt, ". ")
  #line-at(70.824pt, 464.83pt, "Ongoing work aims to improve measurement techniques for dielectric materials. However, at present, we ")
  #line-at(70.824pt, 478.87pt, "are not able to guarantee that TEEY measurements on dielectrics are entirely free of artefacts. We ")
  #line-at(70.824pt, 493.03pt, "therefore choose not to release these data until the remaining uncertainties concerning their accuracy ")
  #line-at(70.824pt, 507.07pt, "have been resolved. ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 658.06pt, "14")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(76.824pt, 660.58pt, " M. Belhaj et al, Effect of the incident electron fluence on the electron emission yield of polycrystalline Al2O3, Applied Surface ")
  #line-at(70.824pt, 672.1pt, "Science, Volume 257, Issue 10, 2011, Pages 4593-4596")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 681.1pt, "15")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(76.824pt, 683.62pt, " Q. Gibaru et al ; Experimental and Monte-Carlo study of double-hump electron emission yield curves of SiO2 thin films. J. Appl. ")
  #line-at(70.824pt, 695.136pt, "Phys. 7 April 2023; 133 (13): 135102 ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
