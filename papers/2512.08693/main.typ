#original-page(612pt, 792pt, (image("graphics/page-06.png", width: 376.5pt), 70.5pt, 76pt))[
  #set text(font: "Calibri", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(116.42pt, 263.21pt, "Figure 5-Typical curve of the used Incident electron charge as function of the incident electron energy   ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 285.53pt, "In the second step, the sample holder is negatively biased and the sample is again exposed to an electron ")
  #line-at(70.824pt, 299.69pt, "flux with increasing primary energy. The negative bias ensures that no emitted electrons, especially ")
  #line-at(70.824pt, 313.73pt, "secondary and tertiary")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(173.42pt, 311.21pt, "13")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(179.42pt, 313.73pt, " electrons, are recollected. The energy shift of the primary electrons, which are ")
  #line-at(70.824pt, 327.89pt, "decelerated by the negative bias applied to the sample holder, is taken into account when plotting the ")
  #line-at(70.824pt, 341.93pt, "TEEY curves. ")
  #line-at(70.824pt, 365.09pt, "The charge measured on the sample holder, Q")
