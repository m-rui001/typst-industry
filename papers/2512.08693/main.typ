#original-page(612pt, 792pt, (image("graphics/page-01.png", width: 144.5pt), 70.5pt, 668.5pt))[
  #set text(font: "Calibri", size: 18pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 87.98pt, "Electron Emission Yield Datasets Under Electron Impact From ")
  #line-at(70.824pt, 111.14pt, "Surfaces Characterized In Situ by XPS or AES ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 159.5pt, "M. Belhaj* and S. Dadouch** ")
  #line-at(70.824pt, 182.66pt, "DPHY, ONERA, Université de Toulouse, 31000, Toulouse, France  ")
  #set text(font: "Calibri", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#595959"))
  #line-at(70.824pt, 205.7pt, "*Mohamed.Belhaj@onera.fr")
  #line-at(209.57pt, 205.7pt, "**Sarah.Dadouch@onera.fr")
  #set text(font: "Calibri", size: 14.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 231.86pt, "Abstract ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 255.74pt, "We have generated at ONERA electron emission data under electron impact for several years, although ")
  #line-at(70.824pt, 269.93pt, "only part of this work has been published. Existing tabulated datasets in the literature rarely document ")
  #line-at(70.824pt, 283.97pt, "surface conditions, even though secondary electrons originate within only a few nanometers of the ")
  #line-at(70.824pt, 298.13pt, "surface. Consequently, emission data cannot be reliably interpreted without detailed surface composition ")
  #line-at(70.824pt, 312.17pt, "information, including contamination, oxidation after air exposure, or in situ cleaning. We present the ")
  #line-at(70.824pt, 326.33pt, "measurement, characterization, and calibration procedures used to produce a series of datasets for ")
  #line-at(70.824pt, 340.37pt, "various conductive and semiconductive materials. The data, provided, include emission yields as a function ")
  #line-at(70.824pt, 354.53pt, "of incident electron energy together with surface composition obtained from X-Ray Photoelectron ")
  #line-at(70.824pt, 368.57pt, "Spectroscopy (XPS) or Auger Electron Spectroscopy (AES) analyses. Initial datasets cover copper and gold, ")
  #line-at(70.824pt, 382.73pt, "with additional materials (germanium, titanium, silver, aluminum, nickel, …) to be released on arXiv. ")
  #set text(font: "Calibri", size: 14.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 415.73pt, "INTRODUCTION ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 439.75pt, "When exposed to electron bombardment, surfaces may in turn emit electrons that can be either secondary ")
  #line-at(70.824pt, 453.91pt, "electrons, originating from the target material, or as backscattered electrons, corresponding to incident ")
  #line-at(70.824pt, 467.95pt, "electrons that are re-emitted into the vacuum after undergoing sequences of elastic or inelastic ")
  #line-at(70.824pt, 482.11pt, "interactions. The total number of emitted electrons may therefore be lower or higher than the number of ")
  #line-at(70.824pt, 496.15pt, "incident electrons. ")
  #line-at(70.824pt, 519.31pt, "In many applications involving electron–surface interactions under vacuum, an accurate determination of ")
  #line-at(70.824pt, 533.35pt, "the electron emission yield is essential. This yield is defined as the ratio between the total number of ")
  #line-at(70.824pt, 547.51pt, "electrons emitted into the vacuum, including both secondary and backscattered electrons, and the ")
  #line-at(70.824pt, 561.55pt, "number of incident electrons. It is denoted TEEY, Total Electron Emission Yield. The TEEY is the sum of the ")
  #line-at(70.824pt, 575.71pt, "SEY, Secondary Electron Yield, and the BSEY, Backscattered Electron Yield. In the literature, especially in ")
  #line-at(70.824pt, 589.75pt, "more recent publications, the TEEY is frequently referred to as SEY, a practice that unfortunately ")
  #line-at(70.824pt, 603.91pt, "introduces confusion and errors. ")
  #line-at(70.824pt, 626.98pt, "Secondary electrons originate from depths on the order of a few nanometers. As a consequence, the SEY ")
  #line-at(70.824pt, 641.14pt, "and thus the TEEY are extremely sensitive to the surface composition. Any contamination")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(472.66pt, 638.62pt, "1")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(475.66pt, 641.14pt, ", oxidation")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(522.94pt, 638.62pt, "2")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(525.94pt, 641.14pt, ", or ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 681.1pt, "1")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(73.824pt, 683.62pt, " Hilleret, N., Scheuerlein, C. & Taborelli, M. The secondary-electron yield of air-exposed metal surfaces. Appl Phys A 76, 1085–")
  #line-at(70.824pt, 695.136pt, "1091 (2003) ")
  #set text(font: "Calibri", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 704.136pt, "2")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(73.824pt, 706.656pt, " Jiangtao Li, Bart Hoekstra, Zhen-Bin Wang, Jie Qiu and Yi-Kang Pu. Secondary electron emission influenced by oxidation on the ")
  #line-at(70.824pt, 718.176pt, "aluminum surface: the roles of the chemisorbed oxygen and the oxide layer 2018 Plasma Sources Sci. Technol. 27 044002 ")
]

