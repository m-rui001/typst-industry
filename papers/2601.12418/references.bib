	file = {Full Text PDF:C\:\\Users\\akbeher\\Zotero\\storage\\ZJ74J6FQ\\Du et al. - 2024 - Near 6-GHz Sezawa Mode Surface Acoustic Wave Resonators Using AlScN on SiC.pdf:application/pdf},
