@article{chang_voltage-controlled_2024,
	title = {A {Voltage}-{Controlled} {Surface} {Acoustic} {Wave} {Oscillator} {Based} on {Lithium} {Niobate} on {Sapphire} {Low}-{Loss} {Acoustic} {Delay} {Line}},
