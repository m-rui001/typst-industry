@article{du_near_2024,
	title = {Near 6-{GHz} {Sezawa} {Mode} {Surface} {Acoustic} {Wave} {Resonators} {Using} {AlScN} on {SiC}},
	volume = {33},
	issn = {1941-0158},
	url = {https://ieeexplore.ieee.org/abstract/document/10617811},
	doi = {10.1109/JMEMS.2024.3430984},
	abstract = {Surface Acoustic Wave (SAW) devices featuring Aluminum Scandium Nitride (AlScN) on a 4H-Silicon Carbide (SiC) substrate, offer a unique blend of high sound velocity, low thermal resistance, substantial piezoelectric response, simplified fabrication, as well as suitability for high-temperature and harsh environment operation. This study presents high-frequency SAW resonators employing AlScN thin films on SiC substrates, utilizing the second SAW mode (referred to as the Sezawa mode). The resonators achieve remarkable performance, boasting a K {\textasciicircum}{\textbackslash}mathrm 2 value of 5.5\% at 4.7 GHz and a maximum Bode-Q (Q \_{\textbackslash}mathrm max ) of 911 at 4.3 GHz, outperforming previous AlScN SAW devices. Additionally, a SAW resonator with a 0.96 {\textbackslash}mu m wavelength attains 5.9 GHz frequency with K {\textasciicircum}{\textbackslash}mathrm 2 of 4.0\% and Q \_{\textbackslash}mathrm max of 762. Our study underscores the potential of the AlScN on SiC platform for advanced radio-frequency applications. [2024-0075]},
	number = {5},
	urldate = {2025-12-22},
	journal = {Journal of Microelectromechanical Systems},
	author = {Du, Xingyu and Sharma, Nishant and Tang, Zichen and Leblanc, Chloe and Jariwala, Deep and Olsson, Roy H.},
	month = oct,
	year = {2024},
	keywords = {acoustic device, Acoustic devices, AlScN, Aluminum compounds, microelectromechanical systems, Microelectromechanical systems, Resonant frequency, Resonators, SiC, Silicon carbide, Surface acoustic wave, Surface acoustic wave devices, Surface acoustic waves},
