	pages = {193},
	file = {Full Text PDF:C\:\\Users\\akbeher\\Zotero\\storage\\Y58ZFHQI\\Maity et al. - 2020 - Coherent acoustic control of a single silicon vacancy spin in diamond.pdf:application/pdf},
}

