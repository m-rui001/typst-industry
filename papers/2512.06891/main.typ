  #line-at(90.024pt, 532.63pt, "configurations, the sound source effectively excites the meron texture lattice through ")
  #line-at(90.024pt, 556.03pt, "coupling with the underlying structure. ")
  #line-at(114.02pt, 579.43pt, "Additionally, for edge excitation, the sound source was placed at the center of the ")
