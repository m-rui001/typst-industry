  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(262.92pt, 142.8pt, " skyrmions with integer topological charge in the sigma model ")
  #line-at(36pt, 167.28pt, "in 1926, topological structures such as skyrmion")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(266.64pt, 162.72pt, "[2, 3]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.8pt, 167.28pt, " and meron")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(337.2pt, 162.72pt, "[1, 4]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(354.36pt, 167.28pt, " have been discovered across diverse fields ")
  #line-at(36pt, 191.76pt, "including particle physics")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(159.12pt, 187.2pt, "[5, 6]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
