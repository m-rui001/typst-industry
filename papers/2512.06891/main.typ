  #line-at(416.16pt, 191.76pt, ". These stringent magnetic")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(542.04pt, 187.2pt, "[7, 8]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(36pt, 216.12pt, "and optical")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(89.28pt, 211.56pt, "[2, 12]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(111pt, 216.12pt, " experimental constraints significantly impede the deeper exploration of topological states of ")
  #line-at(36pt, 240.6pt, "matter. Therefore, identifying readily excitable vector fields and developing methods for the macroscopic ")
  #line-at(36pt, 265.08pt, "construction or observation of their topological textures are pivotal for advancing studies of topological ")
  #line-at(36pt, 289.56pt, "phenomena and quasiparticles. ")
  #line-at(60pt, 313.92pt, "Acoustic systems provide a unique macroscopic platform for exploring topological phenomena of ")
  #line-at(36pt, 338.4pt, "skyrmions")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.04pt, 333.84pt, "[13-15]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.04pt, 338.4pt, " and merons")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(168.36pt, 333.84pt, "[16, 17]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.68pt, 338.4pt, " using velocity vector fields. For instance, a hexagonally symmetric acoustic ")
  #line-at(36pt, 362.88pt, "metasurface coupled with a six-speaker array")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(261.48pt, 358.32pt, "[13]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(274.8pt, 362.88pt, " successfully generated skyrmion textures. Moreover, the ")
  #line-at(36pt, 387.36pt, "bimeron texture—comprising a meron and an anti-meron with opposite polarities")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(464.76pt, 382.8pt, "[1]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(474.12pt, 387.36pt, "—remains stable ")
  #line-at(36pt, 411.72pt, "propagation")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.24pt, 407.16pt, "[18]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.68pt, 411.72pt, " in curved geometries, offering a compelling alternative to skyrmions for next-generation ")
  #line-at(36pt, 436.2pt, "spintronic devices. However, its exploration in acoustics remains limited, even though stationary meron and ")
  #line-at(36pt, 460.68pt, "anti-meron textures have been demonstrated using standing waves")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(354.12pt, 456.12pt, "[16]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(367.56pt, 460.68pt, " generated by a four-speaker array or by ")
  #line-at(36pt, 485.16pt, "Mie-resonant metastructures")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(172.68pt, 480.6pt, "[17]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(186.12pt, 485.16pt, " in isolated resonant cavities.  Their transport and the underlying manipulation ")
  #line-at(36pt, 509.52pt, "dynamics remain largely unexplored, and realizing bimeron transport together with a deeper understanding of ")
  #line-at(36pt, 534pt, "its dynamics is essential for leveraging these quasiparticles in topological information storage and ")
  #line-at(36pt, 558.48pt, "transmission. ")
  #line-at(60pt, 582.96pt, "In this work, we design Archimedean-like square spiral metastructures (ASSMs) that experimentally ")
  #line-at(36pt, 607.32pt, "generate acoustic meron topological textures on metasurfaces through the excitation of spoof surface acoustic ")
  #line-at(36pt, 631.8pt, "waves (SSAWs). We further demonstrate that composite chiral metastructures, formed via mirror-symmetric ")
  #line-at(36pt, 656.28pt, "combinatorial operations, achieve stable one- and two-dimensional topological bimeron transport. We reveal ")
  #line-at(36pt, 680.76pt, "that the bimeron transport originates from the locked, opposite phase differences of SSAWs dictated by the ")
  #line-at(36pt, 705.12pt, "handedness of the cavity resonant modes. The intrinsic robustness of the meron textures against structural ")
  #line-at(36pt, 729.6pt, "defects is validated through the calculations of their topological charge. Our findings establish stable acoustic ")
  #line-at(36pt, 754.08pt, "bimeron transport as a topologically resilient foundation for future acoustic information processing and storage ")
  #line-at(36pt, 778.56pt, "technologies. ")
]

