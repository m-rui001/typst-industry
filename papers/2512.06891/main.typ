  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(90.024pt, 259.61pt, "Two-dimensional chiral metastructure.")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(276.19pt, 259.61pt, " Based on the two-unit composite metastructure ")
  #line-at(90.024pt, 283.01pt, "constructed via \"01\" encoding, a fully interconnected 3×3 array was formed by applying ")
  #line-at(90.024pt, 306.41pt, "mirror symmetry to the boundaries of adjacent units arranged in a \"010101010\" ")
  #line-at(90.024pt, 329.81pt, "sequence, as shown in Fig. S1.This configuration can also be interpreted as a one-")
  #line-at(90.024pt, 353.21pt, "dimensional chain of nine units that has been folded twice to form the metastructure. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(132.62pt, 555.43pt, "Fig. S 1 Schematic diagram of the two-dimensional 3×3 array coupling design ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(90.024pt, 610.66pt, "Robustness to the sound source.")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(255.53pt, 610.66pt, "  The excitation of meron textures is inherently ")
  #line-at(90.024pt, 634.06pt, "dependent on the structural eigenmodes, such that the resulting two-dimensional ")
  #line-at(90.024pt, 657.46pt, "coupled array is, in theory, independent of the position of the sound source within the ")
  #line-at(90.024pt, 680.86pt, "acoustic-material interaction. This independence is contingent upon satisfying the ")
  #line-at(90.024pt, 704.26pt, "excitation frequency of the eigenmode. Based on this principle, we devised two distinct ")
  #line-at(90.024pt, 727.66pt, "sound source placement configurations, as illustrated in Fig. S2. ")
]

