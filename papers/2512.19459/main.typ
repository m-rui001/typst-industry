  #line-at(145.58pt, 168.5pt, ": a typically inaccessible regime with conventional extensional rheometers. Under magnetic forcing, the ")
  #line-at(90.024pt, 179.78pt, "nanoparticles assemble into field-aligned, chain-like structures, that generate a tunable magneto-elastic response, and ")
  #line-at(90.024pt, 191.06pt, "markedly alter the extensional flow. Although behaving as Newtonian liquids in the absence of a magnetic field, the field ")
  #line-at(90.024pt, 202.46pt, "induces extensional thickening, and the emergence of beads-on-a-string (BOAS) structures in the ferrofluid filaments: ")
  #line-at(90.024pt, 213.86pt, "a non-Newtonian signature. By combining controlled elongation with high-speed imaging, we directly quantify the ")
  #line-at(90.024pt, 225.14pt, "magnetic-field-dependent extensional viscosity and relaxation time. Our findings underscore how magnetically induced ")
  #line-at(90.024pt, 236.54pt, "microstructures govern filament stability and extensional dynamics in ferrofluids. ")
  #line-at(63.84pt, 268.01pt, "Ferrofluids (FF) respond strongly to magnetic fields (MF) ")
  #line-at(54pt, 279.53pt, "by virtue of magnetic nanoparticles (MNP) suspended stably ")
  #line-at(54pt, 291.05pt, "in a carrier liquid. Since inception and development, ferroflu- ")
  #line-at(54pt, 302.57pt, "ids have attracted sustained academic and research interest ")
  #line-at(54pt, 313.97pt, "since they juxtapose the ability to deform and flow like ")
  #line-at(54pt, 325.49pt, "ordinary liquids, with the possibility of being magnetically ")
  #line-at(54pt, 337.01pt, "controlled or actuated.")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.22pt, 332.45pt, "1,2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(153.38pt, 337.01pt, ". This combination has birthed sev- ")
  #line-at(54pt, 348.53pt, "eral applications, ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(126.5pt, 348.53pt, "viz")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(137.54pt, 348.53pt, ". in rotary seals and bearings, vibration ")
  #line-at(54pt, 360.05pt, "damping and acoustic devices, magnetically assisted heat ")
  #line-at(54pt, 371.57pt, "transfer systems")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(120.38pt, 367.01pt, "3")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(123.62pt, 371.57pt, ", and adaptive fluid-based technologies")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(286.85pt, 367.01pt, "4–6")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(296.69pt, 371.57pt, ", ")
  #line-at(54pt, 382.97pt, "etc.  In recent years, they have made a strong presence ")
  #line-at(54pt, 394.49pt, "in biomedical avenues, such as magnetic drug delivery")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
