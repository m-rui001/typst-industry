  #line-at(72pt, 460.8pt, "zero at the tilt angle of 0°, owing to the full ")
  #line-at(72pt, 472.32pt, "compensation among the LED units. As the tilt angle ")
  #line-at(72pt, 483.84pt, "increases from 0° to 5°, the equalization gets disrupted, ")
  #line-at(72pt, 495.36pt, "resulting in the switching behavior similar to that ")
  #line-at(72pt, 506.76pt, "observed under bottom-LED illumination. When the ")
  #line-at(72pt, 518.28pt, "tilt angle increases further from 5° to 10°, the ")
  #line-at(72pt, 529.8pt, "switching reverses its sign and begins to resemble that ")
  #line-at(72pt, 541.32pt, "under top-LED illumination. These changes in ")
  #line-at(72pt, 552.84pt, "switching amplitudes as a function of tilt angle are ")
  #line-at(72pt, 564.24pt, "summarized in Fig. 6(e), where the ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
