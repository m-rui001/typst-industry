  #line-at(324pt, 300.72pt, "magnetization, whereas that from the bottom-LED ")
  #line-at(324pt, 312.24pt, "unit becomes more effective. This mechanism helps to ")
  #line-at(324pt, 323.76pt, "explain the negative shift in the Kerr response ")
  #line-at(324pt, 335.16pt, "observed at the tilt angle of 5° in Fig. 6(f). ")
  #line-at(324pt, 358.2pt, "Another important factor governing the observed ")
  #line-at(324pt, 369.72pt, "hysteresis loops is the fraction of reflected light ")
  #line-at(324pt, 381.24pt, "collected by the objective lens. As indicated in ")
  #line-at(324pt, 392.76pt, "Fig. 6(a), tilting of the sample can cause the reflected ")
  #line-at(324pt, 404.16pt, "image to fall partially outside the objective’s front ")
  #line-at(324pt, 415.68pt, "pupil, and thus it cannot be fully captured by the ")
  #line-at(324pt, 427.2pt, "detector. Considering that the bottom-LED image is ")
  #line-at(324pt, 438.72pt, "located on the left side of the figure and the reflected ")
  #line-at(324pt, 450.24pt, "light propagates toward the right, this mechanism has ")
  #line-at(324pt, 461.76pt, "a stronger impact on the bottom-LED illumination ")
  #line-at(324pt, 473.16pt, "compared to the top-LED scheme. Under the top-LED ")
  #line-at(324pt, 484.68pt, "illumination (Fig. 7(b)), as long as the tilt angle ")
  #line-at(324pt, 496.32pt, "remains below ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(384.96pt, 496.32pt, "𝜃")
  #set text(font: "Times New Roman", size: 6.947pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.547pt, 496.32pt, "்")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(398.28pt, 496.32pt, "≈arcsin(NA)")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(455.88pt, 496.32pt, ", the reflected light is ")
  #line-at(324pt, 507.96pt, "still largely collected by the objective, yet the ")
  #line-at(324pt, 519.48pt, "variations in switching amplitude of hysteresis loops ")
  #line-at(324pt, 530.88pt, "are primarily determined by the effective incident ")
  #line-at(324pt, 542.4pt, "angle. Under the bottom-LED illumination (Fig. 7(c)), ")
  #line-at(324pt, 553.92pt, "however, even a small tilt leads to a significant loss of ")
  #line-at(324pt, 565.44pt, "the reflected light. This accounts for the observation ")
  #line-at(324pt, 576.96pt, "that, although the normalized Kerr response increases ")
  #line-at(324pt, 588.36pt, "with the tilt angle from 0° to 5° under bottom-LED ")
  #line-at(324pt, 599.88pt, "illumination (Fig. 6(f)), the absolute switching ")
  #line-at(324pt, 611.4pt, "amplitude still decreases (Fig. 6(e)), as there is an ")
  #line-at(324pt, 622.92pt, "approximately 40% reduction in the illumination ")
  #line-at(324pt, 634.44pt, "intensity. Moreover, for a sufficiently large tilt angle ")
  #line-at(324pt, 645.96pt, "(")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(327.31pt, 645.96pt, " 𝜃")
  #set text(font: "Times New Roman", size: 6.947pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.28pt, 648pt, "ெ")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(344.64pt, 645.96pt, ") determined by the numerical aperture and ")
  #line-at(324pt, 657.6pt, "specific focus distance (Fig. 7(d)), none of the ")
  #line-at(324pt, 669.12pt, "reflected light from the bottom-LED unit can be ")
  #line-at(324pt, 680.64pt, "eventually collected by the objective. As a result, both ")
  #line-at(324pt, 692.16pt, "the switching amplitude and the experimentally ")
  #line-at(324pt, 703.68pt, "measured Kerr response approach zero at larger tilt ")
  #line-at(324pt, 715.08pt, "angles of 15° and 20°. ")
]

