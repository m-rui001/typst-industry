  #line-at(324pt, 446.64pt, "points between the intended and the observed ")
  #line-at(324pt, 458.04pt, "heightmaps. Next, as shown in Fig. 3(g), the lateral ")
  #line-at(324pt, 469.56pt, "dimensions are calibrated using feature sizes. ")
  #line-at(324pt, 481.08pt, "Subsequently, by performing an in-plane rotation ")
  #line-at(324pt, 492.6pt, "around the ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(381.72pt, 492.6pt, "z")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(385.56pt, 492.6pt, "-axis, the intended and observed ")
  #line-at(324pt, 504.12pt, "heightmaps are aligned laterally (Fig. 3(h)). This is ")
  #line-at(324pt, 515.64pt, "then followed by a vertical translating and rescaling ")
  #line-at(324pt, 527.04pt, "along the ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(364.92pt, 527.04pt, "z")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(368.76pt, 527.04pt, "-axis, after which the observed heightmap ")
  #line-at(324pt, 538.56pt, "can be well fitted, as shown in Fig. 3(i). ")
  #line-at(324pt, 561.6pt, "In the case of our tilted test sample, however, the ")
  #line-at(324pt, 573.12pt, "required transformations can be simplified and result ")
  #line-at(324pt, 584.64pt, "in a direct 3D fitting of the tilted plane. After applying ")
  #line-at(324pt, 596.04pt, "the edge mask (Fig. 3(e)) to the original heightmap ")
  #line-at(324pt, 607.56pt, "(Fig. 3(c)), we obtained the masked heightmap shown ")
  #line-at(324pt, 619.08pt, "in Fig. 3(j). The subsequent fitting process can be ")
  #line-at(324pt, 630.6pt, "viewed as an extrapolation of the effective height ")
  #line-at(324pt, 642.12pt, "indices onto the broader two-dimensional plane, as ")
  #line-at(324pt, 653.64pt, "illustrated in Fig. 3(k). Based on the fitted heightmap, ")
  #line-at(324pt, 665.04pt, "regions from subtracted images corresponding to ")
  #line-at(324pt, 676.56pt, "different focal heights were stitched together. This ")
  #line-at(324pt, 688.08pt, "produced a composite image with consistent clarity ")
  #line-at(324pt, 699.6pt, "across the entire field of view, as shown in Fig. 3(l). ")
]

