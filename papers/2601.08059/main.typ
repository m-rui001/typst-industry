  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 294.12pt, "FIG. 1. Experimental setup and workflow for extended depth of field (EDOF) magneto-optical Kerr effect (MOKE)")
  #line-at(72pt, 305.64pt, "microscopy. (a) Optical path of the wide-field MOKE microscopy system. The flat magnetic sample was mounted on ")
  #line-at(72pt, 317.16pt, "a tilted sample holder to imitate a non-planar surface. (b) Flowcharts illustrating the EDOF MOKE imaging process. ")
  #line-at(72pt, 328.68pt, "Unlike conventional MOKE microscopy, where the sample position remains fixed while the magnetic field is varied, ")
  #line-at(72pt, 340.2pt, "here a series of images at different heights")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(240.809pt, 340.2pt, " ℎ")
  #set text(font: "Times New Roman", size: 6.947pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(249pt, 342.24pt, "௜")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(254.64pt, 340.2pt, "are acquired by moving the sample along ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(421.92pt, 340.2pt, "z")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(425.76pt, 340.2pt, "-axis for each magnetic field ")
  #line-at(72pt, 351.84pt, "value. This procedure ensures that magnetization variations across the non-planar surface are fully resolved. The ")
  #line-at(72pt, 363.36pt, "resulting ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(110.28pt, 363.36pt, "Signal")
  #line-at(139.109pt, 363.36pt, "Stack")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(164.04pt, 363.36pt, "is then compared with a pre-acquired ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(319.2pt, 363.36pt, "Background Stack")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(396.24pt, 363.36pt, "that captures the sample features at ")
  #line-at(72pt, 375.72pt, "different heights")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(137.398pt, 375.72pt, " ℎ")
  #set text(font: "Times New Roman", size: 6.947pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.32pt, 378.12pt, "௜")
  #line-at(145.44pt, 371.76pt, "௕")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(150.36pt, 375.72pt, ". After drift compensation, height matching and background subtraction, the")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(450.454pt, 375.72pt, " Subtracted Stack")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(519.858pt, 375.72pt, " used ")
  #line-at(72pt, 387.36pt, "for image reconstruction is prepared (see section III.A). Finally, Sobel-filter-based sharpness detection is used to guide ")
  #line-at(72pt, 398.88pt, "the reconstruction of an")
  #line-at(171.337pt, 398.88pt, "image that is uniformly sharp and well resolved across the entire field of view")
  #line-at(492.442pt, 398.88pt, "(see section ")
  #line-at(72pt, 410.4pt, "III.B). Additional post-processing is applied to further improve the image quality (see sections III.C-D).")
]

