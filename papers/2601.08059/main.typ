#original-page(612pt, 792pt, none)[
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 762.72pt, "*Le Zhao: le.zhao@tuwien.ac.at")
  #set text(font: "Arial", size: 6.468pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 771.48pt, "†")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(75.24pt, 774.96pt, "Amalio Fern")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(124.2pt, 774.96pt, "á")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(128.64pt, 774.96pt, "ndez-Pacheco: amalio.fernandez-pacheco@tuwien.ac.at  ")
  #line-at(503.696pt, 774.96pt, "2 ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 92.88pt, "ABSTRACT")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.36pt, 92.88pt, " High-resolution imaging of magnetic nanostructures is essential for understanding fundamental spin ")
  #line-at(72pt, 104.28pt, "phenomena and designing advanced devices. Recent developments in three-dimensional (3D) nanomagnetism have ")
  #line-at(72pt, 115.8pt, "highlighted the growing need for imaging techniques that can capture magnetic structures across curved or tilted ")
  #line-at(72pt, 127.32pt, "surfaces with high sensitivity. Though widely used as a powerful technique for imaging magnetization states, ")
  #line-at(72pt, 138.84pt, "conventional magneto-optical Kerr effect (MOKE) microscopy faces inherent limitations in measuring non-planar ")
  #line-at(72pt, 150.36pt, "systems due to its shallow depth of field (DOF). Here, we present an extended depth of field MOKE imaging approach, ")
  #line-at(72pt, 161.88pt, "combining through-focus scanning with image-stitching-based reconstruction, to obtain sharp and well-resolved ")
  #line-at(72pt, 173.28pt, "magnetic domain images across non-planar sample geometries. The method is validated on both perpendicularly and ")
  #line-at(72pt, 184.8pt, "in-plane magnetized films tilted on purpose for this study, enabling quantitative analysis of domain morphology and ")
  #line-at(72pt, 196.32pt, "detection sensitivity. This laboratory-accessible technique provides a fast and versatile route for 3D magnetic imaging, ")
  #line-at(72pt, 207.84pt, "complementing large-scale X-ray-based methods and offering a practical tool for investigating non-planar magnetic ")
  #line-at(72pt, 219.36pt, "samples with tilted or curved 3D geometries. ")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(135.48pt, 253.8pt, "I. INTRODUCTION")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 276.84pt, "The ")
  #line-at(101.525pt, 276.84pt, "exploration ")
  #line-at(160.852pt, 276.84pt, "of ")
  #line-at(183.05pt, 276.84pt, "three-dimensional ")
  #line-at(269.229pt, 276.84pt, "(3D) ")
  #line-at(72pt, 288.36pt, "nanomagnetism has attracted growing attention in ")
  #line-at(72pt, 299.88pt, "recent years [1–5], driven not only by the fundamental ")
  #line-at(72pt, 311.28pt, "interests in curved and topologically complex ")
  #line-at(72pt, 322.8pt, "magnetic textures [6–8], but also their potential ")
  #line-at(72pt, 334.32pt, "applications in next-generation spintronic devices [9–")
  #line-at(72pt, 345.84pt, "11]. Unlike conventional thin-film systems, where ")
  #line-at(72pt, 357.36pt, "magnetization on planar surfaces can be easily probed, ")
  #line-at(72pt, 368.76pt, "emerging 3D nanomagnetic architecture often involve ")
  #line-at(72pt, 380.28pt, "tilted facets, patterned structures, or non-planar ")
  #line-at(72pt, 391.8pt, "substrates. These structural complexities introduce ")
  #line-at(72pt, 403.32pt, "additional challenges for magnetization imaging, ")
  #line-at(72pt, 414.84pt, "demanding advanced detection techniques that ")
  #line-at(72pt, 426.36pt, "combine height axial (")
  #set text(font: "Times New Roman", size: 9.941pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(165.84pt, 426.36pt, "z")
  #set text(font: "Arial", size: 9.941pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(169.68pt, 426.36pt, "-axis) spatial resolution with ")
  #line-at(72pt, 437.76pt, "sensitivity to arbitrary magnetization components. ")
  #line-at(72pt, 460.8pt, "Recent advances in electron- or X-ray-based magnetic ")
  #line-at(72pt, 472.32pt, "tomography and laminography have demonstrated ")
  #line-at(72pt, 483.84pt, "their capability in investigating 3D magnetization over ")
  #line-at(72pt, 495.36pt, "complex ")
  #line-at(120.193pt, 495.36pt, "geometries [12–18]. ")
  #line-at(214.642pt, 495.36pt, "However, ")
  #line-at(267.441pt, 495.36pt, "these ")
  #line-at(72pt, 506.76pt, "approaches typically require large-scale facilities, ")
  #line-at(72pt, 518.28pt, "highlighting the need for complementary, laboratory-")
  #line-at(72pt, 529.8pt, "accessible techniques that enable three-dimensional ")
  #line-at(72pt, 541.32pt, "magnetization resolution in compact table-top setups. ")
  #line-at(72pt, 552.84pt, "Magneto-optical Kerr effect (MOKE) microscopy has ")
  #line-at(72pt, 564.24pt, "long served as a powerful and versatile tool for ")
  #line-at(72pt, 575.76pt, "visualizing magnetic domains and dynamics, offering ")
  #line-at(72pt, 587.28pt, "diffraction-limited ")
  #line-at(163.099pt, 587.28pt, "resolution ")
  #line-at(220.316pt, 587.28pt, "together ")
  #line-at(270.237pt, 587.28pt, "with ")
  #line-at(72pt, 598.8pt, "comparatively fast data acquisition and non-invasive ")
  #line-at(72pt, 610.32pt, "nature [19]. ")
  #line-at(129.934pt, 610.32pt, "While ")
  #line-at(165.501pt, 610.32pt, "dark-field ")
  #line-at(216.14pt, 610.32pt, "MOKE ")
  #line-at(256.751pt, 610.32pt, "focused ")
  #line-at(72pt, 621.84pt, "magnetometry has been utilized to characterize the ")
  #line-at(72pt, 633.24pt, "magnetization ")
  #line-at(148.122pt, 633.24pt, "vector ")
  #line-at(192.399pt, 633.24pt, "in ")
  #line-at(219.616pt, 633.24pt, "3D ")
  #line-at(251.328pt, 633.24pt, "magnetic ")
  #line-at(72pt, 644.76pt, "nanostructures [20], direct MOKE microscopy for ")
  #line-at(72pt, 656.28pt, "imaging 3D nanomagnetic samples faces intrinsic ")
  #line-at(72pt, 667.8pt, "limitations. Importantly, the shallow depth of field ")
  #line-at(72pt, 679.32pt, "(DOF) imposed by high-numerical-aperture objectives ")
  #line-at(72pt, 690.84pt, "leads to blurred off-focus regions when imaging non-")
  #line-at(72pt, 702.24pt, "planar surfaces. Another challenge originates from the ")
  #line-at(72pt, 713.76pt, "fact that both in-plane magnetization (longitudinal and ")
  #line-at(324pt, 253.8pt, "transversal Kerr effects) and out-of-plane component ")
  #line-at(324pt, 265.32pt, "(polar Kerr effect) contribute to the overall detected ")
  #line-at(324pt, 276.84pt, "signal [21], ")
  #line-at(386.14pt, 276.84pt, "making ")
  #line-at(432.643pt, 276.84pt, "the ")
  #line-at(461.351pt, 276.84pt, "interpretation ")
  #line-at(531.786pt, 276.84pt, "of ")
  #line-at(324pt, 288.36pt, "measurements ")
  #line-at(392.443pt, 288.36pt, "more ")
  #line-at(424.284pt, 288.36pt, "complicated ")
  #line-at(484.224pt, 288.36pt, "on ")
  #line-at(505.598pt, 288.36pt, "complex ")
  #line-at(324pt, 299.88pt, "geometries. ")
  #line-at(324pt, 322.8pt, "Progress in computational optics and imaging ")
  #line-at(324pt, 334.32pt, "reconstruction has opened promising pathways to ")
  #line-at(324pt, 345.84pt, "address these challenges [22,23]. One simple but ")
  #line-at(324pt, 357.36pt, "effective strategy can be through-focus scanning [24], ")
  #line-at(324pt, 368.76pt, "which involves capturing a stack of images by varying ")
  #line-at(324pt, 380.28pt, "the focus distance. Subsequently, the sharp and well-")
  #line-at(324pt, 391.8pt, "resolved regions within the focus range from each ")
  #line-at(324pt, 403.32pt, "image are stitched together [25], effectively extending ")
  #line-at(324pt, 414.84pt, "the depth of field and enabling high-quality imaging ")
  #line-at(324pt, 426.36pt, "across non-planar surfaces. While proven practicable ")
  #line-at(324pt, 437.76pt, "in various optical microscopy modalities, the ")
  #line-at(324pt, 449.28pt, "applicability of through-focus scanning in MOKE ")
  #line-at(324pt, 460.8pt, "microscopy has yet to be validated. Furthermore, as ")
  #line-at(324pt, 472.32pt, "the effective incident angle of illumination varies with ")
  #line-at(324pt, 483.84pt, "the local surface slope, the Kerr responses associated ")
  #line-at(324pt, 495.36pt, "with ")
  #line-at(353.006pt, 495.36pt, "in-plane ")
  #line-at(397.102pt, 495.36pt, "and ")
  #line-at(422.689pt, 495.36pt, "out-of-plane ")
  #line-at(483.217pt, 495.36pt, "magnetization ")
  #line-at(324pt, 506.76pt, "components need to be carefully evaluated. ")
  #line-at(324pt, 529.8pt, "In this work, we introduce an extended depth of field ")
  #line-at(324pt, 541.32pt, "(EDOF) MOKE microscopy approach specifically ")
  #line-at(324pt, 552.84pt, "designed for non-planar and tilted magnetic samples. ")
  #line-at(324pt, 564.24pt, "By systematically integrating through-focus scanning ")
  #line-at(324pt, 575.76pt, "with an image-stitching procedure, we reconstructed ")
  #line-at(324pt, 587.28pt, "domain images that remain sharp and well-resolved ")
  #line-at(324pt, 598.8pt, "across the entire field of view. Moreover, we analyzed ")
  #line-at(324pt, 610.32pt, "the mechanisms that govern Kerr response under ")
  #line-at(324pt, 621.84pt, "different illumination conditions, providing insights ")
  #line-at(324pt, 633.24pt, "into how MOKE microscope can intrinsically probe ")
  #line-at(324pt, 644.76pt, "in-plane magnetization along non-planar surfaces. ")
  #line-at(324pt, 656.28pt, "This methodology not only extends the applicability of ")
  #line-at(324pt, 667.8pt, "MOKE microscopy beyond flat films, but also ")
  #line-at(324pt, 679.32pt, "establishes a versatile platform for studying complex ")
  #line-at(324pt, 690.84pt, "magnetic systems with non-planar 3D geometries. ")
]

