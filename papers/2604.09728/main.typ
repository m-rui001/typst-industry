#original-page(595.32pt, 841.92pt, (image("graphics/page-06.png", width: 446.5pt), 70.5pt, 126.5pt))[
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(70.8pt, 92.76pt, "Table 1: Physical properties of used materials and ambient air for simulation. For CFRP, the thermal conductivity is out-of-")
  #line-at(70.8pt, 103.32pt, "plane. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.8pt, 213pt, "In the IRT experiment, the external heat source was provided by two xenon flash lamps VH3-")
  #line-at(70.8pt, 226.8pt, "6000 with Tria 6000 S (Hensel GmbH, Germany) generators, each capable of delivering pulses ")
  #line-at(70.8pt, 240.6pt, "ranging from 187 to 6000 J of energy. The duration of the impulse was set to 2 ms. The ")
  #line-at(70.8pt, 254.4pt, "positioning of the lamps at an angle less than 30° relative to the specimen surface was ")
  #line-at(70.8pt, 268.2pt, "implemented to prevent any potential influence on the blind frequency [31]. Additionally, a ")
  #line-at(70.8pt, 282pt, "9.27 mm Polymethylmethacrylate (PMMA) plate was positioned in front of each lamp, serving ")
  #line-at(70.8pt, 295.8pt, "to suppress near-infrared radiation within the operating range of the IR camera [32, 33] and ")
  #line-at(70.8pt, 309.6pt, "thereby ensure the accuracy ad quality of the thermographic measurements [32]. Surface ")
  #line-at(70.8pt, 323.4pt, "temperature measurements were obtained using an IR camera (IR9410BI with max. 1280 x ")
  #line-at(70.8pt, 337.2pt, "1024 pixels resolution and thermal sensitivity (NETD) of 20 mK at 30 °C), with a pixel ")
  #line-at(70.8pt, 351pt, "resolution of 0.3 mm and frame rates 180 frames per second. An active photodiode (PDA36A2, ")
  #line-at(70.8pt, 364.8pt, "Thorlabs, USA), equipped with suitable neutral density filters (ND) from Thorlabs, was ")
  #line-at(70.8pt, 378.6pt, "implemented to monitor the flash pulse. This approach was adopted to account for the ")
  #line-at(70.8pt, 392.4pt, "occurrence of cutting afterglow effects from Thermograms in the pre-treatment stage [34]. ")
  #line-at(70.8pt, 406.2pt, "Figure 3 shows the experimental setup and its schematic representation.")
