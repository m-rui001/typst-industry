  #line-at(70.8pt, 619.92pt, "parameters specified in Table 3 [42], the number of NOS was set to 439, with a coefficient of ")
  #line-at(70.8pt, 633.96pt, "variation of 0.5, a target confidence interval width of ")
  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
