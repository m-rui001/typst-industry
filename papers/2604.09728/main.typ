  #line-at(192.6pt, 689.4pt, "= 𝑐𝑜𝑛𝑠𝑡")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(234.24pt, 689.4pt, "), the effective selection of window samples is influenced by ")
  #line-at(70.8pt, 703.44pt, "two factors: the overall image size and the dimensions ")
  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.88pt, 703.44pt, "𝑛𝑥𝑛")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(353.28pt, 703.44pt, " of the selected window. For certain ")
