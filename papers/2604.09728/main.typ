  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(236.04pt, 412.92pt, " is very close to zero and exhibits nearly linear convergence. ")
  #line-at(70.8pt, 426.72pt, "This underscores the instrument's inherent robustness and minimal sensitivity to background ")
  #line-at(70.8pt, 440.52pt, "noise in these regions, thereby establishing a sharp and interpretable quantitative baseline.   ")
  #line-at(88.8pt, 454.32pt, "As previously mentioned in section 3.2.3, only statistical selected windows strategies are ")
  #line-at(70.8pt, 468.12pt, "taken into account for the calculation of morphological measurements. The results of the ")
