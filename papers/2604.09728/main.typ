  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(508.2pt, 633.96pt, "𝛾")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(514.8pt, 633.96pt, " = ")
  #line-at(70.8pt, 647.76pt, "0.99 of achieving the desired confidence interval. The assumption that CV = 0.5 is a ")
  #line-at(70.8pt, 661.56pt, "conservative one for the variability expected in thermographic measurements. This assumption ")
  #line-at(70.8pt, 675.36pt, "ensures a sufficiently robust sampling. It is important to note that when a constant number of ")
  #line-at(70.8pt, 689.4pt, "NOS is selected (")
