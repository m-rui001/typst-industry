#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 85.32pt, "analyte molecules into the plasmonic hotspot, thereby enabling single-molecule SERS ")
  #line-at(90.024pt, 103.46pt, "measurements of various dyes and proteins")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.01pt, 98.9pt, "24")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(312.05pt, 103.46pt, ". In a similar approach, Schuknecht et al. ")
  #line-at(90.024pt, 121.46pt, "reported DNA origami based assembly of tip-to-tip gold nanorod dimers with controlled ")
  #line-at(90.024pt, 139.58pt, "gaps of approximately 8 nm, enabling label-free single-protein SERS by specifically ")
  #line-at(90.024pt, 157.58pt, "capturing target proteins within the plasmonic hotspot")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(385.75pt, 153.02pt, "25")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(393.79pt, 157.58pt, ". So far, the practical ")
  #line-at(90.024pt, 175.7pt, "implementation of such DNA-assembled nanoantennas has been limited to the ")
  #line-at(90.024pt, 193.7pt, "visible/near-infrared (NIR) spectral range, as gold or silver NPs are predominantly ")
  #line-at(90.024pt, 211.82pt, "employed with limited extensions into high-index electric materials")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(423.55pt, 207.26pt, "20,22,25–27")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(463.78pt, 211.82pt, ". However, ")
  #line-at(90.024pt, 229.94pt, "this spectral range is strongly limiting, first because in the visible range the contribution ")
  #line-at(90.024pt, 247.94pt, "from the fluorescence is typically significant, then because most biomolecules have small ")
  #line-at(90.024pt, 266.06pt, "intrinsic Raman cross-sections in the visible and NIR regions")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(397.27pt, 261.5pt, "28")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.43pt, 266.06pt, ". Therefore, the use of ")
  #line-at(90.024pt, 284.09pt, "higher excitation energy (UV radiation) can contribute to reduce the background ")
  #line-at(90.024pt, 302.21pt, "fluorescence and can lead to UV resonance Raman enhancement thanks to the absorbance ")
  #line-at(90.024pt, 320.33pt, "of the biomolecules in this spectral range (due to the presence of multiple electronic ")
  #line-at(90.024pt, 338.33pt, "resonances)")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(146.54pt, 333.77pt, "29,30")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(164.78pt, 338.33pt, ". Nanostructures, and NPs in particular, based on metals such as aluminum ")
  #line-at(90.024pt, 356.45pt, "(Al), magnesium (Mg), rhodium (Rh) and gallium (Ga) can exhibit localized surface ")
  #line-at(90.024pt, 374.45pt, "plasmon resonances (LSPRs) in the UV or deep-UV wavelength")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(412.39pt, 369.89pt, "28,31–35")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(442.66pt, 374.45pt, ". Recent works ")
  #line-at(90.024pt, 392.57pt, "have reported on the integration of two or more plasmonic materials in the same system ")
  #line-at(90.024pt, 410.57pt, "introducing additional tunability in the spectroscopic properties")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(404.35pt, 406.01pt, "36,37")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(422.59pt, 410.57pt, ". For instance, in a ")
  #line-at(90.024pt, 428.69pt, "recent research we investigated UV-SERS and plasmon-driven photochemistry using a ")
  #line-at(90.024pt, 446.81pt, "composite platform of nanoporous Al decorated with Rh NPs")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(400.87pt, 442.25pt, "38")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(409.03pt, 446.81pt, ". While this approach ")
  #line-at(90.024pt, 464.81pt, "provided valuable insights from averaged UV-SERS spectra, it offered limited control ")
  #line-at(90.024pt, 482.95pt, "over the morphology, size, and spatial distribution of the Rh NPs, which constrained a ")
  #line-at(90.024pt, 506.71pt, "detailed understanding of structure")
  #set text(font: "DengXian", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(254.93pt, 506.71pt, "–")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(260.93pt, 506.71pt, "property relationships at the nanoscale. More recently, ")
  #line-at(90.024pt, 532.15pt, "we developed a strategy for constructing well-defined, programmable Rh nanocube (NCs) ")
  #line-at(90.024pt, 550.27pt, "dimers on DNA origami scaffolds which can precisely host a biomolecule at the hotspot.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(509.62pt, 545.71pt, "39")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 568.39pt, "Rh NCs are an ideal UV‑plasmonic structures due to their strong LSPR in the UV region ")
  #line-at(90.024pt, 586.39pt, "and excellent aqueous stability, properties that have been directly leveraged for effective ")
  #line-at(90.024pt, 604.51pt, "UV‑SERS")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(140.06pt, 599.95pt, "40,41")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(158.18pt, 604.51pt, ". Building upon this tailored UV-plasmonic platform, here we demonstrate ")
  #line-at(90.024pt, 622.51pt, "how this platform can be used to achieve single-protein UV-SERS detection. Furthermore, ")
  #line-at(90.024pt, 640.63pt, "we show a pronounced synergistic enhancement effect between the aluminum film ")
  #line-at(90.024pt, 658.66pt, "substrate and the Rh-NCs-dimer nanoantenna by using well-designed micropattern, ")
  #line-at(90.024pt, 676.78pt, "showing that the UV-SERS spectrum of functionalized streptavidin inside the hotspot can ")
  #line-at(90.024pt, 694.9pt, "be detected consistently only on top of aluminum film. Our observations are further ")
  #line-at(90.024pt, 712.9pt, "confirmed by polarization resolved measurements, confirming previous simulations,")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(497.74pt, 708.34pt, "42–46")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 731.02pt, "that verify the SERS signal of streptavidin is maximized when the polarization of the ")
  #line-at(90.024pt, 749.016pt, "incident laser on sample is aligned parallel to the main axis of the NCs dimer. ")
]

