#original-page(595.32pt, 841.92pt, (image("graphics/page-24.png", width: 381pt), 109.5pt, 89.5pt))[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 217.94pt, "Fig. S5. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(128.06pt, 217.94pt, "Potential configurations of the origami+Rh NCs after the drop cast on the Al substrate. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 270.26pt, "Note #5 - Substrate‑Specific Control on Micropatterned Substrates ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 296.09pt, "To rigorously decouple the plasmonic enhancement originating from the aluminum film from any ")
  #line-at(90.024pt, 314.21pt, "non‑specific background, we performed integrated UV‑SERS mapping on engineered ")
  #line-at(90.024pt, 332.33pt, "micropatterns. These patterns consisted of alternating, well‑defined stripes of aluminum ")
  #line-at(90.024pt, 350.33pt, "(plasmonically active) and silica (plasmonically inactive), as shown in Fig. S6a (inset). ")
  #line-at(90.024pt, 368.45pt, "We tested the system at a ‘0.5X’ DNA‑origami assembly density (average inter‑dimer spacing ")
  #line-at(90.024pt, 386.45pt, "~1 μm). The samples were prepared both with and without the target protein, streptavidin. The full ")
  #line-at(90.024pt, 404.57pt, "set of correlative characterization data—including large‑area SERS maps, spatially resolved ")
  #line-at(90.024pt, 422.57pt, "intensity profiles of the characteristic DNA band at 1061 cm⁻¹, and high‑resolution AFM ")
  #line-at(90.024pt, 440.69pt, "topographs—is compiled in Fig. S6. ")
  #line-at(90.024pt, 458.81pt, "The results demonstrate a definitive, binary response: characteristic SERS signals (from either the ")
  #line-at(90.024pt, 476.83pt, "DNA scaffold or the captured protein) were exclusively and reproducibly detected on the ")
  #line-at(90.024pt, 494.95pt, "aluminum stripes. No measurable signal above the noise floor was obtained from the adjacent ")
  #line-at(90.024pt, 512.95pt, "silica regions. This clear spatial contrast provides direct and visual evidence that the observed ")
  #line-at(90.024pt, 531.07pt, "UV‑SERS enhancement is an intrinsic property of the aluminum‑based plasmonic nanocavity and ")
  #line-at(90.024pt, 549.19pt, "is not supported by the silica substrate. ")
]

