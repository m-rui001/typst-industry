#original-page(595.32pt, 841.92pt, (image("graphics/page-07.png", width: 509.5pt), 43.5pt, 49.5pt))[
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.97pt, 791.136pt, "7")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(45.36pt, 80.28pt, "shuttlecock, which finally spins naturally counter-clockwise. ")
  #line-at(45.36pt, 92.66pt, "During this clockwise to counter-clockwise spining for the ")
  #line-at(45.36pt, 105.14pt, "slice shot of the LH, some kinetic energy is therefore ")
  #line-at(45.36pt, 117.5pt, "transferred to rotation energy, which slows down more the ")
  #line-at(45.36pt, 129.86pt, "shuttlecock. Reversively, the reverse slice shots performed by ")
  #line-at(45.36pt, 142.34pt, "LH induce a natural counter-clockwise spinning, while the ")
  #line-at(45.36pt, 154.7pt, "reverse slice shots performed by RH induce a clockwise to ")
  #line-at(45.36pt, 167.18pt, "counter-clockwise spinning.   ")
  #line-at(56.76pt, 179.54pt, "Figure 9 compares the decrease in shuttlecock velocity after ")
  #line-at(45.36pt, 192.02pt, "slice shots and reverse slice shots for a left-handed player. The ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(45.36pt, 204.38pt, "V(r)")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(62.064pt, 204.38pt, " curves show that the speed decreases more rapidly for the ")
  #line-at(45.36pt, 216.74pt, "left-handed slice shot than for the left-handed reverse slice ")
  #line-at(45.36pt, 229.22pt, "shot, as characterized by the fit of the curves to equation (6), ")
  #line-at(45.36pt, 242.3pt, "which gives a shorter aerodynamic length ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(211.97pt, 242.3pt, "<L>")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(236.45pt, 242.3pt, "4.06 m for the ")
  #line-at(45.36pt, 255.5pt, "LH slice compared to ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
