  #line-at(56.76pt, 244.34pt, "A Phantom Miro 3a10 high-speed camera was used on the ")
  #line-at(45.36pt, 256.82pt, "badminton court to capture high frame rate videos (3000 fps) ")
  #line-at(45.36pt, 269.21pt, "of shuttlecock trajectories. The resolution of the videos was ")
  #line-at(45.36pt, 282.41pt, "maximized to 1280")
  #line-at(133.34pt, 282.41pt, "800 pixels with an exposure time of ")
  #line-at(45.36pt, 294.89pt, "333 µs for each frame. A Canon camera was also used, with a ")
  #line-at(45.36pt, 307.97pt, "capture frame rate set to 500 fps (1920")
  #line-at(218.21pt, 307.97pt, "1080 pixels). The ")
  #line-at(45.36pt, 320.45pt, "videos captured the shots performed on court by elite national ")
  #line-at(45.36pt, 332.93pt, "and international players, during the French international ")
  #line-at(45.36pt, 345.29pt, "badminton championships 2025 (IFB) in Rennes and during a ")
  #line-at(45.36pt, 357.77pt, "session dedicated to the present study. Tracker (23, 24)")
  #line-at(269.45pt, 357.77pt, "a free ")
  #line-at(45.36pt, 370.13pt, "Java video analysis tool, was used to track shuttlecock ")
  #line-at(45.36pt, 382.49pt, "trajectories and extract speed or time-of-flight curves. ")
