#align(center)[
  #text(size: 14pt, weight: "bold")[Frequency modulated enhancement of microwave resonator sensing]
  #v(6pt)
  Pranaya Kishore Rath#super[1], James D. Philips#super[2], Taekwan Yoon#super[2], Kent R. Shirer#super[2],
  Arash Fereidouni#super[2], and Johannes Pollanen#super[1]
