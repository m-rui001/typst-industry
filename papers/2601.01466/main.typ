#original-page(595.32pt, 841.92pt, (image("graphics/page-04.png", width: 462.5pt), 80pt, 77.5pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(139.92pt, 80.28pt, "4. RESULTS ")
  #line-at(42.591pt, 97.68pt, "In this section, we present a comprehensive comparison of the ")
  #line-at(42.591pt, 109.204pt, "three surrogate models under both constant-current and ")
  #line-at(42.581pt, 120.728pt, "dynamic-current conditions. The reference model is the SPM ")
  #line-at(42.581pt, 132.251pt, "solved using finite-difference methods.We also investigate the ")
  #line-at(42.571pt, 143.775pt, "influence of labeled data on model accuracy and generalization ")
  #line-at(42.571pt, 155.299pt, "performance. All training experiments were conducted on an ")
  #line-at(42.571pt, 166.823pt, "NVIDIA RTX 4500 Ada Generation GPU. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(42.571pt, 186.264pt, "4.1 PI-SPM under constant current condition ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(42.571pt, 203.784pt, "First, the three models were evaluated under constant-current ")
  #line-at(42.571pt, 215.308pt, "conditions. The training currents were ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.452pt, 234.869pt, "𝐼𝐼")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.6pt, 236.88pt, "train")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(133.68pt, 234.84pt, "= [1, 2, 4, 6, 8, 10] A,")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(42.596pt, 254.521pt, "and the test currents were ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(119.636pt, 274.082pt, "𝐼𝐼")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(122.76pt, 276.12pt, "test")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(135.72pt, 274.08pt, "= [1.5, 3, 5, 7, 9] A.")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(42.604pt, 293.641pt, "To ensure a relatively fair comparison, the number of neurons ")
  #line-at(42.604pt, 305.165pt, "in each model was adjusted such that all three network ")
  #line-at(42.604pt, 316.689pt, "architectures contained approximately the same number of ")
  #line-at(42.604pt, 328.213pt, "trainable parameters (about 6,650). In addition, all training ")
  #line-at(42.604pt, 339.736pt, "hyperparameters and sampling strategies were kept identical. ")
  #line-at(42.604pt, 351.141pt, "The models were trained using the Adam optimizer with an ")
  #line-at(42.604pt, 362.784pt, "initial learning rate of ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.644pt, 362.784pt, "1 × 10")
  #set text(font: "Cambria Math", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.84pt, 359.04pt, "−4")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(191.04pt, 362.76pt, ", followed by a 90% ")
  #line-at(42.596pt, 374.403pt, "exponential decay every 1,500 epochs. The number of samples ")
  #line-at(42.596pt, 385.927pt, "used for the two boundary conditions and the PDE residual ")
  #line-at(42.596pt, 397.451pt, "were 200, 500, and 2,000, respectively. The total number of ")
  #line-at(42.596pt, 408.974pt, "training epochs was 20,000. ")
  #line-at(42.596pt, 428.416pt, "The performance of the three models on the test data is shown ")
  #line-at(42.596pt, 439.94pt, "in Fig. 3. The accuracy of the split and merged architecture ")
  #line-at(42.586pt, 451.464pt, "shows no significant difference. The DeepONet-based model ")
  #line-at(42.586pt, 462.868pt, "exhibits larger errors and requires longer training time. ")
  #line-at(42.586pt, 474.392pt, "However, this does not imply that the DeepONet architecture ")
  #line-at(42.586pt, 485.915pt, "is inferior to the other two. Because the three architectures ")
  #line-at(42.586pt, 497.439pt, "differ substantially, their optimal hyperparameters may not be ")
  #line-at(42.586pt, 508.963pt, "identical. Although DeepONet shows the worst relative ")
  #line-at(42.586pt, 520.486pt, "performance among the three, its predicted concentrations and ")
  #line-at(42.586pt, 531.891pt, "terminal voltages still agree well with the finite-difference-")
  #line-at(42.586pt, 543.414pt, "based reference solutions, as illustrated in Fig. 4. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(48.24pt, 711.36pt, "Figure 3. Relative ")
  #set text(font: "Cambria Math", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(122.04pt, 711.36pt, "𝐿𝐿")
  #set text(font: "Cambria Math", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
