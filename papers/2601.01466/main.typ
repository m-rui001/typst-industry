#original-page(595.32pt, 841.92pt, (image("graphics/page-01.png", width: 428.5pt), 83.5pt, 189.5pt))[
  #set text(font: "Times New Roman", size: 14.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.44pt, 112.32pt, "Physics-informed neural network surrogate modeling of single particle model ")
  #line-at(232.088pt, 128.396pt, "for lithium-ion batteries ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(153.48pt, 152.76pt, "Yi Zhuang*, Yusheng Zheng*, Yunhong Che*, Remus Teodorescu* ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(112.086pt, 170.28pt, "*Aalborg University, Aalborg, 9220, Denmark (yizhu@energy.aau.dk, yzhe@energy.aau.dk, ")
  #line-at(213.848pt, 181.803pt, "ych@energy.aau.dk, ret@energy.aau.dk )")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.085pt, 200.767pt, "Abstract")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(122.285pt, 200.767pt, ": Physics-based models play a key role in battery management, yet face challenges in real-time ")
  #line-at(85.08pt, 212.28pt, "applications due to the high computational cost of solving coupled algebraic-partial differential equations. ")
  #line-at(85.07pt, 223.804pt, "To accelerate model simulation, this study benchmarks three physics-informed neural network (PINN) ")
  #line-at(85.07pt, 235.327pt, "architectures for modeling the battery single particle model, including two conventional PINN architectures ")
  #line-at(85.06pt, 246.732pt, "and a DeepONet-based architecture. Both the accuracy and the generalization of these PINNs have been ")
  #line-at(85.04pt, 258.255pt, "evaluated and compared under various current conditions. Our results highlight the potential of PINNs in ")
  #line-at(85.04pt, 269.779pt, "modeling battery physics but also reveal limitations of conventional PINN architectures under highly ")
  #line-at(85.05pt, 281.303pt, "dynamic current conditions. Among them, the Fourier-enhanced DeepONet achieves superior ")
  #line-at(85.04pt, 292.827pt, "generalization performance and offers nearly a 10× speedup compared with numerical solvers. This work ")
  #line-at(85.04pt, 304.35pt, "provides an example of integrating physics-based models with data-driven solutions to not only accelerate ")
  #line-at(85.04pt, 315.874pt, "computation but also provide more physical insights. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(85.04pt, 333.274pt, "Keywords")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(125pt, 333.274pt, ": Physics-informed neural networks, Battery modeling, Lithium-ion batteries, Single-particle ")
  #line-at(85.03pt, 344.798pt, "model, Deep operator networks ")
  #line-at(123.84pt, 369.84pt, "1. INTRODUCTION ")
  #line-at(42.596pt, 387.24pt, "Lithium-ion battery pack serves as the primary power and ")
  #line-at(42.606pt, 398.764pt, "energy storage component for electric vehicles, where ")
  #line-at(42.606pt, 410.288pt, "hundreds or even thousands of cells are assembled. As a result, ")
  #line-at(42.606pt, 421.811pt, "the battery management system (BMS) plays a critical role in ")
  #line-at(42.606pt, 433.335pt, "ensuring operational safety, efficiency, and reliability (Li et ")
  #line-at(42.616pt, 444.739pt, "al., 2025). Traditional BMS implementations rely on ")
  #line-at(42.616pt, 456.263pt, "equivalent circuit models (ECMs) for state estimation or ")
  #line-at(42.596pt, 467.787pt, "optimal control. Although these empirical models are ")
  #line-at(42.596pt, 479.31pt, "computationally efficient, they struggle to capture the complex ")
  #line-at(42.596pt, 490.834pt, "electrochemical processes inside the cells during operation. ")
  #line-at(42.596pt, 502.238pt, "This limitation fundamentally restricts the long-term accuracy ")
  #line-at(42.596pt, 513.762pt, "and robustness of ECM-based estimation methods. In contrast, ")
  #line-at(42.586pt, 525.286pt, "physics-based models (PBMs) offer a promising path toward ")
  #line-at(42.586pt, 536.809pt, "next-generation BMS technologies. Based on first-principles ")
  #line-at(42.576pt, 548.333pt, "electrochemical theory, PBMs describe internal battery states ")
  #line-at(42.576pt, 559.857pt, "through coupled partial differential equations and algebraic ")
  #line-at(42.576pt, 571.261pt, "equations, enabling high-fidelity prediction of concentration ")
  #line-at(42.576pt, 582.785pt, "dynamics, reaction kinetics, and internal potentials. However, ")
  #line-at(42.576pt, 594.308pt, "the strong nonlinearity and multi-scale coupling inherent in ")
  #line-at(42.576pt, 605.832pt, "these models pose significant challenges for real-time control ")
  #line-at(42.576pt, 617.356pt, "and onboard implementation, necessitating various model-")
  #line-at(42.576pt, 628.88pt, "reduction strategies. As summarized in Li et al. (2022), ")
  #line-at(42.566pt, 640.284pt, "existing reduction approaches are primarily based on ")
  #line-at(42.566pt, 651.807pt, "mathematical simplifications. ")
  #line-at(42.566pt, 671.369pt, "In recent years, advances in machine learning have opened ")
  #line-at(42.566pt, 682.893pt, "new opportunities for reconstructing physics-based models ")
  #line-at(42.566pt, 694.297pt, "with ")
  #line-at(70.883pt, 694.297pt, "significantly ")
  #line-at(131.473pt, 694.297pt, "improved ")
  #line-at(180.311pt, 694.297pt, "computational ")
  #line-at(248.106pt, 694.297pt, "efficiency. ")
  #line-at(42.566pt, 705.821pt, "Compared with traditional reduced-order modeling techniques, ")
  #line-at(42.566pt, 717.344pt, "data-driven and physics-informed learning methods offer the ")
  #line-at(42.566pt, 728.868pt, "potential to preserve essential electrochemical behavior while ")
  #line-at(42.566pt, 740.392pt, "enabling fast, real-time computation, thus providing a ")
  #line-at(42.556pt, 751.915pt, "powerful alternative for next-generation BMS applications. ")
  #line-at(304.753pt, 369.84pt, "Physics-informed learning methods (Raissi et al., 2019) have ")
  #line-at(304.744pt, 381.364pt, "gained increasing attention due to their data efficiency and ")
  #line-at(304.744pt, 392.887pt, "strong generalization capability. Hassanaly et al. (2024a, ")
  #line-at(304.743pt, 404.411pt, "2024b) developed physics-informed neural network (PINN) ")
  #line-at(304.734pt, 415.935pt, "based surrogate models for both the single particle model ")
  #line-at(304.734pt, 427.458pt, "(SPM) and pseudo-2D (P2D) models without using any ")
  #line-at(304.704pt, 438.863pt, "labeled data, demonstrating the strong potential of PINNs for ")
  #line-at(304.704pt, 450.386pt, "P2D modeling. Lee et al. (2025) also constructed a P2D ")
  #line-at(304.704pt, 461.91pt, "surrogate model using PINNs and proposed a method to ")
  #line-at(304.704pt, 473.434pt, "address the nonlinearity of the Butler–Volmer equation. ")
  #line-at(304.704pt, 484.957pt, "However, a major limitation of these models is that they take ")
  #line-at(304.704pt, 496.362pt, "only time and space as inputs, which restricts their ")
  #line-at(304.704pt, 507.885pt, "applicability to the specific current profiles used during ")
  #line-at(304.704pt, 519.409pt, "training. To further improve the generalization ability of ")
  #line-at(304.704pt, 530.933pt, "PINNs, operator-learning frameworks such as PI-DeepONet ")
  #line-at(304.694pt, 542.457pt, "(Lu et al., 2021a; Wang et al., 2021a) and PI-FNO (Li et al., ")
  #line-at(304.694pt, 553.98pt, "2024) were introduced. These methods learn mappings ")
  #line-at(304.694pt, 565.384pt, "between function spaces and therefore exhibit much stronger ")
  #line-at(304.694pt, 576.908pt, "generalization performance. Zheng et al. (2023) applied PI-")
  #line-at(304.694pt, 588.432pt, "DeepONet to construct an enhanced single particle model ")
  #line-at(304.694pt, 599.956pt, "(ESPM) surrogate model, while Brendel et al. (2025) ")
  #line-at(304.674pt, 611.479pt, "combined PI-DeepONet with Physics-Parameterized PINNs ")
  #line-at(304.664pt, 623.003pt, "(Cho et al., 2024) and spatio-temporal multi-scale Fourier ")
  #line-at(304.654pt, 634.527pt, "features (Wang et al., 2021b) to further enhance generalization. ")
  #line-at(304.654pt, 653.969pt, "Despite these advances, existing studies still lack a systematic ")
  #line-at(304.654pt, 665.492pt, "investigation ")
  #line-at(368.61pt, 665.492pt, "into ")
  #line-at(396.328pt, 665.492pt, "the ")
  #line-at(420.688pt, 665.492pt, "generalization ")
  #line-at(489.564pt, 665.492pt, "limitations ")
  #line-at(544.397pt, 665.492pt, "of ")
  #line-at(304.654pt, 677.016pt, "conventional PINN architectures, as well as how labeled data ")
  #line-at(304.654pt, 688.42pt, "affect PINN performance. Moreover, direct comparisons ")
  #line-at(304.654pt, 699.944pt, "between ")
  #line-at(350.978pt, 699.944pt, "conventional ")
  #line-at(415.658pt, 699.944pt, "PINNs ")
  #line-at(455.736pt, 699.944pt, "and ")
  #line-at(483.214pt, 699.944pt, "operator-learning ")
  #line-at(304.654pt, 711.468pt, "approaches such as PI-DeepONet remain sparse, leaving open ")
  #line-at(304.644pt, 722.991pt, "questions about their relative strengths and applicability to ")
  #line-at(304.644pt, 734.515pt, "battery modeling.  ")
  #line-at(304.644pt, 753.957pt, "To address these gaps, this work makes two primary ")
  #line-at(304.644pt, 765.481pt, "contributions. First, we designed new PINN architectures that ")
]

