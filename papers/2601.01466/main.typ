  #line-at(42.58pt, 538.099pt, "Achieving satisfactory generalization on the test data requires ")
  #line-at(42.58pt, 549.623pt, "incorporating hundreds of GRF current samples into the ")
  #line-at(42.58pt, 561.146pt, "training dataset. However, this substantially increases the ")
  #line-at(42.58pt, 572.67pt, "computational cost. For example, training with 100 current ")
  #line-at(42.58pt, 584.194pt, "samples for 20,000 epochs takes approximately 15 hours.  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(310.44pt, 79.32pt, "Figure 7. Performance of the DeepONet-based PI-SPM under GRF ")
  #line-at(316.083pt, 89.643pt, "test current conditions. (Top: positive-electrode concentration; ")
  #line-at(316.083pt, 100.083pt, "bottom: negative-electrode concentration). ")
  #line-at(310.44pt, 235.8pt, "Figure 8. Error trend with different numbers of training current ")
  #line-at(316.083pt, 246.357pt, "samples. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.8pt, 267.48pt, "The GRF current profile varies only at very low frequencies, ")
  #line-at(304.8pt, 279.004pt, "making the operator relatively easy to learn but not ")
  #line-at(304.8pt, 290.527pt, "representative of real applications. In practice, the current in ")
  #line-at(304.8pt, 302.051pt, "energy-storage systems and electric vehicles is highly dynamic ")
  #line-at(304.8pt, 313.455pt, "and contains frequent abrupt changes. To better capture such ")
  #line-at(304.8pt, 324.979pt, "behavior, we introduce the Random Step Current (RSC) ")
  #line-at(304.8pt, 336.503pt, "profile. The RSC is a piecewise-constant waveform with ")
  #line-at(304.8pt, 348.027pt, "randomly sampled amplitudes and abrupt transitions, resulting ")
  #line-at(304.8pt, 359.55pt, "in a highly dynamic, non-periodic current profile.  ")
  #line-at(304.79pt, 378.992pt, "Fig. 9(a) shows an example of an RSC profile, and Fig. 9(b) ")
  #line-at(304.78pt, 390.516pt, "compares the two electrodes’ surface concentrations predicted ")
  #line-at(304.77pt, 402.04pt, "by the DeepONet-based PI-SPM with the reference solution. ")
  #line-at(304.77pt, 413.563pt, "The results indicate that DeepONet can follow the general ")
  #line-at(304.77pt, 424.968pt, "trend but fails to capture the high-frequency components. This ")
  #line-at(304.77pt, 436.491pt, "limitation is closely related to the spectral bias of fully ")
  #line-at(304.77pt, 448.015pt, "connected neural networks, a well-known pathology that ")
  #line-at(304.75pt, 459.539pt, "prevents PINN-type models from accurately learning high-")
  #line-at(304.75pt, 471.062pt, "frequency functions (Wang et al., 2021b). Wang et al. (2021b) ")
  #line-at(304.74pt, 482.586pt, "analyzed this issue using Neural Tangent Kernel theory and ")
  #line-at(304.74pt, 493.99pt, "proposed two multi-scale architectures: the multi-scale Fourier ")
  #line-at(304.73pt, 505.514pt, "feature architecture and the spatio-temporal multi-scale ")
  #line-at(304.72pt, 517.038pt, "Fourier feature architecture. ")
  #line-at(304.72pt, 536.599pt, "In the spatio-temporal multi-scale Fourier feature method, ")
  #line-at(304.72pt, 548.003pt, "different frequency bands can be selected according to the ")
  #line-at(304.72pt, 559.647pt, "characteristics of the target problem. In this work, we use ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(532.964pt, 559.647pt, "𝜎𝜎")
  #set text(font: "Cambria Math", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(538.2pt, 561.6pt, "𝑟𝑟")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(545.28pt, 559.56pt, "=")
  #line-at(304.796pt, 571.323pt, "1")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(310.314pt, 571.323pt, " and ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.756pt, 571.323pt, "𝜎𝜎")
  #set text(font: "Cambria Math", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(334.92pt, 573.36pt, "𝑡𝑡")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(341.4pt, 571.32pt, "= 30")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(362.754pt, 571.32pt, " to help the network better learn high-frequency ")
  #line-at(304.787pt, 582.963pt, "dynamics in the time domain. As shown in Fig. 9(c), after ")
  #line-at(304.787pt, 594.367pt, "applying the Fourier feature mapping, the predicted surface ")
  #line-at(304.787pt, 605.891pt, "concentrations exhibit significantly improved agreement with ")
  #line-at(304.787pt, 617.415pt, "the dynamic features of the reference solution. ")
  #line-at(304.787pt, 636.976pt, "We further compare the computation time of the traditional ")
  #line-at(304.787pt, 648.38pt, "finite-difference solver (with 50 discretization points in the ")
  #line-at(304.777pt, 659.904pt, "radial domain) and the Fourier-enhanced DeepONet surrogate ")
  #line-at(304.777pt, 671.428pt, "model under the RSC current profile. For 50 repeated ")
  #line-at(304.777pt, 682.952pt, "simulations on a CPU, the average computation times are 551 ")
  #line-at(304.777pt, 694.475pt, "ms for the finite-difference method and 56 ms for the surrogate ")
  #line-at(304.767pt, 705.88pt, "model. This corresponds to approximately a 10× speedup. ")
  #line-at(304.767pt, 717.403pt, "Such an acceleration becomes particularly advantageous in ")
  #line-at(304.767pt, 728.927pt, "scenarios requiring repeated simulations, including sensitivity ")
  #line-at(304.767pt, 740.451pt, "analysis, parameter identification, and real-time control, where ")
  #line-at(304.757pt, 751.974pt, "rapid evaluation of battery models is essential. ")
  #set text(font: "Arial", size: 5.52pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(113.701pt, 311.719pt, "(a)")
  #line-at(112.471pt, 415.128pt, "(c)")
  #line-at(226.88pt, 311.719pt, "(b)")
  #line-at(226.88pt, 415.128pt, "(d)")
]

