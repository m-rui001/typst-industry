  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(130.592pt, 713.16pt, " error of the three models under the test ")
  #line-at(53.883pt, 721.8pt, "conditions. (a) Positive-electrode concentration error. (b) ")
