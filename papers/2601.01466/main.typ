  #line-at(516.599pt, 469.56pt, "1/𝑟𝑟")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(531.958pt, 469.56pt, " term ")
  #line-at(304.8pt, 481.323pt, "at ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(314.521pt, 481.323pt, "𝑟𝑟= 0")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(338.036pt, 481.323pt, ", both sides of the equation are multiplied by ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(519.119pt, 481.323pt, "𝑟𝑟")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(524.039pt, 481.323pt, ".")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(304.8pt, 500.884pt, "3.4 Initial condition hard constraint ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.8pt, 518.404pt, "In the vanilla PINN framework, the initial and boundary ")
  #line-at(304.8pt, 529.808pt, "conditions are imposed by minimizing their residuals within ")
  #line-at(304.8pt, 541.332pt, "the loss function, a strategy commonly referred to as the ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(535.066pt, 541.332pt, "soft-")
  #line-at(304.8pt, 552.855pt, "constraint")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(345.357pt, 552.855pt, " method. Although widely used and often effective, ")
  #line-at(304.8pt, 564.379pt, "incorporating these residual terms inevitably increases the ")
  #line-at(304.8pt, 575.903pt, "training complexity. To alleviate this issue, several studies (Lu ")
  #line-at(304.8pt, 587.427pt, "et al., 2021b; Sukumar and Srivastava, 2022) have proposed ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(304.8pt, 598.831pt, "hard-constraint")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(367.677pt, 598.831pt, " methods, in which the neural network outputs ")
  #line-at(304.8pt, 610.354pt, "are reconstructed such that the initial and boundary conditions ")
  #line-at(304.8pt, 621.878pt, "are inherently satisfied. ")
  #line-at(304.8pt, 641.44pt, "In our work, the output of the neural network ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(489.478pt, 641.44pt, "𝑁𝑁𝑁𝑁(𝑟𝑟̃, 𝑡𝑡̃, 𝐼𝐼; 𝜃𝜃)")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(543.601pt, 641.44pt, " is ")
  #line-at(304.8pt, 653.083pt, "passed through an output-transformation layer to ensure that ")
  #line-at(304.79pt, 664.726pt, "the initial condition")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.107pt, 664.726pt, "𝑐𝑐̃(𝑟𝑟̃, 0) = 𝑐𝑐̃")
  #set text(font: "Cambria Math", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.88pt, 666.72pt, "0")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(461.04pt, 664.68pt, "is exactly satisfied. ")
  #line-at(304.797pt, 676.323pt, "Specifically, the transformed output is defined as ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(367.675pt, 695.885pt, "𝑐𝑐̃(𝑟𝑟̃, 𝑡𝑡̃) = 𝑁𝑁𝑁𝑁(𝑟𝑟̃, 𝑡𝑡̃, 𝐼𝐼; 𝜃𝜃)")
  #line-at(462.962pt, 695.885pt, "𝑡𝑡̃ + 𝑐𝑐̃")
  #set text(font: "Cambria Math", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(483.36pt, 697.92pt, "0")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.92pt, 695.88pt, ",")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.795pt, 715.561pt, "which enforces the initial condition by construction. ")
  #set text(font: "Arial", size: 6.697pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(55.414pt, 717.483pt, "c")
