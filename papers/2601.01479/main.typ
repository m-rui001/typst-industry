  #line-at(217.01pt, 389.93pt, "12")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(223.97pt, 393.89pt, ". The (200) peak exhibits the highest intensity, indicating a ")
  #line-at(72.024pt, 407.45pt, "preferred growth along this plane. These features confirm that the synthesized material is a ZnO–NiO ")
  #line-at(72.024pt, 421.01pt, "composite system. ")
  #line-at(72.024pt, 442.75pt, "As shown in Figure ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(161.3pt, 442.75pt, "2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(166.82pt, 442.75pt, "(a), the Na-doped ZnO films preserved the hexagonal wurtzite phase, which ")
  #line-at(72.024pt, 456.43pt, "indicates successful substitution of Na")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
