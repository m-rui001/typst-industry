  #line-at(323.59pt, 94.58pt, ". This observation suggests that direct contact ")
  #line-at(72.024pt, 107.3pt, "of NiO with the electrolyte facilitates improved charge transfer through its nanoporous network ")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(513.82pt, 103.34pt, "28")
