  #line-at(244.73pt, 456.43pt, " ions i the ZnO crystal lattice. No additional peaks ")
  #line-at(72.024pt, 470.11pt, "corresponding to secondary compounds such as NaCl or Na")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.47pt, 471.07pt, "2")
