  #line-at(369.55pt, 352.49pt, "(b) shows clear peaks at 37.2°, ")
  #line-at(72.024pt, 366.53pt, "43.3°, and 62.9°, indexed to the (111), (200), and (220) planes of cubic NiO (JCPDS card no. 47-")
  #line-at(72.024pt, 380.21pt, "1049). These results confirm the formation of a face-centered cubic (FCC) structure typical of NiO ")
  #line-at(72.024pt, 393.89pt, "synthesized via sol–gel methods ")
