  #line-at(72.024pt, 81.96pt, "This reduction may be due to structural mismatch and defect formation at the interface after doping, ")
  #line-at(72.024pt, 94.58pt, "which can slow charge transfer between the two oxides ")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
