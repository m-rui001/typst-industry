  #line-at(221.64pt, 444.6pt, ". Moreover, thicker high-k dielectrics can be used as gate dielectrics ")
  #line-at(54pt, 465.36pt, "(compared to low-k oxides) without compensation in gate modulation, thus gate leakage and subthreshold ")
  #line-at(54pt, 486pt, "swing (SS) can be reduced, on/off ratio can be increased, and it facilitates device scaling and ultra-large-")
