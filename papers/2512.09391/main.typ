  #set text(font: "Times New Roman", size: 11.977pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.8pt, 382.56pt, ". However, the voltage blocking capability of these devices is still well behind the theoretical ")
  #line-at(54pt, 403.2pt, "limits due to poor electric field management inside the semiconductor. The integration of a good-quality ")
  #line-at(54pt, 423.96pt, "high-k dielectric (k>100) with GaN can significantly reduce the electric field stress hence can improve ")
  #line-at(54pt, 444.6pt, "the voltage blocking capability")
