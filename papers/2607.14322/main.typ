  #line-at(72.024pt, 493.63pt, "with spontaneous conversion from one to another phase. In other words, during evaporation, ")
  #line-at(72.024pt, 514.27pt, "the liquid molecules are evaporated and again re-adsorbed at the liquid-vapor interface. Now, ")
  #line-at(72.024pt, 535.03pt, "near the edge of liquid domain, the probability of re-adsorption is reduced due to the presence ")
  #line-at(72.024pt, 555.67pt, "of solid boundary. Also, the large diffusion angle between the liquid vapor interface and solid ")
  #line-at(72.024pt, 576.43pt, "domain provide more scope for the evaporated molecules to diffuse to far field. As a result, ")
  #line-at(72.024pt, 597.1pt, "the overall diffusion length becomes significantly smaller thereby furnishes steep vapor ")
  #line-at(72.024pt, 617.86pt, "concentration gradient similar to sessile droplets [45]. This sharp concentration gradient ")
  #line-at(72.024pt, 638.5pt, "justifies the diverging nature of the evaporative flux near three-phase contact point of the ")
  #line-at(72.024pt, 659.26pt, "capillary bridges especially for hydrophilic surfaces. In case of SH cases, the interfacial mass ")
  #line-at(72.024pt, 679.9pt, "flux distribution is relatively more uniform i.e., the diverging nature is partially mitigated due ")
  #line-at(72.024pt, 700.54pt, "to reduced wedge angle (i.e., shrunk diffusion domain) between the liquid-vapor interface ")
  #line-at(72.024pt, 721.3pt, "and the solid surface. ")
]

