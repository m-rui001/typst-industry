  #line-at(72.024pt, 235.46pt, "the initial stage. With progressing time, this fluid motion result in internal heat advection ")
  #line-at(72.024pt, 256.13pt, "thereby resulting in generation of multiple local thermal extrema at the interface. This ")
  #line-at(72.024pt, 276.89pt, "condition results in formation of multiple local vortices temporarily adjacent the interface ")
  #line-at(72.024pt, 297.53pt, "during the flow developing stages. Finally, at stable state, the primary cooling spot shifts ")
