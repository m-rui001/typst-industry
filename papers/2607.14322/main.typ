#original-page(595.32pt, 841.92pt, (image("graphics/page-02.png", width: 156.5pt), 124.5pt, 750.5pt))[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
