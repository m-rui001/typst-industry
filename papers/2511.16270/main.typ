  #line-at(90.024pt, 375.05pt, "2.1 Theory of damage location method for fan-shaped sensor cluster ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 404.83pt, "The fan-shaped sensor cluster structure proposed in this paper consists of five ")
  #line-at(90.024pt, 424.39pt, "sensors. Among them, three sensors are arranged in an equidistant linear array, while ")
  #line-at(90.024pt, 443.83pt, "the remaining two sensors form a set of symmetric L-shaped structures with the ")
  #line-at(90.024pt, 463.39pt, "sensor at the center of the linear array as the vertex. The L-shaped sensor cluster is an ")
  #line-at(90.024pt, 482.83pt, "isosceles right triangle structure, and the side length of the right-angle side is the same ")
  #line-at(90.024pt, 502.39pt, "as the distance of the linear array. Xue et al. ")
