  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.1pt, 417.43pt, ". Among various NDT methods, the detection technology based on Lamb ")
  #line-at(90.024pt, 436.99pt, "waves has great application potential in the nondestructive testing of large plate ")
  #line-at(90.024pt, 456.43pt, "structures")
