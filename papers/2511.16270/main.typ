  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(159.38pt, 495.43pt, ". When conducting detection using Lamb waves, sensors are typically ")
  #line-at(90.024pt, 514.99pt, "placed on the surface of plate-like materials to actively generate excitation signals. ")
  #line-at(90.024pt, 534.43pt, "Meanwhile, additional sensors are placed at other locations to receive the Lamb wave ")
  #line-at(90.024pt, 554.02pt, "signals. Subsequent processing and analysis of the collected signals allow damage ")
  #line-at(90.024pt, 573.46pt, "detection in the plate.")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
