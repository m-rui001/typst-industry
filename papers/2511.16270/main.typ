  #line-at(100.34pt, 373.85pt, "]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(102.5pt, 378.41pt, ". It utilizes physical phenomena such as sound, heat, light, electricity, and ")
