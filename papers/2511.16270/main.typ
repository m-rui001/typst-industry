  #line-at(316.63pt, 497.83pt, "]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(318.79pt, 502.39pt, " confirmed through formula derivation ")
  #line-at(90.024pt, 521.83pt, "and experimental verification that when the source is in the 45° direction relative to ")
  #line-at(90.024pt, 541.39pt, "the LSSC, the LSSC localization method can accurately locate the source. Therefore, ")
  #line-at(90.024pt, 560.86pt, "for the fan-shaped sensor cluster, the angle between the right-angle sides of the ")
