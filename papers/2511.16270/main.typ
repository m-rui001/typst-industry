  #line-at(502.3pt, 593.02pt, ", ")
  #line-at(90.024pt, 612.46pt, "various array signal processing methods are also developing rapidly. Beamforming ")
  #line-at(90.024pt, 632.02pt, "has been widely used in the field of NDT in recent years due to its excellent ")
  #line-at(90.024pt, 651.46pt, "performance in directional signal transmission and reception ")
