#original-page(595.32pt, 841.92pt, (image("graphics/page-04.png", width: 418.5pt), 88.5pt, 72pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 85.94pt, "approaches effectively reduce localization blind zones and improve both the accuracy ")
  #line-at(90.024pt, 105.38pt, "and stability of localization. ")
  #line-at(114.02pt, 124.94pt, "In order to further reduce the blind area of damage location, based on the above ")
  #line-at(90.024pt, 144.38pt, "work, a damage location method with fan-shaped sensor clusters is proposed in this ")
  #line-at(90.024pt, 163.94pt, "paper. Through two groups of sector sensor clusters and one sensor transmitting ")
  #line-at(90.024pt, 183.38pt, "excitation signal, the beamforming and LSSC location methods are combined to ")
  #line-at(90.024pt, 202.94pt, "enhance the accuracy of localization results. The simulation and experiment are ")
  #line-at(90.024pt, 222.38pt, "carried out, and the damage location results using this method are compared with ")
  #line-at(90.024pt, 241.97pt, "those using T-shaped sensor cluster. The simulation and experimental results show ")
  #line-at(90.024pt, 261.41pt, "that the proposed method can enhance the accuracy of localization results. This ")
  #line-at(90.024pt, 280.97pt, "method can provide a new approach for damage detection of large structures. ")
  #set text(font: "Times New Roman", size: 15.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 334.25pt, "2. Theory")
  #line-at(157.34pt, 334.25pt, "for damage localization")
