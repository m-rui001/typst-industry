  #set text(font: "Times New Roman", size: 15.96pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 222.74pt, "1. Introduction")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 261.41pt, "Plate structure is widely used in aerospace, hull manufacturing, construction and ")
  #line-at(90.024pt, 280.97pt, "other large structures. When the structure is damaged due to long-term use, such as ")
  #line-at(90.024pt, 300.41pt, "corrosion, leakage or foreign object impact, the stability of the structure will be ")
  #line-at(90.024pt, 319.97pt, "affected. If the damaged location is not identified and repaired in a timely manner, it ")
  #line-at(90.024pt, 339.41pt, "may lead to economic losses and even casualties")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
