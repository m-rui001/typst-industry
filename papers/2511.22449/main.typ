#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "YuMincho-Regular", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.84pt, 785.28pt, "2 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(53.998pt, 84.001pt, "The charge degree of freedom of point defects has emerged as a key factor in realizing solid-state quantum ")
  #line-at(53.998pt, 100.443pt, "technologies. Stable charge states under optical irradiation are crucial for achieving bright emission and spectral ")
  #line-at(53.998pt, 116.758pt, "stability in the spin–photon interface")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(215.04pt, 113.28pt, "1–3")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(225.48pt, 116.76pt, ", whereas controlled charge cycling underpins efficient spin readout via ")
  #line-at(53.996pt, 133.202pt, "photoelectrically detected magnetic resonance (PDMR)")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(289.2pt, 129.72pt, "4")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(292.68pt, 133.2pt, ", enabling scalable and highly integrated quantum devices. ")
  #line-at(54.003pt, 149.642pt, "These two applications impose opposite requirements in ionization: suppression or enhancement, yet both ")
  #line-at(54.003pt, 165.957pt, "fundamentally rely on a quantitative understanding of ionization cross-sections and charge dynamics. ")
  #line-at(54.013pt, 198.841pt, "Negatively charged silicon vacancies (")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(216.131pt, 198.841pt, "S")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(221.411pt, 198.841pt, "=3/2)")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(244.32pt, 195.36pt, "5")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(247.8pt, 198.84pt, " in the 4H polytype of silicon carbide (4H-SiC), namely V1 and V2 at ")
  #line-at(54.003pt, 215.155pt, "quasi-hexagonal and -cubic sites, respectively, and have attracted considerable attention as highly promising quantum ")
  #line-at(54.003pt, 231.597pt, "defects")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(83.76pt, 228.12pt, "6–8")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(94.2pt, 231.6pt, ". Their excellent spin–photon properties, including long spin coherence")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(416.64pt, 228.12pt, "6,7,9,10 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(443.76pt, 231.6pt, "access to nuclear-spin ")
  #line-at(54.011pt, 248.042pt, "memory")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(89.04pt, 244.56pt, "9,11")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(101.04pt, 248.04pt, ", spectral stability")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(175.32pt, 244.56pt, "7,9,12,13")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(201.6pt, 248.04pt, ", and recently demonstrated spin–photon entanglement")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(431.16pt, 244.56pt, "14")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.12pt, 248.04pt, " and nuclear-spin single-")
  #line-at(54.011pt, 264.355pt, "shot readout")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.88pt, 260.88pt, "15,16")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.6pt, 264.36pt, ", make them strong candidates for quantum networking applications. Moreover, recent ")
  #line-at(54pt, 280.802pt, "demonstrations of their integration into nanophotonic structures")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(320.4pt, 277.32pt, "9,17–19 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(344.76pt, 280.8pt, "and the enhanced spectral stability achieved by ")
  #line-at(54.001pt, 297.242pt, "embedding defects in diode devices")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(202.8pt, 293.76pt, "20–22")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(220.2pt, 297.24pt, ", which are compatible with wafer-scale semiconductor fabrication, highlight ")
  #line-at(54.007pt, 313.555pt, "the technological maturity of SiC platform. In parallel, V2 centers have enabled highly sensitive photoelectrical spin ")
  #line-at(54.007pt, 329.997pt, "readout via PDMR, from single-defect detection to large-ensemble defects including nuclear spins")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.08pt, 326.52pt, "23–25")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.48pt, 330pt, ". PDMR ")
  #line-at(54.001pt, 346.442pt, "implementations likewise benefit from the device-integration advantages of a mature SiC electronics platform, which ")
  #line-at(54.001pt, 362.757pt, "is available on large-scale wafers. Consequently, silicon vacancies in SiC are poised to play a central role in scalable ")
  #line-at(54.012pt, 379.199pt, "quantum technologies. ")
  #line-at(54.012pt, 411.956pt, "Despite these advances, the charge stability and ionization efficiency of silicon vacancies under optical irradiation ")
  #line-at(54.012pt, 428.398pt, "remain insufficiently understood. A major obstacle is the absence of a clear optical signature of charge-state ")
  #line-at(54.012pt, 444.84pt, "transitions. Unlike nitrogen–vacancy centers in diamond, which exhibit photoinduced blinking")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.4pt, 441.36pt, "26,27")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(465.12pt, 444.84pt, ", silicon vacancies ")
  #line-at(53.998pt, 461.155pt, "rarely show detectable blinking under optical excitation")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(284.28pt, 457.68pt, "6,28")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(296.4pt, 461.16pt, ", making their charge dynamics difficult to access optically. ")
  #line-at(53.995pt, 477.602pt, "Recent low-temperature charge-resonance-check (CRC) techniques provide partial information on charge-state ")
  #line-at(53.985pt, 494.044pt, "dynamics")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(94.32pt, 490.56pt, "21 ")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(103.56pt, 494.04pt, "including the charge fluctuations in the surrounding defect environment, yet the excitation-wavelength ")
  #line-at(54.012pt, 510.355pt, "dependence of silicon-vacancy ionization has not been determined conclusively. ")
  #line-at(54.012pt, 543.239pt, "In PDMR experiments, in which photoionized carriers are measured for spin detection, the primary factor is the ")
  #line-at(54.012pt, 559.554pt, "wavelength dependence of the excitation and ionization efficiencies of the relevant charge states of the target defect, ")
  #line-at(54.012pt, 575.996pt, "as demonstrated for the nitrogen–vacancy center in diamond")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(320.88pt, 572.52pt, "29")
  #set text(font: "Times New Roman", size: 10.56pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(327.84pt, 576pt, ". Further, an additional complication arises from ")
  #line-at(53.998pt, 592.442pt, "background photocurrent. At room temperature, only the V2 center contributes to the spin-dependent signal. In ")
  #line-at(54.009pt, 608.757pt, "contrast, the V1 center and other defects generate spin-insensitive photocurrent, increasing the background ")
  #line-at(54.019pt, 625.199pt, "photocurrent and reducing the signal-to-noise ratio of V2 PDMR. Understanding the physical origin and spectral ")
  #line-at(54.03pt, 641.641pt, "characteristics of both V2 and background photocurrents is therefore essential for optimizing PDMR measurements. ")
  #line-at(54.04pt, 674.398pt, "In this work, we address these challenges by directly detecting and imaging photocurrent from individual V1 and V2 ")
  #line-at(54.04pt, 690.84pt, "centers. Direct charge measurements allow us to probe charge-cycling events, while the imaging enables us to ")
  #line-at(54.051pt, 707.155pt, "disentangle defect-origin photocurrent from background contributions and to determine the excitation-wavelength ")
  #line-at(54.051pt, 723.597pt, "dependence of both the ionization efficiency of silicon vacancies and the background defects. With these capabilities, ")
  #line-at(54.04pt, 740.039pt, "we provide insight into the charge robustness of silicon vacancies and their surrounding environment for spin–photon ")
]

