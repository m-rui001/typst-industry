    title = {Microfabrication of large-area circular high-stress silicon nitride membranes for optomechanical applications},
    journal = {AIP Advances},
    volume = {6},
    number = {6},
    pages = {065004},
    year = {2016},
    month = {06},
    abstract = { In view of the integration of membrane resonators with more complex MEMS structures, we developed a general fabrication procedure for circular shape SiNx membranes using Deep Reactive Ion Etching (DRIE). Large area and high-stress SiNx membranes were fabricated and used as optomechanical resonators in a Michelson interferometer, where Q values up to 1.3 × 106 were measured at cryogenic temperatures, and in a Fabry-Pérot cavity, where an optical finesse up to 50000 has been observed. },
    issn = {2158-3226},
    doi = {10.1063/1.4953805},
    url = {https://doi.org/10.1063/1.4953805},
    eprint = {https://pubs.aip.org/aip/adv/article-pdf/doi/10.1063/1.4953805/12912299/065004\_1\_online.pdf},
}

