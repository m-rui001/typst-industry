#original-page(612pt, 792pt, (image("graphics/page-01.png", width: 2.5pt), 144.5pt, 325pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(560.26pt, 30.96pt, "1 ")
  #set text(font: "Times New Roman", size: 24pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(47.04pt, 78.5pt, "Physics-Informed Neural Networks for Device and ")
  #line-at(57.96pt, 106.1pt, "Circuit Modeling: A Case Study of NeuroSPICE")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(146.18pt, 132.38pt, "Chien-Ting Tung, ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(228.41pt, 132.38pt, "Member, IEEE")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.41pt, 132.38pt, ", and Chenming Hu, ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(385.99pt, 132.38pt, "Life Fellow, IEEE")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(49.08pt, 170.18pt, "Abstract")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(80.184pt, 170.18pt, "—We present NeuroSPICE, a physics-informed neural ")
  #line-at(46.8pt, 181.22pt, "network (PINN) framework for device and circuit simulation. ")
  #line-at(46.8pt, 192.14pt, "Unlike conventional SPICE, which relies on time-discretized ")
  #line-at(46.8pt, 203.06pt, "numerical solvers, NeuroSPICE leverages PINNs to solve circuit ")
  #line-at(46.8pt, 213.86pt, "differential-algebraic equations (DAEs) by minimizing the ")
  #line-at(46.8pt, 224.78pt, "residual of the equations through backpropagation. It models ")
  #line-at(46.8pt, 235.58pt, "device and circuit waveforms using analytical equations in time ")
  #line-at(46.8pt, 246.53pt, "domain with exact temporal derivatives. While PINNs do not ")
  #line-at(46.8pt, 257.33pt, "outperform SPICE in speed or accuracy during training, they ")
  #line-at(46.8pt, 268.25pt, "offer unique advantages such as surrogate models for design ")
  #line-at(46.8pt, 279.05pt, "optimization and inverse problems. NeuroSPICE’s flexibility ")
  #line-at(46.8pt, 289.97pt, "enables the simulation of emerging devices, including highly ")
  #line-at(46.8pt, 300.89pt, "nonlinear systems such as ferroelectric memories.  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(46.8pt, 323.09pt, "Index Terms")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(94.464pt, 323.09pt, "—Neural network, machine learning, SPICE, circuit ")
  #line-at(46.8pt, 333.41pt, "modeling, device modling  ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(131.06pt, 356.69pt, "I.")
  #line-at(138.98pt, 356.69pt, "INTRODUCTION ")
  #line-at(73.824pt, 372.29pt, "PICE")
  #line-at(101.9pt, 372.29pt, "(Simulation Program with Integrated Circuit ")
  #line-at(73.824pt, 384.29pt, "Emphasis) was developed at UC Berkeley as a general-")
  #line-at(73.824pt, 396.41pt, "purpose differential system solver [1]. Modern circuit ")
  #line-at(46.8pt, 408.41pt, "simulators solve discretized differential and algebraic ")
  #line-at(46.8pt, 420.55pt, "equations using well-established numerical methods [1], [2]. ")
  #line-at(46.8pt, 432.67pt, "As device research expands, chips increasingly integrate ")
  #line-at(46.8pt, 444.67pt, "emerging physical effects such as ferroelectric (FE) materials ")
  #line-at(46.8pt, 456.79pt, "[3], photonic elements [4], [5], and three-dimensional thermal ")
  #line-at(46.8pt, 468.91pt, "coupling in 3DICs [6] that require new device formulations ")
  #line-at(46.8pt, 480.91pt, "and Multiphysics coupling not easily expressed or maintained ")
  #line-at(46.8pt, 493.03pt, "in existing SPICE compact-model workflows. ")
  #line-at(46.8pt, 505.03pt, "    On the other hand, artificial intelligence (AI) benefits from ")
  #line-at(46.8pt, 517.15pt, "enhancing IC technology. AI or neural networks (NN) can ")
  #line-at(46.8pt, 529.27pt, "learn the relationship between input and output data through ")
  #line-at(46.8pt, 541.27pt, "training. However, NN can also be used without data using ")
  #line-at(46.8pt, 553.39pt, "loss functions based on physics equations as a physics-")
  #line-at(46.8pt, 565.39pt, "informed neural network (PINN) [7]. PINN solves the ")
  #line-at(46.8pt, 577.51pt, "differential equations by minimizing the residual in the loss ")
  #line-at(46.8pt, 589.66pt, "function. The differential equations define the loss function, ")
  #line-at(46.8pt, 601.66pt, "and no data is needed. Several studies have demonstrated ")
  #line-at(46.8pt, 613.78pt, "PINN for applications such as power system simulation [8], ")
  #line-at(46.8pt, 625.9pt, "[9] and transistor simulation [10]. So far, there has been no ")
  #line-at(46.8pt, 637.9pt, "study applying PINN to circuit simulations.  ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 663.1pt, "    This work was supported by the Berkeley Device Modeling Center, ")
  #line-at(46.8pt, 672.82pt, "University of California at Berkeley, Berkeley, CA, USA. The review of this ")
  #line-at(46.8pt, 682.42pt, "article was arranged by Editor XXX. (Corresponding author: Chien-Ting ")
  #line-at(46.8pt, 692.136pt, "Tung.) ")
  #line-at(56.88pt, 701.736pt, "The authors are with the Department of Electrical Engineering and ")
  #line-at(46.8pt, 711.456pt, "Computer Sciences, University of California at Berkeley, Berkeley, CA 94720 ")
  #line-at(46.8pt, 721.056pt, "USA (e-mail: cttung@berkeley.edu). ")
  #line-at(56.88pt, 730.776pt, "Color versions of one or more of the figures in this article are available ")
  #line-at(46.8pt, 740.016pt, "online at http://ieeexplore.ieee.org. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.25pt, 170.54pt, "    In this paper, we investigate the feasibility of PINN as ")
  #line-at(313.25pt, 182.66pt, "circuit simulator. NeuroSPICE is a physics-informed neural ")
  #line-at(313.25pt, 194.66pt, "network (PINN) framework that represents circuit unknowns ")
  #line-at(313.25pt, 206.78pt, "(node voltages and selected branch currents) as continuous ")
  #line-at(313.25pt, 218.78pt, "functions of time by taking time as an explicit network input. ")
  #line-at(313.25pt, 230.9pt, "During training, the network outputs are differentiated with ")
  #line-at(313.25pt, 243.02pt, "respect to time via backpropagation to obtain analytical time ")
  #line-at(313.25pt, 255.05pt, "derivatives. This continuous, differentiable representation ")
  #line-at(313.25pt, 267.17pt, "avoids finite-difference time approximations during loss ")
  #line-at(313.25pt, 279.29pt, "evaluation and makes it straightforward to express device and ")
  #line-at(313.25pt, 291.29pt, "Multiphysics equations inside a single Python environment. ")
  #line-at(313.25pt, 303.41pt, "NeuroSPICE lowers the barrier to rapid prototyping of ")
  #line-at(313.25pt, 315.41pt, "emerging device models (no Verilog-A required), naturally ")
  #line-at(313.25pt, 327.53pt, "accommodates Multiphysics or higher-order formulations. It ")
  #line-at(313.25pt, 339.65pt, "can be potentially used as differentiable circuit surrogate ")
  #line-at(313.25pt, 351.65pt, "model for design optimization. ")
  #line-at(401.71pt, 376.25pt, "II.")
  #line-at(412.99pt, 376.25pt, "M")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(421.87pt, 376.25pt, "ETHODOLOGY")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.35pt, 391.73pt, "NeuroSPICE is formulated as a physics-informed neural ")
  #line-at(313.25pt, 403.85pt, "network (PINN) (Fig. 1). The network input is time ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(529.3pt, 403.85pt, "t")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(532.06pt, 403.85pt, " and the ")
  #line-at(313.25pt, 415.87pt, "network outputs are node voltages (and, where desired, branch ")
  #line-at(313.25pt, 427.99pt, "currents); the input may be extended to include design ")
  #line-at(313.25pt, 440.11pt, "parameters or spatial coordinates for Multiphysics problems ")
  #line-at(313.25pt, 452.11pt, "beyond conventional SPICE simulation. NeuroSPICE replaces ")
  #line-at(313.25pt, 464.23pt, "numerical time stepping with a neural network that directly ")
  #line-at(313.25pt, 476.23pt, "represents the entire waveform as an analytical function of ")
  #line-at(313.25pt, 488.35pt, "time. During training, a set of time points spanning the ")
  #line-at(313.25pt, 500.47pt, "simulation interval is presented to the network as the input ")
  #line-at(313.25pt, 512.47pt, "vector, and the network returns an array of voltages (or ")
  #line-at(313.25pt, 524.59pt, "currents) evaluated at those time points. These output ")
  #line-at(313.25pt, 536.71pt, "waveforms are therefore represented by the neural network as ")
  #line-at(313.25pt, 548.71pt, "continuous, analytical functions of time.  The loss function is ")
  #line-at(313.25pt, 560.83pt, "constructed ")
  #line-at(374.873pt, 560.83pt, "from ")
  #line-at(409.633pt, 560.83pt, "the ")
  #line-at(437.212pt, 560.83pt, "residuals ")
  #line-at(488.168pt, 560.83pt, "of ")
  #line-at(512.012pt, 560.83pt, "the ")
  #line-at(539.591pt, 560.83pt, "circuit ")
  #line-at(313.25pt, 572.83pt, "differential-algebraic ")
  #line-at(409.586pt, 572.83pt, "equations ")
  #line-at(459.704pt, 572.83pt, "(DAEs) ")
  #line-at(502.622pt, 572.83pt, "together ")
  #line-at(547.332pt, 572.83pt, "with ")
  #line-at(313.25pt, 584.98pt, "initial-condition constraints; an optimizer updates the network ")
  #line-at(313.25pt, 597.1pt, "parameters to minimize this loss driving the DAE residuals ")
  #line-at(313.25pt, 609.1pt, "and initial-condition errors toward zero. ")
  #line-at(323.35pt, 621.22pt, "Fig. 2 illustrates a representative DAE for a transistor ")
  #line-at(313.25pt, 633.22pt, "amplifier, formed by applying Kirchhoff’s current law at each ")
  #line-at(313.25pt, 645.34pt, "node. The MOSFET model is implemented in Python as ")
  #line-at(313.25pt, 657.46pt, "shown in Fig. 3. Unlike typical SPICE device models (for ")
  #line-at(313.25pt, 669.46pt, "example, BSIM models written in Verilog-A [11], [12]), ")
  #line-at(313.25pt, 681.58pt, "which are evaluated inside a simulator with limited user ")
  #line-at(313.25pt, 693.696pt, "control, NeuroSPICE implements device models in Python to ")
  #line-at(313.25pt, 705.696pt, "facilitate rapid prototyping. Device models may return ")
  #line-at(313.25pt, 717.816pt, "currents, charges, or other quantities beyond the conventional ")
  #line-at(313.25pt, 729.816pt, "voltage–current interface. A key feature of NeuroSPICE is that  ")
  #set text(font: "Times New Roman", size: 48.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 396.41pt, "S ")
]

