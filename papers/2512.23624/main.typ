#original-page(612pt, 792pt, (image("graphics/page-02.png", width: 254pt), 47.5pt, 50pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(560.26pt, 16.56pt, "2 ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 198.26pt, "Fig. 1.")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(71.664pt, 198.26pt, " The schematic diagram of NeuroSPICE. The loss function is ")
  #line-at(46.8pt, 209.18pt, "the DAE of the circuit and the initial condition. The neural network ")
  #line-at(46.8pt, 220.1pt, "will update its parameters to minimize loss. I.C. is the initial ")
  #line-at(46.8pt, 230.9pt, "condition.  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 386.45pt, "Fig. 2.")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(71.784pt, 386.45pt, " Example DAE of a transistor amplifier and its loss function. ")
  #line-at(46.8pt, 397.37pt, "In this case, the KCL of each node will be solved including the ")
  #line-at(46.8pt, 408.29pt, "current of the nmos. The time derivative is computed by the autograd ")
  #line-at(46.8pt, 419.11pt, "function during backpropagation. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 607.3pt, "Fig. 3.")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(71.544pt, 607.3pt, " The pseudocode of the device model. The MOSFET DC and ")
  #line-at(46.8pt, 618.22pt, "switching currents are computed and returned to the loss function. ")
  #line-at(46.8pt, 629.14pt, "Charge currents (dQ/dt) are analytically computed by autograd.")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(46.8pt, 654.46pt, "these temporal derivatives such as dV/dt and dQ/dt (Fig. 3) are ")
  #line-at(46.8pt, 666.58pt, "obtained analytically via automatic differentiation (autograd) ")
  #line-at(46.8pt, 678.58pt, "provided by machine-learning frameworks such as PyTorch ")
  #line-at(46.8pt, 690.7pt, "[13]. Because the neural network represents nodal voltages as ")
  #line-at(46.8pt, 702.816pt, "explicit functions of the input time and autograd applies the ")
  #line-at(46.8pt, 714.816pt, "chain rule during back propagation, dV/dt, dQ/dt, and related ")
  #line-at(46.8pt, 726.936pt, "quantities are computed exactly from the network’s analytical ")
  #line-at(46.8pt, 738.936pt, "representation rather than by finite-difference approximations. ")
  #line-at(313.25pt, 59.76pt, "Consequently, NeuroSPICE does not require time-domain ")
  #line-at(313.25pt, 71.88pt, "discretization, linearization, or numerical integration schemes ")
  #line-at(313.25pt, 83.9pt, "(e.g., backward Euler) used in conventional transient SPICE ")
  #line-at(313.25pt, 96.02pt, "solvers. All required derivatives are available analytically ")
  #line-at(313.25pt, 108.02pt, "during both training and inference. This allows easy ")
  #line-at(313.25pt, 120.14pt, "implementation of emerging device models and Multiphysics ")
  #line-at(313.25pt, 132.26pt, "models without knowing the numerical details in conventional ")
  #line-at(313.25pt, 144.26pt, "SPICE. The total loss is a weighted sum of the DAE residual ")
  #line-at(313.25pt, 156.38pt, "loss (DAE")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(359.11pt, 157.34pt, "loss")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(369.19pt, 156.38pt, ") and the initial-condition loss (IC")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(525.1pt, 157.34pt, "loss")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(535.18pt, 156.38pt, "), with ")
  #line-at(313.25pt, 168.5pt, "coefficients a and b chosen to balance these terms [14].  ")
  #line-at(385.99pt, 192.5pt, "III.")
  #line-at(400.63pt, 192.5pt, "R")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407.23pt, 192.5pt, "ESULT ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(434.11pt, 192.5pt, "&")
  #line-at(443.95pt, 192.5pt, "D")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(451.18pt, 192.5pt, "ISCUSSION")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.35pt, 207.98pt, "NeuroSPICE ")
  #line-at(386.516pt, 207.98pt, "is ")
  #line-at(404.146pt, 207.98pt, "implemented ")
  #line-at(467.5pt, 207.98pt, "with ")
  #line-at(496.274pt, 207.98pt, "Pytorch, ")
  #line-at(540.916pt, 207.98pt, "Adam ")
  #line-at(313.25pt, 220.1pt, "optimizer, and Tanh activation function. All cases use a 4-")
  #line-at(313.25pt, 232.22pt, "layer fully connected neural network with 50 neurons in each ")
  #line-at(313.25pt, 244.22pt, "hidden layer. Training is done on a NVIDIA Quadro Pro GPU. ")
  #line-at(323.35pt, 256.37pt, "We evaluate NeuroSPICE with some simple MOSFET ")
  #line-at(313.25pt, 268.37pt, "circuits. The transient response of the transistor amplifier in Fig. 2 ")
  #line-at(313.25pt, 280.49pt, "is shown in Fig. 4, and HSPICE is used as a reference. The ")
  #line-at(313.25pt, 292.61pt, "NeuroSPICE-calculated V")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(416.11pt, 293.57pt, "D")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(420.55pt, 292.61pt, " and V")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(449.62pt, 293.57pt, "G")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(454.06pt, 292.61pt, " closely match the HSPICE ")
  #line-at(313.25pt, 304.61pt, "results. Fig. 5 shows a more complex five-stage ring oscillator; ")
  #line-at(313.25pt, 316.73pt, "these results demonstrate that NeuroSPICE can simulate unstable, ")
  #line-at(313.25pt, 328.73pt, "self-oscillating systems and solve DAEs that include multiple ")
  #line-at(313.25pt, 340.85pt, "nonlinear device models.  ")
  #line-at(323.35pt, 352.97pt, "NeuroSPICE is also a flexible platform for emerging devices ")
  #line-at(313.25pt, 364.97pt, "and systems. As an example, FE devices are a promising ")
  #line-at(313.25pt, 377.09pt, "technology for low-power in-memory computing. However, it is ")
  #line-at(313.25pt, 389.21pt, "difficult to implement a well-posed ferroelectric compact model ")
  #line-at(313.25pt, 401.21pt, "in SPICE simulators since it requires not only deep understanding ")
  #line-at(313.25pt, 413.35pt, "of ferroelectric physics but also the knowledge of Verilog-A ")
  #line-at(313.25pt, 425.35pt, "coding and circuit simulations [3]. The Landau–Khalatnikov ")
  #line-at(313.25pt, 437.47pt, "(LK) model [15] is commonly used to describe FE material ")
  #line-at(313.25pt, 449.59pt, "dynamics which is highly nonlinear. In NeuroSPICE, it is ")
  #line-at(313.25pt, 461.59pt, "straightforward to implement this model in DAE form. Fig. 6 ")
  #line-at(313.25pt, 473.71pt, "demonstrates NeuroSPICE’s flexibility by simulating a FeRAM ")
  #line-at(313.25pt, 485.83pt, "cell that couples the LK FE model with the MOSFET model. ")
  #line-at(313.25pt, 497.83pt, "NeuroSPICE reproduces the voltage drop associated with ")
  #line-at(313.25pt, 509.95pt, "polarization switching in the FE capacitor. ")
  #line-at(323.35pt, 521.95pt, "Table I summarizes the hyperparameters used for each case. ")
  #line-at(313.25pt, 534.07pt, "We observe that highly nonlinear devices and circuits require ")
  #line-at(313.25pt, 546.19pt, "more training epochs. In the FeRAM example, the LK model ")
  #line-at(313.25pt, 558.19pt, "necessitated a larger number of epochs and a smaller learning rate ")
  #line-at(313.25pt, 570.31pt, "to reach convergence. The training time for NeuroSPICE is ")
  #line-at(313.25pt, 582.34pt, "longer than that of commercial SPICE, primarily because Python ")
  #line-at(313.25pt, 594.46pt, "implementations are slower than optimized C/C++ code and ")
  #line-at(313.25pt, 606.58pt, "because the PINN’s internal matrices are typically larger than the ")
  #line-at(313.25pt, 618.58pt, "circuit’s nodal matrices. Thus, we do not think NeuroSPICE is a ")
  #line-at(313.25pt, 630.7pt, "direct replacement for SPICE in normal circuit simulations. ")
  #line-at(313.25pt, 642.82pt, "Despite the longer training time, NeuroSPICE inference is ")
  #line-at(313.25pt, 654.82pt, "comparable to or faster than SPICE (approximately 200 µs in our ")
  #line-at(313.25pt, 666.94pt, "tests). Because NeuroSPICE represents node voltages and branch ")
  #line-at(313.25pt, 678.94pt, "quantities as continuous, differentiable functions of time and ")
  #line-at(313.25pt, 691.06pt, "computes exact temporal derivatives via automatic differentiation, ")
  #line-at(313.25pt, 703.176pt, "the framework is fully differentiable; by training NeuroSPICE ")
  #line-at(313.25pt, 715.176pt, "with design parameters, NeuroSPICE can serve as a differentiable ")
  #line-at(313.25pt, 727.296pt, "circuit surrogate in inference for inverse design and ")
  #line-at(313.25pt, 739.296pt, "gradient-based optimization, with analytically represented output ")
]

