  #line-at(427.03pt, 59.76pt, "ONCLUSION")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.35pt, 76.08pt, "We study NeuroSPICE, a PINN-based circuit simulator that ")
  #line-at(313.25pt, 88.22pt, "transcends the numerical time-stepping of conventional SPICE. It ")
  #line-at(313.25pt, 100.22pt, "can solve circuits with strongly nonlinear devices and extend to ")
  #line-at(313.25pt, 112.34pt, "Multiphysics systems for emerging-technology exploration. We ")
  #line-at(313.25pt, 124.46pt, "have identified current challenges for NeuroSPICE and propose ")
  #line-at(313.25pt, 136.46pt, "its potential usage as circuit surrogate models. Further work ")
  #line-at(313.25pt, 148.58pt, "should evaluate scalability, convergence and its use in ")
  #line-at(313.25pt, 160.58pt, "gradient-based design optimization. ")
