#original-page(595pt, 842pt, (image("graphics/page-04.png", width: 392.5pt), 99pt, 419.5pt))[
  #set text(font: "Times New Roman", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.4pt, 780pt, "4 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 88.56pt, "these results provide materials-specific insights into phonon transport across buried ")
  #line-at(90pt, 113.04pt, "interfaces and illustrate how bonding quality and transition-layer design control heat ")
  #line-at(90pt, 137.52pt, "dissipation in next-generation WBG and UWBG devices.  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 186.24pt, "2. Experimental Method and Measurement Principle ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114pt, 210.72pt, "In this work, we employed the PWA-TDTR technique to achieve depth-resolved ")
  #line-at(90pt, 235.2pt, "and quantitative thermal characterization of multilayer heterostructures. The schematic ")
  #line-at(90pt, 259.68pt, "of the experimental setup is shown in Figure 1. Unlike conventional TDTR, which is ")
  #line-at(90pt, 284.16pt, "primarily sensitive to near-surface transport, the PWA-TDTR configuration integrates ")
  #line-at(90pt, 308.64pt, "a high-performance lock-in amplifier and advanced signal-processing module while ")
  #line-at(90pt, 333.12pt, "preserving the original optical layout and laser source. These improvements enable ")
  #line-at(90pt, 357.6pt, "stable signal acquisition under low-frequency modulation, thereby greatly enhancing ")
  #line-at(90pt, 381.84pt, "sensitivity to heat diffusion through buried interlayers and interfaces—an essential ")
  #line-at(90pt, 406.32pt, "requirement for realistic device structures. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 654.96pt, "Fig. 1.")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(123.757pt, 654.96pt, " Schematic of the PWA-TDTR setup (PBS: polarizing beam splitter; EOM: ")
  #line-at(90pt, 671.28pt, "electro-optic modulator; λ/2: halfwave plate; λ/4: quarter-wave plate). ")
  #line-at(114pt, 716.16pt, "The PWA-TDTR system preserves all functional components of a standard TDTR ")
  #line-at(90pt, 740.64pt, "apparatus but incorporates two key upgrades: a balanced photodetector (PDA465A, ")
  #line-at(90pt, 765.12pt, "Thorlabs) for noise suppression and a UHFLI lock-in amplifier (Zurich Instruments) ")
]

// arXiv source page 5
#original-page(595pt, 842pt, none)[
  #set text(font: "Times New Roman", size: 9.12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.4pt, 780pt, "5 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 88.56pt, "equipped with periodic waveform analysis (PWA) functionality. This advanced lock-in ")
  #line-at(90pt, 113.04pt, "architecture enables simultaneous acquisition of multiple harmonic components and ")
  #line-at(90pt, 137.52pt, "reconstruction of the full periodic temperature waveform at the sample surface, ")
  #line-at(90pt, 162pt, "providing richer thermal information compared to the sinusoidal detection scheme of ")
  #line-at(90pt, 186.24pt, "conventional TDTR. ")
  #line-at(114pt, 210.72pt, "For low-frequency operation, the UHFLI lock-in amplifier generates a 50% duty-")
  #line-at(90pt, 235.2pt, "cycle square-wave reference to drive the electro-optic modulator (EOM), while ")
  #line-at(90pt, 259.68pt, "synchronously recording the reflected probe signal. In contrast to conventional TDTR, ")
  #line-at(90pt, 284.16pt, "the delay stage is fixed at -20 ps, and the mechanical chopper is removed, allowing ")
  #line-at(90pt, 308.64pt, "PWA functionality to capture the complete thermoreflectance waveform throughout the ")
  #line-at(90pt, 333.12pt, "modulation cycle. The acquired data are normalized in amplitude and time, and ")
  #line-at(90pt, 357.6pt, "subsequently fitted using multilayer heat transport models to extract key thermal ")
  #line-at(90pt, 381.84pt, "parameters, including thermal conductivity, volumetric heat capacity, and interfacial ")
  #line-at(90pt, 406.32pt, "thermal conductance. ")
  #line-at(114pt, 430.8pt, "Further details of the system configuration, signal modeling, and fitting ")
  #line-at(90pt, 455.28pt, "methodology can be found in our previous publication [24], where the reliability of the ")
  #line-at(90pt, 479.76pt, "approach has been systematically benchmarked. ")
  #line-at(114pt, 504.24pt, "A distinctive advantage of PWA-TDTR is its ability to extend modulation ")
  #line-at(90pt, 528.72pt, "frequencies down to ~50 Hz without altering the optical layout [24]. This dramatically ")
  #line-at(90pt, 553.2pt, "increases the thermal penetration depth, enabling sensitivity to structures from a few ")
  #line-at(90pt, 577.44pt, "micrometers up to several tens of micrometers in thickness. As such, the method is ")
  #line-at(90pt, 601.92pt, "particularly suitable for characterizing thick transition layers, low-thermal-conductivity ")
  #line-at(90pt, 626.4pt, "interlayers, and buried interfaces that are inaccessible to conventional TDTR. In ")
  #line-at(90pt, 650.88pt, "addition, by employing a multi-frequency joint fitting strategy guided by sensitivity ")
  #line-at(90pt, 675.36pt, "analysis [25], the method achieves stable parameter extraction and effective decoupling ")
  #line-at(90pt, 699.84pt, "of thermal contributions from shallow and deep regions—an essential capability for ")
  #line-at(90pt, 724.32pt, "analyzing realistic multilayer heterostructures in advanced devices. ")
]

