#original-page(612pt, 792pt, (image("graphics/page-01.png", width: 116pt), 231pt, 564pt))[
  #set text(font: "Times New Roman", size: 14.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(77.184pt, 85.1pt, "Model-based upscaling of vanadium redox flow battery systems: engineering ")
  #line-at(234.05pt, 117.26pt, "challenges and solutions ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(226.49pt, 147.62pt, "Bence Sziffer ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.01pt, 143.06pt, "a,b,")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(306.79pt, 147.62pt, "*, Viktor Józsa ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(381.91pt, 143.06pt, "a")
  #line-at(72.024pt, 178.58pt, "a")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(75.624pt, 183.14pt, " Department of Energy Engineering, Faculty of Mechanical Engineering, Budapest University of ")
  #line-at(72.024pt, 196.94pt, "Technology and Economics, Műegyetem rkp. 3., H-1111 Budapest, Hungary ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 214.22pt, "b")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(76.104pt, 218.78pt, " MTA-BME Lendület “Momentum” Renewable Energy Systems Research Group, Műegyetem ")
  #line-at(72.024pt, 232.58pt, "rkp. 3., H-1111, Budapest, Hungary  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 276.17pt, "Abstract ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 303.77pt, "Large-scale energy storage has become an inevitable solution for integrating stochastically ")
  #line-at(72.024pt, 318.65pt, "available renewable energy sources into the electric grid. Vanadium redox flow batteries offer a ")
  #line-at(72.024pt, 333.53pt, "viable option among other technologies, due to their long lifetime and independently scalable ")
  #line-at(72.024pt, 348.41pt, "output power and capacity. The electrolyte temperature should be maintained within the range of ")
  #line-at(72.024pt, 363.41pt, "5–40 °C for safe operation; therefore, a thermal management system is necessary, which affects ")
  #line-at(72.024pt, 378.29pt, "battery efficiency. The study presents a detailed, containerized battery model with a hybrid thermal ")
  #line-at(72.024pt, 393.17pt, "management system that considers thermal radiation and real ambient temperatures. A total of 180 ")
  #line-at(72.024pt, 408.07pt, "configurations were investigated in 10 cases, ranging from 4 to 400 kW, with 18 different ")
  #line-at(72.024pt, 422.95pt, "discharging current–cell number ratios in each case, including multistack arrangements. Current-")
  #line-at(72.024pt, 437.83pt, "dependent ohmic losses influence the electric efficiency, which increases from a minimum of 68% ")
  #line-at(72.024pt, 452.71pt, "to 89% in low-current configurations. However, the net system efficiency ranges between 43% ")
  #line-at(72.024pt, 467.59pt, "and 66% due to the self-consumption of pumps, the inverter, and the thermal management system. ")
  #line-at(72.024pt, 482.47pt, "In addition to the detailed efficiency analysis, a comprehensive investigation of thermal processes ")
  #line-at(72.024pt, 497.35pt, "is provided in terms of the current–cell number ratio and output power, which is crucial for ")
  #line-at(72.024pt, 512.35pt, "designing thermal management systems and sizing batteries. ")
  #line-at(72.024pt, 535.15pt, "Keywords: vanadium redox flow battery, upscaling, thermal management, efficiency, thermal ")
  #line-at(72.024pt, 548.95pt, "analysis  ")
  #line-at(72.024pt, 562.75pt, "* Corresponding author. E-mail: ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#0000ff"))
  #line-at(231.05pt, 562.75pt, "sziffer@energia.bme.hu")
]

