  #line-at(72.024pt, 138.38pt, "work to reduce the consumption of thermal management systems, like the exploitation of dynamic ")
  #line-at(72.024pt, 165.98pt, "flow factor modulation, the two-stage pumping system for electrolyte circulation to utilize its high ")
  #line-at(72.024pt, 193.58pt, "COP even in low power stacks. Another research area could be the potential exploitation of the ")
  #line-at(72.024pt, 221.18pt, "generated waste heat through a thermally regenerative electrochemical cycle to produce electricity. ")
