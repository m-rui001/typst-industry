	publisher = {John Wiley \& Sons, Ltd},
	author = {Walter, Michael and Gross, David and Eisert, Jens},
	year = {2016},
	keywords = {axiomatic approach, entanglement theory, multipartite entanglement, operational approach, pure quantum states, quantum information theory},
	pages = {293--330},
}

