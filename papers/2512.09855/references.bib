@article{menotti_generation_2016,
	title = {Generation of energy-entangled {W} states via parametric fluorescence in integrated devices},
	volume = {94},
	url = {https://link.aps.org/doi/10.1103/PhysRevA.94.013845},
	doi = {10.1103/PhysRevA.94.013845},
	abstract = {Tripartite entangled states, such as Greenberger-Horne-Zeilinger and W states, are typically generated by manipulating two pairs of polarization-entangled photons in bulk optics. Here we propose a scheme to generate W states that are entangled in the energy degree of freedom in an integrated optical circuit. Our approach employs photon pairs generated by spontaneous four-wave mixing in a microring resonator. We also present a feasible procedure for demonstrating the generation of such a state, and we compare polarization-entangled and energy-entangled schemes for the preparation of W states.},
