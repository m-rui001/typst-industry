}

@article{lee_quantum_2003,
	title = {Quantum cryptography using single-particle entanglement},
	volume = {68},
	url = {https://link.aps.org/doi/10.1103/PhysRevA.68.012324},
	doi = {10.1103/PhysRevA.68.012324},
