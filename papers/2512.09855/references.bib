	month = jul,
	year = {2020},
	note = {Publisher: Optica Publishing Group},
	keywords = {Diode lasers, High power lasers, Microwave photonics, Raman lasers, Ring resonators, Tunable diode lasers},
	pages = {21713--21728},
}

@article{li_microresonator_2017,
	title = {Microresonator {Brillouin} gyroscope},
	volume = {4},
	copyright = {© 2017 Optical Society of America},
	issn = {2334-2536},
	url = {https://opg.optica.org/optica/abstract.cfm?uri=optica-4-3-346},
