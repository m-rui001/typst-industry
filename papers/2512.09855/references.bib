@article{eilers_photoelastic_1992,
	title = {Photoelastic effect in \$\{{\textbackslash}mathrm\{{Ti}\}\}{\textasciicircum}\{3+\}\$-doped sapphire},
	volume = {45},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.45.9604},
	doi = {10.1103/PhysRevB.45.9604},
	abstract = {We have used photothermal-beam-deflection spectroscopy to measure the change in the index of refraction of Ti3+-doped sapphire after pulsed excitation at 532 nm with a neodymium-doped yttrium aluminum garnet laser. The beam-deflection signal arises from both thermal and nonthermal sources. The nonthermal part of the signal decays with the fluorescence lifetime of Ti3+ in sapphire. The shape of the nonthermal part depends on whether the probe beam is polarized perpendicular (σ) or parallel (π) to the c axis of the crystal. This behavior can be explained by a photoelastic law based upon the anisotropic volume expansion caused by a strong Jahn-Teller effect of the TiO6 complex in the excited state. The experimental values of the change in the index of refraction for each ion per unit volume are Δn/N=3.3 Å3 and Δn/N=1.2 Å3 for σ and π polarization, respectively, compared with the calculated values of Δn/N=3.73 Å3 (for σ) and Δn/N=1.50 Å3 (for π) for a model that includes the photoelastic law. The bulk expansion per TiO6 complex, derived from the beam-deflection signal, is ≊11.8 Å3, while the calculated value based on the configuration-coordinate model is ≊9.9 Å3.},
	number = {17},
	urldate = {2024-10-01},
	journal = {Physical Review B},
	author = {Eilers, H. and Strauss, E. and Yen, W. M.},
	month = may,
	year = {1992},
	note = {Publisher: American Physical Society},
	pages = {9604--9610},
}

