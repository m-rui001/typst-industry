  #line-at(466.8pt, 279.36pt, " = 150℃ the ")
  #line-at(90pt, 293.04pt, "heat supply to the droplet was sufficient to prevent flooding, and – similar to the 110°C-case – the ")
  #line-at(90pt, 306.72pt, "post substrate showed sustained larger temperature drops than the flat substrate. For ")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.72pt, 306.72pt, "T")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 6.947pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(474.84pt, 307.68pt, "S")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(478.68pt, 306.72pt, " = 165℃, ")
  #line-at(90pt, 320.4pt, "due to the Leidenfrost effect on the flat surface, the post substrate showed a much lower temperature, ")
