  #line-at(257.76pt, 395.88pt, "t")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(260.88pt, 395.88pt, " = 6.0 ms) and finally ends up with a central droplet attached ")
  #line-at(90pt, 409.56pt, "to the post surrounded by satellite droplets (Fig. S2 (b), ")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.64pt, 409.56pt, "t")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.76pt, 409.56pt, " = 16 ms). We hypothesize that the volume ")
  #line-at(90pt, 423.24pt, "of the post at the center causes the droplet to strech to a larger spreading diameter than on the flat ")
  #line-at(90pt, 436.8pt, "surface, which leads to a thinner film that enhances the breakup. Fig. S6 (c) and (d) correspond to ")
  #line-at(90pt, 450.48pt, "the high-temperature breakup mode. On the flat substrate, the droplet maintains a thin liquid layer ")
