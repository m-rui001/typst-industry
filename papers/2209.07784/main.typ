  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(288.36pt, 238.44pt, " = 130℃, we can identify a higher temperature drop ")
  #line-at(90pt, 252.12pt, "on the post substrate for the first two droplet impact events. After that, the sample flooded due to a ")
  #line-at(90pt, 265.68pt, "higher volume flow rate compared to the 110℃-case. The flooding minimized the influence of the ")
  #line-at(90pt, 279.36pt, "post and the temperature curves on the two substrates gradually became similar. At ")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(456.84pt, 279.36pt, "T")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 6.947pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(462.96pt, 280.32pt, "S")
