  #line-at(113.64pt, 434.88pt, " = 110℃ (a), the droplet on the flat substrate experiences a gentle nucleate boiling, in which ")
  #line-at(90pt, 448.56pt, "the generation and coalescence of small vapor bubbles lead to a slight deformation of the droplet ")
  #line-at(90pt, 462.24pt, "shape but no significant lateral expansion. On the contrary, the droplet on the post substrate ")
  #line-at(90pt, 475.8pt, "generates larger vapor bubbles and undergoes a foaming process as the bubbles accumulate and ")
  #line-at(90pt, 489.48pt, "attach to the post, which ultimately leads to an expansion of the droplet-solid contact line (")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(486.48pt, 489.48pt, "t")
