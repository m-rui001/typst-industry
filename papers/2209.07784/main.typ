#original-page(612pt, 792pt, none)[
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126pt, 82.08pt, "in impact and boiling modes between the post and flat substrates. In general, the post ")
  #line-at(126pt, 95.76pt, "enhances droplet breakup. Unexpectedly, though, a non-breakup transition region exists ")
  #line-at(126pt, 109.44pt, "for the post surface within a small temperature range between the two breakup modes, ")
  #line-at(126pt, 123pt, "which is caused by a complex interplay of inertial and pinning forces. ")
  #line-at(108pt, 136.68pt, "3)")
  #line-at(126pt, 136.68pt, "The post substrate has a higher cooling capacity than the flat substrate between 110 ℃ and ")
  #line-at(126pt, 150.36pt, "130 ℃ due to a larger liquid-solid interface area and an expanding droplet profile. However, ")
  #line-at(126pt, 164.04pt, "the enhancement becomes negligible as the temperature approaches the Leidenfrost ")
  #line-at(126pt, 177.6pt, "temperature of the flat surface. ")
  #line-at(108pt, 191.28pt, "4)")
  #line-at(126pt, 191.28pt, "On an inclined surface, the post substrate successfully prevents the droplet from sliding or ")
  #line-at(126pt, 204.96pt, "bouncing off the substrate, which leads to a 51% to 180% increase in local temperature ")
  #line-at(126pt, 218.52pt, "drop. ")
  #line-at(90pt, 240.24pt, "Overall, we show that droplet impact on a single post considerably improves the interfacial heat ")
  #line-at(90pt, 253.92pt, "transfer by influencing droplet dynamics and boiling behavior. The post structure provides an ")
  #line-at(90pt, 267.48pt, "enlarged contact area and a delayed Leidenfrost effect by pinning the droplet. This pinning also ")
  #line-at(90pt, 281.16pt, "assists in droplet breakup and prevents the droplet from sliding off the surface for impact on an ")
  #line-at(90pt, 294.84pt, "inclined substrate. These large-structured surfaces can potentially increase the cooling performance ")
  #line-at(90pt, 308.52pt, "in droplet impingement cooling applications [57] and prevent droplet bouncing for inclined ")
  #line-at(90pt, 321.96pt, "impingement surfaces [58].  ")
