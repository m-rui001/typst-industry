  #line-at(492.96pt, 489.48pt, " =0.1). ")
  #line-at(90pt, 503.16pt, "The physical mechanism behind this foaming is not yet fully understood [2]. It has been suggested ")
  #line-at(90pt, 516.84pt, "that small amounts of dissolved ionic salt in the water prevent bubble coalescence due to ")
  #line-at(90pt, 530.4pt, "electrostatic effects and changes in surface tension [3]. In the present case, the post structure ")
  #line-at(90pt, 544.08pt, "provides additional nucleation sites for the bubbles that can pin to the side wall of the post as they ")
  #line-at(90pt, 557.76pt, "growing (")
  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
