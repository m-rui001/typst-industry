  #set text(font: ("Times New Roman", "New Computer Modern Math"), size: 11.019pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 101.88pt, "We presented and discussed the cooling capacity of single-droplet impact in the main manuscript ")
  #line-at(90pt, 115.56pt, "and extend our exploration to multi-droplet impact here. Fig. S9 shows the area-weighted average ")
  #line-at(90pt, 129.24pt, "temperature of the bottom surface temperature at different ")
