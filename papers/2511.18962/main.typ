// arXiv source page 3
#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 83.16pt, "modulation of carrier concentration in semiconductors has shown great promise due to its fast ")
  #line-at(72pt, 110.76pt, "response times, low energy consumption, and ability to deliver significant changes in ")
  #line-at(72pt, 138.36pt, "emissivity. ")
  #line-at(72pt, 174pt, "Current demonstrations of dynamic thermal emission via carrier concentration modulation in ")
  #line-at(72pt, 201.6pt, "semiconductors primarily rely on high-cost semiconductor platforms such as gallium arsenide ")
  #line-at(72pt, 229.2pt, "(GaAs), as demonstrated by the Noda group")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(283.44pt, 224.64pt, "28,29")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(301.68pt, 229.2pt, " and Greffet group")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(390.48pt, 224.64pt, "22")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(398.64pt, 229.2pt, ", and indium arsenide ")
  #line-at(72pt, 256.8pt, "(InAs), as demonstrated by the Brongersma group")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(312.24pt, 252.24pt, "31")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(320.4pt, 256.8pt, ". However, silicon, which is abundant and ")
  #line-at(72pt, 284.4pt, "significantly more cost-effective by a factor of over 100 compared to gallium arsenide")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(485.76pt, 280.44pt, "35")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(492.72pt, 284.4pt, ", has ")
  #line-at(72pt, 312pt, "been largely overlooked due to its inherently low emissivity in the mid-infrared wavelength ")
  #line-at(72pt, 339.48pt, "range. Despite these challenges, engineering such a device on silicon offers advantages. ")
  #line-at(72pt, 367.08pt, "Silicon’s widespread availability and well-established and scalable fabrication processes ")
  #line-at(72pt, 394.68pt, "make it ideal for large-scale integration and cost-effective manufacturing. Additionally, ")
  #line-at(72pt, 422.28pt, "silicon-based platforms enable compatibility with existing semiconductor fabrication ")
  #line-at(72pt, 449.88pt, "infrastructure. ")
  #line-at(72pt, 485.52pt, "In this paper, we demonstrate through device design calculations that dynamic control of ")
  #line-at(72pt, 513.12pt, "thermal emissions can be achieved in an all-silicon platform. Our device operates by ")
  #line-at(72pt, 540.72pt, "manipulating the carrier concentration within a silicon p-n junction, which is controlled using ")
  #line-at(72pt, 568.32pt, "an applied bias voltage. Through detailed device simulations, we show that thermal emission ")
  #line-at(72pt, 595.92pt, "can be dynamically modulated by applying voltage bias. When combined with a tailored ")
  #line-at(72pt, 623.52pt, "photonic structure, this approach enables narrowband thermal emission characteristics. By ")
  #line-at(72pt, 651.12pt, "demonstrating the feasibility of silicon-based systems for dynamic thermal control, this work ")
  #line-at(72pt, 678.72pt, "paves the way for scalable and cost-effective technology in mid-infrared dynamic thermal ")
  #line-at(72pt, 706.32pt, "emitter design. ")
]

