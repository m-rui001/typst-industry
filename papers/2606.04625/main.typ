  #line-at(329.47pt, 580.15pt, "Modelling the extent of distortion expected on the device ")
  #line-at(329.47pt, 591.7pt, "wafer post-thinning ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.47pt, 605.74pt, "The dense scanner readouts with respect to the scanner grid, ")
  #line-at(315.07pt, 616.66pt, "are then used to model CPE corrections with the field layout of ")
  #line-at(315.07pt, 627.58pt, "the used wafers. The results are shown in Figure 7. Figure 7(a) ")
