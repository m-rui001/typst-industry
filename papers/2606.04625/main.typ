  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(338.11pt, 375.65pt, "m. Once this stage is reached, the vacuum on one or both ")
  #line-at(315.07pt, 386.69pt, "the chucks can be released so the bond front can propagate to the ")
