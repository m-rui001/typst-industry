  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(55.824pt, 477.91pt, " plasma chamber in the XBS300 cluster from SUSS at 100 W. ")
  #line-at(45.36pt, 488.83pt, "Then they again undergo DI water rinsing and are spin-dried ")
  #line-at(45.36pt, 499.75pt, "until a minimal amount of water molecules are left adsorbed on ")
  #line-at(45.36pt, 510.67pt, "the surface to enable hydrophilic bonding. ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(45.36pt, 528.07pt, "B.")
  #line-at(59.784pt, 528.07pt, "Wafer chucking, bond initiation and bond front ")
  #line-at(59.784pt, 539.59pt, "progression ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(59.784pt, 553.63pt, "The wafers are carried in the XBS300 cluster with a robot ")
  #line-at(45.36pt, 564.55pt, "capable of handing both single and double-thickness wafers. In ")
  #line-at(45.36pt, 575.47pt, "this case, the single wafers are carried between the different ")
  #line-at(45.36pt, 586.42pt, "cleaner and plasma chambers as described in previous ")
  #line-at(45.36pt, 597.34pt, "subsection, and before being carried into the bond chamber ")
  #line-at(45.36pt, 608.26pt, "(XBA). The blanket wafers are loaded after pre-alignment ")
  #line-at(45.36pt, 619.18pt, "station into the bond. While the patterned wafers (discussed ")
  #line-at(45.36pt, 630.1pt, "later) can be marker-aligned in the XBA prior to bond initiation. ")
  #line-at(45.36pt, 641.02pt, "The wafers are vacuum chucked along a circular rim only close ")
  #line-at(45.36pt, 651.94pt, "to the edges. A small gas pressure (called ‘")
