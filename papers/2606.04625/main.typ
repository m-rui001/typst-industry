  #line-at(45.36pt, 609.58pt, "creates for ultimately performing further lithography steps on ")
  #line-at(45.36pt, 620.98pt, "one of the wafers, depends on the target matching and the ")
  #line-at(45.36pt, 632.5pt, "correction capabilities of a scanner. ")
