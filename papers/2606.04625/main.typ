  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(321.55pt, 203.66pt, "m, use of an ASML NXT:2000i for dense readouts of the ")
  #line-at(315.07pt, 214.7pt, "overlay markers with respect to the scanner grid. After the ")
  #line-at(315.07pt, 225.62pt, "thinning, both the top (thinned wafer), and the bottom wafer ")
  #line-at(315.07pt, 236.54pt, "markers are also measured. The measurements are done at 54 ")
  #line-at(315.07pt, 247.49pt, "points-per-field (ppf), resulting in approximately 13000 markers ")
  #line-at(315.07pt, 258.41pt, "per wafer (including the partial fields). A direct subtraction of ")
  #line-at(315.07pt, 269.33pt, "the layers gives the bonding induced overlay between the two ")
  #line-at(315.07pt, 280.25pt, "wafers, which is frozen at the interface and does not change ")
  #line-at(315.07pt, 291.17pt, "during thinning (shown in Fig 6 after a 4-parameter removal ")
  #line-at(315.07pt, 302.09pt, "with translations in ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(393.34pt, 302.09pt, "x-y")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.34pt, 302.09pt, ", uniform rotation and scaling terms).  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "italic", fill: rgb("#44546a"))
  #line-at(315.07pt, 511.51pt, "Fig. 6 ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#44546a"))
  #line-at(338.83pt, 511.51pt, "Grid measurements of the top and bottom wafer with respect to ")
  #line-at(315.07pt, 521.83pt, "the scanner grid can be directly subtracted to reveal the misalignments ")
  #line-at(315.07pt, 532.27pt, "between the bottom-top wafer frozen at the bonding interface during ")
  #line-at(315.07pt, 542.59pt, "bonding. The above map shows bonding overlay after 4-parameter")
