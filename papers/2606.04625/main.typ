  #line-at(45.36pt, 264.29pt, "possible in XT260 scanner, specially targeted for advanced ")
  #line-at(45.36pt, 275.21pt, "packaging applications (Fig 4(f)). All CPE results in Fig 4 show ")
  #line-at(45.36pt, 286.13pt, "low levels of distortion coming from bonding despite using low ")
