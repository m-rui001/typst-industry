#original-page(612pt, 792pt, none)[
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.025pt, 82.28pt, "Abstract ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.025pt, 103.03pt, "Interpreting complex datasets remains a major challenge for scientists, particularly due to ")
  #line-at(85.025pt, 117.55pt, "high dimensionality and collinearity among variables. We introduce a novel application of ")
  #line-at(85.025pt, 132.3pt, "Kolmogorov-Arnold Networks (KANs) to enhance interpretability and parsimony beyond ")
  #line-at(85.025pt, 147.05pt, "what traditional correlation analyses offer. ")
  #line-at(85.025pt, 167.55pt, "We present two interpretable, color-coded visualization tools: the ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(423.42pt, 167.55pt, "Pairwise KAN Matrix")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.025pt, 182.3pt, "(PKAN) and the ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(176.08pt, 182.3pt, "Multivariate KAN Contribution Matrix")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(372.15pt, 182.3pt, " (MKAN). PKAN characterizes ")
  #line-at(85.025pt, 196.83pt, "nonlinear associations between pairs of variables, while MKAN serves as a nonlinear ")
  #line-at(85.025pt, 211.58pt, "feature-ranking tool that quantifies the relative contributions of inputs in predicting a target ")
  #line-at(85.025pt, 226.33pt, "variable. ")
  #line-at(85.025pt, 246.83pt, "These tools support pre-processing (e.g., feature selection, redundancy analysis) and post-")
  #line-at(85.025pt, 261.58pt, "processing (e.g., model explanation, physical insights) in model development workflows. ")
  #line-at(85.025pt, 276.1pt, "Through experimental comparisons, we demonstrate that PKAN and MKAN yield more ")
  #line-at(85.025pt, 290.85pt, "robust and informative results than ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(276.88pt, 290.85pt, "Pearson Correlation")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(376.65pt, 290.85pt, " and ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(406.93pt, 290.85pt, "Mutual Information.")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(509.48pt, 290.85pt, " By ")
  #line-at(85.025pt, 305.35pt, "capturing the strength and functional forms of relationships, these matrices facilitate the ")
  #line-at(85.025pt, 320.1pt, "discovery of hidden physical patterns and promote domain-informed model development. ")
]

