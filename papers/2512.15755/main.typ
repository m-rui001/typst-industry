  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(275.63pt, 278.85pt, "). Users can select any metric they prefer, adding ")
  #line-at(85.025pt, 293.6pt, "interpretability to the strength of association. In our case, both metrics are scaled so that ")
  #line-at(85.025pt, 308.1pt, "0.0 corresponds to always using the target mean as the predictor, and 1.0 corresponds to ")
