  #line-at(193.83pt, 372.62pt, ") are either too computationally costly for large datasets or provide ")
  #line-at(85.025pt, 387.37pt, "only limited insight")
  #set text(font: "Calibri", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
