#original-page(612pt, 792pt, (image("graphics/page-03.png", width: 12.5pt), 346.5pt, 315pt))[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.025pt, 82.28pt, "Our era is defined by vast data growth and widespread access to machine learning models ")
  #line-at(85.025pt, 97.03pt, "across scientific and engineering domains. These resources create opportunities for ")
  #line-at(85.025pt, 111.53pt, "discovery but pose challenges such as high-dimensionality, noise, collinearity, and non-")
  #line-at(85.025pt, 126.3pt, "linear relationships that limit interpretability. Large datasets also impose heavy ")
  #line-at(85.025pt, 141.05pt, "computational demands, restricting analyses and reducing confidence in outcomes. ")
  #line-at(85.025pt, 155.55pt, "Therefore, tools that efficiently manage complexity while producing interpretable and ")
  #line-at(85.025pt, 170.3pt, "trustworthy models are needed across disciplines1. ")
  #line-at(85.025pt, 190.8pt, "Scientists and engineers face key challenges during model development: the data must ")
  #line-at(85.025pt, 205.58pt, "contain sufficient information about the underlying processes")
