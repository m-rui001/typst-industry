#original-page(612pt, 792pt, (image("graphics/page-16.png", width: 4.5pt), 85.5pt, 429.5pt))[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.025pt, 82.28pt, "The strength of the association (indicated by the background color intensity) is defined by ")
