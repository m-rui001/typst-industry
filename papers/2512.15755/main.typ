  #line-at(85.775pt, 538.42pt, "Discussion and Conclusions ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.025pt, 559.67pt, "Machine learning models can lack interpretability and exhibit “black box” behavior. ")
  #line-at(507.2pt, 559.67pt, "This ")
  #line-at(85.025pt, 574.42pt, "motivates the development of tools that make data-model relationships more ")
  #line-at(85.025pt, 588.92pt, "understandable. However, complex nonlinear, noisy, and multivariate associations can still ")
  #line-at(85.025pt, 603.7pt, "challenge interpretability during pre- and post-processing. The KAN architecture enables ")
  #line-at(85.025pt, 618.45pt, "the extraction and visualization of functional forms between variables. We use this ")
  #line-at(85.025pt, 632.95pt, "characteristic to introduce the pairwise (PKAN) and multivariate (MKAN) matrices, which ")
  #line-at(85.025pt, 647.7pt, "use simple KAN networks to characterize relational strengths and functional forms between ")
  #line-at(85.025pt, 662.45pt, "variables. ")
  #line-at(85.025pt, 682.97pt, "Traditional methods like ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(208.33pt, 682.97pt, "Pearson Correlation")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(305.88pt, 682.97pt, " and ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(330.9pt, 682.97pt, "Mutual Information")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(428.18pt, 682.97pt, " are widely used for ")
  #line-at(85.025pt, 697.725pt, "assessing dependence, but lack information about relational form, and often struggle with ")
  #line-at(85.025pt, 712.225pt, "non-linear relationships and noise. Our KAN-based approach is more robust under such ")
]

