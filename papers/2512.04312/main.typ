  #line-at(70.08pt, 464.76pt, "and interference behavior. The table 3 below summarizes their physical interpretations and quantum mechanical ")
  #line-at(70.08pt, 477.6pt, "implications. ")
  #line-at(70.08pt, 503.4pt, "Table 3. Physical interpretations and quantum‑state implications of the selected spectral phase profiles. ")
