  #set text(font: "Times New Roman", size: 9.694pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.199pt, 460.075pt, "Here, we investigate coherent spectral phase transfer in three representative wavelength conversion regimes, each ")
  #line-at(70.199pt, 472.917pt, "involving distinct combinations of input, intermediary, and output fields. These regimes are selected to reflect ")
  #line-at(70.199pt, 485.877pt, "practically relevant scenarios in photonic quantum transduction where spectral mismatches commonly arise between ")
  #line-at(70.199pt, 498.716pt, "quantum systems and communication channels.  ")
  #line-at(104.762pt, 524.394pt, "Table 1. Selected nonlinear wavelength-conversion schemes and corresponding target applications. ")
