  #set text(font: "Times New Roman", size: 8.759pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.199pt, 535.194pt, "Figure 8. Conversion efficiency comparison for three different phase-matching cases: (a) linear-type, (b) negative quartic, and (c) ")
