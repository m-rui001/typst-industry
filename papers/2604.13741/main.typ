#original-page(595pt, 842pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.725pt, 804.24pt, "2 ")
  #line-at(90pt, 83.28pt, "performance. Accurate ITC values are also indispensable for predictive models of ")
  #line-at(90pt, 103.92pt, "multiphase media such as nanofluids,")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(269.631pt, 99.84pt, "5")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(273.631pt, 103.92pt, " and emulsions,")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.625pt, 99.84pt, "6")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(352.625pt, 103.92pt, " and soft condensed matter.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(484.25pt, 99.84pt, "7")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(102pt, 124.56pt, "Extensive ")
  #line-at(163.687pt, 124.56pt, "studies ")
  #line-at(211.391pt, 124.56pt, "have ")
  #line-at(248.412pt, 124.56pt, "employed ")
  #line-at(310.1pt, 124.56pt, "time-domain ")
  #line-at(385.792pt, 124.56pt, "and ")
  #line-at(417.488pt, 124.56pt, "frequency-domain ")
  #line-at(90pt, 145.44pt, "thermoreflectance (TDTR and FDTR) techniques to investigate ITC at metal-liquid ")
  #line-at(90pt, 166.08pt, "interfaces, revealing strong dependence of ITC on interfacial chemistry and wettability, ")
  #line-at(90pt, 186.72pt, "with hydrophilic surfaces exhibiting several-fold higher conductance than hydrophobic ")
  #line-at(90pt, 207.36pt, "ones.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.996pt, 203.28pt, "8-13")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(129.66pt, 207.36pt, " However, these approaches are largely restricted to specific metal-liquid pairs, ")
  #line-at(90pt, 228.24pt, "limiting their general applicability.  ")
  #line-at(102pt, 248.88pt, "Here, we introduce a broadband square-pulsed source (SPS) thermometry method")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(494.786pt, 244.8pt, "14-")
  #line-at(90pt, 265.44pt, "17")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(98pt, 269.52pt, " that measures ITC across diverse solid-liquid interfaces. Operating from 1 Hz to 10 ")
  #line-at(90pt, 290.16pt, "MHz, it probes liquid films confined between the transducer substrate and an arbitrary ")
  #line-at(90pt, 311.04pt, "solid, enabling ITC measurements for virtually any solid-liquid pair. Each frequency ")
  #line-at(90pt, 331.68pt, "sweep requires only about one minute of acquisition time, and reliable results can ")
  #line-at(90pt, 352.32pt, "typically be obtained using just two to three frequencies. This combination of speed and ")
  #line-at(90pt, 372.96pt, "universality allows rapid and quantitative benchmarking of interfacial heat transport, ")
  #line-at(90pt, 393.84pt, "opening a broadly applicable route for the design and understanding of thermal ")
  #line-at(90pt, 414.48pt, "interfaces. ")
  #line-at(102pt, 435.12pt, "The SPS thermometry method employs two continuous-wave lasers: a square-wave ")
  #line-at(90pt, 455.76pt, "modulated pump periodically heats the sample, while changes in probe reflectance track ")
  #line-at(90pt, 476.64pt, "the transient surface temperature. By fitting the temporal response across a broad ")
  #line-at(90pt, 497.28pt, "frequency range (1 Hz-10 MHz), both ITC and liquid-film thickness can be extracted. ")
  #line-at(90pt, 517.92pt, "The experimental setup and heat transfer model of SPS are detailed in Supplementary ")
  #line-at(90pt, 538.56pt, "Sec. S1 and Refs.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(174.322pt, 534.48pt, "14,18")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(192.322pt, 538.56pt, ".  ")
  #line-at(102pt, 559.44pt, "To generalize ITC measurements beyond metal-liquid systems, we devised three ")
  #line-at(90pt, 580.08pt, "sample configurations (Fig. 1). In the conventional case [Fig. 1(a)], a bulk liquid is ")
  #line-at(90pt, 600.72pt, "applied to a metal transducer on glass. Both the pump and probe beams pass through ")
  #line-at(90pt, 621.36pt, "the substrate and focus at the glass-metal interface. In this configuration, the relevant ")
  #line-at(90pt, 642.48pt, "unknowns are the metal-liquid ITC (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(265.562pt, 642.48pt, "𝐺")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(272.769pt, 644.88pt, "\"")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(278.185pt, 642.48pt, ") and the liquid’s thermal conductivity (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(469.397pt, 642.48pt, "𝑘")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(475.313pt, 644.88pt, "$")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(481.14pt, 642.48pt, ") and ")
  #line-at(90pt, 664.8pt, "heat capacity (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(165.214pt, 664.8pt, "𝐶")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(170.966pt, 667.2pt, "$")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.646pt, 664.8pt, "). The glass-metal ITC (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(302.94pt, 664.8pt, "𝐺")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(309.877pt, 667.2pt, "#")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(316.146pt, 664.8pt, ") contributes negligibly to the overall ")
  #line-at(90pt, 687.12pt, "thermal resistance, since solid-solid interfaces are typically an order of magnitude more ")
  #line-at(90pt, 708pt, "conductive than solid-liquid ones, and is therefore treated as a fixed parameter in the ")
  #line-at(90pt, 728.64pt, "analysis. ")
]

