#original-page(595pt, 842pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.725pt, 804.24pt, "9 ")
  #line-at(90pt, 83.28pt, "dominant silicone-oil modes, producing very weak vibrational overlap and hence ")
  #line-at(90pt, 103.92pt, "extremely low interfacial coupling. ")
  #line-at(102pt, 124.56pt, "Overall, the agreement among experiments, models, and theoretical analyses ")
  #line-at(90pt, 145.44pt, "indicates that solid-liquid ITC is governed by vibrational overlap, wettability, and the ")
  #line-at(90pt, 166.08pt, "actual interfacial structure. The consistency across metals, oxides, semiconductors, and ")
  #line-at(90pt, 186.72pt, "polymers demonstrates SPS as a broadly applicable platform for benchmarking thermal ")
  #line-at(90pt, 207.36pt, "transport at solid-liquid interfaces. ")
  #line-at(102pt, 228.24pt, "In summary, the square-pulsed source (SPS) method offers a robust and broadly ")
  #line-at(90pt, 248.88pt, "applicable approach for quantifying ITC across diverse solid-liquid systems. Validated ")
  #line-at(90pt, 269.52pt, "on the benchmark Al-water interface, it was further extended to glass-water, Si-water, ")
  #line-at(90pt, 290.16pt, "Al-silicone oil, and PMMA-silicone oil pairs, revealing distinct conductance behaviors ")
  #line-at(90pt, 311.04pt, "governed by surface condition, wettability, and vibrational overlap. These results ")
  #line-at(90pt, 331.68pt, "demonstrate SPS as a universal platform for rapid, quantitative benchmarking of ")
  #line-at(90pt, 352.32pt, "interfacial heat transport, with broad implications for thermal management, ")
  #line-at(90pt, 372.96pt, "microfluidics, and energy conversion technologies. ")
