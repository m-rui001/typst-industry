  #line-at(292.08pt, 791.4pt, "20 ")
  #line-at(85.08pt, 66.955pt, "Only the electricity and heating sectors are considered in this study and are represented by the AC ")
  #line-at(85.08pt, 86.032pt, "Electrical and Heating buses respectively. The AC Electrical bus gathers both the High and Low ")
  #line-at(85.08pt, 104.988pt, "Voltage systems. The electrical demand time series has been retrieved from European Network ")
  #line-at(85.069pt, 123.944pt, "Transmission System Operators for Electricity (ENTSO-e) through the compilation by Open ")
  #line-at(85.069pt, 142.899pt, "Power System Data [40] for the year 2015. The electricity used to cover electrified domestic ")
  #line-at(85.091pt, 161.855pt, "heating demand is subtracted as it needs to be included in the heating demand. The definitive ")
