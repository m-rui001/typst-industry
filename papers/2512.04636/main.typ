  #line-at(85.104pt, 722.487pt, "systems. The latter is modelled as an individual water tank, with considerable standing losses (33 ")
  #line-at(85.093pt, 741.443pt, "%/day meaning it is fully self-discharged within 3 days), which will ultimately limit its capacity ")
  #set text(font: "Calibri", size: 12.437pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(63.501pt, 71.159pt, "a")
  #line-at(63.962pt, 206.052pt, "c")
