  #line-at(85.069pt, 363.534pt, "PHPS is also present to manage daily variations. Therefore, PHPS is used simultaneously to ")
  #line-at(85.069pt, 382.49pt, "balance long-duration wind fluctuations and daily fluctuations from solar generation. ")
