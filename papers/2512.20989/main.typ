  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.384pt, 138.38pt, " flow of 1200 sccm. The ability to mitigate parasitic charge layers in devices without the ")
  #line-at(72.024pt, 165.98pt, "need for time sensitive processes such as HF treatment allows for efficient devices to be ")
  #line-at(72.024pt, 193.58pt, "fabricated, and N doped layers hold immense promise for use in both vertical and lateral devices ")
