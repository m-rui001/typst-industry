#original-page(595.32pt, 841.92pt, (image("graphics/page-04.png", width: 296.5pt), 83pt, 116pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.65pt, 803.976pt, "4 ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 82.32pt, "the SHG originates mostly from the ridges of the two gratings, in qualitative accordance with the ")
  #line-at(72.024pt, 101.3pt, "previous theoretical considerations [34]. To the best of our knowledge, we report the first experimental ")
  #line-at(72.024pt, 120.98pt, "demonstration of SPP-induced SHG with delocalization over > 10 ")
  #line-at(379.03pt, 120.98pt, "m length scales. To confirm our ")
  #line-at(72.024pt, 140.54pt, "results we repeated this SHG measurements on three different nonlinear microscope setups and saw ")
  #line-at(72.024pt, 159.5pt, "comparable results in all cases (see Methods). We also explored different grating spacings and saw ")
  #line-at(72.024pt, 178.46pt, "comparable results for all grating spacings explored (10 – 35 µm). ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(317.33pt, 235.34pt, "Figure 1. a) Schematic illustration of the ")
  #line-at(317.33pt, 254.3pt, "system: fundamental beam incident on a ")
  #line-at(317.33pt, 273.26pt, "grating excites a surface plasmon polariton, ")
  #line-at(317.33pt, 292.37pt, "which then out-couples through a second ")
  #line-at(317.33pt, 311.33pt, "grating, marked in red. Fundamental marked ")
  #line-at(317.33pt, 330.29pt, "in red and SHG in blue arrows. b) White light ")
  #line-at(317.33pt, 349.25pt, "reflection image of the gratings fabricated on a ")
  #line-at(317.33pt, 368.21pt, "monocrystalline gold flake. c)/d) Fundamental ")
  #line-at(317.33pt, 387.17pt, "(1030 nm)/Second-harmonic ")
  #line-at(484.369pt, 387.17pt, "(515 nm, ")
  #line-at(317.33pt, 406.13pt, "logarithmic scale) images obtained upon ")
  #line-at(317.33pt, 425.09pt, "illumination of the left grating with a focused ")
  #line-at(317.33pt, 444.05pt, "laser beam. e) Second-harmonic and white ")
  #line-at(317.33pt, 463.13pt, "light intensity (normalised to maximum) line ")
  #line-at(317.33pt, 482.11pt, "profiles overlaid. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 671.86pt, "We now explore producing delocalized SHG by counterpropagating SPPs directly on a flat surface, i.e. ")
  #line-at(72.024pt, 690.82pt, "without exploiting an outcoupling grating. The principle is illustrated in Figure 2a: following SPP ")
  #line-at(72.024pt, 709.78pt, "excitation at the in-coupling grating (1, on the left-hand side) a second grating (2, right-hand side), ")
  #line-at(72.024pt, 728.74pt, "functioning as a Bragg reflector for the SPP, is now used to redirect the SPP back towards the excitation ")
  #line-at(72.024pt, 747.696pt, "spot. We confirmed this second grating acts as a reflector using finite element method modelling, see ")
  #line-at(72.024pt, 766.656pt, "Supplementary Information Note 3, with our simulations indicating approximately 33 % of the SPP’s ")
]

