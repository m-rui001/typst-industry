  #line-at(72.024pt, 147.26pt, "Figure S4b-g we present the observed SHG when exciting the in-coupling grating at different positions, ")
  #line-at(72.024pt, 166.22pt, "to excite each structure in turn (with the letters b-g marked in Figure S4a to denote which grating is ")
  #line-at(72.024pt, 185.18pt, "being measured). The exposure time is the same in all plots (5 s) and the length scale is the same on all ")
  #line-at(72.024pt, 204.14pt, "plots. As can be seen, we observe qualitatively similar results in all cases. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(72.024pt, 529.39pt, "Figure S4. a) White light reflection image of a flake with a series of reflection gratings at different ")
  #line-at(72.024pt, 548.35pt, "distances from the in-coupling grating. Each grating structure is marked b)-g), and the SHG from each ")
  #line-at(72.024pt, 567.43pt, "structure is presented in the subsequent parts of the image. Scale bar is the same on all plots. ")
]

