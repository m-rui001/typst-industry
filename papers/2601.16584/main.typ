#original-page(595.32pt, 841.92pt, (image("graphics/page-03.png", width: 411pt), 73.5pt, 535.5pt))[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 804pt, "C Trivedi ")
  #line-at(72pt, 82.315pt, "pump and turbine. Furthermore, we investigated, blade loading and other secondary flow ")
  #line-at(72pt, 101.271pt, "characteristics during the inception of unsteady vortical flow, Dean vortices, in the pump mode ")
  #line-at(72pt, 120.227pt, "operation. According to the author’s the best of knowledge, no research on pump mode is available in ")
  #line-at(72pt, 139.182pt, "the literature; although, the pump mode operation is important to store energy. The present study ")
  #line-at(72pt, 158.138pt, "provides valuable information on the flow characteristics in pump mode operation of a pump-turbine. ")
  #set text(font: "Times New Roman", size: 20.04pt, weight: "regular", style: "normal", fill: rgb("#003b57"))
  #line-at(72pt, 203.52pt, "Computational model and range of parameters ")
  #set text(font: "Times New Roman", size: 15.96pt, weight: "regular", style: "normal", fill: rgb("#003b57"))
  #line-at(72pt, 242.28pt, "Reversible pump-turbine ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 269.28pt, "The present study is conducted on a reversible pump-turbine test facility in the Waterpower ")
  #line-at(72pt, 288.236pt, "laboratory, NTNU, Norway. The turbine is a reduced scale model of a prototype in Norway. The test ")
  #line-at(72pt, 307.191pt, "facility is used for the research and model tests of the model Francis turbine and the reversible pump-")
  #line-at(72pt, 326.147pt, "turbine. Detailed information about the test facility is presented in our previous studies [13–15]. The ")
  #line-at(72pt, 345.103pt, "reversible pump-turbine includes 6 blades, 28 guide vanes, 14 stay vanes, spiral casing and elbow ")
  #line-at(72pt, 364.18pt, "type draft tube. The inlet and outlet diameter of the model runner are 0.631 m and 0.349 m, ")
  #line-at(72pt, 383.136pt, "respectively. The maximum efficiency at the design load is 90.5%. Other reference parameters are ")
  #line-at(72pt, 402.091pt, "presented in ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(128.28pt, 402.091pt, "Table 1")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(162.484pt, 402.091pt, ". An isometric view of the turbine is shown in ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(366.406pt, 402.091pt, "Figure 1")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.485pt, 402.091pt, ". The computational ")
  #line-at(72pt, 421.047pt, "model of the turbine with all components was considered for the numerical modelling. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(455.16pt, 421.047pt, "Figure 2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 440.003pt, "shows the final mesh considered for the present study. Hexahedral mesh was created in all ")
  #line-at(72pt, 458.958pt, "components. ANSYS® ICEM CFD™ was used for creating the hexahedral mesh in the spiral casing ")
  #line-at(71.989pt, 477.914pt, "and draft tube domains. ANSYS® TGrid™ was used for creating the hexahedral mesh in the guide ")
  #line-at(71.989pt, 496.87pt, "vane and the runner domains. The final mesh contained 58.19 million nodes after the proper ")
  #line-at(71.989pt, 515.825pt, "verification and validation. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 728.224pt, "Figure 1")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(111.479pt, 728.224pt, " Computational model of the turbine considered for the present study. The flow directions (P) ")
  #line-at(72pt, 747.301pt, "and (T) indicate the pump and turbine mode operations, respectively. ")
]

