#original-page(595.32pt, 841.92pt, (image("graphics/page-35.png", width: 4pt), 90.5pt, 301.5pt))[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 804pt, "C Trivedi ")
  #set text(font: "Times New Roman", size: 20.04pt, weight: "regular", style: "normal", fill: rgb("#003b57"))
  #line-at(72pt, 90.72pt, "Conclusions ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 120.84pt, "We investigated the reversible pump-turbine at design and off design conditions for both turbine and ")
  #line-at(72pt, 139.796pt, "pump modes operation. The computational domain consisted of all components of the turbine, ")
  #line-at(72pt, 158.751pt, "including a spiral casing with extended inlet, stay vanes, guide vanes, runner and an elbow type draft ")
  #line-at(72pt, 177.707pt, "tube. Both steady state and unsteady state simulations were conducted. The computational domain ")
  #line-at(72pt, 196.663pt, "included 58.19 million hexahedral nodes. Estimated total numerical error was 7.7% at design load ")
  #line-at(72pt, 215.618pt, "condition. For detailed analysis of the flow characteristics, 21 observation points were created in the ")
  #line-at(72pt, 234.574pt, "computational domain, enabling time-dependent pressure fluctuations. Three operating conditions in ")
  #line-at(72.011pt, 253.651pt, "turbine mode and four operating conditions in pump mode were investigated. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.011pt, 280.534pt, "Turbine mode ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(108.012pt, 307.537pt, "The static pressure, radial, and tangential velocity variation is strongly dependent on the exact ")
  #line-at(108.012pt, 326.493pt, "position of the blades relative to the guide vanes in the vaneless space. ")
  #line-at(108.024pt, 345.449pt, "The results clearly show that the high amplitude frequency can be up to six times the ")
  #line-at(108.024pt, 364.405pt, "fundamental frequency of the blade. ")
  #line-at(108.035pt, 383.482pt, "Pressure gradient on the blade leading edge is 0.02 - 1.12 times the specific hydraulic energy, ")
  #line-at(108.035pt, 402.437pt, "indicating the significant change of pressure on small radii of leading edge may induce very ")
  #line-at(108.035pt, 421.393pt, "high stresses. ")
  #line-at(108.035pt, 440.349pt, "Investigation of flow field in the blade passage shows high separation of flow on the suction ")
  #line-at(108.035pt, 459.304pt, "side of the blade.  ")
  #line-at(108.046pt, 478.26pt, "The spectral analysis of pressure data at the observation points in the runner clearly indicates ")
  #line-at(108.046pt, 497.216pt, "up to 30 harmonics of the runner rotational frequency. This frequency also coincides with the ")
  #line-at(108.046pt, 516.172pt, "guide vane passing frequency. ")
  #line-at(108.046pt, 535.127pt, "Flow field analysis in the draft tube at part load shows the presence of several swirling zones ")
  #line-at(108.046pt, 554.204pt, "having local rotation; flow in the centre of the draft tube is pumping towards the runner. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.05pt, 583.129pt, "Pump mode ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.05pt, 610.133pt, " Flow direction in the pump mode operation reverses, where the flow enters the draft tube and ")
  #line-at(90.05pt, 629.089pt, "leaves from the spiral casing. ")
  #line-at(108.057pt, 656.092pt, "Investigation of the flow field in the draft tube revealed interesting characteristics. Secondary ")
  #line-at(108.057pt, 675.048pt, "flow in the draft tube develops the Dean vortices up the runner edge. ")
  #line-at(108.068pt, 694.004pt, "Three distinct zones of swirling flow were obtained in the draft tube. (1) Outer edge swirl — ")
  #line-at(108.046pt, 712.96pt, "zone near to the wall, has high rotational velocity and travels radially inward. (2) core swirl ")
  #line-at(108.035pt, 731.915pt, "— zone in the centre of the draft tube travels radially outward towards the wall and collides ")
  #line-at(108.035pt, 750.871pt, "with the outer edge swirl. (3) Dean vortices — two vortices spin in opposite directions on the ")
]

