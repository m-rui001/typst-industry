#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.98pt, "Introduction  ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 105.02pt, "High-resolution, high-throughput, label-free imaging of transparent biological specimens, e.g., cell ")
  #line-at(70.824pt, 117.74pt, "cultures and tissue slices, remains one of the central challenges in optical microscopy")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(450.7pt, 113.78pt, "1,2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(459.46pt, 117.74pt, ". Conventional ")
  #line-at(70.824pt, 130.34pt, "bright-field microscopes operating in the visible (VIS) spectral range often fail to produce sufficient ")
  #line-at(70.824pt, 143.06pt, "image contrast when dealing with unstained cells and tissues. Most cellular structures are of low ")
  #line-at(70.824pt, 155.66pt, "absorption, which results in minimal intensity modulation and poor visibility of crucial fine features")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(513.12pt, 151.7pt, "1,2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(521.88pt, 155.66pt, ". ")
  #line-at(70.824pt, 168.26pt, "As a consequence, a wide range of biological studies still rely on the use of extrinsic labels, such as ")
  #line-at(70.824pt, 180.98pt, "absorbing dyes or fluorescent markers, which enhance contrast and allow for identification of specific ")
  #line-at(70.824pt, 193.58pt, "structures. However, these labelling protocols are time-consuming, prone to variability, and often ")
  #line-at(70.824pt, 206.3pt, "perturb the native state of the specimen")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(250.85pt, 202.34pt, "1,2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(259.61pt, 206.3pt, ". In addition, labelling introduces chemical and procedural ")
  #line-at(70.824pt, 219.02pt, "complexity, increasing cost and limiting throughput in biomedical workflows. ")
  #line-at(70.824pt, 239.57pt, "A major breakthrough in label-free imaging has been achieved through Quantitative Phase Imaging ")
  #line-at(70.824pt, 252.17pt, "(QPI) techniques")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.7pt, 248.21pt, "1,2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(157.46pt, 252.17pt, ". QPI provides high-contrast visualization of transparent samples by mapping ")
  #line-at(70.824pt, 264.89pt, "variations in refractive index and physical thickness. In contrast to intensity-based methods, QPI can ")
  #line-at(70.824pt, 277.49pt, "reveal fine structural details without the need for external markers, which enables long-term observation ")
  #line-at(70.824pt, 290.21pt, "of living cells in their physiological environment without photodamage. Many implementations have ")
  #line-at(70.824pt, 302.81pt, "been developed, including high-throughput digital holographic microscopy")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(421.9pt, 298.85pt, "1,2,3")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(435.82pt, 302.81pt, " or high-resolution ")
  #line-at(70.824pt, 315.41pt, "Fourier ptychography")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(166.46pt, 311.45pt, "4")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(169.97pt, 315.41pt, ". These techniques have opened powerful opportunities in cell biology and tissue ")
  #line-at(70.824pt, 328.13pt, "pathology imaging. However, QPI has a fundamental limitation -  it lacks intrinsic chemical specificity. ")
  #line-at(70.824pt, 340.73pt, "Since it relies solely on optical thickness (refractive index and physical thickness) contrast, QPI provides ")
  #line-at(70.824pt, 353.45pt, "structural information but cannot distinguish between different biochemical components. In many ")
  #line-at(70.824pt, 366.17pt, "biomedical and diagnostic applications, this lack of molecular sensitivity restricts its usefulness. ")
  #line-at(70.824pt, 386.69pt, "To address this limitation, researchers have increasingly focused on Deep Ultraviolet (DUV) imaging")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(517.68pt, 382.73pt, "5–")
  #line-at(70.824pt, 395.47pt, "10")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(77.784pt, 399.43pt, ". DUV offers unique advantages for label-free biochemical contrast")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(372.79pt, 395.47pt, "11–13")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(389.95pt, 399.43pt, ". Biomolecules such as nucleic ")
  #line-at(70.824pt, 412.03pt, "acids and proteins exhibit strong intrinsic absorption bands in the DUV spectral range, e.g., DNA absorbs ")
  #line-at(70.824pt, 424.63pt, "strongly at wavelength of approximately 260 nm, while lipids absorb around 320 nm")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.98pt, 420.67pt, "14,15")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.7pt, 424.63pt, ". This native ")
  #line-at(70.824pt, 437.35pt, "absorption can be used to provide label-free chemically specific contrast that effectively acts as a built-")
  #line-at(70.824pt, 449.95pt, "in molecular stain. In addition, the short wavelength of DUV light can lead to improved diffraction-")
  #line-at(70.824pt, 462.67pt, "limited resolution compared to the visible range, which enables submicron structural visualization. ")
  #line-at(70.824pt, 475.27pt, "These two factors, chemical specificity and improved resolution, make DUV a very attractive modality ")
  #line-at(70.824pt, 487.99pt, "for biomedical imaging and histopathology. ")
  #line-at(70.824pt, 508.63pt, "Practical implementation of DUV microscopy is technically challenging")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(400.54pt, 504.67pt, "16")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407.5pt, 508.63pt, ", however. Standard glass ")
  #line-at(70.824pt, 521.23pt, "optics strongly absorb DUV radiation. Only specialized materials such as fused silica or reflective ")
  #line-at(70.824pt, 533.83pt, "components, such as Cassegrain objectives, can be used to construct optical imaging systems. High-")
  #line-at(70.824pt, 546.55pt, "quality DUV objectives are expensive. Even with advanced materials, their numerical aperture (NA) ")
  #line-at(70.824pt, 559.18pt, "remains relatively low, which limits the achievable resolution. Furthermore, traditional lens-based ")
  #line-at(70.824pt, 571.9pt, "architectures inherently restrict the field of view (FOV). Imaging extended tissue sections or large cell ")
  #line-at(70.824pt, 584.5pt, "cultures efficiently is, therefore, cumbersome. These constraints, including high cost, limited NA, small ")
  #line-at(70.824pt, 597.1pt, "FOV, and potential chromatic aberrations, have so far limited the widespread use of DUV in practical ")
  #line-at(70.824pt, 609.82pt, "biomedical imaging. DUV illumination at high intensities can also induce phototoxic effects, which ")
  #line-at(70.824pt, 622.42pt, "further complicates live-cell studies. Recently, Gorti et al.")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(330.43pt, 618.46pt, "17")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(337.39pt, 622.42pt, " quantified UV-induced photodamage and ")
  #line-at(70.824pt, 635.14pt, "reported a critical total fluence threshold for significant cell death of approximately 1 µJ/µm². Under ")
  #line-at(70.824pt, 647.74pt, "reported DUV imaging conditions (plasma-laser source at a wavelength of 255 nm, power density ~1 ")
  #line-at(70.824pt, 660.34pt, "nW/µm², 50 ms exposure time), the fluence per frame is around 0.05 nJ/µm², allowing the authors to ")
  #line-at(70.824pt, 673.18pt, "perform more than 20,000 sequential acquisitions before reaching the damage threshold.  ")
  #line-at(70.824pt, 693.7pt, "A promising strategy to bypass these constraints is to adopt a lensless imaging approach. Lensless digital ")
  #line-at(70.824pt, 706.3pt, "holographic microscopy")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.77pt, 702.34pt, "7,12,18,19")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(207.41pt, 706.3pt, " (LH) removes lenses entirely and directly records the diffracted optical ")
  #line-at(70.824pt, 719.04pt, "field as a hologram on a sensor. The complex sample information is then numerically reconstructed by ")
  #line-at(70.824pt, 731.64pt, "computational back-propagation to the sample plane. By eliminating conventional optics, LH avoids the ")
  #line-at(70.824pt, 744.36pt, "absorption and aberration issues that are present in DUV lens-based systems and is thus a perfect ")
  #line-at(70.824pt, 756.96pt, "candidate for DUV imaging development. This trend is echoed by an alternative lensless ptychographic ")
]

