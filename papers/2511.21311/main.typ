#original-page(595.32pt, 841.92pt, (image("graphics/page-25.png", width: 487.5pt), 70.5pt, 72.5pt))[
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(73.584pt, 520.39pt, "Figure S1. Relationship between exposure time, effective grayscale depth of a single hologram, and noise levels ")
  #line-at(240.41pt, 531.91pt, "in LH-DUV reconstructions. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 552.34pt, "These experiments collectively demonstrate that LH-DUV holography is remarkably robust across ")
  #line-at(70.824pt, 564.94pt, "detectors and operates effectively even when using standard CMOS cameras originally designed for the ")
  #line-at(70.824pt, 577.54pt, "visible range. Although the two CMOS cameras used in this study exhibited markedly different ")
  #line-at(70.824pt, 590.26pt, "maximum exposure times and dynamic ranges and quantum efficiencies in the DUV, meaningful ")
  #line-at(70.824pt, 602.86pt, "reconstructions were achievable in both cases, despite the fact that that all measurements were ")
  #line-at(70.824pt, 615.58pt, "performed deep within the low illumination regime (much below 100 uW measurable by power meter ")
  #line-at(70.824pt, 628.18pt, "PM100D with S175C sensor, Thorlabs). This further highlights the inherent efficiency of LH-DUV and ")
  #line-at(70.824pt, 640.9pt, "its natural resistance to phototoxicity. Nevertheless, the ability to obtain high-quality amplitude and ")
  #line-at(70.824pt, 653.5pt, "phase reconstructions using detectors originally designed for the visible range underscores the unique ")
  #line-at(70.824pt, 666.22pt, "practicality and versatility of the LH-DUV approach. ")
]
