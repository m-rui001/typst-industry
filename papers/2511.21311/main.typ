#original-page(595.32pt, 841.92pt, (image("graphics/page-05.png", width: 413pt), 70.5pt, 250.5pt))[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.02pt, "quantitative analysis of the denoising influence is provided in the Supplementary Material, wherease ")
  #line-at(70.824pt, 93.86pt, "proposed PSR with TV and autofocusing algorithm is carefully described in the Methods section. ")
  #line-at(70.824pt, 120.38pt, "Even when the recorded hologram contained only three gray levels (first row), the final reconstruction ")
