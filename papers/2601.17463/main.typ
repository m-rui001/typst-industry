  #line-at(69.6pt, 381.12pt, "generating the figures given in this paper. ")
  #line-at(69.6pt, 406.32pt, "PSD plots, ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
