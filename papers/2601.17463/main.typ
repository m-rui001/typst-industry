#original-page(595.2pt, 841.92pt, (image("graphics/page-09.png", width: 6.5pt), 407pt, 205.5pt))[
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(231.163pt, 116.4pt, "Paper submitted to ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(293.155pt, 116.4pt, "Radiation Measurents ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(521.76pt, 116.4pt, "9 ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(81.6pt, 143.04pt, "The good reproducibility is obviously due to the following facts: ")
  #line-at(89.218pt, 168pt, "(i)")
  #line-at(117.6pt, 168pt, "The samples were not wrapped but positioned in a reflective cup. This eliminates light yield ")
  #line-at(117.6pt, 186.96pt, "variations due to imperfect wrapping. ")
  #line-at(86.162pt, 212.64pt, "(ii)")
  #line-at(117.6pt, 212.64pt, "Temperature variations in the lab were quite small and well below ")
  #line-at(413.214pt, 212.64pt, " 2°C. Temperature effects ")
  #line-at(117.6pt, 232.08pt, "on the PMT gain are thus negligible. ")
  #line-at(83.105pt, 257.04pt, "(iii)")
  #line-at(117.6pt, 257.04pt, "The PMT orientation did not change because of the base fixed in the setup. This and the ")
  #line-at(117.6pt, 276pt, "magnetic shield reduced potential effects of the terrestrial magnetic field. ")
  #line-at(81.6pt, 300.96pt, "Uncertainties of the FOMs are derived by error propagation from uncertainties of the peak positions ")
  #line-at(69.6pt, 319.92pt, "and peak widths obtained from the corresponding fit procedure. Error bands of the FOM fits are provided ")
  #line-at(69.6pt, 338.88pt, "by the fit algorithm. ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(69.6pt, 381.84pt, "3.")
  #line-at(80.906pt, 381.84pt, "Results and discussion ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(81.6pt, 406.8pt, "The results of this work are presented in Figure 4 to Figure 7 and in ")
  #set text(font: "Times New Roman", size: 10.08pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(381.898pt, 406.8pt, "Table 2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(412.162pt, 406.8pt, ". ")
  #line-at(81.6pt, 431.76pt, "Figure 4 exhibits the quite decent neutron-gamma discrimination capabilities of EJ-276D, M600, and ")
  #line-at(69.6pt, 450.72pt, "M700 scintillators in contrast to the rudimentary (but, surprisingly, still observable) PSD performance ")
  #line-at(69.6pt, 469.68pt, "of the common EJ-200. The data were taken before ageing. It is evident that M700 provides the best ")
  #line-at(69.6pt, 488.88pt, "neutron-gamma discrimination, reaching a FOM > 2 below 200 keVee and keeping a good discrimination ")
  #line-at(69.6pt, 507.84pt, "(FOM > 1.5) down to 100 keVee (Figure 6). The performance of M600 is worse than that of EJ-276D; ")
  #line-at(69.6pt, 526.8pt, "the differences seem to be larger at lower energies (Figure 6), which might be due to the lower light yield ")
  #line-at(69.6pt, 545.76pt, "(")
  #set text(font: "Times New Roman", size: 10.08pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(73.263pt, 545.76pt, "Table 2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(105.904pt, 545.76pt, "). Altogether, all three scintillators offered with PSD capabilities are good candidates for ")
  #line-at(69.6pt, 564.72pt, "simultaneous measurements of fast neutrons and gamma rays. ")
  #line-at(81.6pt, 589.68pt, "The characterization measurements were repeated after ageing of all samples by steaming and freezing ")
  #line-at(69.6pt, 608.64pt, "as described in section 2.3. Though this procedure was rather short if compared with other, similar ")
  #line-at(69.6pt, 627.6pt, "investigations [20], an optical degradation of the Eljen materials EJ-200 and EJ-276D was clearly visible: ")
  #line-at(69.6pt, 646.56pt, "The corresponding samples became milky and opaque, while the PU-based scintillators, M600 and ")
  #line-at(69.6pt, 665.52pt, "M700, seemed undisturbed and clear as before (see Figure 1). Surprisingly, these visible differences are ")
  #line-at(69.6pt, 684.48pt, "not reflected in the test results, at least not to the extent expected. Light yield and FOM measured at ")
  #line-at(69.6pt, 703.44pt, "477 keVee (")
  #set text(font: "Times New Roman", size: 10.08pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(124.844pt, 703.44pt, "Table 2")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(156.473pt, 703.44pt, ") show only slight variations which do not significantly exceed the experimental ")
]

