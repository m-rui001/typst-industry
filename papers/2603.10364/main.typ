  #line-at(167.54pt, 150.02pt, "51%")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(191.54pt, 150.02pt, " (at the Mie transition) to ")
