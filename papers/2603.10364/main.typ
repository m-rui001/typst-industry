  #line-at(243.53pt, 585.91pt, " manifold in the DCT domain provides the mathematical ")
  #line-at(72.024pt, 600.58pt, "foundation for a transition from reduced-order modeling to experimental compressed sensing ")
  #line-at(72.024pt, 615.22pt, "(CS). By identifying the minimal set of physical wavelengths (")
