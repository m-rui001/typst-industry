  #line-at(72.024pt, 98.06pt, "mathematical artifacts.")
  #line-at(72.024pt, 120.74pt, "By bridging the gap between wave scattering and information theory, we transition spectroscopy ")
  #line-at(72.024pt, 135.38pt, "from a redundant heuristic-based sampling approach to an optimal experimental design. We have ")
  #line-at(72.024pt, 150.02pt, "demonstrated that ")
