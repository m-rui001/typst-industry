  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(134.9pt, 495.79pt, " of the maximum signal height to isolate significant physical resonances. For each ")
  #line-at(72.024pt, 510.43pt, "identified peak, a localized spectral window is defined. The LRMSE is the average RMSE calculated ")
  #line-at(72.024pt, 525.07pt, "exclusively within these high-complexity zones, revealing which basis better preserves the fine ")
  #line-at(72.024pt, 539.71pt, "structure of the Mie manifold during the transition regime. ")
  #set text(font: "Calibri", size: 15.96pt, weight: "regular", style: "normal", fill: rgb("#0f4761"))
