  #set text(font: "Cambria Math", size: 8.52pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(526.06pt, 190.82pt, "𝑒𝑥𝑡")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 203.06pt, "signal is inherently sparse and governed by a universal, size-dependent complexity profile that ")
  #line-at(72.024pt, 217.7pt, "transcends specific molecular chemistry. In doing so, we provide a mathematical answer to a ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(523.06pt, 217.7pt, "50")
