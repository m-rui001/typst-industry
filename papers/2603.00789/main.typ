  #line-at(72.024pt, 304.01pt, "and acoustic-amplitude evolutions (mean absolute correlation > 0.6; Extended Data Fig. S4; ")
  #line-at(72.024pt, 331.61pt, "Extended Data Videos S1–S3). Together, these results clarify the physical origins of the measured ")
  #line-at(72.024pt, 359.23pt, "signals and establish sub-millisecond, deterministic links among vapor-jet dynamics, cavity ")
  #line-at(72.024pt, 386.83pt, "oscillations, and airborne acoustics—enabling accurate, rapid (few-hundred-microsecond) and ")
  #line-at(72.024pt, 414.43pt, "low-cost, noninvasive inference of cavity depth and oscillation frequency from airborne ")
  #line-at(72.024pt, 442.03pt, "measurements. ")
  #line-at(72.024pt, 513.22pt, "To extend the impact of this work and further illustrate the broader implications of our theory, we ")
