// arXiv source page 2
#original-page(612pt, 792pt, (image("graphics/page-02.png", width: 471.5pt), 70.5pt, 89pt))[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(534.58pt, 739.68pt, "2 ")
  #set text(font: "Times New Roman", size: 14.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 85.1pt, "Summary paragraph")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 107.06pt, "Aeroacoustic emissions from intense evaporation are widely measured yet often treated as ")
  #line-at(72.024pt, 134.66pt, "noisy byproducts and used mainly in empirical monitoring")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(374.47pt, 130.7pt, "1–8")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(386.59pt, 134.66pt, ". Here, we show that airborne ")
  #line-at(72.024pt, 162.26pt, "sound encodes physics-governed sub-millisecond fingerprints of vapor-jet dynamics in ")
  #line-at(72.024pt, 189.86pt, "excessive vaporization, exemplified by vapor keyholes in laser metal processing")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(488.02pt, 185.9pt, "9–16")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(504.1pt, 189.86pt, ". From ")
  #line-at(72.024pt, 217.49pt, "first principles, we develop a vapor-jet-cavity oscillation framework and incorporate it into ")
  #line-at(72.024pt, 245.09pt, "an aeroacoustic formulation, thereby coupling measured sound to transient cavity depth and ")
  #line-at(72.024pt, 272.69pt, "oscillation frequency")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(179.42pt, 268.73pt, "17–30")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(199.58pt, 272.69pt, ". Reconciled with synchronized multimodal in-situ data, airborne ")
  #line-at(72.024pt, 300.29pt, "acoustics enable accurate tracking of vapor-cavity properties within tens to hundreds of ")
  #line-at(72.024pt, 327.89pt, "microseconds. Combined with newly discovered correlations, cavity-jet-acoustic theory ")
  #line-at(72.024pt, 355.49pt, "recasts the transition from steady, pore-free to pore-shedding vaporizations as a critical-")
  #line-at(72.024pt, 383.11pt, "frequency event. Aeroacoustic emissions thus become scalable, physics-guided, and cost-")
  #line-at(72.024pt, 410.71pt, "efficient probes of rapidly evolving liquid–vapor systems.  ")
]

// arXiv source page 3
#original-page(612pt, 792pt, none)[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(534.58pt, 739.68pt, "3 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 83.18pt, "Airborne sound accompanies nearly every instance of rapid vaporization, a common physical ")
  #line-at(72.024pt, 110.78pt, "process that occurs from boiling and cavitation to laser ablation and metal welding")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(475.03pt, 106.22pt, "1–5")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.18pt, 110.78pt, ". Yet, even ")
  #line-at(72.024pt, 138.38pt, "when acoustic emissions from excessive evaporation exhibit repeatable tonal features, the ")
  #line-at(72.024pt, 165.98pt, "mechanisms governing how those features evolve, as well as how they map quantitatively onto ")
  #line-at(72.024pt, 193.58pt, "momentary vaporization dynamics, remain only partially understood")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(400.87pt, 189.02pt, "1,2,4–6")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(425.11pt, 193.58pt, ". Arising from mass and ")
  #line-at(72.024pt, 221.21pt, "momentum exchange between vapor jets and the surrounding medium, these ubiquitous emissions ")
  #line-at(72.024pt, 248.81pt, "are often treated as noisy, broadband, and configuration-sensitive, hence hindering mechanistic ")
  #line-at(72.024pt, 276.41pt, "interpretation")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.58pt, 271.85pt, "2,5–7")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(154.82pt, 276.41pt, ". Accordingly, despite the widespread empirical usage of acoustic sensing, a ")
  #line-at(72.024pt, 304.01pt, "deterministic and physics-based understanding of how transient liquid–vapor motion relates to ")
  #line-at(72.024pt, 331.61pt, "measurable airborne sound has remained elusive")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(305.09pt, 327.05pt, "4,6–8")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.33pt, 331.61pt, ". This gap raises a fundamental question: ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(522.7pt, 331.61pt, "can ")
  #line-at(72.024pt, 359.23pt, "the ubiquitous yet seemingly noisy sound of excessive vaporization encode transient physics-")
  #line-at(72.024pt, 386.83pt, "consistent signatures of the process itself?  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 442.03pt, "More broadly, this question concerns ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(250.73pt, 442.03pt, "observability and mechanistic attribution")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(447.67pt, 442.03pt, " in non-equilibrium ")
  #line-at(72.024pt, 469.63pt, "intense vaporization across a wide range of scientific and engineering topics")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(450.31pt, 465.07pt, "4,5")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(460.39pt, 469.63pt, ". Notably, laser-")
  #line-at(72.024pt, 497.23pt, "based metal processing (LMP), where concentrated laser energy deposition melts and resolidifies ")
  #line-at(72.024pt, 524.86pt, "metal feedstock to produce dense components, offers a particularly tangible testbed for addressing ")
  #line-at(72.024pt, 552.46pt, "this gap. In laser-based welding and powder bed fusion (PBF), excessive laser heating frequently ")
  #line-at(72.024pt, 580.06pt, "occurs and drives the melt pool to temperatures near or above the alloy’s boiling point")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(509.74pt, 575.5pt, "9")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(513.82pt, 580.06pt, ". The ")
  #line-at(72.024pt, 607.66pt, "ensuing rapid vaporization generates airborne acoustic emissions and produces a recoil pressure ")
  #line-at(72.024pt, 635.26pt, "that depresses the liquid surface, forming a vapor-filled cavity known as a ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(457.27pt, 635.26pt, "keyhole")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(493.78pt, 630.7pt, "10")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(501.94pt, 635.26pt, ". Under ")
  #line-at(72.024pt, 662.88pt, "vigorous and highly transient evaporation, the vapor jet sustains a deep keyhole geometry while ")
  #line-at(72.024pt, 690.48pt, "emitting sound")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(143.18pt, 685.92pt, "8")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(147.26pt, 690.48pt, "; oscillations of the deep keyhole, sometimes accompanied by intermittent collapse ")
]

// arXiv source page 4
#original-page(612pt, 792pt, none)[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(534.58pt, 739.68pt, "4 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 83.18pt, "and gas entrapment that shed near-spherical pores and seed defects known as keyhole porosity")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(529.18pt, 78.62pt, "10")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(537.22pt, 83.18pt, ", ")
  #line-at(72.024pt, 110.78pt, "can in turn modulate the vapor jet and its associated acoustic emissions")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(413.11pt, 106.22pt, "9–11")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(429.07pt, 110.78pt, ". Albeit a specific case, ")
  #line-at(72.024pt, 138.38pt, "LMP couples acoustic emissions with driven vapor jets, compliant liquid cavities, and strongly ")
  #line-at(72.024pt, 165.98pt, "time-dependent interfacial dynamics, making it representative of a broader class of vaporization-")
  #line-at(72.024pt, 193.58pt, "driven dynamical systems and a useful context for developing transferable observability principles.  ")
  #line-at(72.024pt, 248.81pt, "Another crucial and impactful aspect of the aforementioned observability and interpretability ")
  #line-at(72.024pt, 276.41pt, "hinges on ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(123.26pt, 276.41pt, "time-resolved accessibility")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(251.69pt, 276.41pt, ", namely, the extent to which they can be achieved rapidly ")
  #line-at(72.024pt, 304.01pt, "using easily accessible, cost-effective sensing methods across diverse practical settings. In recent ")
  #line-at(72.024pt, 331.61pt, "years, monitoring approaches spanning from high-fidelity ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(362.35pt, 331.61pt, "in situ")
