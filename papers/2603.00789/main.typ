  #line-at(318.29pt, 133.82pt, "2–8")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(330.41pt, 138.38pt, ". With the support of the new theoretical ")
  #line-at(72.024pt, 165.98pt, "framework and synchronized observations from our vaporization prototype, airborne emissions ")
  #line-at(72.024pt, 193.58pt, "can be elevated from qualitative indicators to quantitative, physics-informed observables that ")
  #line-at(72.024pt, 221.21pt, "recover key dynamical variables and stability-relevant thresholds. Moreover, the coupled ")
