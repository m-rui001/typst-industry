  #line-at(442.081pt, 500.394pt, "recent")
  #line-at(134.765pt, 512.349pt, "works on machining and drilling applications. Finally, we make a special emphasis on")
  #line-at(134.765pt, 524.304pt, "emerging near- and mid-infrared laser technologies which hold promises to transfer")
  #line-at(134.765pt, 536.259pt, "ultrafast laser 3D writing from wide- to narrow-gap materials, i.e., semiconductors.")
  #line-at(134.765pt, 548.214pt, "This is strongly supported by the advent of a new generation of stable and powerful")
  #line-at(134.765pt, 560.17pt, "ultrashort pulse sources which emit in the transparency range of semiconductors. In")
  #line-at(134.765pt, 572.125pt, "contrast to dielectrics, enhanced nonlinearities are found when focusing intense in-")
  #line-at(134.765pt, 584.08pt, "frared laser pulses in semiconductors. In practice, this strongly limits the space-time")
  #line-at(134.765pt, 596.035pt, "energy")
