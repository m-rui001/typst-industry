  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "italic", fill: rgb("#0e0e0e"))
  #line-at(72.025pt, 172.55pt, "Physically, Eq. (5) shows that continuous measurement perturbs the steady state only through its ")
