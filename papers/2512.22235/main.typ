  #line-at(72.025pt, 197.83pt, "not translate into disturbance of the physical ensemble. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 231.33pt, "3. MEASUREMENT-INVARIANT STEADY STATES")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 257.83pt, "We now identify the precise condition under which continuous measurement leaves the physical steady-")
