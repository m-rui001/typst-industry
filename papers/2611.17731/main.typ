  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(118.8pt, 656.88pt, "/s have been reported along with zigzag diffusivities ranging from 80-800 cm")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(453.72pt, 652.92pt, "2")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(457.2pt, 656.88pt, "/s ")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(467.64pt, 652.92pt, "8,9")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(476.28pt, 656.88pt, ". As such, both ")
  #line-at(71.995pt, 670.316pt, "the overall diffusion coefficients obtained from stroboSCAT and the anisotropic ratio between the armchair ")
  #line-at(71.995pt, 683.751pt, "and zigzag axes are lower than previously reported values. To date, it is unclear if this wide range of results ")
  #line-at(71.995pt, 697.187pt, "is a function of time resolution, excitation density, or sample preparation procedure (e.g., defect density). ")
  #line-at(71.995pt, 710.623pt, "Presumably, differences in experimental methods can come into play, including how data are modeled, fit, ")
]

