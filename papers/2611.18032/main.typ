  #line-at(79.37pt, 660.039pt, "Figure 1a illustrates the operating principle of the proposed reflective moiré metasurface. Superimposing")
  #set text(font: "Times New Roman", size: 11.018pt, weight: "regular", style: "normal", fill: rgb("#000000"))
