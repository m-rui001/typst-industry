  #line-at(79.37pt, 575.264pt, "to predictive and reconfigurable multibeam engineering while reducing reliance on computationally")
  #set text(font: "Times New Roman", size: 10.909pt, weight: "regular", style: "normal", fill: rgb("#000000"))
