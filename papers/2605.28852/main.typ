  #line-at(336.43pt, 139.34pt, " mean tends to underestimate the ")
  #line-at(85.104pt, 160.1pt, "grain size, since small grains and misindexed points are weighted equally to large ")
  #line-at(85.104pt, 180.74pt, "grains. The ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(141.74pt, 180.74pt, "area-weighted ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(217.37pt, 180.74pt, "mean is a better option as it weights each grain’s ")
  #line-at(85.104pt, 201.5pt, "contribution to the size distribution by its sectional area. Use of the ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(409.87pt, 201.5pt, "arithmetic")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(463.3pt, 201.5pt, " mean ")
  #line-at(85.104pt, 222.14pt, "implies a normal distribution shape, whereas the ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(320.35pt, 222.14pt, "geometric")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(370.99pt, 222.14pt, " mean value implies a log-")
  #line-at(85.104pt, 242.9pt, "normal distribution, which is both empirically a better match of the grain size ")
