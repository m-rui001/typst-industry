  #line-at(234.05pt, 284.21pt, "quantile values")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(311.09pt, 284.21pt, " such as the 10")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(381.55pt, 279.65pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(387.91pt, 284.21pt, ", 50")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.91pt, 279.65pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(412.27pt, 284.21pt, ", and 90")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(450.46pt, 279.65pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 304.97pt, "percentiles (written as D10, D50, and D90 in ISO 13067) do not assume anything about ")
  #line-at(85.104pt, 325.61pt, "the underlying distribution shape, and can be expressed as either number- or area-")
