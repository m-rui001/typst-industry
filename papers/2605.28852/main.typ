  #set text(font: "Times New Roman", size: 12.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 97.34pt, "1.3")
  #line-at(113.9pt, 97.34pt, "Grain size statistics ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 118.7pt, "The simplest statistic to summarise a grain size distribution is the (implicitly number-")
  #line-at(85.104pt, 139.34pt, "weighted, arithmetic) ")
