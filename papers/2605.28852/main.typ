#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.1pt, 96.26pt, "grain boundaries can break up large grains (or, conversely, clean-up procedures can ")
  #line-at(106.1pt, 116.9pt, "artificially link them). ")
  #line-at(88.104pt, 145.58pt, "(5)")
  #line-at(106.1pt, 145.58pt, "A 10° misorientation threshold angle may be more appropriate than 5° when ")
  #line-at(106.1pt, 166.34pt, "analysing maps with highly developed sub-grain structure.  ")
  #line-at(88.104pt, 195.02pt, "(6)")
  #line-at(106.1pt, 195.02pt, "The EBSD map field of view should follow the average aspect ratio of the grains. ")
  #set text(font: "Times New Roman", size: 15.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 231.38pt, "2")
  #line-at(106.7pt, 231.38pt, "Grain reconstruction methods and size metrics ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 261.26pt, "This section aims to determine the best grain reconstruction procedure and size metric, ")
  #line-at(85.104pt, 282.05pt, "subject to the following constraints: ")
  #line-at(103.1pt, 310.73pt, "(1)")
  #line-at(121.1pt, 310.73pt, "The procedure and results should be software-agnostic. The map post-processing ")
  #line-at(121.1pt, 331.49pt, "procedure must be available in any of the major commercial and open-source ")
  #line-at(121.1pt, 352.13pt, "software packages (OIM Analysis, AZtecCrystal, and MTEX), and the measured ")
  #line-at(121.1pt, 372.89pt, "grain sizes should be consistent between them. ")
  #line-at(103.1pt, 401.57pt, "(2)")
  #line-at(121.1pt, 401.57pt, "A good grain size metric (e.g. grain area, equivalent circle diameter, minimum or ")
  #line-at(121.1pt, 422.21pt, "maximum Feret lengths) is insensitive to operator-selected experimental or data-")
  #line-at(121.1pt, 442.97pt, "processing parameters, and sensitive to physical differences in the ")
  #line-at(121.1pt, 463.61pt, "microstructure. ")
  #line-at(103.1pt, 492.31pt, "(3)")
  #line-at(121.1pt, 492.31pt, "A good grain size statistic (e.g. mean, median, n")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(351.67pt, 487.75pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(358.03pt, 492.31pt, " percentiles) and visualisation ")
  #line-at(121.1pt, 513.07pt, "method (e.g. grain map, histogram plot) should be easy to read (e.g. fewer ")
  #line-at(121.1pt, 533.71pt, "numbers is better), intuitive to understand (e.g. familiar measurement units), and ")
  #line-at(121.1pt, 554.47pt, "conservative in nature, i.e. low-quality data can be identified quickly and ")
  #line-at(121.1pt, 575.11pt, "directly. As with the grain size metrics, it should also be insensitive to operator-")
  #line-at(121.1pt, 595.87pt, "selected parameters, and sensitive to physical differences. ")
  #set text(font: "Times New Roman", size: 12.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 625.63pt, "2.1")
  #line-at(113.9pt, 625.63pt, "Grain reconstruction  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 646.99pt, "Consistency between the grain reconstruction and EBSD map clean-up methods in ")
  #line-at(85.104pt, 667.66pt, "different software packages was tested using a small EBSD map ")
  #line-at(85.104pt, 688.42pt, "(161 × 160 points, 1.251 μm step size), acquired using the Oxford Instruments EBSD ")
  #line-at(85.104pt, 709.06pt, "system (AZtec 6.2) and exported in .h5oina (HDF5 binary) and .ctf (text) formats. Edge ")
  #line-at(85.104pt, 729.82pt, "grains were not excluded because this map is very small.  ")
]

