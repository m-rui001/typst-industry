  #line-at(85.104pt, 493.27pt, "grains=calcGrains(ebsd('indexed'),'angle',10*degree)")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(399.79pt, 493.27pt, ".  ")
  #line-at(85.104pt, 521.95pt, "Grain maps (grains in random colours) from the three software programs are shown in ")
  #line-at(85.104pt, 542.71pt, "Figure 1. The reconstructed grains are identical as long as no clean-up is performed. ")
  #line-at(85.104pt, 563.35pt, "Figure 1 (d) and (e) show cleaned-up maps using the AZtecCrystal and OIM Analysis ")
  #line-at(85.104pt, 584.11pt, "algorithms. There are minor differences but the overall grain structures appear ")
  #line-at(85.104pt, 604.75pt, "qualitatively similar. ")
  #line-at(85.104pt, 633.43pt, "The uncertainty component from clean-up varies between datasets, but an uncertainty ")
  #line-at(85.104pt, 654.19pt, "range can be determined from the difference between no clean-up and maximum ")
  #line-at(85.104pt, 674.86pt, "clean-up and modelled as a Type B uncertainty with rectangular distribution. Examples ")
