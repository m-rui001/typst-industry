  #set text(font: "Times New Roman", size: 12.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 376.13pt, "1.4")
  #line-at(113.9pt, 376.13pt, "Recommended updates to existing standards ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 397.49pt, "References [1], [7], [10], [11], [12] recommended several updates to both ASTM E2627 ")
  #line-at(85.104pt, 418.13pt, "and ISO 13067, both generally and for AM materials. Items which have not already ")
  #line-at(85.104pt, 438.89pt, "been addressed in a subsequent version of the standards are summarised below: ")
  #line-at(88.104pt, 467.59pt, "(1)")
  #line-at(106.1pt, 467.59pt, "Small grains < 10 or < 100 points per grain should not be removed as this severely ")
