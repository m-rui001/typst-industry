#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 20.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.02pt, 103.7pt, "Towards standardisation of average grain size ")
  #line-at(143.06pt, 126.74pt, "measurement of additively manufactured ")
  #line-at(189.77pt, 149.78pt, "microstructures using EBSD ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 177.26pt, "Vivian Tong")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(144.26pt, 172.7pt, "1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.34pt, 177.26pt, ", Hannah Zhang")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(225.29pt, 172.7pt, "1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(229.37pt, 177.26pt, ", Jacopo Del Gaudio")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(327.31pt, 172.7pt, "1,2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(337.39pt, 177.26pt, ", Ken Mingard")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407.59pt, 172.7pt, "1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(411.67pt, 177.26pt, ", Ali Gholinia")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(477.34pt, 172.7pt, "2 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(103.1pt, 205.94pt, "1.")
  #line-at(121.1pt, 205.94pt, "National Physical Laboratory, Teddington, United Kingdom ")
  #line-at(103.1pt, 234.62pt, "2.")
  #line-at(121.1pt, 234.62pt, "Henry Royce Institute, Department of Materials, University of Manchester, ")
  #line-at(121.1pt, 255.26pt, "Manchester, M13 9PL, United Kingdom ")
  #set text(font: "Times New Roman", size: 15.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 291.77pt, "1")
  #line-at(106.7pt, 291.77pt, "Introduction ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 321.65pt, "Additively manufactured (AM) alloys have heterogeneous microstructures with broad ")
  #line-at(85.104pt, 342.29pt, "grain size distributions and highly anisotropic and/or non-convex grain shapes. AM ")
  #line-at(85.104pt, 363.05pt, "components can have complex geometries and porosity which may affect the local ")
  #line-at(85.104pt, 383.69pt, "microstructure. Currently there is no electron backscatter diffraction (EBSD)-based ")
  #line-at(85.104pt, 404.45pt, "grain size measurement standard suitable for typical AM materials.  ")
  #line-at(85.104pt, 433.13pt, "An interlaboratory comparison study was conducted to find out what grain size metrics ")
  #line-at(85.104pt, 453.89pt, "and summary statistics are currently used to describe average grain size. Participants ")
  #line-at(85.104pt, 474.55pt, "were asked to measure and report the average grain size from the same EBSD map ")
  #line-at(85.104pt, 495.31pt, "dataset. Detailed reports have been published in Reference [1]. Based on these results, ")
  #line-at(85.104pt, 515.95pt, "we have tested and propose recommendations for a new standard for measuring average ")
  #line-at(85.104pt, 536.59pt, "grain size in AM materials. The present work demonstrates the suitability and ")
  #line-at(85.104pt, 557.35pt, "limitations of the proposal across several different Ni and Al AM components.  ")
  #set text(font: "Times New Roman", size: 12.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 587.11pt, "1.1")
  #line-at(113.9pt, 587.11pt, "Grain size standards ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 608.47pt, "A major standardisation need of grain size measurement is for patent claims and alloy ")
  #line-at(85.104pt, 629.11pt, "grade specifications. The measured grain size in this context is to distinguish between ")
  #line-at(85.104pt, 649.87pt, "(dis)similar structures. Three general standards exist for grain size measurement of ")
  #line-at(85.104pt, 670.54pt, "metallic materials: ASTM E112 [2], describes intercept and planimetric methods to ")
  #line-at(85.104pt, 691.3pt, "measure average grain size from micrograph images; ASTM E2627 [3] and ISO 13067 ")
  #line-at(85.104pt, 711.94pt, "[4] both describe electron backscatter diffraction (EBSD)-based grain size ")
  #line-at(85.104pt, 732.7pt, "measurements, but specify different requirements. Other material-specific standards for ")
]

// arXiv source page 2
#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 96.26pt, "grain size measurement also exist, such as ISO 4499 for WC grain size measurement in ")
  #line-at(85.104pt, 116.9pt, "hardmetals. ")
  #line-at(85.104pt, 145.58pt, "ASTM E112 has been cited within the ‘Claims’ section of 242 patents between 1970 ")
  #line-at(85.104pt, 166.34pt, "and 2024 [5], but neither ASTM E2627 nor ISO 13067 have been cited in the ‘Claims’ ")
  #line-at(85.104pt, 186.98pt, "section of any patents since their first publications in 2013 and 2011 respectively [6]. ")
  #line-at(85.104pt, 215.78pt, "Quantitative grain boundary identification and full sectional grain size distributions are ")
  #line-at(85.104pt, 236.42pt, "available from EBSD orientation maps. For additively manufactured (AM) alloys, ")
  #line-at(85.104pt, 257.06pt, "which typically have complex microstructures with broad grain size distributions, ")
  #line-at(85.104pt, 277.85pt, "EBSD may offer a more complete description of the microstructure compared to ")
  #line-at(85.104pt, 298.49pt, "planimetric or intercept-based methods which only measure the average grain size. ")
  #line-at(85.104pt, 319.25pt, "However, EBSD-based average grain size measurements are extremely sensitive to ")
  #line-at(85.104pt, 339.89pt, "operator choices during the experimental, data clean-up, grain reconstruction, and ")
  #line-at(85.104pt, 360.65pt, "statistical analysis steps, which may limit its usefulness in a patent claim.  ")
  #set text(font: "Times New Roman", size: 12.96pt, weight: "regular", style: "normal", fill: rgb("#2f5496"))
  #line-at(85.104pt, 390.41pt, "1.2")
  #line-at(113.9pt, 390.41pt, "Grain size metrics ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.104pt, 411.77pt, "The simplest grain size metric available from an EBSD grain map is grain area. This ")
  #line-at(85.104pt, 432.41pt, "metric makes no assumptions about grain shape, but area units (m")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(401.35pt, 427.85pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.43pt, 432.41pt, ")")
  #line-at(411.43pt, 432.41pt, "are less intuitive ")
  #line-at(85.104pt, 453.17pt, "than length units, so the equivalent circle (CEq) diameter is often reported instead. This ")
  #line-at(85.104pt, 473.83pt, "approximation of the grain sectional diameter in equiaxed microstructures, but can be ")
  #line-at(85.104pt, 494.59pt, "extremely misleading if the grains are elongated, e.g. along the build direction. Ellipse ")
  #line-at(85.104pt, 515.23pt, "fitting can describe the elongation, but the fitted ellipse shape is sensitive to the choice ")
  #line-at(85.104pt, 535.99pt, "of best-fit algorithm, especially for highly non-convex grains. Feret diameters along ")
  #line-at(85.104pt, 556.63pt, "various directions, which is the minimum distance between two parallel lines containing ")
  #line-at(85.104pt, 577.39pt, "the grain, can be used instead. These values are lengths that can be measured directly ")
  #line-at(85.104pt, 598.03pt, "from the EBSD grain map. The maximum Feret diameter (MFD) is most commonly ")
  #line-at(85.104pt, 618.79pt, "reported. The minimum Feret diameter, as well as Feret diameters along primary sample ")
  #line-at(85.104pt, 639.43pt, "axes, are also used. The ASTM number G is specified in ASTM grain size standards to ")
  #line-at(85.104pt, 660.22pt, "represent average grain size. It is convenient for relating materials properties because it ")
  #line-at(85.104pt, 680.86pt, "scales with most grain-size-dependent material properties [7], but it is unintuitive to ")
  #line-at(85.104pt, 701.62pt, "relate to microstructural features on an EBSD map. ")
]

