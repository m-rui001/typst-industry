  #line-at(45.54pt, 269.22pt, "Fig. 6. (a) Layout and photograph of the proposed rectifier. (b) Measured |")
  #set text(font: "Times New Roman", size: 7.76pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(276.78pt, 269.22pt, "S")
