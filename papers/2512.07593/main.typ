  #line-at(351.6pt, 738.18pt, "11")
  #set text(font: "Times New Roman", size: 9.755pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(358.02pt, 737.16pt, "| is shown in Fig. 6(b). when the power is lower ")
  #line-at(304.56pt, 748.92pt, "than 2 dBm, the reflection coefficients of the protected and ")
