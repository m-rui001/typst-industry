  #line-at(314.4pt, 263.999pt, "As shown in Table ΙΙ, this design demonstrates advantages in ")
  #line-at(304.56pt, 275.759pt, "terms of efficiency in low power, voltage limit, the number of ")
  #line-at(304.56pt, 287.52pt, "dc loads, and circuit size.  ")
  #line-at(393.18pt, 310.92pt, "V.")
  #line-at(409.62pt, 310.92pt, "C")
  #set text(font: "Times New Roman", size: 7.76pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(416.1pt, 310.92pt, "ONCLUSION")
  #set text(font: "Times New Roman", size: 9.755pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(314.4pt, 325.98pt, "A ")
  #line-at(336.19pt, 325.98pt, "low-power ")
  #line-at(393.148pt, 325.98pt, "rectifier ")
  #line-at(438.611pt, 325.98pt, "protection ")
  #line-at(492.847pt, 325.98pt, "strategy ")
  #line-at(538.319pt, 325.98pt, "for ")
  #line-at(304.56pt, 337.74pt, "electromagnetic energy harvesting applications was designed ")
  #line-at(304.56pt, 349.5pt, "and validated in this letter. By incorporating a PIN diode to ")
  #line-at(304.56pt, 361.26pt, "dynamically adjust the structure of the rectifier, the rectifier is ")
  #line-at(304.56pt, 372.96pt, "effectively protected from reverse breakdown with almost no ")
  #line-at(304.56pt, 384.72pt, "impact on the rectification efficiency. Moreover, the proposed ")
  #line-at(304.56pt, 396.42pt, "protection strategy can also be applied to other circuits that are ")
  #line-at(304.56pt, 408.18pt, "at risk of reverse breakdown and high power. ")
