  #line-at(72.024pt, 248.18pt, "metal-semiconductor interface, it is possible to tailor the Schottky barrier height, suppress ")
  #line-at(72.024pt, 267.17pt, "Fermi-level pinning, and enhance carrier extraction ")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(324.31pt, 263.21pt, "34–37")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(343.63pt, 267.17pt, ".  At the same time, the performance ")
  #line-at(72.024pt, 286.13pt, "of such devices remains highly sensitive to TMD film quality, contact resistance, and ")
  #line-at(72.024pt, 305.09pt, "nonradiative recombination induced by defects or interfaces ")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(362.59pt, 301.13pt, "31,38–42")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(391.63pt, 305.09pt, ". For WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(434.23pt, 306.05pt, "2")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.1pt, 305.09pt, " specifically, most ")
  #line-at(72.024pt, 324.05pt, "photovoltaic demonstrations have relied either on mechanically exfoliated flakes, which are ")
  #line-at(72.024pt, 343.01pt, "limited in area and difficult to scale ")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(243.77pt, 339.05pt, "15,43")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(261.05pt, 343.01pt, ", or on CVD-grown films whose growth conditions and ")
  #line-at(72.024pt, 362.09pt, "transfer routes may introduce inhomogeneity or damage ")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.67pt, 358.13pt, "24,25,39,40")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(385.39pt, 362.09pt, ". ")
  #line-at(72.024pt, 394.97pt, "These considerations highlight a clear need for a scalable WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(397.75pt, 395.93pt, "2")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(401.59pt, 394.97pt, " synthesis route that (i) ")
  #line-at(72.024pt, 413.93pt, "produces large-area thin films with controllable thickness, high crystallinity, and low roughness; ")
  #line-at(72.024pt, 432.89pt, "(ii) allows direct comparison between different W precursors (sputtered films vs foils) to ")
  #line-at(72.024pt, 451.87pt, "elucidate growth mechanisms and morphology control; and (iii) integrates seamlessly with ")
  #line-at(72.024pt, 470.83pt, "transfer and device fabrication processes for Schottky-barrier solar cells. In this work, we ")
  #line-at(72.024pt, 489.91pt, "address these challenges by employing a custom-built thermal CVD (T-CVD) system to ")
  #line-at(72.024pt, 508.87pt, "sulfurize both sputtered W thin films and W foils over a wide temperature range (400-1000 °C). ")
  #line-at(72.024pt, 527.83pt, "Raman spectroscopy, combined with full-width-at-half-maximum analysis of the E12g and A1g ")
  #line-at(72.024pt, 546.79pt, "modes, identifies 800 °C as the optimal synthesis temperature. In contrast, X-ray ")
  #line-at(72.024pt, 565.75pt, "photoelectron spectroscopy (XPS) confirms the conversion from tungsten oxide to WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(493.9pt, 566.71pt, "2")
  #line-at(501.1pt, 561.79pt, "26–28")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(520.3pt, 565.75pt, ". ")
  #line-at(72.024pt, 584.71pt, "Comprehensive scanning electron microscopy (SEM), atomic force microscopy (AFM), and ")
  #line-at(72.024pt, 603.67pt, "transmission electron microscopy (TEM) characterizations reveal that sputtered-W-derived ")
  #line-at(72.024pt, 622.66pt, "WS2 forms uniform, wafer-scale films with low surface roughness and well-defined layered ")
  #line-at(72.024pt, 641.62pt, "crystallinity. In contrast, foil-derived WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(278.81pt, 642.58pt, "2")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(282.65pt, 641.62pt, " exhibits thicker, island-like morphologies with ")
  #line-at(72.024pt, 660.82pt, "significant height variations. ")
  #line-at(72.024pt, 693.58pt, "Building on these materials advances, we implement a PMMA-assisted wet-transfer process ")
  #line-at(72.024pt, 712.54pt, "to integrate large-area WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(208.13pt, 713.5pt, "2")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(211.97pt, 712.54pt, " films onto indium tin oxide (ITO)-coated glass and fabricate ")
  #line-at(72.024pt, 731.62pt, "Au/WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.34pt, 732.58pt, "2")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.18pt, 731.62pt, "/ITO Schottky-barrier solar cells. The resulting devices achieve a power conversion ")
  #line-at(72.024pt, 750.576pt, "efficiency (PCE) of 1.45 %, with performance metrics that compare favorably with earlier WS")
  #set text(font: "Arial", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(515.98pt, 751.536pt, "2")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(519.82pt, 750.576pt, "-")
]

