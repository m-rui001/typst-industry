  #line-at(70.944pt, 281.81pt, "consistent description of sensitivity and selectivity in TMDC-based gas sensors. This theoretical ")
  #line-at(70.944pt, 296.21pt, "foundation can be extended to other 2D materials and gas species, offering a predictive approach for ")
  #line-at(70.944pt, 310.73pt, "optimizing sensor design and improving detection performance in practical air-quality monitoring ")
  #line-at(70.944pt, 325.25pt, "applications. ")
