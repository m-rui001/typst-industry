#original-page(612pt, 792pt, none)[
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(535.06pt, 740.976pt, "4 ")
  #line-at(70.824pt, 81pt, "what gives rise to the correlated outcomes typical of Bell states (Eq. 1) [21], [22]. In an optically ")
  #line-at(70.824pt, 95.66pt, "isotropic system, the probabilities of measuring H and V polarization are equal for both the signal ")
  #line-at(70.824pt, 110.18pt, "and idler photons.  ")
  #line-at(106.82pt, 136.7pt, "Thus, SPDC provides a robust and experimentally accessible source of entangled photon ")
  #line-at(70.824pt, 151.22pt, "pairs in which both photons always share the same polarization. This makes type-I SPDC an ideal ")
  #line-at(70.824pt, 165.86pt, "platform for studies of polarization correlations, Bell-inequality violations, quantum communication ")
  #line-at(70.824pt, 180.38pt, "protocols, and relevant to the present work – indirect detection experiments that rely on ")
  #line-at(70.824pt, 194.9pt, "polarization-correlated absorption or filtering applied to one branch of the entangled pair. When ")
  #line-at(70.824pt, 209.66pt, "the idler photon is absorbed in the basis state ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
