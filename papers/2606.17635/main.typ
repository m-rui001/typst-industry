  #line-at(70.824pt, 81pt, "The uncertainty of both methods is therefore assessed consistently through the statistical spread ")
  #line-at(70.824pt, 95.66pt, "of reconstruction errors across the dataset, without introducing additional model-specific ")
  #line-at(70.824pt, 110.18pt, "uncertainty estimation techniques. While more advanced analyses—such as pointwise confidence ")
  #line-at(70.824pt, 124.7pt, "intervals, bootstrap-based uncertainty estimation, or alternative kernel-based reconstruction ")
  #line-at(70.824pt, 139.22pt, "methods (e.g., Gaussian-kernel smoothing)—could be considered, they fall outside the scope of ")
  #line-at(70.824pt, 153.86pt, "the present work. The focus of this study is thus a direct, application-oriented comparison ")
  #line-at(70.824pt, 168.38pt, "demonstrating the relative robustness of the two approaches in the presence of accidental ")
  #line-at(70.824pt, 182.9pt, "coincidence noise. ")
