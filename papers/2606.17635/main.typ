#original-page(612pt, 792pt, (image("graphics/page-05.png", width: 398pt), 108.5pt, 70.5pt))[
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(535.06pt, 740.976pt, "5 ")
  #line-at(70.824pt, 346.01pt, " Fig. 1. Temperature measurement using photon entanglement with a signal-photon detector in ")
  #line-at(70.824pt, 360.53pt, "the “clear-arm” and an idler-photon trigger. The photon interactions with the material act as a ")
  #line-at(70.824pt, 375.05pt, "quantum measurement with changing polarization statistics. ")
  #line-at(106.82pt, 401.69pt, "In the modeling of such “clear-arm” remote temperature measurement of the femtosecond ")
  #line-at(70.824pt, 416.21pt, "laser pulses surface heat accumulation, the process of entangled photon generation and detection ")
  #line-at(70.824pt, 430.75pt, "is programmed with Qiskit quantum simulation toolkit [24], [25]. The entangled-photon process is ")
  #line-at(70.824pt, 445.27pt, "modeled using Qiskit to ensure a physically consistent simulation of entanglement generation, ")
  #line-at(70.824pt, 459.79pt, "correlation, and measurement. Although classical correlated bit generation could reproduce ")
  #line-at(70.824pt, 474.43pt, "similar statistics, the quantum-circuit approach provides a more realistic and extensible framework ")
  #line-at(70.824pt, 488.95pt, "aligned with the underlying experimental implementation. The temperature affected absorption of ")
  #line-at(70.824pt, 503.47pt, "idler photons is simulated with approximation of rapid surface temperature increasing during ten ")
  #line-at(70.824pt, 517.99pt, "picoseconds and correspondingly fast changes of optical properties [14] (adapted Fig. 2.). Such a ")
  #line-at(70.824pt, 532.63pt, "short heating time is explained by dynamic energy exchanges between electrons and photons ")
  #line-at(70.824pt, 547.15pt, "under two-temperature model [26]. ")
]

