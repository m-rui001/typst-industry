@article{Padgett:s,
author = {Miles J. Padgett},
journal = {Opt. Expr.},
keywords = {Diffractive optics; Laser beam shaping; Spatial light modulators; Optical tweezers or optical manipulation; Optical vortices ; Singular optics ; Beam shaping; Laser beams; Light beams; Optical vortices; Quantum optics; Vortex beams},
number = {10},
