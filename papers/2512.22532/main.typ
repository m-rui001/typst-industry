  #line-at(72.025pt, 121.8pt, "Conversely, verification of these scalings would support the interpretation that collective quantum modes ")
  #line-at(72.025pt, 134.3pt, "can sustain entanglement over macroscopic distances at ambient temperature, provided the measurement ")
  #line-at(72.025pt, 147.05pt, "basis is collective and estimator limitations are properly accounted for. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 173.8pt, "4.6 Broader perspective ")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 200.33pt, "Taken together, these results show that long-range, room-temperature entanglement of collective modes is ")
  #line-at(72.025pt, 213.08pt, "not anomalous, nor does it require exotic protection mechanisms. It follows naturally from standard open-")
  #line-at(72.025pt, 225.58pt, "system quantum mechanics once collective degrees of freedom, phase diffusion, and estimator physics are ")
  #line-at(72.025pt, 238.33pt, "treated consistently. This perspective provides a unifying framework for understanding macroscopic ")
  #line-at(72.025pt, 251.08pt, "quantum correlations across a wide range of systems and offers a principled foundation for scalable, ")
  #line-at(72.025pt, 263.83pt, "room-temperature quantum technologies based on collective modes. ")
]

