  #line-at(325.63pt, 551.92pt, "𝑁")
  #set text(font: "Cambria Math", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.65pt, 554.17pt, "eff")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(346.4pt, 551.92pt, "∼𝑇𝐵")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(371.4pt, 551.92pt, ", fixing the rate at which second ")
  #line-at(72.025pt, 564.67pt, "moments can be estimated with a given confidence. ")
  #line-at(72.025pt, 591.2pt, "This distinction explains why increasing integration time improves the statistical significance of ")
  #line-at(72.025pt, 603.95pt, "entanglement witnesses without altering the state itself. Apparent decay of correlations under short ")
  #line-at(72.025pt, 616.45pt, "measurement times or low bandwidth should therefore not be interpreted as physical decoherence of the ")
  #line-at(72.025pt, 629.2pt, "collective mode, but as a limitation of the measurement process. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 655.95pt, "4.5 Falsifiability and experimental implications ")
