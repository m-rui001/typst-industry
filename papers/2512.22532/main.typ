#original-page(612pt, 792pt, none)[
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 82.28pt, "remains a diffusive quantum variable in the absence of explicit phase pinning, and entanglement resides ")
  #line-at(72.025pt, 95.03pt, "in correlations of collective quadrature fluctuations rather than in a fixed mean-field phase. ")
  #line-at(72.025pt, 121.55pt, "This numerical example demonstrates that, under realistic ambient conditions and macroscopic ")
  #line-at(72.025pt, 134.05pt, "separation, collective-mode entanglement is compatible with modest signal levels and large ensemble ")
  #line-at(72.025pt, 146.8pt, "participation, provided the reduced open-system parameters satisfy the analytically derived bounds. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 173.55pt, "2.7.5 Conclusion of the analytical example")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 200.08pt, "This explicit calculation shows that, under realistic room-temperature conditions and macroscopic ")
  #line-at(72.025pt, 212.83pt, "separation, collective-mode entanglement is compatible with modest signal levels. Distance enters only ")
  #line-at(72.025pt, 225.33pt, "through the coherent coupling rate, while large ensemble participation enhances signal-to-noise without ")
  #line-at(72.025pt, 238.08pt, "eliminating the quantum character of the collective degree of freedom. The collective phase remains a ")
  #line-at(72.025pt, 250.83pt, "diffusive quantum variable, not a classical order parameter, confirming the robustness of collective-mode ")
  #line-at(72.025pt, 263.58pt, "entanglement at ambient conditions. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 294.1pt, "3. RESULTS: STOCHASTIC SIMULATIONS AND NULL-MODEL COMPARISON")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 320.6pt, "This section presents numerical results validating the analytical framework developed in Section 2 and ")
  #line-at(72.025pt, 333.35pt, "establishing its distinguishability from classical correlated-noise explanations. All simulations implement ")
  #line-at(72.025pt, 346.1pt, "the reduced collective-mode dynamics defined in Section 2, and all datasets—quantum and classical—are ")
  #line-at(72.025pt, 358.87pt, "processed through an identical analysis pipeline. ")
  #set text(font: "Times New Roman", size: 11pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 385.37pt, "3.1 Quantum collective-mode simulations")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.025pt, 411.87pt, "We simulate the stochastic dynamics of two collective modes governed by the Lindblad master equation ")
  #line-at(72.025pt, 424.62pt, "introduced in Section 2. The simulations are performed using covariance-matrix evolution derived from ")
  #line-at(72.025pt, 437.4pt, "the associated quantum Langevin equations, which is exact for the Gaussian dynamics considered here. ")
  #line-at(72.025pt, 450.15pt, "No wavefunction collapse, postselection, or measurement backaction is included in the state evolution. ")
  #line-at(72.025pt, 476.9pt, "The steady-state covariance matrix ")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(228.35pt, 476.9pt, "𝑉")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(235.6pt, 476.9pt, " is obtained across a broad parameter range spanning the separable–")
  #line-at(72.025pt, 489.65pt, "entangled transition. The primary control parameters are the normalized coherent coupling ")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(473.45pt, 489.65pt, "𝐺/𝜅")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(492.45pt, 489.65pt, " and the ")
  #line-at(72.025pt, 502.65pt, "effective noise occupancy ")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(189.08pt, 502.65pt, "𝑛")
  #set text(font: "Cambria Math", size: 8pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(195.33pt, 504.9pt, "eff")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(205.83pt, 502.65pt, ", while detunings are set to zero and stability conditions are enforced. For ")
  #line-at(72.025pt, 515.17pt, "each parameter set, we compute the symplectic eigenvalues of the partially transposed covariance matrix ")
  #line-at(72.025pt, 527.92pt, "and evaluate the Duan–Simon inseparability criterion. ")
]

