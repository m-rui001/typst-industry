  #line-at(246.35pt, 95.03pt, "𝑛")
  #set text(font: "Times New Roman", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(252.85pt, 95.03pt, "defined operationally in Section 2.2, rather than by the ambient ")
  #line-at(72.025pt, 108.03pt, "temperature through ")
  #set text(font: "Cambria Math", size: 11pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(164.33pt, 108.03pt, "𝑘")
