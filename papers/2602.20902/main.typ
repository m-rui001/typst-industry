#original-page(595.32pt, 841.92pt, (image("graphics/page-04.png", width: 129pt), 70.5pt, 408pt))[
  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(517.78pt, 790.056pt, "4 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.72pt, "The analysis of mass transport behaviour primarily depends on the type of experimental data ")
  #line-at(70.824pt, 97.7pt, "considered. In general, experimental modalities provide mass permeation data in two forms. ")
  #line-at(70.824pt, 113.54pt, "The first involves ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(157.82pt, 113.54pt, "c(x,t)")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(182.78pt, 113.54pt, "-type data, i.e., the temporal evolution of concentration distributions. In ")
  #line-at(70.824pt, 129.38pt, "this case, the analysis relies on a specific mathematical expression for ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(405.79pt, 129.38pt, "c(x,t)")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(430.51pt, 129.38pt, " (the solution to Eq. ")
  #line-at(70.824pt, 145.22pt, "1b), which depends on system properties such as geometry or symmetry, boundary and initial ")
  #line-at(70.824pt, 161.18pt, "conditions defined by the experimental setup, as well as additional physicochemical parameters ")
  #line-at(70.824pt, 176.9pt, "of the interfaces affecting intercompartmental mass transfer kinetics. ")
  #line-at(70.824pt, 200.9pt, "The second form consists of ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(213.89pt, 200.9pt, "n(t)")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(231.17pt, 200.9pt, "-type data, i.e., cumulative sorption profiles, analysed using ")
