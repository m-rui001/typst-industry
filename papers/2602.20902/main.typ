  #line-at(70.824pt, 105.62pt, "The paper elucidates the potential of the photoacoustics based techniques for a broad ")
  #line-at(70.824pt, 121.58pt, "characterization of physical processes accompanying mass transport phenomena in thin films. ")
  #line-at(70.824pt, 137.42pt, "Two base techniques: front-side detection PA and the diffuse reflection PA (DPRA), upgraded ")
  #line-at(70.824pt, 153.26pt, "towards recently introduced multibeam setups and applied for the monitoring of a model ")
  #line-at(70.824pt, 169.1pt, "photodegradable pigment permeation from a donor phase into a thin acceptor membrane, ")
  #line-at(70.824pt, 185.06pt, "allowed for the multispecies bulk transport and interfacial kinetics quantification at the ")
  #line-at(70.824pt, 200.9pt, "donor/acceptor and acceptor air interfaces simultaneously. The characterization of the methods ")
