  #line-at(56.88pt, 324.24pt, "treated as a fixed input parameter. In contrast to our current study, which simultaneously determines seven ")
  #line-at(56.88pt, 349.92pt, "thermal properties of the SOI sample, the TDTR measurements were limited to extracting only three: ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(498.918pt, 349.92pt, "𝑘")
