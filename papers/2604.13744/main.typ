  #line-at(413.916pt, 271.2pt, ", with a reported uncertainty ")
  #line-at(56.88pt, 297.84pt, "of approximately 10%. To measure ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
