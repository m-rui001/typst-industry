#original-page(595pt, 842pt, (image("graphics/page-16.png", width: 426.5pt), 104pt, 63.5pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(291.705pt, 804.24pt, "16 ")
  #set text(font: "Arial", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 278.64pt, "Figure 6.")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(104.194pt, 278.64pt, " Comparison of the in-plane and cross-plane thermal conductivities of the 1.6 ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(463.139pt, 278.64pt, "μ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.661pt, 278.64pt, "m-thick Si film ")
  #line-at(56.88pt, 297.6pt, "obtained using the SPS method with literature data and theoretical predictions at two temperatures: (a) 300 K ")
  #line-at(56.88pt, 316.56pt, "and (b) 100 K. Solid symbols represent the SPS measurements from this work; open symbols correspond to ")
  #line-at(56.88pt, 335.52pt, "TDTR results reported by Jiang et al. [28, 29]. Curves represent first-principles predictions. The SPS results ")
  #line-at(56.88pt, 354.48pt, "show strong agreement with both experimental and theoretical references, with reduced uncertainty achieved ")
  #line-at(56.88pt, 373.44pt, "through simultaneous multi-parameter fitting.  ")
  #set text(font: "Arial", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 418.8pt, "4. Conclusions ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.88pt, 445.44pt, "In summary, we have developed and validated a variable-spot-size, multi-frequency square-pulsed source ")
  #line-at(56.88pt, 470.64pt, "(SPS) method for comprehensive thermal characterization of multilayered thin-film systems. This approach ")
  #line-at(56.88pt, 495.84pt, "enables the simultaneous extraction of in-plane and cross-plane thermal conductivities, volumetric heat ")
  #line-at(56.88pt, 521.28pt, "capacities, and interfacial thermal conductance within a single experimental framework. By combining a wide ")
  #line-at(56.88pt, 546.48pt, "modulation frequency range with tunable laser spot sizes, the method achieves enhanced sensitivity across ")
  #line-at(56.88pt, 571.92pt, "multiple layers and directions of heat transport. ")
  #line-at(73.38pt, 597.12pt, "Applied to a silicon-on-insulator (SOI) sample, the SPS method successfully determined seven key thermal ")
  #line-at(56.88pt, 622.32pt, "parameters with high accuracy. These results exhibit strong consistency with literature data and theoretical ")
  #line-at(56.88pt, 647.76pt, "predictions over a broad temperature range (80–500 K), confirming its reliability and broad applicability for ")
  #line-at(56.88pt, 672.96pt, "analyzing multilayered thermal transport. These findings highlight the strength of the SPS technique in ")
  #line-at(56.88pt, 698.4pt, "resolving anisotropic and interface-dominated heat transport in complex multilayer systems. ")
  #line-at(73.38pt, 723.6pt, "Although this study focused on an SOI sample, the SPS technique is broadly applicable to other ")
  #line-at(56.88pt, 749.04pt, "multilayered systems, particularly those with anisotropy, buried interfaces, or non-bulk thermal properties. Its ")
  #line-at(56.88pt, 774.24pt, "tunable measurement configuration offers flexibility across a range of material geometries and thermal regimes. ")
  #set text(font: "Arial", size: 10.386pt, weight: "regular", style: "normal", fill: rgb("#000000"))
