  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(418.71pt, 403.92pt, "m-thick Si film with those ")
  #line-at(56.88pt, 430.32pt, "reported by Jiang et al. [28, 29], alongside first-principles predictions at 300 K and 100 K. At both temperatures, ")
  #line-at(56.88pt, 455.52pt, "our results show good agreement with both the TDTR data and theoretical values. Importantly, our ")
  #line-at(56.88pt, 480.72pt, "measurements exhibit reduced uncertainties relative to TDTR, primarily because our method simultaneously ")
  #line-at(56.88pt, 506.16pt, "determines a larger set of thermal parameters. As a result, uncertainties in intermediate parameters do not ")
  #line-at(56.88pt, 531.6pt, "propagate into the final values of ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(209.961pt, 531.6pt, "𝑘")
  #set text(font: "Cambria Math", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(216.03pt, 533.76pt, "!,EF LFI'")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(246.823pt, 531.6pt, " and ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(268.205pt, 531.6pt, "𝑘")
  #set text(font: "Cambria Math", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(274.274pt, 533.76pt, "\",EF LFI'")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.989pt, 531.6pt, ". Furthermore, while TDTR could only characterize ")
  #line-at(56.88pt, 558.24pt, "relatively thick Si films (")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
