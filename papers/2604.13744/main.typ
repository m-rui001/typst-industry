  #line-at(56.88pt, 67.2pt, "sharp, oxide-free interface–an assumption that does not hold for our sample. Specifically, a 2-3 nm native SiO")
  #set text(font: "Times New Roman", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
