  #line-at(78pt, 261.6pt, "a LIFE-funded initiative in Germany that sought to convert municipal solid waste into a ")
  #line-at(78pt, 282.36pt, "high-quality renewable fuel through mechanical-biological treatment. The project's ")
  #line-at(78pt, 303pt, "objective was to recover the biogenic fraction of waste, with the aim of producing a ")
