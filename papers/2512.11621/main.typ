  #line-at(78pt, 637.32pt, "selected in this work are representative of the regions where these species were collected ")
  #line-at(78pt, 657.96pt, "or cultivated. ")
  #line-at(78pt, 686.76pt, "In the present work, a study is made of 16 herbaceous species collected, which has been ")
