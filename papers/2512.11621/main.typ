  #line-at(78pt, 728.16pt, "collection, directly from the area where the species are autochthonous, develops crops of ")
  #line-at(78pt, 748.8pt, "other species in areas of Andalusia, specifically in the sub-Baetic mountain range (37.4°N, ")
]

