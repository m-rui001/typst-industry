  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(133.92pt, 82.08pt, " Aromatic seed waste, thermogravimetric analysis (TGA), Fourier Transform ")
