  #line-at(78pt, 490.92pt, "suitable for direct combustion processes, as they combine high energy density with a lower ")
  #line-at(78pt, 511.68pt, "tendency toward slagging and pollutant emissions. Conversely, species with a greater ")
  #line-at(78pt, 532.32pt, "proportion of oxygenated and aromatic functional groups, such as ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(401.28pt, 532.32pt, "Rosmarinus officinalis")
  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(78pt, 553.08pt, "and ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(97.8pt, 553.08pt, "Thymus mastichina")
  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(190.32pt, 553.08pt, ", exhibit better performance in pyrolysis processes, as they promote ")
  #line-at(78pt, 573.72pt, "dehydration, depolymerization, and condensation reactions that enhance the quality and ")
  #line-at(78pt, 594.48pt, "stability of the resulting bio-oils. ")
  #line-at(78pt, 629.16pt, "Moreover, the parameters ash content, total nitrogen, and HHV were found to have a ")
  #line-at(78pt, 649.8pt, "decisive influence on the energetic performance and thermal stability of the biomasses. ")
  #line-at(78pt, 670.56pt, "High ash or nitrogen levels can reduce the calorific value and increase NOx and SO₂ ")
  #line-at(78pt, 691.2pt, "emissions, whereas moderate values of these parameters optimize both combustion ")
  #line-at(78pt, 711.96pt, "efficiency and durability. Overall, this study provides a solid basis for the sustainable ")
  #line-at(78pt, 732.6pt, "selection and utilization of aromatic seed residues in different thermochemical conversion ")
]

