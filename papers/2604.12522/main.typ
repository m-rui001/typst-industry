  #line-at(229.716pt, 348.72pt, "(𝑓)")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(248.197pt, 348.72pt, " corresponds to a depth-weighted average of the thermal ")
  #line-at(56.88pt, 376.8pt, "transport properties within the thermally sampled region. Owing to this frequency-domain selectivity, ")
  #line-at(56.88pt, 404.4pt, "SPS thermoreflectance has been widely applied to investigate thermal transport in a broad range of ")
  #line-at(56.88pt, 432pt, "materials and multilayered structures.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(237.483pt, 427.92pt, "17-23")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(80.88pt, 459.6pt, "In HFCVD diamond films, grain coarsening during growth produces a fine-grained, defect-rich ")
  #line-at(56.88pt, 487.2pt, "nucleation layer beneath a coarse-grained surface region. As a result, phonon transport is primarily ")
  #line-at(56.88pt, 514.8pt, "influenced by grain-boundary scattering, leading to a cross-plane thermal conductivity that is highest ")
  #line-at(56.88pt, 542.4pt, "near the growth surface and decreases toward the substrate. To capture this depth dependence, we ")
  #line-at(56.88pt, 570pt, "describe the local thermal conductivity as ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(227.218pt, 597.6pt, "𝑘(𝑧) = 𝑘")
