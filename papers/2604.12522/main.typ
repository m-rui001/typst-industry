  #line-at(56.88pt, 382.32pt, "The integration of high-thermal-conductivity diamond films onto silicon carbide (SiC) substrates ")
  #line-at(56.88pt, 409.92pt, "offers a promising pathway for thermal management in high-power electronic devices. Here, we ")
  #line-at(56.88pt, 437.52pt, "investigate the depth-dependent thermal conductivity of a ~5 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(354.826pt, 437.52pt, "µ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(361.74pt, 437.52pt, "m-thick diamond film grown on SiC ")
  #line-at(56.88pt, 465.12pt, "by hot-filament chemical vapor deposition (HFCVD) using square-pulsed source (SPS) thermometry. ")
  #line-at(56.88pt, 492.72pt, "Electron backscatter diffraction (EBSD) and transmission electron microscopy (TEM) reveal ")
  #line-at(56.88pt, 520.32pt, "pronounced grain coarsening from the nucleation interface to the film surface. By combining ")
  #line-at(56.88pt, 547.92pt, "frequency-dependent thermal penetration with a depth-resolved thermal transport model, we ")
  #line-at(56.88pt, 575.52pt, "quantitatively reconstruct the thermal conductivity profile. The thermal conductivity increases ")
  #line-at(56.88pt, 603.36pt, "sharply from ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.174pt, 603.36pt, "~60 W m")
