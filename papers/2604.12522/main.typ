  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.705pt, 804.24pt, "5 ")
  #line-at(80.88pt, 68.16pt, "The depth-dependent thermal conductivity of the diamond film was measured using square-")
  #line-at(56.88pt, 95.76pt, "pulsed source (SPS) thermoreflectance.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(247.384pt, 91.68pt, "14, 15")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(267.658pt, 95.76pt, " In this technique, a square-wave modulated pump laser ")
  #line-at(56.88pt, 123.36pt, "induces periodic heating, and the resulting surface temperature oscillation amplitude is directly ")
  #line-at(56.88pt, 150.96pt, "measured in the time domain using a waveform analyzer. Because the analysis relies on amplitude ")
  #line-at(56.88pt, 178.56pt, "detection rather than phase tracking, SPS avoids phase-drifting artifacts inherent to phase-sensitive ")
  #line-at(56.88pt, 206.16pt, "methods and provides improved measurement robustness and signal-to-noise ratio.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(454.462pt, 202.08pt, "16")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(80.88pt, 233.76pt, "A defining characteristic of SPS thermoreflectance is its broad modulation-frequency range, ")
  #line-at(56.88pt, 261.6pt, "extending from a few hertz to tens of megahertz. The modulation frequency ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(431.245pt, 261.6pt, "𝑓")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.195pt, 261.6pt, " controls the thermal ")
  #line-at(56.88pt, 289.68pt, "penetration depth ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(142.784pt, 289.68pt, "𝑑")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.739pt, 292.08pt, "#")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(155.691pt, 289.68pt, ", such that higher frequencies probe near-surface regions while lower frequencies ")
  #line-at(56.88pt, 319.2pt, "access deeper layers. When ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(201.217pt, 319.2pt, "𝑑")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(208.172pt, 321.6pt, "#")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(215.465pt, 319.2pt, " is smaller than the diamond film thickness ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(442.247pt, 319.2pt, "ℎ")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(448.904pt, 321.6pt, "$%&")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(461.611pt, 321.6pt, " , the measured ")
  #line-at(56.88pt, 348.72pt, "effective thermal conductivity ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
