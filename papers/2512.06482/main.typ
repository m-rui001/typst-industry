  #line-at(46.802pt, 553.691pt, "B. Results and Analysis ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(56.872pt, 568.213pt, "The heating results of the absorbent paper are pictured by ")
  #line-at(46.792pt, 579.617pt, "the UNI-T UTi260B professional thermal imager, as shown in ")
  #line-at(46.782pt, 591.141pt, "Fig. 4. For each group, 160 hot spots are selected, and their ")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
