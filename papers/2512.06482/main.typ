  #line-at(323.401pt, 589.918pt, "This paper elucidates the output characteristics of the ")
  #line-at(313.202pt, 601.92pt, "magnetron in the injection-pulling state through numerical ")
  #line-at(313.202pt, 614.041pt, "simulations. It proposes a novel method to achieve ")
  #line-at(313.202pt, 626.162pt, "simultaneous phase-frequency modulation of the magnetron. ")
  #line-at(313.202pt, 638.164pt, "Subsequently, ")
  #line-at(383.037pt, 638.164pt, "microwave ")
  #line-at(440.874pt, 638.164pt, "heating ")
  #line-at(483.71pt, 638.164pt, "experiments ")
  #line-at(545.869pt, 638.164pt, "were ")
  #line-at(313.202pt, 650.285pt, "conducted. Experimental results demonstrate that, under ")
  #line-at(313.202pt, 662.407pt, "different loads, the sweep-frequency scheme incorporating the ")
  #line-at(313.202pt, 674.409pt, "injection-pulling state not only extends the bandwidth of ")
  #line-at(313.202pt, 686.53pt, "conventional injection-locking frequency sweeping schemes ")
  #line-at(313.202pt, 698.532pt, "but also delivers substantial uniformity enhancement, offering ")
  #line-at(313.202pt, 710.653pt, "a novel perspective on applying injection modulation ")
  #line-at(313.202pt, 722.774pt, "magnetrons in the microwave heating field. ")
