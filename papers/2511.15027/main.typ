  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(181.7pt, 309.65pt, "z")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(184.82pt, 308.69pt, " at 0 GPa; however, the difference nearly vanishes at 60 GPa. These ")
  #line-at(72.024pt, 333.05pt, "changes result from anisotropic lattice compression, with the ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(409.03pt, 333.05pt, "z")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(413.71pt, 333.05pt, "-axis shrinking more ")
  #line-at(72.024pt, 357.53pt, "significantly than the ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(175.46pt, 357.53pt, "x")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(180.86pt, 357.53pt, "-axis and suppressing the lone pair activity of Bi atoms. This study calls ")
  #line-at(72.024pt, 382.01pt, "for revisiting the pressure dependence of thermal conductivity anisotropy and provides insights ")
