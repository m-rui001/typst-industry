  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(228.89pt, 285.17pt, "x")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(232.49pt, 284.21pt, " at both pressures, with a much greater advantage at 60 GPa. ")
  #line-at(72.024pt, 308.69pt, "Above 10 meV, ")
