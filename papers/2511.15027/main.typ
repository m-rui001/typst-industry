  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(100.22pt, 113.06pt, "Se is an emerging semiconductor with intrinsically low thermal conductivity, making it ")
  #line-at(72.024pt, 137.42pt, "a promising material for thermoelectric applications. Hydrostatic pressure can effectively tunes ")
  #line-at(72.024pt, 161.9pt, "the thermal conductivity, with various pressure-dependent trends reported. However, its impact ")
  #line-at(72.024pt, 186.38pt, "on thermal anisotropy, particularly in the highly anisotropic Bi")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(407.11pt, 187.34pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
