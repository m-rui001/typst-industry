  #line-at(419.95pt, 187.34pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(424.03pt, 186.38pt, "Se, remains poorly ")
  #line-at(72.024pt, 210.86pt, "understood. Here, we report a pressure-driven reversal of thermal anisotropy: ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(447.94pt, 210.86pt, "κ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
