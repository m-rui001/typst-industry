  #line-at(179.66pt, 236.18pt, "x")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(183.26pt, 235.22pt, " at 60 GPa without phase transition. This stems from distinct phonon ")
  #line-at(72.024pt, 259.7pt, "dispersions along the ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(177.38pt, 259.7pt, "x")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
