  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(239.09pt, 592.39pt, ". This is typically achieved through backpropagation, where the gradients ")
  #line-at(166.49pt, 605.23pt, "of the loss function with respect to the network parameters are computed using the chain ")
  #line-at(166.49pt, 617.98pt, "rule, and the parameters are updated via an optimization algorithm such as stochastic ")
