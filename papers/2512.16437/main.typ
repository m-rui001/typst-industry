  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.064pt, 59.4pt, ",")
  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
