  #line-at(240.05pt, 579.55pt, "𝑦̂, 𝑦)")
  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(259.49pt, 579.55pt, ", which measures the difference between the predicted output ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
