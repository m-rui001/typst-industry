  #line-at(489.36pt, 619.78pt, ". The algorithm ")
  #line-at(166.49pt, 632.62pt, "selects the split that minimizes the sum of the MSEs of the resulting child nodes. ")
  #line-at(187.73pt, 645.34pt, "The splitting process continues until a stopping criterion is met, such as a maximum ")
  #line-at(166.49pt, 658.18pt, "tree depth or a minimum number of samples per leaf. The resulting tree model can be ")
  #line-at(166.49pt, 671.02pt, "visualized as a hierarchical structure where each internal node represents a decision based ")
  #line-at(166.49pt, 683.86pt, "on a feature, and each leaf node represents a predicted outcome. ")
  #line-at(187.73pt, 696.7pt, "One of the key strengths of tree-based models is their ability to capture non-linear ")
  #line-at(166.49pt, 709.42pt, "relationships between the input features and the target variable without requiring feature ")
  #line-at(166.49pt, 722.26pt, "scaling. Moreover, tree models are naturally capable of handling both numerical and cat-")
  #line-at(166.49pt, 735.1pt, "egorical data. However, they tend to be prone to overfitting, which can be mitigated ")
  #line-at(166.49pt, 747.936pt, "through techniques like pruning or by using ensemble methods such as random forests ")
  #line-at(166.49pt, 760.776pt, "or gradient boosting; naive Bayes is a simple yet effective probabilistic classifier based on ")
  #line-at(166.49pt, 773.496pt, "Bayes’ theorem, with the strong assumption that features are conditionally independent ")
]

