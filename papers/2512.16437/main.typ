  #line-at(187.73pt, 192.02pt, "The results are shown in Figure 8, where the algorithm’s selection is displayed, ")
  #line-at(166.49pt, 204.74pt, "grouping images that highlight the damage to the wind turbine blades. ")
  #set text(font: "Palatino Linotype", size: 9pt, weight: "bold", style: "normal", fill: rgb("#000000"))
