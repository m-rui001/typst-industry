  #line-at(166.49pt, 474.31pt, "function. ")
  #line-at(187.73pt, 487.15pt, "The network’s final output is produced by the neurons in the output layer, and the ")
  #line-at(166.49pt, 499.99pt, "overall network function can be represented as Equation (10). ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
