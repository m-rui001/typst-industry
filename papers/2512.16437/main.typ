  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.73pt, 363.65pt, "Image handling for detecting defects in wind turbine blades is crucial in the wind ")
  #line-at(166.49pt, 376.49pt, "energy industry. This study demonstrates a viable approach using the Orange Data Min-")
  #line-at(166.49pt, 389.21pt, "ing software, which produced accurate results with image embedding and clustering tech-")
  #line-at(166.49pt, 402.05pt, "niques.")
  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(166.49pt, 426.89pt, "3.1. Algorithms Analysis ")
  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.73pt, 442.75pt, "Four models were evaluated using the “Test Learning Algorithms on Data” function-")
