#original-page(595.32pt, 841.92pt, (image("graphics/page-03.png", width: 526.5pt), 34.5pt, 67.5pt))[
  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(36pt, 59.4pt, "Appl. Sci. ")
  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(69.984pt, 59.4pt, "2024")
  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(86.064pt, 59.4pt, ",")
  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(87.984pt, 59.4pt, " 14")
  #set text(font: "Palatino Linotype", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(98.064pt, 59.4pt, ", x FOR PEER REVIEW ")
  #line-at(532.44pt, 59.4pt, "3 of 21 ")
  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(166.49pt, 102.26pt, "SCADA system, a method to differentiate false alarms from real alarms in the detection of ")
  #line-at(166.49pt, 115.1pt, "faults in wind turbines. To do this, they first use multivariate clustering to obtain appro-")
  #line-at(166.49pt, 127.94pt, "priate subsets of wind turbines, and then use an autoregressive neural network. Finally, ")
  #line-at(166.49pt, 140.66pt, "the residuals between the median values of the cluster and the target values are used to ")
  #line-at(166.49pt, 153.5pt, "calculate the level of anomaly. Choe et al. [27] emphasized the importance of reducing ")
  #line-at(166.49pt, 166.34pt, "maintenance and operational costs for wind energy system reliability, employing a state ")
  #line-at(166.49pt, 179.18pt, "monitoring system as an effective tool for wind turbine blade maintenance. ")
  #line-at(187.73pt, 192.02pt, "Sustainability considerations are essential in analyzing any renewable energy con-")
  #line-at(166.49pt, 204.74pt, "version system. Mourad et al. [25] focused on sustainability in their study, emphasizing ")
  #line-at(166.49pt, 217.58pt, "the need for fault-free equipment to achieve optimal results in energy transformation. ")
  #line-at(166.49pt, 230.42pt, "Their evaluation of various phenomena damaging wind turbine blades concluded that ")
  #line-at(166.49pt, 243.26pt, "maintenance and fault detection could increase blade lifespan, contributing to savings in ")
  #line-at(166.49pt, 256.1pt, "greenhouse gas emissions. Ogaili et al. [28] proposed vibration analysis methods to en-")
  #line-at(166.49pt, 268.85pt, "hance sustainability by determining blade failures, including erosion, cracking, and mass ")
  #line-at(166.49pt, 281.69pt, "imbalance, thereby improving blade performance and reducing maintenance costs while ")
  #line-at(166.49pt, 294.53pt, "minimizing energy conversion efficiency. Kong et al. [29] determined that monitoring off-")
  #line-at(166.49pt, 307.37pt, "shore wind turbine blades is crucial for power generation due to substantial structural ")
  #line-at(166.49pt, 320.21pt, "loads, utilizing non-destructive testing methods, and proposed using UAVs for pinpoint-")
  #line-at(166.49pt, 332.93pt, "ing failure locations. ")
  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(166.49pt, 357.77pt, "1.3. Bibliometric Analysis and Research Clusters ")
  #set text(font: "Palatino Linotype", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.73pt, 373.61pt, "To gain a comprehensive understanding of the current research landscape in wind ")
  #line-at(166.49pt, 386.45pt, "turbine blade fault detection, a bibliometric analysis was conducted using Scopus and ")
  #line-at(166.49pt, 399.29pt, "VOSviewer 1.6.20 software. The analysis focused on identifying clusters of related terms ")
  #line-at(166.49pt, 412.01pt, "and keywords that frequently co-occur in the literature, which reveals the interconnect-")
  #line-at(166.49pt, 424.85pt, "edness of various research areas. ")
  #line-at(187.73pt, 437.69pt, "Figure 1 shows the results of this bibliometric analysis, identifying eight distinct re-")
  #line-at(166.49pt, 450.55pt, "search clusters. These clusters highlight the key areas of focus in the field and their inter-")
  #line-at(166.49pt, 463.39pt, "relationships: ")
  #line-at(187.73pt, 476.11pt, "Advancements in Electrical System Fault Diagnosis (Red): This cluster focuses on ")
  #line-at(166.49pt, 488.95pt, "topics such as fault diagnosis, vibration analysis, and electric fault currents. ")
  #line-at(187.73pt, 501.79pt, "Innovations in Detection and Fault Tolerance in Mechanical Structures (Green): This ")
  #line-at(166.49pt, 514.63pt, "cluster includes research on cracks, sensors, and fault tolerance in mechanical systems. ")
  #line-at(187.73pt, 527.47pt, "Innovations in Wind Turbine Blade Inspection (Blue): Emphasizes the role of inspec-")
  #line-at(166.49pt, 540.19pt, "tion, image analysis, and fracture mechanics in improving blade integrity. ")
  #line-at(187.73pt, 553.03pt, "Structural Health Monitoring (Yellow): Discusses non-destructive testing methods, ")
  #line-at(166.49pt, 565.87pt, "including ultrasonic applications for monitoring blade health. ")
  #line-at(187.73pt, 578.71pt, "Advancements in Composite Materials Design (Purple): Focuses on the development ")
  #line-at(166.49pt, 591.55pt, "of composite materials and acoustic emission testing for enhanced blade durability. ")
  #line-at(187.73pt, 604.39pt, "Exploring Mechanical Failures in Composite Structures (Cyan): Examines mechani-")
  #line-at(166.49pt, 617.11pt, "cal failures, fatigue testing, and fracture mechanics in composite structures. ")
  #line-at(187.73pt, 629.98pt, "Adhesive Joints (Orange): Investigates adhesive technologies and their role in turbine ")
  #line-at(166.49pt, 642.82pt, "component assembly and maintenance. ")
  #line-at(187.73pt, 655.66pt, "Advances in Lightning Protection Systems (Brown): Covers research on lightning ")
  #line-at(166.49pt, 668.5pt, "protection methods and systems, crucial for turbine safety. ")
]

