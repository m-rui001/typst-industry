  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(250.99pt, 458.59pt, ".  ")
  #line-at(72.024pt, 475.51pt, "In this work, we employ an A-type antiferromagnetic metal, (Fe")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.99pt, 476.47pt, "0.5")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(334.15pt, 475.51pt, "Co")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(345.82pt, 476.47pt, "0.5")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(353.98pt, 475.51pt, ")")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(357.34pt, 476.47pt, "5")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(360.58pt, 475.51pt, "GeTe")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(382.78pt, 476.47pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(386.02pt, 475.51pt, ", and construct ")
  #line-at(72.024pt, 491.83pt, "the FCGT/WSe")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(138.02pt, 492.79pt, "2")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(141.26pt, 491.83pt, "/FCGT van der Waals structure. Although FCGT exhibits bulk spin ")
