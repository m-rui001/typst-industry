  #line-at(359.26pt, 405.91pt, "). On the other hand, ")
  #line-at(72.024pt, 423.43pt, "owing to the bulk spin degeneracy")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(211.13pt, 419.95pt, "29–32")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(227.33pt, 423.43pt, ", memory devices are either volatile, where the stored ")
  #line-at(72.024pt, 441.07pt, "resistance states can be lost upon power and magnetic field removal. Or they rely on ")
