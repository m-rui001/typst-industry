  #line-at(438.24pt, 300.29pt, "), ")
  #line-at(72.024pt, 317.93pt, "demonstrating the capability of AFM materials in MTJ construction. Furthermore, A-type van ")
  #line-at(72.024pt, 335.45pt, "der Waals antiferromagnets have been extensively investigated. In these materials, interlayer ")
  #line-at(72.024pt, 353.11pt, "antiferromagnetic coupling can stabilize an intermediate spin-flop state. In particular, this can ")
  #line-at(72.024pt, 370.63pt, "manifest as a surface spin-flop, where low-field switching of the interfacial magnetic moment ")
  #line-at(72.024pt, 388.27pt, "induces a considerable magnetoresistance")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(248.23pt, 384.79pt, "18–23")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(264.43pt, 388.27pt, ". Nonetheless, on the one hand, memory ")
  #line-at(72.024pt, 405.91pt, "function is still confined to low temperatures (e.g., CrSBr")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(306.19pt, 402.43pt, "24–26")
