  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(448.5pt, 504.66pt, ") with a small read voltage ")
  #line-at(313.2pt, 516.784pt, "(<200 mV), allowing low IR drop, significantly lower static ")
  #line-at(313.19pt, 528.848pt, "power consumption, and read disturbance mitigation compared ")
  #line-at(313.22pt, 540.912pt, "against existing non-volatile memories. To further enhance its ")
  #line-at(313.21pt, 552.976pt, "area efficiency through monolithic 3D integration, BEOL-")
  #line-at(313.22pt, 565.101pt, "compatible ferroelectric nvCAPs with amorphous oxide ")
  #line-at(313.22pt, 577.165pt, "semiconductor channels, such as W-doped In")
