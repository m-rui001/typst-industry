  #line-at(313.205pt, 391.561pt, "    Prior works have examined writing characteristics of BEOL-")
  #line-at(313.215pt, 403.084pt, "compatible ferroelectric nvCAPs using dual DC sweep C-V ")
  #line-at(313.205pt, 414.607pt, "measurement with a slow DC sweep rate [6, 7]. However, C-V ")
  #line-at(313.215pt, 426.07pt, "measurement in typical measurement equipment is performed ")
  #line-at(313.205pt, 437.593pt, "over a time scale of a few seconds (~2.2 sec with a DC sweep ")
  #line-at(313.175pt, 449.116pt, "rate of ~6.7 mV/ms in our prior work [6]), which is comparable ")
  #line-at(313.175pt, 460.579pt, "to applying ~1 s long write pulses to the nvCAPs for PGM/ERS ")
  #line-at(313.185pt, 472.102pt, "under the pulse-mode operation. For practical applications ")
  #line-at(313.175pt, 483.625pt, "requiring high clock frequency [14], it is essential to ")
  #line-at(313.185pt, 495.088pt, "systematically examine pulse-based writing characteristics of ")
  #line-at(313.175pt, 506.611pt, "oxide-channel ferroelectric nvCAPs and understand the ")
  #line-at(313.175pt, 518.134pt, "difference from those obtained under bi-directional DC voltage ")
