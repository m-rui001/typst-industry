  #line-at(46.795pt, 42.423pt, "> REPLACE THIS LINE WITH YOUR MANUSCRIPT ID NUMBER (DOUBLE-CLICK HERE TO EDIT) < ")
  #line-at(46.785pt, 65.469pt, "DC sweep rate (~6.7 mV/ms), which does not truly capture the ")
  #line-at(46.785pt, 77.533pt, "behavior of oxide-channel ferroelectric nvCAPs under pulse-")
  #line-at(46.775pt, 89.597pt, "mode operation in a practical memory array [8, 9].  ")
  #line-at(46.795pt, 101.721pt, "    This work systemically examines the pulse-mode operation ")
  #line-at(46.795pt, 113.785pt, "of oxide channel ferroelectric nvCAPs, focusing on their pulse-")
  #line-at(46.805pt, 125.849pt, "mode writing, retention, write endurance, and read endurance ")
  #line-at(46.805pt, 137.914pt, "characteristics under different device geometries and operating ")
  #line-at(46.805pt, 150.038pt, "conditions. We introduce a BEOL-compatible ferroelectric ")
  #line-at(46.795pt, 162.102pt, "nvCAP with an ALD IWO channel fabricated with an improved ")
  #line-at(46.805pt, 174.166pt, "process flow from our prior work [6]. We outline the governing ")
  #line-at(46.805pt, 186.23pt, "device physics arising from unique interplay between the ")
  #line-at(46.815pt, 198.354pt, "ferroelectric (FE) and channel layer, leading to several non-")
  #line-at(46.805pt, 210.418pt, "idealities under pulse-mode. The device operation and ")
  #line-at(46.795pt, 222.482pt, "polarization dynamics under pulse-mode are carefully ")
