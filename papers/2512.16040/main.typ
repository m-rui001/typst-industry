  #line-at(46.8pt, 270.663pt, "with non-destructive read have emerged as a promising device for ")
  #line-at(46.809pt, 281.04pt, "next-generation memory paradigms. Recently, BEOL-compatible ")
  #line-at(46.809pt, 291.363pt, "ferroelectric nvCAPs with an amorphous oxide semiconductor ")
  #line-at(46.809pt, 301.74pt, "channel have been reported, suggesting the possibility of ")
  #line-at(46.818pt, 312.063pt, "monolithic 3D integration of nvCAPs on top of CMOS. So far, the ")
  #line-at(46.818pt, 322.44pt, "characterization studies on oxide-channel ferroelectric nvCAPs ")
  #line-at(46.809pt, 332.763pt, "have been done using dual DC sweep C-V measurements which ")
  #line-at(46.809pt, 343.14pt, "are typically performed over a time scale of a few seconds. ")
  #line-at(46.809pt, 353.463pt, "However, non-volatile memory arrays typically require nvCAPs to ")
  #line-at(46.809pt, 363.84pt, "operate under pulse-mode. It is thus crucial to advance ")
  #line-at(46.818pt, 374.163pt, "understanding of the behavior of oxide-channel ferroelectric ")
  #line-at(46.818pt, 384.54pt, "nvCAPs under pulse-mode operation, governed by the unique ")
  #line-at(46.818pt, 394.863pt, "interplay between ferroelectric layer and oxide channel physics. In ")
  #line-at(46.818pt, 405.24pt, "this study, we provide a systematic study of the pulse-mode ")
  #line-at(46.836pt, 415.563pt, "operation of ferroelectric nvCAPs with an amorphous oxide ")
  #line-at(46.827pt, 425.94pt, "semiconductor ")
  #line-at(113.962pt, 425.94pt, "channel, ")
  #line-at(156.861pt, 425.94pt, "including ")
  #line-at(203.544pt, 425.94pt, "its ")
  #line-at(223.164pt, 425.94pt, "pulse-based ")
  #line-at(278.832pt, 425.94pt, "write ")
  #line-at(46.827pt, 436.263pt, "characteristics and reliability characteristics. We examine overlap ")
  #line-at(46.827pt, 446.64pt, "area, wake-up and pulse-width dependent C")
  #set text(font: "Times New Roman", size: 6pt, weight: "bold", style: "normal", fill: rgb("#000000"))
