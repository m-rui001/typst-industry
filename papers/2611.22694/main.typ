  #line-at(90pt, 372.72pt, "towards longer delay times, consistent with the increased acoustic propagation distance. ")
  #line-at(90pt, 403.92pt, "In the top pad region (Fig. 2(b)), an additional echo reveals the bonding interface within ")
  #line-at(90pt, 435.12pt, "the hybrid bonding structure. For clarity, the enlarged views in Fig. 2(c) show the ")
  #line-at(90pt, 466.32pt, "acoustic echo signals of two interfaces after subtraction of the thermal background. ")
  #line-at(90pt, 497.52pt, "Notably, the waveform of the top/bottom pad echo differs from that of the bottom ")
