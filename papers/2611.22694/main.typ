#original-page(595.2pt, 841.92pt, (image("graphics/page-05.png", width: 402.5pt), 96.5pt, 114.5pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(240.263pt, 91.92pt, "2. Sample Preparation ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 419.52pt, "Fig. 1. Structure and preparation of the hybrid bonding sample. (a) Schematic cross ")
  #line-at(90pt, 450.72pt, "section of the hybrid bonding structure within the stacked chip. (b) Polished sample ")
  #line-at(90pt, 481.92pt, "geometry for TDTR measurements at different remaining thicknesses. (c) Cross-")
  #line-at(90pt, 513.12pt, "sectional TEM image of the hybrid bonding region. (d) Top-view SEM images of the ")
  #line-at(90pt, 544.32pt, "top and bottom Cu pad arrays. ")
  #line-at(90pt, 606.72pt, "The chip sample consists of six dies connected through Cu/dielectric hybrid bonding ")
  #line-at(90pt, 637.92pt, "layers in a face-to-back configuration. Figure 1(a) shows the local structure around the ")
  #line-at(90pt, 669.12pt, "investigated bonding interface. The sample was polished at a shallow angle to enable ")
  #line-at(90pt, 700.32pt, "TDTR measurements at different positions with varying remaining thicknesses, as ")
  #line-at(90pt, 731.52pt, "illustrated in Fig. 1(b). An Al transducer layer was then deposited on the polished ")
  #line-at(90pt, 762.72pt, "surface for TDTR measurements. ")
]

