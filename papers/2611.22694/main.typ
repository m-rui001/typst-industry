#original-page(595.2pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90pt, 123.12pt, "In TDTR, a modulated pump pulse train heats the Al transducer, where the absorbed ")
  #line-at(90pt, 154.32pt, "optical energy is converted into heat. The resulting heat diffuses into the underlying ")
  #line-at(90pt, 185.52pt, "layers, and the temperature response depends on the thermal properties of the multilayer ")
  #line-at(90pt, 216.72pt, "structure. A time-delayed probe beam detects the temperature change from the ")
  #line-at(90pt, 247.92pt, "reflectance variation, allowing the thermal response to be recorded as a function of ")
  #line-at(90pt, 279.12pt, "pump-probe delay. The reflected probe signal is detected by a photodetector and ")
  #line-at(90pt, 310.32pt, "analyzed using a lock-in amplifier to obtain the in-phase (")
