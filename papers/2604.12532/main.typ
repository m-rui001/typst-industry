#original-page(595pt, 842pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.705pt, 804.24pt, "5 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(56.88pt, 68.16pt, "2.1. Fundamental principle of the SPS method ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(74.88pt, 95.76pt, "As illustrated in Fig. 1, the SPS method utilizes a TEM")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(336.811pt, 96.72pt, "00")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(344.811pt, 95.76pt, " pump laser modulated with a 50% duty-")
  #line-at(56.88pt, 123.36pt, "cycle square wave to induce periodic heating on the sample surface. A probe laser, concentrically ")
  #line-at(56.88pt, 150.96pt, "aligned with the pump beam, monitors the resulting temperature variations via the thermoreflectance ")
  #line-at(56.88pt, 178.56pt, "effect. The reflected probe beam is collected by a photodetector, and the signals are processed using ")
  #line-at(56.88pt, 206.16pt, "a periodic waveform analyzer integrated within a Zurich Instruments UHF lock-in amplifier, enabling ")
  #line-at(56.88pt, 233.76pt, "high signal-to-noise ratio extraction of voltage waveforms over the entire square-wave heating cycle. ")
  #line-at(56.88pt, 261.36pt, "The measured waveforms are subsequently normalized in amplitude and time and fitted with a ")
  #line-at(56.88pt, 288.96pt, "thermal model to extract the thermal properties of the sample [20,21].  ")
  #line-at(74.88pt, 316.56pt, "As a thermoreflectance method, SPS typically requires the deposition of a ~100 nm metal ")
  #line-at(56.88pt, 344.16pt, "transducer layer to facilitate thermoreflectance detection. At the probe wavelength of 785 nm, ")
  #line-at(56.88pt, 371.76pt, "materials such as aluminum (Al), titanium nitride (TiN), and hafnium nitride (HfN) are commonly ")
  #line-at(56.88pt, 399.36pt, "used due to their high thermoreflectance coefficients. In addition to thermoreflectance performance, ")
  #line-at(56.88pt, 426.96pt, "the selection of transducer materials is influenced by their thermal conductivity and optical ")
  #line-at(56.88pt, 454.56pt, "absorptance at the probe wavelength.  ")
  #line-at(74.88pt, 482.16pt, "Transducers with a low thermal conductivity are particularly advantageous for resolving the in-")
  #line-at(56.88pt, 510pt, "plane thermal diffusivity of materials with thermal conductivities below ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.579pt, 510pt, "1 W m")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.55pt, 505.68pt, "#$")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(450.15pt, 510pt, " K")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(460.814pt, 505.68pt, "#$")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(472.415pt, 510pt, " [22]. For this ")
  #line-at(56.88pt, 538.32pt, "reason, magnetron-sputtered Al (~")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(232.856pt, 538.32pt, " 50 W m")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(274.745pt, 534pt, "#$")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(286.345pt, 538.32pt, " K")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(297.01pt, 534pt, "#$")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(310.884pt, 538.32pt, ") is preferred over thermally evaporated Al ")
  #line-at(56.88pt, 566.4pt, "(~")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(67.722pt, 566.4pt, "200 W m")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(113.981pt, 562.08pt, "#$")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(125.582pt, 566.4pt, " K")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.246pt, 562.08pt, "#$")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.2pt, 566.4pt, ") for measuring the in-plane thermal diffusivity of PI films. Additionally, low ")
  #line-at(56.88pt, 594.48pt, "optical absorptance at the probe wavelength helps minimize probe-induced steady-state heating, ")
  #line-at(56.88pt, 622.08pt, "which is especially important when measuring thermally insulating materials like PI. Given these ")
  #line-at(56.88pt, 649.68pt, "considerations, magnetron-sputtered Al is identified as the most suitable transducer material for SPS ")
  #line-at(56.88pt, 677.28pt, "measurements on low-conductivity thin films. Although the thermoreflectance coefficient of Al films ")
  #line-at(56.88pt, 704.88pt, "may vary depending on the deposition method, normalizing the experimental signals effectively ")
  #line-at(56.88pt, 732.48pt, "eliminates the influence of these variations. ")
]

