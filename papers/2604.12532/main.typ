  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(329.764pt, 344.88pt, "), which has important implications for heat ")
  #line-at(56.88pt, 372.72pt, "dissipation in electronic devices. Although advanced techniques such as Structured Illumination with ")
  #line-at(56.88pt, 400.32pt, "Thermal Imaging (SI-TI) [10] and Spatially-Resolved Lock-in micro Thermography (SR-LIT) [11,12] ")
