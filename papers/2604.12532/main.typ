  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(125.213pt, 247.68pt, "Swanson school of engineering, University of Pittsburgh, Pittsburgh, US ")
