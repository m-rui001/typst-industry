  #line-at(56.88pt, 683.52pt, "representative samples: the 25 μm-thick suspended Kapton HN-100 film and the 5.0 μm-thick spin-")
  #line-at(56.88pt, 711.12pt, "coated PI film. A comparative summary of the measured thermal properties for all samples is ")
  #line-at(56.88pt, 738.72pt, "provided at the end of this section.  ")
