  #line-at(394.841pt, 317.28pt, " values for a 2-µm-thick spin-")
  #line-at(56.88pt, 345.12pt, "coated PI film that were more than twice those obtained in our study. This discrepancy is likely ")
  #line-at(56.88pt, 372.72pt, "attributable to differences in the polyimide precursor solution, spin-coating parameters, thermal ")
  #line-at(56.88pt, 400.32pt, "curing protocols, or even differences in the thermal measurement techniques employed. ")
  #line-at(74.88pt, 428.16pt, "The observed enhancement in ")
