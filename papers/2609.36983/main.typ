  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(112.124pt, 549.6pt, " Later with segmented thermoelectric legs, high-temperature selective solar absorber, ")
  #line-at(70.8pt, 570.24pt, "and combined optical and thermal concentration of ~270, they achieved  a system efficiency ")
