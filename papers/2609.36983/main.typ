  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(263.071pt, 357.12pt, " Narrowband emitters which minimize the radiative ")
  #line-at(70.8pt, 378pt, "heating from atmosphere could reach more significant temperature drop in particular under ")
  #line-at(70.8pt, 398.64pt, "vacuum condition without convection.")
