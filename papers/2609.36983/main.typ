  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(81.464pt, 295.2pt, " and stagnation temperature beyond 200°C has been demonstrated in vacuum without ")
  #line-at(70.8pt, 315.84pt, "optical concentration.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(174.757pt, 311.76pt, "[13]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(188.085pt, 315.84pt, " On the other hand, spectral selectivity is equally important for ")
  #line-at(70.8pt, 336.48pt, "radiative sky cooling, as it requires low solar absorption and high infrared emission to achieve ")
  #line-at(70.8pt, 357.12pt, "sub-ambient daytime temperatures.")
