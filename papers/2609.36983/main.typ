  #line-at(507.376pt, 435.84pt, "[18]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.2pt, 466.8pt, "Early work utilized near-black solar absorber to heat up the hot side of thermoelectric ")
  #line-at(70.8pt, 487.44pt, "generators (TEGs) to produce power at daytime but suffered from low performance.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(474.646pt, 483.36pt, "[19-23]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.8pt, 508.08pt, "With selective solar absorbers and high thermal concentration (i.e., absorber-to-TEG area ")
  #line-at(70.8pt, 528.72pt, "ratio), Kraemer et al. experimentally demonstrated the solar TEG conversion efficiency of ")
  #line-at(70.8pt, 549.6pt, "4.6%.")
