  #line-at(70.8pt, 82.08pt, "1. Introduction ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(106.2pt, 108.72pt, "Photothermal conversion technologies that utilize solar energy and cold outer space ")
