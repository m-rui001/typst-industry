  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.109pt, 586.8pt, "2 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.109pt, 590.88pt, "illumination.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(254.773pt, 586.8pt, "[20]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(268.101pt, 590.88pt, " On the other hand, sub-ambient temperatures ")
  #line-at(70.8pt, 611.52pt, "achieved by radiative coolers create negative-temperature differentials across the TEGs, and ")
  #line-at(70.8pt, 632.4pt, "nighttime solid-state power generation has been experimentally demonstrated very recently. ")
  #line-at(70.8pt, 653.04pt, "Raman et al. reported power density ~2.5 mW/m")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(305.562pt, 648.96pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(309.562pt, 653.04pt, " from single TEG module in ambient during ")
