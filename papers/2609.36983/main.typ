  #line-at(70.8pt, 150.24pt, "demand.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(111.786pt, 146.16pt, "[1, 2]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(129.115pt, 150.24pt, " Manipulation of light is the key factor to such technology and various materials ")
  #line-at(70.8pt, 170.88pt, "such as semiconductors, carbon, polymers, and 2D materials have been studied.")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(453.359pt, 166.8pt, "[3]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(462.687pt, 170.88pt, " Spectral ")
  #line-at(70.8pt, 191.52pt, "selectivity with high solar absorptivity and low infrared emissivity has been recognized as one ")
  #line-at(70.8pt, 212.4pt, "major focus to enhance the solar thermal conversion long ago for more efficient solar water ")
  #line-at(70.8pt, 233.04pt, "heaters ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.779pt, 228.96pt, "[4]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.107pt, 233.04pt, " and recently for solar thermal power generation including solar thermoelectric ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(498.622pt, 228.96pt, "[5]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.8pt, 253.68pt, "and solar thermophotovoltaic devices.")
