  #line-at(253.413pt, 249.6pt, "[6, 7]")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(270.741pt, 253.68pt, " Various selective solar absorbers have been ")
  #line-at(70.8pt, 274.32pt, "designed and fabricated that exceed solar absorptivity of 0.8 and emissivity lower than 0.1,")
