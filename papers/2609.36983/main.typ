  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(70.8pt, 124.32pt, "Ken Araki, and Liping Wang")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(209.128pt, 120.24pt, "*")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.8pt, 165.84pt, "K. Araki, L. Wang ")
  #line-at(70.8pt, 186.48pt, "School for Engineering of Matter, Transport and Energy, Arizona State University, Tempe, ")
  #line-at(70.8pt, 207.12pt, "USA ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.8pt, 223.92pt, "*")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(74.8pt, 228pt, " Corresponding author. Email: liping.wang@asu.edu ")
  #line-at(70.8pt, 269.28pt, "Funding: U.S. National Science Foundation (CBET-2212342) ")
  #line-at(70.8pt, 310.56pt, "Keywords: vanadium dioxide, phase transition, solar heating, radiative cooling, thermoelectric ")
  #line-at(70.8pt, 331.44pt, "generator, photothermal conversion ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.8pt, 372.72pt, "Abstract.")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(118.454pt, 372.72pt, " Day-night solid-state power generation is experimentally demonstrated with ")
  #line-at(70.8pt, 388.56pt, "thermoelectric generators integrated with a tunable radiative coating, which switches between ")
  #line-at(70.8pt, 404.4pt, "a selective solar absorber during daytime and a radiative cooler during nighttime by ")
  #line-at(70.8pt, 420.48pt, "temperature without any external control. The self-adaptive radiative coating is carefully ")
  #line-at(70.8pt, 436.32pt, "designed with thermochromic VO")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(234.429pt, 437.28pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(238.429pt, 436.32pt, " thin film on heavily doped silicon substrate along with a ")
  #line-at(70.8pt, 452.16pt, "phase-shifting silicon spacer in between, whose physical mechanism is elucidated. The ")
  #line-at(70.8pt, 468pt, "fabricated coating exhibits a high solar absorptivity of 0.90 and a low infrared emissivity of ")
  #line-at(70.8pt, 483.84pt, "0.23 during daytime, and a high emissivity of 0.85 at night, resulting in large emissivity ")
  #line-at(70.8pt, 499.68pt, "change of 0.62 within the atmospheric transparency window upon metal-to-insulator phase ")
  #line-at(70.8pt, 515.52pt, "transition. From outdoor tests in a high vacuum apparatus, the tunable radiative coating in 35-")
  #line-at(70.8pt, 531.36pt, "mm squared size achieves 1.64 W/m")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(246.745pt, 527.28pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(250.745pt, 531.36pt, " power generation around noon time from a stack of ")
  #line-at(70.8pt, 547.44pt, "commercial thermoelectric modules of 15 mm squared, which is 28% more from that with a ")
  #line-at(70.8pt, 563.28pt, "black absorber. At night, it produces 26 mW/m")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(297.083pt, 559.2pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(301.083pt, 563.28pt, " power in vacuum, outperforming the black ")
  #line-at(70.8pt, 579.12pt, "emitter by 63%. Even exposed the ambient with convective loss, the 2-inch-round tunable ")
  #line-at(70.8pt, 594.96pt, "coating generates power of 0.48 W/m")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(251.404pt, 590.88pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(255.404pt, 594.96pt, " at noon time, 14% more than the black absorber of the ")
  #line-at(70.8pt, 610.8pt, "same size. The tunable radiative coating covered thermoelectric modules produces open ")
  #line-at(70.8pt, 627.36pt, "circuit voltages from 433 mV to ")
  #line-at(234.687pt, 627.36pt, "62 mV in vacuum and from 300 mV to ")
  #line-at(431.579pt, 627.36pt, "51 mV in ambient ")
  #line-at(70.8pt, 643.68pt, "through 24-hr continuous outdoor tests.  ")
]

