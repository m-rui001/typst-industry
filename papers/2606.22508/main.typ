  #line-at(72pt, 204.902pt, "provides volumetric and label-free imaging of the spatiotemporal evolution of temperature fields hence acting")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.964pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 218.451pt, "as a unique platform for quantifying thermal diffusivity and uncovering the physical parameters governing")
