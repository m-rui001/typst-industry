  #line-at(307.558pt, 177.803pt, "38")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.799pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(318.467pt, 177.803pt, "], as well as for probing material anisotropy[")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.909pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(507.621pt, 177.803pt, "39")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.799pt, weight: "regular", style: "normal", fill: rgb("#000000"))
