  #line-at(70.824pt, 460.94pt, "resonant behavior within the 6-dB bandwidth, i.e., between 144.14 MHz and 148.42 MHz. (b) Delay ")
  #line-at(70.824pt, 479.9pt, "time as a function of the excitation frequency, measured in the time domain.  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 499.82pt, "The same approach as that described in Section 3.2 was used to determine the delay time and ")
  #line-at(70.824pt, 520.46pt, "group velocity from the time-domain measurements. At excitation frequencies of ")
