  #line-at(70.824pt, 82.1pt, "output amplitude remains within 6 dB of its maximum, i.e. above half the maximum amplitude. ")
  #line-at(70.824pt, 102.74pt, "For the sensor investigated here, this yields an electrical bandwidth of 4.28 MHz. Within this ")
  #line-at(70.824pt, 123.65pt, "bandwidth, the sensor exhibits resonant behavior, resulting in a monotonically rising signal ")
  #line-at(70.824pt, 144.29pt, "during the settling process. Beyond this range, as shown in Fig. 4, an overshoot is observed due ")
  #line-at(70.824pt, 164.93pt, "to the increased mismatch between the excitation period and the temporal periodicity of the ")
  #line-at(70.824pt, 185.57pt, "IDT. ")
