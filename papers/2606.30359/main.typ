#original-page(595.276pt, 841.89pt, (image("graphics/page-27.png", width: 4.5pt), 104pt, 654pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(498.824pt, 804.344pt, "27 ")
  #line-at(85.544pt, 82.664pt, "historical demand patterns with a proportional redistribution of the remaining surplus ")
  #line-at(49.544pt, 82.664pt, "201 ")
  #line-at(85.544pt, 98.744pt, "according to ownership shares. For newly established energy communities, this surplus ")
  #line-at(49.544pt, 98.744pt, "202 ")
  #line-at(85.544pt, 114.584pt, "could instead be allocated directly following the same proportions derived from the ")
  #line-at(49.544pt, 114.584pt, "203 ")
  #line-at(85.544pt, 130.424pt, "dynamic allocation model, as investment decisions can be defined before the sharing ")
  #line-at(49.544pt, 130.424pt, "204 ")
  #line-at(85.544pt, 146.264pt, "agreement enters into force. ")
  #line-at(49.544pt, 146.264pt, "205 ")
  #line-at(85.544pt, 176.024pt, "This hybrid strategy achieves full utilization of the generated energy while preserving ")
  #line-at(49.544pt, 176.024pt, "206 ")
  #line-at(85.544pt, 191.864pt, "equity among participants. The differences between the current model based on equity ")
  #line-at(49.544pt, 191.864pt, "207 ")
  #line-at(85.544pt, 207.944pt, "and equally distributed along the year and the blended scenarios are revealing. Users such ")
  #line-at(49.544pt, 207.944pt, "208 ")
  #line-at(85.544pt, 223.784pt, "as 1PHOF and 1MLOF show only marginal gains or losses, suggesting their consumption ")
  #line-at(49.544pt, 223.784pt, "209 ")
  #line-at(85.544pt, 239.624pt, "closely matches their fixed share. In contrast, users like 1TJOF, 1RYOF, and 5PJOF ")
  #line-at(49.544pt, 239.624pt, "210 ")
  #line-at(85.544pt, 255.464pt, "experience sharp differences, up to 2.22 percentage points below their static share, ")
  #line-at(49.544pt, 255.464pt, "211 ")
  #line-at(85.544pt, 271.304pt, "indicating they consistently under-consume relative to their assigned portion. ")
  #line-at(49.544pt, 271.304pt, "212 ")
  #line-at(85.544pt, 301.304pt, "These patterns have real design implications. A purely fixed allocation misaligns with ")
  #line-at(49.544pt, 301.304pt, "213 ")
  #line-at(85.544pt, 317.144pt, "actual consumption behaviour, while a dynamic model, though more efficient reaching a ")
  #line-at(49.544pt, 317.144pt, "214 ")
  #line-at(85.544pt, 332.984pt, "SCR of 67,02%, fails to fully utilize available energy. The blended solution appears ")
  #line-at(49.544pt, 332.984pt, "215 ")
  #line-at(85.544pt, 348.824pt, "optimal but also reveals intra-community asymmetries: some members benefit more from ")
  #line-at(49.544pt, 348.824pt, "216 ")
  #line-at(85.544pt, 364.664pt, "flexibility, while others lose potential access to surplus energy. Nevertheless, its ")
  #line-at(49.544pt, 364.664pt, "217 ")
  #line-at(85.544pt, 380.504pt, "implementation in existing energy communities should be relatively straightforward, as ")
  #line-at(49.544pt, 380.504pt, "218 ")
  #line-at(85.544pt, 396.344pt, "the resulting annual allocation shares remain close to those originally agreed under ")
  #line-at(49.544pt, 396.344pt, "219 ")
  #line-at(85.544pt, 412.184pt, "equity-based schemes. ")
  #line-at(49.544pt, 412.184pt, "220 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 442.664pt, "3.2.2.3")
  #line-at(157.544pt, 442.664pt, "Set allocation based on Marginal Contribution to Profit (MC) ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.544pt, 442.664pt, "221 ")
  #line-at(85.544pt, 472.904pt, "Transitioning from a community energy management model that prioritizes equity ")
  #line-at(49.544pt, 472.904pt, "222 ")
  #line-at(85.544pt, 488.744pt, "through fixed distribution shares based on investment to one that maximizes self-")
  #line-at(49.544pt, 488.744pt, "223 ")
  #line-at(85.544pt, 504.584pt, "consumption and minimizes costs, raises the question: what would happen if energy ")
  #line-at(49.544pt, 504.584pt, "224 ")
  #line-at(85.544pt, 520.424pt, "distribution were instead based on marginal contribution? This metric captures the added ")
  #line-at(49.544pt, 520.424pt, "225 ")
  #line-at(85.544pt, 536.264pt, "value each participant brings to the community, not only in financial terms but also in ")
  #line-at(49.544pt, 536.264pt, "226 ")
  #line-at(85.544pt, 552.104pt, "how their consumption patterns enhance the overall efficiency of the system. The model ")
  #line-at(49.544pt, 552.104pt, "227 ")
  #line-at(85.544pt, 567.944pt, "preserves the initial investment commitments but redefines energy allocation shares to ")
  #line-at(49.544pt, 567.944pt, "228 ")
  #line-at(85.544pt, 583.784pt, "reflect optimized performance and fairness. As a result, the distribution differs ")
  #line-at(49.544pt, 583.784pt, "229 ")
  #line-at(85.544pt, 599.864pt, "substantially from the current equity-based arrangement. ")
  #line-at(49.544pt, 599.864pt, "230 ")
  #line-at(85.544pt, 629.624pt, "This added value may come in two forms: ")
  #line-at(49.544pt, 629.624pt, "231 ")
  #line-at(121.544pt, 660.104pt, "Cost-effectiveness: A participant may help reduce overall system costs by ")
  #line-at(49.544pt, 660.104pt, "232 ")
  #line-at(121.544pt, 676.184pt, "enabling economies of scale or by contributing capital at key stages. ")
  #line-at(49.544pt, 676.184pt, "233 ")
  #line-at(121.544pt, 692.744pt, "Profile complementarity: A user’s consumption pattern may align with gaps in ")
  #line-at(49.544pt, 692.744pt, "234 ")
  #line-at(121.544pt, 708.824pt, "other members’ demand, thereby boosting the community’s overall self-")
  #line-at(49.544pt, 708.824pt, "235 ")
  #line-at(121.544pt, 724.664pt, "consumption rate. ")
  #line-at(49.544pt, 724.664pt, "236 ")
  #line-at(85.544pt, 754.664pt, "To explore this idea further, we proposed the evaluation of the marginal contribution ")
  #line-at(49.544pt, 754.664pt, "237 ")
  #line-at(85.544pt, 770.504pt, "(MC) of each participant as a tool to enhance both fairness and efficiency in energy-")
  #line-at(49.544pt, 770.504pt, "238 ")
]

