#original-page(595.276pt, 841.89pt, (image("graphics/page-13.png", width: 24.5pt), 344.5pt, 741pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(498.824pt, 804.344pt, "13 ")
  #line-at(85.544pt, 82.664pt, "A positive MCP indicates that the user contributes to increasing overall community ")
  #line-at(85.544pt, 98.744pt, "savings; a negative MCP suggests that their presence reduces collective efficiency, ")
  #line-at(85.544pt, 114.584pt, "potentially justifying differentiated remuneration or redistribution strategies. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 144.824pt, "2.5")
  #line-at(122.544pt, 144.824pt, "Methodological Framework for the battery ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.544pt, 175.064pt, "An optimization model based on Mixed-Integer Linear Programming (MILP) to assess ")
  #line-at(85.544pt, 190.904pt, "optimal energy management within a community energy system featuring a shared ")
  #line-at(85.544pt, 206.744pt, "storage solution. The objective is to minimize the individual energy cost of each ")
  #line-at(85.544pt, 222.584pt, "participant, while enforcing proportional limits on storage capacity according to each ")
  #line-at(85.544pt, 238.424pt, "user’s allocation coefficient. ")
  #line-at(85.544pt, 268.664pt, "The model employs the Gurobi Optimizer solver, selected for its high performance on ")
  #line-at(85.544pt, 284.744pt, "large-scale MILP problems and its ability to handle extensive variable sets and ")
  #line-at(85.544pt, 300.584pt, "constraints. The temporal scope covers a full year (365 days) at 15-minute intervals, ")
  #line-at(85.544pt, 316.424pt, "allowing for a detailed representation of renewable generation and consumption patterns ")
  #line-at(85.544pt, 332.264pt, "across daily and seasonal cycles, while ensuring computational feasibility. ")
  #line-at(85.544pt, 362.504pt, "The mathematical model includes seven decision variables per user and time step, totaling ")
  #line-at(85.544pt, 378.344pt, "245,280 variables per participant. Continuous variables include the energy charged into ")
  #line-at(85.544pt, 394.424pt, "the battery (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.527pt, 394.424pt, "𝑥")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(151.797pt, 396.824pt, "4,*")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(161.28pt, 394.424pt, ") and discharged from it (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(288.598pt, 394.424pt, "𝑦")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.949pt, 396.824pt, "4,*")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(304.433pt, 394.424pt, "), both constrained by a maximum energy ")
  #line-at(85.544pt, 411.464pt, "value M=26.875 kWh. This limit corresponds to the maximum charge and discharge in a ")
  #line-at(85.544pt, 427.304pt, "15-minute interval for the battery, which has a nominal capacity of 215 kWh and a ")
  #line-at(85.544pt, 443.144pt, "maximum charge/discharge rate of 0.5 C (107.5 kW); thus, for a 0.25 h period, the ")
  #line-at(85.544pt, 458.984pt, "maximum transferable energy is 107.5 kW")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.958pt, 458.984pt, "·")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(299.087pt, 458.984pt, "0.25 h=26.875 kWh. Additional continuous ")
  #line-at(85.544pt, 476.024pt, "variables include the energy purchased from ((")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(306.941pt, 476.024pt, "𝑧")
