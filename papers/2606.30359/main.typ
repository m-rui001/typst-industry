  #line-at(85.544pt, 193.784pt, "capacity were installed, representing a 3.7% decrease compared to 2024 and remaining ")
  #line-at(85.544pt, 209.624pt, "well below the peak reached in 2022. The slowdown was particularly pronounced in the ")
  #line-at(85.544pt, 225.464pt, "residential sector, where new installations amounted to 229 MW, representing a 17% ")
  #line-at(85.544pt, 241.544pt, "year-on-year decline")
