  #line-at(85.544pt, 287.144pt, "household’s load profile and PV output. The resulting energy balances enabled the ")
  #line-at(55.544pt, 287.144pt, "14 ")
  #line-at(85.544pt, 302.984pt, "calculation of energy imported from the grid, exported to it, and self-consumed. ")
