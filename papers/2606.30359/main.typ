  #line-at(55.544pt, 660.584pt, "34 ")
  #line-at(85.544pt, 676.424pt, "across most users, although there are some notable discrepancies. The highest SSR and ")
  #line-at(55.544pt, 676.424pt, "35 ")
  #line-at(85.544pt, 692.264pt, "SCR values are found for industrial consumers whose demand is concentrated during ")
  #line-at(55.544pt, 692.264pt, "36 ")
