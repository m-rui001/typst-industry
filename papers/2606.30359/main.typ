  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.452pt, 540.584pt, ", ")
  #line-at(324.913pt, 540.584pt, "𝑏")
  #set text(font: "Times New Roman", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(331.001pt, 542.984pt, "discharge")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(363.569pt, 542.984pt, ",4,*")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(374.796pt, 540.584pt, " —are introduced to prevent ")
  #line-at(85.544pt, 558.104pt, "simultaneous charging and discharging, ensuring physically realistic battery operation. ")
  #line-at(85.544pt, 588.344pt, "The model incorporates a set of constraints to ensure that the solutions are physically ")
  #line-at(85.544pt, 604.184pt, "feasible and economically coherent. The fundamental constraint is the energy balance for ")
  #line-at(85.544pt, 620.024pt, "each user at every time step, which requires that the sum of energy inputs equals the sum ")
  #line-at(85.544pt, 635.864pt, "of energy outputs. Specifically, the total of photovoltaic (PV) generation, battery ")
  #line-at(85.544pt, 651.944pt, "discharge adjusted for efficiency, and electricity purchased from the grid must equal the ")
  #line-at(85.544pt, 667.784pt, "user’s total demand, plus the energy used to charge the battery (also adjusted for ")
  #line-at(85.544pt, 683.624pt, "efficiency) and the energy exported to the grid. ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
