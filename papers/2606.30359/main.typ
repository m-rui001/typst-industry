  #line-at(436.155pt, 666.584pt, ") are calculated ")
  #line-at(85.544pt, 682.664pt, "as the difference between the total electricity costs in the baseline scenario (without a ")
  #line-at(85.544pt, 698.504pt, "photovoltaic system) and the optimized electricity costs when all users participate in the ")
  #line-at(85.544pt, 714.344pt, "shared energy model. This value reflects the overall economic benefit of the energy ")
  #line-at(85.544pt, 730.184pt, "community compared to conventional, non-cooperative energy use. ")
