  #line-at(55.544pt, 537.464pt, "28 ")
  #line-at(85.544pt, 567.224pt, "Overall, the results demonstrate substantial savings for nearly all users. Annual savings ")
  #line-at(55.544pt, 567.224pt, "29 ")
  #line-at(85.544pt, 583.064pt, "ranged from €63 to €4,634, depending on system size, consumption pattern, and ")
