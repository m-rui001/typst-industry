  #line-at(299.271pt, 493.064pt, ") is another continuous variable, constrained ")
  #line-at(85.544pt, 510.104pt, "within user-specific limits proportional to their equity coefficients. ")
  #line-at(85.544pt, 540.584pt, "Two binary variables per time step —")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(268.489pt, 540.584pt, "𝑏")
