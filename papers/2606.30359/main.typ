// arXiv source page 3
#original-page(595.276pt, 841.89pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(504.824pt, 804.344pt, "3 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(85.544pt, 82.664pt, "1.")
  #line-at(103.394pt, 82.664pt, "Introduction ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.544pt, 113.144pt, "The transition towards a more sustainable, decentralized, and equitable energy system has ")
  #line-at(85.544pt, 128.984pt, "gained momentum worldwide in response to the combined challenges of climate change, ")
  #line-at(85.544pt, 144.824pt, "energy security, and social justice. Among the different technologies supporting this ")
  #line-at(85.544pt, 160.664pt, "transition, distributed photovoltaic generation has become one of the most widely adopted ")
  #line-at(85.544pt, 176.504pt, "solutions due to its technological maturity and declining installation costs. ")
  #line-at(85.544pt, 206.744pt, "Paradoxically, this success is creating new challenges. As solar penetration increases, ")
  #line-at(85.544pt, 222.584pt, "electricity prices during periods of peak PV generation tend to decline, reducing the value ")
  #line-at(85.544pt, 238.424pt, "of surplus electricity exported to the grid. In many countries, exported electricity receives ")
  #line-at(85.544pt, 254.264pt, "limited compensation, meaning that a growing share of PV generation is produced ")
  #line-at(85.544pt, 270.344pt, "precisely when its economic value is lowest")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(293.725pt, 266.264pt, "1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(297.725pt, 270.344pt, ". This raises a critical question for the energy ")
  #line-at(85.544pt, 286.184pt, "transition: can citizen-led energy systems remain economically viable in electricity ")
  #line-at(85.544pt, 302.024pt, "markets increasingly dominated by renewable generation?  ")
  #line-at(85.544pt, 332.264pt, "Under these conditions, maximizing the local utilization of renewable electricity becomes ")
  #line-at(85.544pt, 348.104pt, "increasingly important for maintaining the attractiveness of PV self-consumption. ")
  #line-at(85.544pt, 378.344pt, "For individual photovoltaic installations, achieving high self-consumption rates remains ")
  #line-at(85.544pt, 394.184pt, "challenging because household demand profiles rarely coincide with peak solar ")
  #line-at(85.544pt, 410.024pt, "production and alternatives such as batteries or heat-pumps requests higher investments ")
  #line-at(85.544pt, 426.104pt, "and are not always feasible. This situation raises important questions regarding the long-")
  #line-at(85.544pt, 441.944pt, "term profitability of purely individual self-consumption models and highlights the need ")
  #line-at(85.544pt, 457.784pt, "for alternative approaches capable of increasing local utilization of renewable generation ")
  #line-at(85.544pt, 473.624pt, "and keep citizens engaged with the energy transition. ")
  #line-at(85.544pt, 503.864pt, "In parallel, energy communities have gained increasing attention across Europe as a novel ")
  #line-at(85.544pt, 519.704pt, "organizational model for citizen participation in the energy transition")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(432.483pt, 515.624pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(436.483pt, 519.704pt, ". Supported by ")
  #line-at(85.544pt, 535.544pt, "European regulatory frameworks, these initiatives enable citizens to collectively engage ")
  #line-at(85.544pt, 551.384pt, "in the generation, management, and consumption of renewable energy. Beyond their ")
  #line-at(85.544pt, 567.464pt, "contribution to decarbonization, energy communities have been associated with broader ")
  #line-at(85.544pt, 583.304pt, "objectives including energy democracy, citizen empowerment, local value creation, and ")
  #line-at(85.544pt, 599.144pt, "social cohesion ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(162.19pt, 595.064pt, "3,4")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(172.19pt, 599.144pt, ".  ")
  #line-at(85.544pt, 629.384pt, "In Spain, this momentum has materialized in numerous citizen-led projects")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(479.02pt, 625.304pt, "5")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(483.02pt, 629.384pt, " that, ")
  #line-at(85.544pt, 645.224pt, "supported primarily by European regulatory frameworks ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(375.917pt, 641.144pt, "6,7")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(385.917pt, 645.224pt, ", have begun to develop ")
  #line-at(85.544pt, 661.064pt, "models of shared generation, collective self-consumption, and participatory governance. ")
  #line-at(85.544pt, 676.904pt, "These citizen initiatives are paving a new path toward models that, beyond technical and ")
  #line-at(85.544pt, 692.744pt, "economic design, generate social returns aligned with local needs.")
  #line-at(408.583pt, 692.744pt, "In practice, however, ")
  #line-at(85.544pt, 708.584pt, "regulatory and administrative complexity has limited the development of most energy ")
  #line-at(85.544pt, 724.664pt, "communities to photovoltaic collective generation and self-consumption schemes. ")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(482.44pt, 720.584pt, "8 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.544pt, 754.904pt, "Many citizen-led photovoltaic energy projects -residential and collective- have been ")
  #line-at(85.544pt, 770.744pt, "established during periods of higher electricity prices and strong public support schemes. ")
]

