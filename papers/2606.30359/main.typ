  #line-at(121.544pt, 280.424pt, "No environmental externalities were included.  ")
  #line-at(121.544pt, 297.224pt, "The system boundaries were restricted to electrical energy. Thermal uses and ")
  #line-at(121.544pt, 313.304pt, "other forms of self-generation were not included in the analysis.  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 343.544pt, "2.4")
  #line-at(122.544pt, 343.544pt, "Energy-Sharing Models ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.544pt, 373.784pt, "Distinct methods for sharing allocations were examined for the energy community. Each ")
  #line-at(85.544pt, 389.624pt, "approach establishes the way in which the photovoltaic (PV) energy production is ")
  #line-at(85.544pt, 405.464pt, "distributed among those involved, which affects not only technical results (such as SCR ")
  #line-at(85.544pt, 421.304pt, "and SSR) but also financial aspects (like savings and fairness). ")
  #line-at(85.544pt, 445.304pt, "• ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(95.587pt, 445.304pt, "Set allocation according to investment (traditional method):")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(401.923pt, 445.304pt, " Annual rates remain ")
  #line-at(85.544pt, 461.144pt, "consistent and are based solely on what each member has invested financially. ")
  #line-at(85.544pt, 484.904pt, "• ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(96.333pt, 484.904pt, "Set allocation using past dynamic distribution:")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(339.262pt, 484.904pt, " Shares are based on the hourly ")
  #line-at(85.544pt, 500.984pt, "distribution that corresponds to actual usage. Since many regions do not permit real-time ")
  #line-at(85.544pt, 516.824pt, "dynamic sharing, this approach uses the dynamic hourly distribution that would have ")
  #line-at(85.544pt, 532.664pt, "taken place in prior years to establish fixed allocations for the group.  ")
  #line-at(85.544pt, 556.424pt, "• ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(94.495pt, 556.424pt, "Set allocation from a past dynamic distribution with surplus sharing")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.59pt, 556.424pt, ": A significant ")
  #line-at(85.544pt, 572.264pt, "consideration when using dynamic allocation in shared systems is how to allocate excess ")
  #line-at(85.544pt, 588.344pt, "energy. This approach utilizes a dynamic allocation profile from a prior year while ")
  #line-at(85.544pt, 604.184pt, "incorporating a guideline for redistributing any surplus generation among participants.  ")
  #line-at(85.544pt, 627.944pt, "• ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(93.112pt, 627.944pt, "Set allocation based on Marginal Contribution to Profit (MCP):")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.368pt, 627.944pt, " Shares are calculated ")
  #line-at(85.544pt, 643.784pt, "based on each member’s marginal contribution to the community’s savings, determined ")
  #line-at(85.544pt, 659.624pt, "by running the model again without the demand of that specific member to assess their ")
  #line-at(85.544pt, 675.464pt, "unique impact. ")
  #line-at(85.544pt, 699.464pt, "• ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(93.498pt, 699.464pt, "Set allocation based on investment and Marginal Contribution to Profit (MCP):")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(485.657pt, 699.464pt, " This ")
  #line-at(85.544pt, 715.304pt, "mixed strategy merges the small input from everyone towards community savings with ")
  #line-at(85.544pt, 731.144pt, "their starting funding in the shared solar power facility. While this technique might not ")
  #line-at(85.544pt, 746.984pt, "suit recently created energy communities, it can act as a temporary fix for long-standing ")
]

