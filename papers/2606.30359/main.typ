  #line-at(85.544pt, 82.664pt, "linked, drawing the necessary energy as much as they want or can take. This pipe is also ")
  #line-at(85.544pt, 98.744pt, "linked to a different source and sink, which represents the distribution network for the ")
  #line-at(85.544pt, 114.584pt, "electricity system. ")
  #line-at(85.544pt, 144.344pt, "The following assumptions on the modelling and parameter values were fixed. ")
  #line-at(124.244pt, 160.904pt, "The energy system was modelled using the oemof.solph library, assuming perfect ")
  #line-at(124.244pt, 176.984pt, "foresight over the simulation horizon and no forecasting errors. All simulations ")
  #line-at(124.244pt, 192.824pt, "were conducted with hourly resolution over a full calendar year (2023/2024), ")
  #line-at(124.244pt, 208.664pt, "based on representative historical consumption and generation data. The model ")
  #line-at(124.244pt, 224.504pt, "allowed both grid import and export, with no technical or contractual constraints ")
  #line-at(124.244pt, 240.344pt, "other than capacity limits.  ")
  #line-at(124.244pt, 257.144pt, "The optimization function was designed to minimize the total annual electricity ")
  #line-at(124.244pt, 272.984pt, "cost for the simulated facilities, which is achieved by evaluating, at each time ")
  #line-at(124.244pt, 288.824pt, "step, the sum of the costs associated with purchasing electricity from the grid and ")
  #line-at(124.244pt, 304.664pt, "generating electricity on-site, while subtracting the revenues obtained from ")
  #line-at(124.244pt, 320.744pt, "selling surplus energy back to the grid. ")
