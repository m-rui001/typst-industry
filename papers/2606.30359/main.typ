  #line-at(85.544pt, 444.104pt, "should be modified under the current low energy prices scenario. ")
  #line-at(49.544pt, 444.104pt, "343 ")
  #line-at(85.544pt, 474.344pt, "The comparative exercise invites reflection on the role of public support mechanisms. At ")
  #line-at(49.544pt, 474.344pt, "344 ")
  #line-at(85.544pt, 490.184pt, "present, many EU member‑states channels most renewable‑energy subsidies to ")
  #line-at(49.544pt, 490.184pt, "345 ")
  #line-at(85.544pt, 506.024pt, "households through direct capital grants or tax rebates calculated on a € per‑kWp ")
  #line-at(49.544pt, 506.024pt, "346 ")
  #line-at(85.544pt, 521.864pt, "basis. Under the individual scenario, these incentives are often essential: a 1 kWp rooftop ")
  #line-at(49.544pt, 521.864pt, "347 ")
  #line-at(85.544pt, 537.704pt, "system that costs €1,750 and saves roughly €65 per year (Table 3) would require more ")
  #line-at(49.544pt, 537.704pt, "348 ")
  #line-at(85.544pt, 553.784pt, "than twenty‑five years to recover its investment without a grant, a period that exceeds ")
  #line-at(49.544pt, 553.784pt, "349 ")
  #line-at(85.544pt, 569.624pt, "typical investment lifetimes and erodes the project’s internal rate of return. Consequently, ")
  #line-at(49.544pt, 569.624pt, "350 ")
  #line-at(85.544pt, 585.464pt, "small households tend to depend on subsidies to make individual self‑consumption ")
  #line-at(49.544pt, 585.464pt, "351 ")
  #line-at(85.544pt, 601.304pt, "attractive. ")
  #line-at(49.544pt, 601.304pt, "352 ")
  #line-at(85.544pt, 631.064pt, "The collective alternative paints a different picture. Even with no direct subsidy, the ")
  #line-at(49.544pt, 631.064pt, "353 ")
  #line-at(85.544pt, 646.904pt, "community plant achieves a ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(224.255pt, 646.904pt, "LCOE")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(254.928pt, 646.904pt, " of €0.023 kWh")
