  #line-at(49.544pt, 145.544pt, "114 ")
  #line-at(85.544pt, 175.784pt, "The greater this complementarity, the greater the opportunity to convert surplus ")
  #line-at(49.544pt, 175.784pt, "115 ")
  #line-at(85.544pt, 191.624pt, "generation into useful local consumption. This underlying effect helps explain why the ")
  #line-at(49.544pt, 191.624pt, "116 ")
  #line-at(85.544pt, 207.464pt, "collective configuration outperforms the equivalent set of individual installations. ")
  #line-at(49.544pt, 207.464pt, "117 ")
  #line-at(85.544pt, 237.464pt, "Having quantified the coordination value, the following sections investigate whether ")
  #line-at(49.544pt, 237.464pt, "118 ")
  #line-at(85.544pt, 253.304pt, "additional improvements can still be achieved once the collective asset is already in ")
  #line-at(49.544pt, 253.304pt, "119 ")
  #line-at(85.544pt, 269.144pt, "operation through alternative allocation schemes and storage integration. ")
  #line-at(49.544pt, 269.144pt, "120 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 299.624pt, "3.2.2")
  #line-at(139.544pt, 299.624pt, "Benefits coming from diverse allocation shares.  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.544pt, 299.624pt, "121 ")
  #line-at(85.544pt, 329.624pt, "Table 1 showed the allocation share members of energy community studied defined based ")
  #line-at(49.544pt, 329.624pt, "122 ")
  #line-at(85.544pt, 345.464pt, "on the equity investment and. The share is applied uniformly every single hour of the ")
  #line-at(49.544pt, 345.464pt, "123 ")
  #line-at(85.544pt, 361.544pt, "year. Results from such allocation are those commented in the previous section. The next ")
  #line-at(49.544pt, 361.544pt, "124 ")
  #line-at(85.544pt, 377.384pt, "question is to what extent the energy distribution model based solely on equity can be ")
  #line-at(49.544pt, 377.384pt, "125 ")
  #line-at(85.544pt, 393.224pt, "considered optimal. ")
  #line-at(49.544pt, 393.224pt, "126 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 423.464pt, "3.2.2.1")
  #line-at(157.544pt, 423.464pt, "Set allocation using past dynamic distribution ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.544pt, 423.464pt, "127 ")
  #line-at(85.544pt, 453.704pt, "First, it should be acknowledged that dynamic energy sharing, although recognized as the ")
  #line-at(49.544pt, 453.704pt, "128 ")
  #line-at(85.544pt, 469.544pt, "optimal solution by several authors, cannot currently be implemented in many countries, ")
  #line-at(49.544pt, 469.544pt, "129 ")
  #line-at(85.544pt, 485.384pt, "including Spain. Nevertheless, while Spanish regulation requires fixed allocation ")
  #line-at(49.544pt, 485.384pt, "130 ")
  #line-at(85.544pt, 501.224pt, "coefficients, these coefficients may vary across the 8,760 hours of the year. ")
  #line-at(49.544pt, 501.224pt, "131 ")
  #line-at(85.544pt, 531.224pt, "Accordingly, our first proposal is to define allocation shares based on the hourly ")
  #line-at(49.544pt, 531.224pt, "132 ")
  #line-at(85.544pt, 547.064pt, "consumption patterns observed in previous years. Due to limitations in the DATADIS ")
  #line-at(49.544pt, 547.064pt, "133 ")
  #line-at(85.544pt, 562.904pt, "platform, only the two most recent years of consumption data were available. Analysis of ")
  #line-at(49.544pt, 562.904pt, "134 ")
  #line-at(85.544pt, 578.744pt, "these data revealed an interannual variability in individual consumption ranging from ")
  #line-at(49.544pt, 578.744pt, "135 ")
  #line-at(85.544pt, 594.584pt, "4.5% to 9.3%. An improved approach would be to construct a representative consumption ")
  #line-at(49.544pt, 594.584pt, "136 ")
  #line-at(85.544pt, 610.424pt, "profile using all available historical data, analogous to the Typical Meteorological Year ")
  #line-at(49.544pt, 610.424pt, "137 ")
  #line-at(85.544pt, 626.504pt, "commonly used in photovoltaic energy modelling. ")
  #line-at(49.544pt, 626.504pt, "138 ")
  #line-at(85.544pt, 656.264pt, "To explore this, we conducted an optimization using the oemof.solph library, which ")
  #line-at(49.544pt, 656.264pt, "139 ")
  #line-at(85.544pt, 672.104pt, "allows us to model hour-by-hour allocations based on each participant’s actual ")
  #line-at(49.544pt, 672.104pt, "140 ")
  #line-at(85.544pt, 687.944pt, "consumption profile. ")
  #line-at(49.544pt, 687.944pt, "141 ")
  #line-at(85.544pt, 717.944pt, "The objective of this optimization was to minimize costs within the community, meaning ")
  #line-at(49.544pt, 717.944pt, "142 ")
  #line-at(85.544pt, 733.784pt, "that electricity generated by the shared photovoltaic system is consumed locally as much ")
  #line-at(49.544pt, 733.784pt, "143 ")
  #line-at(85.544pt, 749.624pt, "as possible, minimizing both exports to the grid and energy imports. The model respects ")
  #line-at(49.544pt, 749.624pt, "144 ")
  #line-at(85.544pt, 765.464pt, "technical constraints, such as hourly demand data for each user, and ensures that at each ")
  #line-at(49.544pt, 765.464pt, "145 ")
]

