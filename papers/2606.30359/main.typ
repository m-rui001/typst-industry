  #line-at(121.544pt, 467.624pt, "When generation fell short of demand, PV output was allocated in proportion to ")
  #line-at(121.544pt, 483.704pt, "each user’s investment share, while remaining energy needs were met via grid ")
  #line-at(121.544pt, 499.544pt, "import. Export constraints ensured that no more energy was sold to the grid than ")
  #line-at(121.544pt, 515.384pt, "was generated. ")
  #line-at(85.544pt, 555.224pt, "Marginal Contribution to Profit (MCP): modelling considerations. The MCP method ")
  #line-at(85.544pt, 571.064pt, "assesses the extent of everyone’s input to the overall savings achieved by the group. For ")
  #line-at(85.544pt, 586.904pt, "every user k, the optimization model operates two times: first, including all users and ")
  #line-at(85.544pt, 602.744pt, "second, omitting user k's load. The additional contribution is then determined by:  ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(225.287pt, 626.984pt, "𝑀𝐶𝑃")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(248.813pt, 629.384pt, "B")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(258.035pt, 626.984pt, "= 𝑆")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(278.8pt, 629.384pt, "988")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(290.071pt, 629.384pt, " −𝑆")
  #set text(font: "Cambria Math", size: 8.4pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(311.013pt, 629.384pt, "988CB")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(334.678pt, 626.984pt, "  (Eq.7) ")
  #line-at(85.544pt, 650.744pt, "Here, ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(116.818pt, 650.744pt, "S")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(122.818pt, 651.704pt, "all")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(131.263pt, 650.744pt, " represents the total community savings with all users included, while ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(490.084pt, 650.744pt, "S")
  #set text(font: "Times New Roman", size: 7.92pt, weight: "regular", style: "italic", fill: rgb("#000000"))
