  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 107.384pt, "4.3")
  #line-at(122.544pt, 107.384pt, "Battery investments recommendations ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.544pt, 107.384pt, "426 ")
  #line-at(85.544pt, 137.864pt, "The findings show that battery storage should not be seen as a one-size-fits-all answer for ")
  #line-at(49.544pt, 137.864pt, "427 ")
  #line-at(85.544pt, 153.704pt, "established energy communities that work under the present electricity market situation. While ")
  #line-at(49.544pt, 153.704pt, "428 ")
  #line-at(85.544pt, 169.544pt, "storage boosts the use of locally produced solar energy and lessens reliance on the grid, its ")
  #line-at(49.544pt, 169.544pt, "429 ")
  #line-at(85.544pt, 185.384pt, "financial appeal heavily depends on the energy-sharing system chosen by the community. ")
  #line-at(49.544pt, 185.384pt, "430 ")
  #line-at(85.544pt, 215.624pt, "Blended dynamic allocation strategy regularly produced better financial returns and wider ")
  #line-at(49.544pt, 215.624pt, "431 ")
  #line-at(85.544pt, 231.464pt, "profit ranges compared to equity-based or MCP-based methods. With today's battery prices and ")
  #line-at(49.544pt, 231.464pt, "432 ")
  #line-at(85.544pt, 247.304pt, "electricity rates, investments in storage seem sensible mainly when allocation systems enhance ")
  #line-at(49.544pt, 247.304pt, "433 ")
  #line-at(85.544pt, 263.144pt, "the value of shared energy resources and enable the battery to adjust to real usage patterns. On ")
  #line-at(49.544pt, 263.144pt, "434 ")
  #line-at(85.544pt, 279.224pt, "the other hand, with fixed allocation systems, the extra value brought in by storage might not ")
  #line-at(49.544pt, 279.224pt, "435 ")
  #line-at(85.544pt, 295.064pt, "be enough to cover the cost of investment. ")
  #line-at(49.544pt, 295.064pt, "436 ")
  #line-at(85.544pt, 325.304pt, "Thus, energy communities should focus on enhancing energy-sharing setups before making ")
  #line-at(49.544pt, 325.304pt, "437 ")
  #line-at(85.544pt, 341.144pt, "large investments in battery storage. Storage should be considered a later-stage optimization ")
  #line-at(49.544pt, 341.144pt, "438 ")
  #line-at(85.544pt, 356.984pt, "step instead of a requirement for boosting community performance.")
  #line-at(49.544pt, 356.984pt, "439 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(103.544pt, 387.224pt, "5.")
  #line-at(121.544pt, 387.224pt, "Conclusions ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(49.544pt, 387.224pt, "440 ")
  #line-at(85.544pt, 417.464pt, "This study investigated how citizen-led photovoltaic initiatives can maintain and enhance their ")
  #line-at(49.544pt, 417.464pt, "441 ")
  #line-at(85.544pt, 433.304pt, "value under increasingly challenging market conditions characterized by declining electricity ")
  #line-at(49.544pt, 433.304pt, "442 ")
  #line-at(85.544pt, 449.384pt, "prices and limited remuneration of surplus generation. ")
  #line-at(49.544pt, 449.384pt, "443 ")
  #line-at(85.544pt, 479.624pt, "The first and most important finding is that collective self-consumption substantially ")
  #line-at(49.544pt, 479.624pt, "444 ")
  #line-at(85.544pt, 495.464pt, "outperforms equivalent individual photovoltaic installations. By aggregating diverse demand ")
  #line-at(49.544pt, 495.464pt, "445 ")
  #line-at(85.544pt, 511.304pt, "profiles, collective schemes require lower installed capacity, increase the local utilization of ")
  #line-at(49.544pt, 511.304pt, "446 ")
  #line-at(85.544pt, 527.144pt, "photovoltaic generation, and generate greater economic savings. These results suggest that, ")
  #line-at(49.544pt, 527.144pt, "447 ")
  #line-at(85.544pt, 542.984pt, "under current market conditions, the long-term development of citizen participation in ")
  #line-at(49.544pt, 542.984pt, "448 ")
  #line-at(85.544pt, 558.824pt, "photovoltaic self-consumption is likely to rely more on collective approaches than on ")
  #line-at(49.544pt, 558.824pt, "449 ")
  #line-at(85.544pt, 574.664pt, "fragmented individual installations. ")
  #line-at(49.544pt, 574.664pt, "450 ")
  #line-at(85.544pt, 605.144pt, "Having established the advantages of collective self-consumption, the analysis explored which ")
  #line-at(49.544pt, 605.144pt, "451 ")
  #line-at(85.544pt, 620.984pt, "strategies can further improve the performance of energy communities. The results show that ")
  #line-at(49.544pt, 620.984pt, "452 ")
  #line-at(85.544pt, 636.824pt, "significant gains can still be achieved without additional investments. More adaptive allocation ")
  #line-at(49.544pt, 636.824pt, "453 ")
  #line-at(85.544pt, 652.664pt, "mechanisms increase the utilization of locally generated energy and improve overall ")
  #line-at(49.544pt, 652.664pt, "454 ")
  #line-at(85.544pt, 668.504pt, "community performance, making them an attractive low-cost strategy for existing initiatives. ")
  #line-at(49.544pt, 668.504pt, "455 ")
  #line-at(85.544pt, 684.344pt, "The study discusses on those that are likely to be implemented right now instead of presenting ")
  #line-at(49.544pt, 684.344pt, "456 ")
  #line-at(85.544pt, 700.184pt, "optimization strategies that in practice are not managerial. ")
  #line-at(49.544pt, 700.184pt, "457 ")
  #line-at(85.544pt, 730.424pt, "Battery storage provides an additional source of flexibility and can further increase the value ")
  #line-at(49.544pt, 730.424pt, "458 ")
  #line-at(85.544pt, 746.264pt, "captured from photovoltaic generation. However, its benefits depend strongly on how energy ")
  #line-at(49.544pt, 746.264pt, "459 ")
  #line-at(85.544pt, 762.344pt, "is allocated and managed within the community. The results indicate that storage is most ")
  #line-at(49.544pt, 762.344pt, "460 ")
]

