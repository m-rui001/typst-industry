#original-page(595.32pt, 841.92pt, (image("graphics/page-03.png", width: 491.5pt), 54pt, 83.5pt))[
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(42.6pt, 226.32pt, "functions as a low-pass filter with different cutoff frequency. High-")
  #line-at(42.6pt, 236.64pt, "frequency waves cannot travel and be reflected to a sharp-bend ")
  #line-at(42.6pt, 246.96pt, "bearded interface. As a result, a triplexer is done when combining ")
  #line-at(42.6pt, 257.4pt, "two diplexers while fully utilizing the whole frequency band ")
  #line-at(42.6pt, 267.72pt, "determined by the VPC’s bandgap, as shown in Fig. 2. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(42.6pt, 290.04pt, "3.2.")
  #line-at(58.56pt, 290.04pt, "Photonic-crystal power combiner  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(51.6pt, 302.16pt, "A PC Y-branch power combiner [18] has been implemented to ")
  #line-at(42.6pt, 312.6pt, "coherently increase the power of multiple THz sources, such as ")
  #line-at(42.6pt, 322.92pt, "resonant tunneling diodes (RTDs) [3]. The device uses a bifurcation ")
  #line-at(42.6pt, 333.24pt, "structure to merge the incoming signals from two RTDs. Owing to ")
  #line-at(42.6pt, 343.56pt, "the mutual injection locking effect, the RTDs can be synchronized ")
  #line-at(42.6pt, 354pt, "when their oscillation frequencies are close to each other. By ")
  #line-at(42.6pt, 364.32pt, "optimizing the air holes at the Y-junction, the transmittance reaches ")
  #line-at(42.6pt, 376.08pt, "~0.71 (")
  #line-at(68.4pt, 376.08pt, "1/√2")
  #line-at(88.68pt, 376.08pt, "), which is theoretically maximum. In the Y-branch, the ")
  #line-at(42.6pt, 386.52pt, "mutual coupling between two RTDs equals to 0.5, ensuring that the ")
  #line-at(42.6pt, 396.84pt, "RTD can interact with the other one. Experimental results confirm ")
  #line-at(42.6pt, 407.16pt, "that both RTDs are locked and power enhancement is 4 times ")
  #line-at(42.6pt, 417.48pt, "compared to a standalone RTD in the structure, shown in Fig. 3. This ")
  #line-at(42.6pt, 427.92pt, "photonic-crystal structure is efficient for on-chip transmitters where ")
  #line-at(42.6pt, 438.24pt, "higher power levels are required with a limited power of single THz ")
  #line-at(42.6pt, 448.56pt, "sources. ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(42.6pt, 628.2pt, "3.3.")
  #line-at(58.56pt, 628.2pt, "Polarization multiplexer  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(51.6pt, 640.44pt, "An effective-medium based polarization multiplexer was ")
  #line-at(42.6pt, 650.76pt, "developed to simultaneously guide two orthogonal polarization ")
  #line-at(42.6pt, 661.08pt, "modes, thereby doubling the data throughput within a single physical ")
  #line-at(42.6pt, 671.4pt, "path [19]. The main feature of this device is its broad bandwidth, ")
  #line-at(42.6pt, 681.84pt, "high polarization extinction ration, and low loss. Specifically, the ")
  #line-at(42.6pt, 692.16pt, "developed multiplexer supports TE and TM modes, both are excited ")
  #line-at(42.6pt, 702.48pt, "at port 1, as shown in Fig. 4. The polarization paths are divided into ")
  #line-at(42.6pt, 713.52pt, "two parts. The ")
  #line-at(101.04pt, 713.52pt, "𝐸")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(105.96pt, 716.16pt, "ଵଵ")
  #line-at(107.28pt, 708.96pt, "௬")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(113.88pt, 713.52pt, " -path (for out-of-plane polarization, to port 3) ")
  #line-at(42.6pt, 724.56pt, "consists of two tapered directional couplers connected by a 90°-")
  #line-at(42.6pt, 735pt, "curved bend. A small air gap between two couplers with sufficient ")
  #line-at(42.6pt, 745.32pt, "long coupling length ensures high power transfer while rejecting the ")
  #line-at(42.6pt, 755.76pt, "𝐸")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(47.52pt, 757.8pt, "ଵଵ")
  #line-at(48.84pt, 752.4pt, "௫")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(55.44pt, 755.76pt, " mode. In contrast, the ")
  #line-at(145.68pt, 755.76pt, "𝐸")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(150.6pt, 757.8pt, "ଵଵ")
  #line-at(151.92pt, 752.4pt, "௫")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(158.52pt, 755.76pt, " -path (for in-plane polarization, to ")
  #line-at(42.6pt, 766.2pt, "port 2) comprises two tapered waveguides bridged by a thin straight ")
  #line-at(308.28pt, 87.84pt, "waveguide with a wide gap. A combination of this wide coupling gap ")
  #line-at(308.28pt, 98.16pt, "filled by high-index effective-medium material enables leakages of ")
  #line-at(308.28pt, 108.6pt, "the ")
  #line-at(322.92pt, 108.6pt, "𝐸")
  #set text(font: "Times New Roman", size: 6.48pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(327.84pt, 110.64pt, "ଵଵ")
  #line-at(329.16pt, 105.24pt, "௫")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(335.76pt, 108.6pt, " mode from the taper to the narrow bridge. Importantly, the ")
  #line-at(308.28pt, 119.04pt, "utilization of effective-medium cladding further increases the ")
  #line-at(308.28pt, 129.36pt, "polarization extinction ratios of more than 20 dB for both modes. ")
  #line-at(308.28pt, 139.8pt, "The insertion losses for two paths are below 1 dB in the whole WR-")
  #line-at(308.28pt, 150.12pt, "3.4 (220–330 GHz) band. The device successfully demonstrated an ")
  #line-at(308.28pt, 160.44pt, "aggregated data rate of 155 Gbit/s, showing capability for broadband ")
  #line-at(308.28pt, 170.76pt, "THz communications for doubling data throughput while ")
  #line-at(308.28pt, 181.2pt, "maintaining a compact on-chip footprint.  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(308.28pt, 361.08pt, "3.4.")
  #line-at(324.24pt, 361.08pt, "Spikeless-interfaced waveguide ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(317.28pt, 373.2pt, "To overcome the mechanical fragility associated with long tapered ")
  #line-at(308.28pt, 383.64pt, "silicon spikes, a spikeless interface has been introduced for coupling ")
  #line-at(308.28pt, 393.96pt, "a dielectric waveguide to a standard hollow metallic waveguide  ")
  #line-at(308.28pt, 404.28pt, "[20]. This design employs a slot waveguide as a coupler without any ")
  #line-at(308.28pt, 414.6pt, "protruding section to the hollow core. To minimize the impedance ")
  #line-at(308.28pt, 425.04pt, "mismatch between air and silicon at the interface, a tapered transition ")
  #line-at(308.28pt, 435.36pt, "region is optimized to maintain high transmittance in the whole WR-")
  #line-at(308.28pt, 445.68pt, "2.2 band (330–500 GHz). To connect two beams of the slot ")
  #line-at(308.28pt, 456pt, "waveguide, an array of sub-wavelength elliptical air holes is used to ")
  #line-at(308.28pt, 466.44pt, "form a low-index anisotropic material, as shown in Fig. 5. In practice, ")
  #line-at(308.28pt, 476.76pt, "this waveguide significantly simplifies alignment and improves ")
  #line-at(308.28pt, 487.08pt, "durability during assembly, making it well suited for practical THz ")
  #line-at(308.28pt, 497.4pt, "module packaging and deployment. By extending the operation ")
  #line-at(308.28pt, 507.84pt, "frequency to 600 GHz, the waveguide can support communications ")
  #line-at(308.28pt, 518.16pt, "for 14 channels with an aggregated data rate of more than 800 Gbit/s, ")
  #line-at(308.28pt, 528.48pt, "which is compatible for ultra-high-speed integrated circuit.   ")
  #set text(font: "Times New Roman", size: 9pt, weight: "bold", style: "italic", fill: rgb("#000000"))
  #line-at(308.28pt, 650.4pt, "3.5.")
  #line-at(324.24pt, 650.4pt, "Truncated rod for imaging ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(317.28pt, 662.52pt, "For sensing and imaging applications, near-field probes based on ")
  #line-at(308.28pt, 672.84pt, "dielectric waveguides have been developed to achieve enhanced ")
  #line-at(308.28pt, 683.28pt, "spatial resolution and material contrast [21], as illustrated in Fig. 6. ")
  #line-at(308.28pt, 693.6pt, "In particular, truncated silicon waveguides provide strong field ")
  #line-at(308.28pt, 703.92pt, "localization at the tip, enabling high-resolution imaging with ")
  #line-at(308.28pt, 714.24pt, "compact hardware. These probes have been applied to ")
  #line-at(308.28pt, 724.68pt, "semiconductor inspection, conductivity mapping, and broadband ")
  #line-at(308.28pt, 735pt, "material classification, illustrating their utility as cost-effective ")
  #line-at(308.28pt, 745.32pt, "sensing elements compatible with silicon-based THz platforms. ")
  #line-at(308.28pt, 755.64pt, "Their simple fabrication and robust performance make them ")
  #line-at(308.28pt, 766.08pt, "attractive for integrated non-destructive evaluation systems. ")
  #set text(font: "Arial", size: 9pt, weight: "regular", style: "italic", fill: rgb("#0e2841"))
  #line-at(51.24pt, 198.24pt, "Figure 2 (a) Low-pass filters formed by zigzag-interface with ")
  #line-at(51.24pt, 208.68pt, "different size in VPC triplexer. (b) Simulated S-parameters.  ")
  #line-at(50.88pt, 573.6pt, "Figure 3 (a) Two RTDs couple to PC Y-branch waveguide. ")
  #line-at(50.88pt, 583.92pt, "Output power is collected by using horn antenna. (b) Spectra of ")
  #line-at(50.88pt, 594.24pt, "standalone RTDs (red and blue). When simultaneously biasing ")
  #line-at(50.88pt, 604.8pt, "both RTDs, combined power (green) is enhanced. ")
  #set text(font: "Arial", size: 9pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(315.6pt, 615.36pt, "Figure 5 Spikeless waveguide based on slot coupler and ")
  #line-at(315.6pt, 625.8pt, "effective-medium channel. Period of elliptical air holes is 50 μm. ")
  #set text(font: "Arial", size: 9pt, weight: "regular", style: "italic", fill: rgb("#0e2841"))
  #line-at(315.84pt, 295.8pt, "Figure 4 (a) Fabricated sample and (b) segmented regions with ")
  #line-at(315.84pt, 306.12pt, "different permittivity tensors of polarization multiplexer. ")
  #line-at(315.84pt, 316.44pt, "Copyright 2024 The Authors, licensed under a Creative ")
  #line-at(315.84pt, 326.76pt, "Commons Attribution-NonCommercial License.  ")
  #line-at(315.84pt, 337.32pt, "(https://creativecommons.org/licenses/by-nc/4.0/) ")
]

