  #line-at(62.398pt, 92.158pt, "y")
  #line-at(70.08pt, 96.12pt, "z")
  #set text(font: "Arial", size: 7.818pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(168.722pt, 175.443pt, "(b) ")
