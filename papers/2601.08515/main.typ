#original-page(595.32pt, 841.92pt, (image("graphics/page-04.png", width: 150pt), 86pt, 87pt))[
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(42.6pt, 242.04pt, "4.")
  #line-at(53.88pt, 242.04pt, "Conclusion  ")
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(51.6pt, 257.28pt, "THz all-silicon waveguides have emerged as an efficient platform ")
  #line-at(42.6pt, 267.6pt, "owing to their extremely low propagation loss (~0.05 dB/cm). The ")
  #line-at(42.6pt, 278.04pt, "guiding mechanisms are categorized based on TIR, PBG, and slot ")
  #line-at(42.6pt, 288.36pt, "confinement effects, providing strong field confinement in the ")
  #line-at(42.6pt, 298.68pt, "microfabricated structure. By leveraging these mechanisms, ")
  #line-at(42.6pt, 309pt, "fundamental waveguide platforms can be extended into functional ")
  #line-at(42.6pt, 319.44pt, "passive components such as polarization/frequency multiplexers and ")
  #line-at(42.6pt, 329.76pt, "power ")
  #line-at(76.793pt, 329.76pt, "combiners/splitters, ")
  #line-at(159.109pt, 329.76pt, "enabling ")
  #line-at(201.606pt, 329.76pt, "ultra-high-speed ")
  #line-at(272.178pt, 329.76pt, "data ")
  #line-at(42.6pt, 340.08pt, "transmission and compact solutions for non-destructive sensing and ")
  #line-at(42.6pt, 350.4pt, "imaging across the THz regime. ")
  #line-at(51.6pt, 363.84pt, "Despite these extensive demonstrations, the transition of ")
  #line-at(42.6pt, 374.16pt, "dielectric-waveguide-based ")
  #line-at(155.682pt, 374.16pt, "technology ")
  #line-at(209.789pt, 374.16pt, "into ")
  #line-at(237.761pt, 374.16pt, "commercially ")
  #line-at(42.6pt, 384.48pt, "deployable systems remains limited. Heterogeneous integration of ")
  #line-at(42.6pt, 394.8pt, "developed components into multi-functional systems compatible ")
  #line-at(42.6pt, 405.24pt, "with existing electronic/photonic ecosystems (e.g., fiber optics, ")
  #line-at(42.6pt, 415.56pt, "antenna) will be essential for future 6G-and-beyond applications. ")
  #line-at(42.6pt, 425.88pt, "Our next direction is the hybrid integration of active THz sources ")
  #line-at(42.6pt, 436.2pt, "and detectors, such as III–V diodes, directly onto silicon waveguide ")
  #line-at(42.6pt, 446.64pt, "platforms to realize compact and portable modules. Ultimately, the ")
  #line-at(42.6pt, 456.96pt, "convergence of passive silicon waveguides and active devices is ")
  #line-at(42.6pt, 467.28pt, "expected to transform dielectric-waveguide technology from ")
  #line-at(42.6pt, 477.6pt, "laboratory-scale prototypes into practical platforms for real-world ")
  #line-at(42.6pt, 487.92pt, "applications.  ")
  #set text(font: "Times New Roman", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
