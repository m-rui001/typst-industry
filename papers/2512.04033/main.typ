  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.02pt, 248.81pt, "The primary drawback of p-NiO/ Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(315.41pt, 249.77pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(319.49pt, 248.81pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(328.15pt, 249.77pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.23pt, 248.81pt, " HJDs is high (>2V) turn-on voltage ")
  #line-at(90.024pt, 276.41pt, "which results in higher conduction losses in the on-state.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(371.47pt, 271.85pt, "22,23")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(389.71pt, 276.41pt, " One way to overcome the ")
  #line-at(90.024pt, 304.01pt, "challenge of high turn-on voltage is to fabricate junction barrier schottky diodes (JBSDs) ")
  #line-at(90.024pt, 331.61pt, "which simultaneously offer benefits of low turn-on voltage and high reverse breakdown ")
  #line-at(90.024pt, 359.21pt, "voltage. There have been prior reports employing the use of p-NiO on Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.02pt, 360.17pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(456.1pt, 359.21pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(464.74pt, 360.17pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.82pt, 359.21pt, " to achieve ")
  #line-at(90.024pt, 386.81pt, "high-performance JBSDs.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(215.69pt, 382.25pt, "24–26")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(235.85pt, 386.81pt, " Additionally, trench Schottky barrier diodes (SBDs) have ")
  #line-at(90.024pt, 414.43pt, "also been demonstrated in the past achieving high breakdown voltage, due to reduced ")
  #line-at(90.024pt, 442.03pt, "surface field (ReSURF) effect at the Schottky metal/semiconductor junction.")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(458.26pt, 437.47pt, "10")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.02pt, 469.63pt, "In this work, we demonstrate a deep trench-junction barrier schottky diode ")
  #line-at(90.024pt, 497.23pt, "(JSBD) which simultaneously leverages the higher breakdown field of the NiO/Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(505.42pt, 498.19pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(509.5pt, 497.23pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(518.14pt, 498.19pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 524.83pt, "junction (at the trench corner) and the RESURF effect due to the trench design (at the ")
  #line-at(90.024pt, 552.43pt, "Schottky contact) for enhanced breakdown voltage. In addition, the JBSDs are integrated ")
  #line-at(90.024pt, 580.03pt, "with an effective space-modulated junction termination extension (SM-JTE) as the edge ")
  #line-at(90.024pt, 607.66pt, "termination. The fabricated JBSDs display a low turn on voltage of ~1V, which is ")
  #line-at(90.024pt, 635.26pt, "significantly lower than that of planar NiO/Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(321.55pt, 636.22pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.63pt, 635.26pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(334.27pt, 636.22pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(338.35pt, 635.26pt, " HJDs fabricated on the same wafer. ")
  #line-at(90.024pt, 662.86pt, "The diodes also achieve a high breakdown voltage between 1.8 and 2 kV, which is ~2× ")
]

