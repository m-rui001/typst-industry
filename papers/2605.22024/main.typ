  #line-at(209.813pt, 530.451pt, "(a), (c), and (d). In such cases, attenuation-based compensation may appear")
  #line-at(38.835pt, 542.406pt, "adequate because the two profiles are similar in amplitude level and decay trend and will be compensated with a similar")
  #line-at(38.835pt, 554.361pt, "attenuation value. However, this apparent profile agreement does not necessarily imply that the attenuation estimate")
  #line-at(38.835pt, 566.316pt, "provides a physically appropriate normalisation for the depth-dependent behaviour of backscatter.")
  #line-at(53.779pt, 578.272pt, "This")
