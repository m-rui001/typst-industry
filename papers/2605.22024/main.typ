  #line-at(53.779pt, 518.496pt, "The second limitation is observed in cases where opposing-face backscatter profiles already show relatively high")
  #line-at(38.835pt, 530.451pt, "profile agreement, such as those in Figure")
  #set text(font: "STIXGeneral-Regular", size: 9.963pt, weight: "regular", style: "normal", fill: rgb("#2f4f4f"))
