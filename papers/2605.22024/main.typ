  #line-at(466.49pt, 331.434pt, "scattering")
  #line-at(38.835pt, 343.389pt, "behaviour. The compensated profiles therefore provide a more consistent representation of depth-resolved scattering")
  #line-at(38.835pt, 355.344pt, "intensity. Hence, the proposed method serves as a preprocessing step that improves the interpretability of ultrasonic")
  #line-at(38.835pt, 367.299pt, "backscatter measurements, making the signals more reliable as inputs for subsequent microstructure characterisation")
  #line-at(38.835pt, 379.254pt, "or inversion frameworks.")
