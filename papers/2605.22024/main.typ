  #line-at(485.229pt, 578.272pt, "wave")
  #line-at(38.835pt, 590.227pt, "interaction with the microstructure. Wall-echo attenuation primarily characterises the cumulative loss of coherent wave")
  #line-at(38.835pt, 602.182pt, "energy along the propagation path, including absorption, scattering out of the coherent beam, diffraction effects, beam")
  #line-at(38.835pt, 614.137pt, "distortion, and phase aberration associated with anisotropic texture. In contrast, pulse-echo backscatter depends on the")
  #line-at(38.835pt, 626.092pt, "portion of locally scattered energy redirected back toward the transducer, and is therefore influenced by the orientation,")
  #line-at(38.835pt, 638.048pt, "morphology, scattering strength, and spatial distribution of microstructural regions. This distinction is consistent with")
  #line-at(38.835pt, 650.003pt, "previous experimental and numerical work on macrozoned Ti–64, where attenuation and backscatter were shown to")
  #line-at(38.835pt, 661.958pt, "respond differently to macrozone morphology, texture, and scattering geometry [")
