  #line-at(90.024pt, 130.94pt, "occurs with stabilized resistance. Due to the incorporation of liquid metal with high ")
  #line-at(90.024pt, 146.54pt, "specific heat capacity, the release of supercooling and phase change latent heat elevates ")
  #line-at(90.024pt, 162.14pt, "the overall temperature descent curve, thereby delaying the occurrence time of the ")
  #line-at(90.024pt, 177.74pt, "minimum temperature.")
