  #line-at(90.024pt, 83.66pt, "E. A variety of LMCs with different morphologies manufactured by the layered cryogenic molding ")
  #line-at(90.024pt, 99.26pt, "method; F. Diffusion of pigment solution encapsulated in the internal vesicle across the ")
  #line-at(90.024pt, 114.86pt, "concentration gradient to the external solution environment; G. Microscopic structure of the cell ")
