#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(295.37pt, 778.08pt, "4 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 84.14pt, "completely solidified. Then, place a pre-frozen EgaIn (Eutectic Gallium and Indium, ")
  #line-at(90.024pt, 99.74pt, "75.5% gallium and 24.5% indium by weight percent) sphere in the center of the upper ")
  #line-at(90.024pt, 115.34pt, "surface. This prevents heat release during the solidification of the liquid metal, which ")
  #line-at(90.024pt, 130.94pt, "could otherwise melt the already-formed sodium hydroxide hemispherical ice block. ")
  #line-at(90.024pt, 146.54pt, "After 1 hour of freezing at -8 ℃, inject NaOH solution (0 to 1°C) into the mold until it ")
  #line-at(90.024pt, 162.14pt, "is filled. These steps ensure that the liquid metal remains protected by a solution layer ")
  #line-at(90.024pt, 177.74pt, "during subsequent membrane formation, preventing direct metal-membrane adhesion ")
  #line-at(90.024pt, 193.34pt, "that would otherwise compromise the original structure and properties. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(114.14pt, 209.06pt, "Step 2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.82pt, 209.06pt, ": After freezing the solution-liquid metal double-layer ice balls for 6 hours, ")
  #line-at(90.024pt, 224.54pt, "remove them from the mold and place them in a 0°C SA-PEDOT: PSS composite gel ")
  #line-at(90.024pt, 240.17pt, "solution (1.5 wt% SA, 0.033 wt% PEDOT:PSS).  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(114.14pt, 255.89pt, "Step 3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(147.14pt, 255.89pt, ": After ensuring the hydrogel solution evenly coats the ice balls through ")
  #line-at(90.024pt, 271.37pt, "multi-directional rolling, quickly transfer them into a 4 °C 5 wt% calcium lactate (CaL) ")
  #line-at(90.024pt, 286.97pt, "solution and keep stationary until the internal ice balls melt (about 5 minutes). This ")
  #line-at(90.024pt, 302.57pt, "ensures complete crosslinking. However, it is crucial to avoid leaving the solution in ")
  #line-at(90.024pt, 318.17pt, "contact with the gel for too long, as the differing osmotic pressures between the inside ")
  #line-at(90.024pt, 333.77pt, "and outside could cause a reaction between NaOH and CaL, affecting the permeability ")
  #line-at(90.024pt, 349.37pt, "and transparency of the cell membrane. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(114.14pt, 365.09pt, "Step 4")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.94pt, 365.09pt, ": Retrieve the formed LMCs from the CaL solution and rinse them quickly ")
  #line-at(90.024pt, 380.57pt, "3 times with deionized water to remove any residual CaL solution from the surface. ")
  #line-at(90.024pt, 396.17pt, "Then, place the cells into a 0.5 mol/L NaOH solution to conduct follow-up experiments. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 415.87pt, "2.4 Preparation of pre-frozen liquid metal core ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 435.19pt, "Target volumes of liquid metal droplets were dropped onto pre-cooled smooth ice ")
  #line-at(90.024pt, 450.79pt, "blocks prepared by freezing 0.5 mol/L NaOH solution, causing phase transition and ")
  #line-at(90.024pt, 466.39pt, "transformation into relatively smooth solid spheres. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 486.07pt, "2.5 Characterization of hydrogel layer cross-sectional morphology ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 505.39pt, "The composite hydrogel membrane samples were prepared for SEM imaging ")
  #line-at(90.024pt, 520.99pt, "using a combination of cryogenic fracturing and freeze-drying techniques to preserve ")
  #line-at(90.024pt, 536.59pt, "their native microstructure. First, the samples were rapidly immersed in liquid nitrogen ")
  #line-at(90.024pt, 552.19pt, "for 3 min to achieve cryogenic freezing, followed by mechanical fracturing to create a ")
  #line-at(90.024pt, 567.82pt, "clean cross-sectional surface. Subsequently, the fractured samples were subjected to ")
  #line-at(90.024pt, 583.42pt, "freeze-drying in a Benchtop Freeze Dryer (Advantage 2.0, SP VirTis, America) under ")
  #line-at(90.024pt, 599.02pt, "vacuum conditions at −50°C for 12 hours to remove residual water while maintaining ")
  #line-at(90.024pt, 614.62pt, "the structural integrity of the hydrogel network. The dried samples were then sputter-")
  #line-at(90.024pt, 630.22pt, "coated with a thin layer of gold (SPUTTER COATER 108auto, CRESSINGTON, UK) ")
  #line-at(90.024pt, 645.82pt, "to enhance conductivity and reduce charging effects during SEM imaging. The ")
  #line-at(90.024pt, 661.42pt, "hydrogel layer cross-sectional morphology images were captured using field emission ")
  #line-at(90.024pt, 677.02pt, "environmental scanning electron microscopes (FESEM, QUANTA FEG 250, America) ")
  #line-at(90.024pt, 692.62pt, "operated at an acceleration voltage of 15 kV, a working distance of 10 mm, and under ")
  #line-at(90.024pt, 708.22pt, "high vacuum conditions. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 727.9pt, "2.6 Electrical testing of LMCs ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 747.24pt, "All resistance values were obtained using the Kelvin four-terminal sensing method ")
  #line-at(90.024pt, 762.84pt, "on a data acquisition system (DAQ970A, Keysight, America) unless otherwise noted. ")
]

