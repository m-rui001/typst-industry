  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 602.02pt, "Beyond static responses, directional movement capabilities are essential for ")
  #line-at(90.024pt, 617.62pt, "artificial living systems to interact with and adapt to their environment and perform ")
  #line-at(90.024pt, 633.22pt, "complex tasks. For liquid metal living matter, the development of movement strategies ")
