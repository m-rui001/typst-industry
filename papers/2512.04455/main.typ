  #line-at(90.024pt, 373.01pt, "4.2 Mechanical response ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 396.17pt, "Mechanical stress is ubiquitous in natural settings, whether from fluid dynamics, ")
