  #line-at(424.99pt, 240.17pt, " As the nuclear ")
  #line-at(90.024pt, 255.77pt, "proportion increases, the electrical conductivity of the composite structure ")
  #line-at(90.024pt, 271.37pt, "progressively enhances under the same external conditions, accompanied by a gradual ")
