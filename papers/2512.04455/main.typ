  #set text(font: "Times New Roman", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(394.03pt, 420.19pt, "1")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(398.11pt, 419.71pt, "). The LMC exhibits ")
  #line-at(90.024pt, 435.19pt, "controlled migration along the flow direction with position correlation exceeding 0.99 ")
  #line-at(90.024pt, 450.79pt, "relative to magnetic guidance")
  #set text(font: "SimSun", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(232.13pt, 450.79pt, ",")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(238.13pt, 450.79pt, " demonstrating remarkable deformability as it adapts to ")
  #line-at(90.024pt, 466.39pt, "the narrowing channel geometry while maintaining forward momentum. Upon reaching ")
  #line-at(90.024pt, 481.99pt, "a channel segment matching its volume or the bifurcation, the LMC establishes ")
