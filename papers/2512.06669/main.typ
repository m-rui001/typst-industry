#original-page(595.276pt, 841.89pt, none)[
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(519.292pt, 793.74pt, "2")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 116.705pt, "ABSTRACT ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 161.039pt, "Flexible electronics and neuromorphic computing face key challenges in material integration and ")
  #line-at(70.02pt, 187.857pt, "function retention. In particular, freestanding membranes suffer from slow sacrificial layer ")
  #line-at(70.02pt, 214.744pt, "removal and interfacial strain, while neuromorphic hardware often relies on area-intensive dual-")
  #line-at(70.02pt, 241.562pt, "device schemes for bipolar synaptic weights. Here, we present a universal strategy based on water-")
  #line-at(70.02pt, 268.38pt, "soluble Sr")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.424pt, 268.826pt, "4")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(121.321pt, 268.38pt, "Al")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(132.907pt, 268.826pt, "2")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.854pt, 268.38pt, "O")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.27pt, 268.826pt, "7")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.154pt, 268.38pt, " sacrificial layers, enabling the rapid release of freestanding ferrimagnetic metal ")
  #line-at(70.02pt, 295.256pt, "membranes, which exhibit deterministic spin–orbit torque switching characteristics with well-")
  #line-at(70.02pt, 322.085pt, "preserved perpendicular magnetic anisotropy and are potential for next-generation ultrafast ")
  #line-at(70.02pt, 348.903pt, "information technology. Extending this approach, we realize single-device ferrimagnetic synapses ")
  #line-at(70.02pt, 375.779pt, "exhibiting intrinsic bipolar resistive switching. When implemented in a ResNet-18 architecture, ")
  #line-at(70.02pt, 402.596pt, "these devices achieve 92% accuracy on CIFAR-10—comparable to floating-point software ")
  #line-at(70.02pt, 429.426pt, "models—while halving device counts relative to differential-pair implementations. These results ")
  #line-at(70.02pt, 456.302pt, "establish a scalable platform linking flexible spintronics with compact, high-performance ")
  #line-at(70.02pt, 483.061pt, "neuromorphic systems, offering foundational advances for next-generation electronics and brain-")
  #line-at(70.02pt, 509.937pt, "inspired hardware. ")
]

