  #line-at(141.662pt, 316.262pt, " and unprecedented stacking/re-growth potential.")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(380.662pt, 311.853pt, "2,5,10,12,13")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(419.455pt, 316.262pt, " These characteristics ")
  #line-at(70.02pt, 343.079pt, "establish freestanding membranes as transformative platforms for advanced functional material ")
  #line-at(70.02pt, 369.955pt, "design and hybrid system integration. ")
  #line-at(70.02pt, 408.42pt, "Nevertheless, the exfoliation and transfer of freestanding membranes constitute a pivotal challenge ")
  #line-at(70.02pt, 435.296pt, "in realizing functional heterostructures and flexible electronic devices. The isolation of ")
  #line-at(70.02pt, 462.125pt, "freestanding membranes has followed a developmental trajectory rooted in two-dimensional ")
  #line-at(70.02pt, 488.884pt, "material research. Since Geim and Novoselov first demonstrated monolayer graphene acquisition ")
  #line-at(70.02pt, 515.76pt, "through Scotch tape-based mechanical exfoliation,")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(306.078pt, 511.365pt, "14")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(313.853pt, 515.76pt, " this methodology has been extended to other ")
  #line-at(70.02pt, 542.578pt, "layered materials including MoS")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(225.907pt, 543.045pt, "2")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(229.811pt, 538.179pt, "15")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(237.601pt, 542.578pt, " and WS")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(279.854pt, 543.045pt, "2")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(283.758pt, 538.179pt, "16")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(291.598pt, 542.578pt, ". Despite inherent limitations in production yield ")
  #line-at(70.02pt, 569.466pt, "and reproducibility, mechanical exfoliation remains the predominant laboratory technique for ")
  #line-at(70.02pt, 596.283pt, "obtaining high-quality two-dimensional materials due to its operational simplicity and broad ")
  #line-at(70.02pt, 623.101pt, "applicability. However, the strong interfacial coupling between conventional epitaxial thin films ")
  #line-at(70.02pt, 649.977pt, "and rigid substrates fundamentally limits the effectiveness of mechanical exfoliation methods in ")
  #line-at(70.02pt, 676.795pt, "preserving film integrity and crystallinity.")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(269.291pt, 672.413pt, "1,17,18")
