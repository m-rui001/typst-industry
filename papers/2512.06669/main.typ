  #line-at(70.02pt, 228.118pt, "by a Pt capping layer deposited at 30 W DC for 4 min. Continuous substrate rotation ensured ")
  #line-at(70.02pt, 241.562pt, "thickness consistency. ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(70.02pt, 262.743pt, "Membrane Transfer ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 285.896pt, "Freestanding Pt/CoTb membranes were fabricated by dissolving the SAO")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(427.879pt, 286.35pt, "T")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(432.595pt, 285.896pt, " sacrificial layer in ")
  #line-at(70.02pt, 299.34pt, "deionized water for 10 min, with the Polydimethylsiloxane (PDMS) support maintaining ")
  #line-at(70.02pt, 312.726pt, "mechanical integrity during release. The membrane was transferred to a new MgO substrate using ")
  #line-at(70.02pt, 326.158pt, "a precision alignment Metatest E1-G transfer system. ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(70.02pt, 347.339pt, "Device Fabrication ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 370.504pt, "Hall bar devices with 5-μm channel widths were patterned through UV photolithography using ")
  #line-at(70.02pt, 383.936pt, "AZ5214 photoresist spin-coated at 4000 rpm. The patterns were processed via Ar ion-beam ")
  #line-at(70.02pt, 397.38pt, "etching (80 mA beam current, 250 s duration). Au/Cr bilayer electrodes (60/15 nm) were deposited ")
  #line-at(70.02pt, 410.765pt, "by electron-beam evaporation, followed by lift-off in acetone using an ultrasonic bath. ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(70.02pt, 431.935pt, "Characterization Techniques ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 455.1pt, "Electrical transport measurements were conducted in a Quantum Design VersaLab integrated with ")
  #line-at(70.02pt, 468.543pt, "precision instrumentation: a Keithley 6221 current source provided excitation currents, while the ")
  #line-at(70.02pt, 481.976pt, "Hall voltage was resolved using a Keithley 2182A nanovoltmeter. An external magnetic field was ")
  #line-at(70.02pt, 495.361pt, "applied perpendicular to the film plane during anomalous Hall effect measurements. Cross-")
  #line-at(70.02pt, 508.805pt, "sectional microstructure evaluation was performed using a JEOL NeoArm transmission electron ")
  #line-at(70.02pt, 522.179pt, "microscope operated at 200 kV. The XRD data was obtained with a Rigaku SmartLab ")
  #line-at(70.02pt, 535.564pt, "diffractometer using Cu-")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(188.704pt, 535.564pt, "K")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(196.441pt, 535.564pt, "α")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(202.632pt, 536.021pt, "1")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(206.512pt, 535.564pt, " radiation (")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(264.302pt, 535.564pt, "λ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(269.402pt, 535.564pt, " = 0.154056 nm). Surface morphology and device ")
  #line-at(70.02pt, 548.996pt, "metrology were characterized through optical profilometry using a Metatest E1-G metallurgical ")
  #line-at(70.02pt, 562.44pt, "microscope. The film stacks in this work are Pt (9 nm)/CoTb (6 nm) unless otherwise noted. ")
]

