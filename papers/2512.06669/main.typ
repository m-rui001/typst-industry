  #line-at(124.204pt, 235.739pt, " offer unique advantages by circumventing limitations imposed by traditional epitaxial ")
  #line-at(70.02pt, 262.556pt, "constraints. These include enhanced strain engineering capabilities,")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
