  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 155.216pt, "Freestanding membranes, defined as substrate-independent materials capable of maintaining ")
  #line-at(70.02pt, 182.045pt, "structural integrity and intrinsic physical/chemical functionalities after detachment from their ")
  #line-at(70.02pt, 208.863pt, "native growth substrates via specific techniques (")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(313.911pt, 208.863pt, "e.g.")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(330.774pt, 208.863pt, ", sacrificial layer exfoliation, interfacial ")
