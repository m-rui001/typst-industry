  #line-at(72.1pt, 393.35pt, "applied bias: once the microcontact population becomes sufficiently connected, the effective ")
  #line-at(72.1pt, 414.37pt, "transport bottleneck shifts abruptly [54,56,57]. ")
  #line-at(90.125pt, 439.87pt, "Within this framework, LECO reduces ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
