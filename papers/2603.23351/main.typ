  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.75pt, 297.25pt, "𝐿")
  #set text(font: "Cambria Math", size: 8.25pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(200.5pt, 300.28pt, "eff")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(210.28pt, 297.25pt, ", ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(216.27pt, 297.25pt, "𝑇")
  #set text(font: "Cambria Math", size: 8.25pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(222.27pt, 300.28pt, "𝑚𝑎𝑥")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(241.05pt, 297.25pt, ", ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(247.08pt, 297.25pt, "𝐶")
  #set text(font: "Cambria Math", size: 8.25pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(253.08pt, 300.28pt, "𝐽")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(257.57pt, 297.25pt, ") with fast observables (imaging and electrical tests), ")
  #line-at(72.1pt, 319.78pt, "then updates margins continuously under tool drift and supply variation. ")
  #set text(font: "Times New Roman", size: 15.775pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 351.3pt, "8.6 Industrial outlook ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.125pt, 379.83pt, "The industrial trajectory for LECO is promising, but bankability will depend on ")
  #line-at(72.1pt, 400.85pt, "transforming performance gains into stability-certified process modules that transfer across ")
  #line-at(72.1pt, 421.12pt, "device architectures and metallization stacks. The path is visible. Long-term module studies ")
  #line-at(72.1pt, 442.15pt, "support stable deployment in specific PERC implementations, while recent failure-mode ")
  #line-at(72.1pt, 463.15pt, "identification in TOPCon under coupled stress highlights that architecture-specific instability ")
  #line-at(72.1pt, 483.43pt, "mechanisms must be anticipated and screened early [15,108]. Mid-term, Cu adoption and ")
  #line-at(72.1pt, 504.45pt, "fine-line scaling will likely determine the tightest stability margins because both increase ")
  #line-at(72.1pt, 524.7pt, "sensitivity to diffusion, corrosion pathways, and current localization [6,143,145]. Long-term, ")
  #line-at(72.1pt, 545.73pt, "AI-guided optimization and digital-twin control offer a route to self-calibrating operation that ")
  #line-at(72.1pt, 566.75pt, "maintains low-resistance contacts while reducing rework, yield loss, and unnecessary thermal ")
  #line-at(72.1pt, 587.02pt, "budget, which aligns LECO development with sustainability objectives [147,148]. ")
  #set text(font: "Times New Roman", size: 20.275pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 632.8pt, "Conclusion ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.125pt, 664.33pt, "LECO has become a practical manufacturing lever for reducing contact resistance in ")
  #line-at(72.1pt, 685.35pt, "advanced crystalline silicon solar cells, but its outcomes are governed by localized coupling ")
  #line-at(72.1pt, 705.62pt, "between laser energy deposition, reverse-bias current localization, and thermally activated ")
  #line-at(72.1pt, 726.63pt, "interfacial evolution. This coupling explains both the existence of a narrow optimization ")
  #line-at(72.1pt, 746.9pt, "window where ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(146.42pt, 746.9pt, "ρ")
  #set text(font: "Cambria Math", size: 8.25pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(153.2pt, 749.9pt, "𝑐")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(157.7pt, 746.9pt, " and FF improve, and the emergence of metastable interfaces that drift ")
  #line-at(72.1pt, 768.675pt, "under combined electrical, thermal, and environmental stress. ")
]

