  #set text(font: "Times New Roman", size: 15.775pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 258.22pt, "4.1 Transport-limited versus junction-limited response ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.125pt, 286.75pt, "A practical first step is to separate losses that are primarily transport-related from losses ")
