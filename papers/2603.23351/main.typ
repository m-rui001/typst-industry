  #set text(font: "Times New Roman", size: 9pt, weight: "regular", style: "italic", fill: rgb("#0e2841"))
  #line-at(72.1pt, 366.33pt, "Figure 9: Hierarchical LECO modeling workflow. A transient electrothermal FE core resolves T and ")
