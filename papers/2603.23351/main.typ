  #line-at(177.97pt, 346.8pt, " (%) so larger values mean stronger shunt degradation, and (c) normalized efficiency ")
  #set text(font: "Cambria Math", size: 9pt, weight: "regular", style: "normal", fill: rgb("#0e2841"))
  #line-at(488.13pt, 346.8pt, "𝜂/𝜂")
  #set text(font: "Cambria Math", size: 6.75pt, weight: "regular", style: "normal", fill: rgb("#0e2841"))
