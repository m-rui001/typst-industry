#original-page(595.5pt, 841.5pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(458.07pt, 792.7pt, "Page 41 of 51 ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 803.95pt, "Donald Intal & Abasifreke U. Ebong: ")
  #set text(font: "Times New Roman", size: 9.75pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(226.05pt, 803.95pt, "Preprint submitted to Elsevier")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 84.08pt, "recipes that sit close to stability boundaries. Data-efficient optimization becomes most ")
  #line-at(72.1pt, 105.1pt, "valuable when it is constrained by mechanistic metrics, so that performance improvement is ")
  #line-at(72.1pt, 125.35pt, "not achieved by trading into reliability risk. ")
  #line-at(90.125pt, 152.37pt, "Recent manufacturing-relevant examples show how Bayesian optimization can be ")
  #line-at(72.1pt, 172.65pt, "integrated into process control problems in silicon PV, including sheet-resistance targeting in ")
  #line-at(72.1pt, 193.67pt, "doping processes, which is directly analogous to LECO recipe search under constraints [147]. ")
  #line-at(72.1pt, 214.7pt, "In parallel, digital-twin perspectives in photovoltaics emphasize combining physics-based ")
  #line-at(72.1pt, 234.95pt, "models with data-driven inference and uncertainty-aware optimization to accelerate ")
  #line-at(72.1pt, 255.97pt, "innovation while balancing performance, longevity, and sustainability constraints [148]. For ")
  #line-at(72.1pt, 276.25pt, "LECO, the highest-value industrial implementation is a constraint-aware twin that fuses ")
  #line-at(72.1pt, 297.25pt, "Section 7 predictors (")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(174.98pt, 297.25pt, "𝐸")
  #set text(font: "Cambria Math", size: 8.25pt, weight: "regular", style: "normal", fill: rgb("#000000"))
