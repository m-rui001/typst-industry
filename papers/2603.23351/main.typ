  #set text(font: "Times New Roman", size: 20.275pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.1pt, 90.83pt, "4. Electrical Parameter Decomposition Framework ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.125pt, 122.35pt, "The microstructural pathways summarized in Section 3 are only meaningful to the extent ")
