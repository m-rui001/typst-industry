  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 82.46pt, "Docking: 5′-/ThiolMC6-D/TTATCTCCTATACAACTTCC/-3′ ")
  #line-at(72.024pt, 127.46pt, "Oligo Nanorulers. ")
  #line-at(72.024pt, 149.9pt, "Three double-stranded DNA constructs positioned the fluorophore at around 3, 6, and 9 nm from the ")
  #line-at(72.024pt, 164.42pt, "metal through defined poly-A/T spacers. After short incubations (30 s-1 min), confocal fluorescence maps ")
  #line-at(72.024pt, 178.94pt, "were recorded around individual pores. ")
  #line-at(72.024pt, 201.38pt, "3 nm: 5′-/ThiolMC6-D/AAAAAAAAAA/Atto647N/-3′ + 5′-/TTTTTTTTTT/-3′ ")
  #line-at(72.024pt, 223.94pt, "6 nm: 5′-/ThiolMC6-D/AAAAAAAAAAAAAAA/Atto647N/-3′ + 5′-/TTTTTTTTTTTTTTT/-3′ ")
  #line-at(72.024pt, 246.38pt, "9 nm: 5′-/ThiolMC6-D/AAAAAAAAAAAAAAAAAAAA/Atto647N/-3′ + 5′-/TTTTTTTTTTTTTTTTTTTT/-3′ ")
  #line-at(72.024pt, 268.85pt, "Optical Measurements. ")
  #line-at(72.024pt, 291.41pt, "Fluorescence intensity maps of nanoruler-functionalized nanopores were acquired on a Nikon A1R+ ")
  #line-at(72.024pt, 305.93pt, "confocal microscope using a 100× oil-immersion objective (NA 1.49) and 640 nm excitation (50 µW). ")
  #line-at(72.024pt, 320.33pt, "Emission was collected through standard Cy5 filter sets and recorded under identical conditions for all ")
  #line-at(72.024pt, 334.85pt, "samples to enable quantitative comparison of fluorescence enhancement versus distance. ")
  #line-at(72.024pt, 357.41pt, "DNA-PAINT measurements were performed on a custom-built wide-field fluorescence microscope based ")
  #line-at(72.024pt, 371.81pt, "on an inverted Olympus IX83 body. Samples were illuminated in epi-configuration with a 640 nm laser ")
  #line-at(72.024pt, 386.33pt, "(Laser Quantum) providing a Gaussian beam and circularly polarized excitation. Fluorescence was ")
  #line-at(72.024pt, 400.85pt, "collected through a 100× oil-immersion objective (NA 1.5, Olympus), filtered by a 532/640 nm dual-band ")
  #line-at(72.024pt, 415.37pt, "set (Chroma), and detected on a CMOS camera (ORCA-Fusion, Hamamatsu). ")
  #line-at(72.024pt, 437.83pt, "Numerical Simulations. ")
  #line-at(72.024pt, 460.27pt, "Three-dimensional electromagnetic simulations were performed in COMSOL Multiphysics using realistic ")
  #line-at(72.024pt, 474.79pt, "conical geometries including the dielectric and Au layers. Near-field intensity distributions were computed ")
  #line-at(72.024pt, 489.31pt, "under 640 nm excitation to identify zones of field enhancement. ")
