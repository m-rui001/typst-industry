  #line-at(72.024pt, 220.82pt, "further studies with controlled excitation and larger datasets will be necessary to disentangle these ")
  #line-at(72.024pt, 235.34pt, "factors. ")
  #line-at(72.024pt, 257.93pt, "These results demonstrate that DNA-PAINT can serve not only as a molecular imaging technique but also ")
  #line-at(72.024pt, 272.33pt, "as a sensitive reporter of the local nanoenvironment within plasmonic structures.")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.71pt, 268.37pt, "39")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(459.67pt, 272.33pt, " Importantly, this ")
  #line-at(72.024pt, 286.85pt, "represents the first experimental realization of DNA-PAINT within solid-state nanopores, establishing a ")
  #line-at(72.024pt, 301.37pt, "new platform that unites single-molecule localization microscopy with nanofluidic confinement. Future ")
  #line-at(72.024pt, 315.89pt, "experiments combining photon-count statistics, dwell-time distributions, and temperature mapping will ")
  #line-at(72.024pt, 330.29pt, "help to clarify the relative contributions of optical enhancement, local heating, and kinetic effects in ")
  #line-at(72.024pt, 344.81pt, "shaping the observed fluorescence dynamics. ")
]

