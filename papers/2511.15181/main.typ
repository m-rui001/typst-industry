  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(165.86pt, 245.9pt, " and guiding chemical reactions at the nanoscale")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(397.03pt, 241.94pt, "15")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(403.99pt, 245.9pt, ". These plasmonic nanopores ")
  #line-at(72.024pt, 260.45pt, "therefore provide a unique platform in which electromagnetic, electrical, and thermal fields can be tuned ")
  #line-at(72.024pt, 274.97pt, "precisely within tens of nanometers.")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
