  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(340.63pt, 159.02pt, " and even data-storage readout.")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(485.5pt, 155.06pt, "8,9")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(494.26pt, 159.02pt, " Following ")
  #line-at(72.024pt, 173.54pt, "our earlier work on three-dimensional conical nanopores made of metal oxides, structures that ")
  #line-at(72.024pt, 187.94pt, "established a robust and versatile platform for electrical and iontronic functionalities,")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(458.47pt, 183.98pt, " 10")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(467.38pt, 187.94pt, " we now extend ")
  #line-at(72.024pt, 202.46pt, "this concept toward plasmonic architectures that enable optical techniques at the single-molecule level. ")
  #line-at(72.024pt, 216.98pt, "When metals such as gold are introduced, plasmonic antennas concentrate light into nanoscale hot ")
  #line-at(72.024pt, 231.5pt, "spots,")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
