  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 297.41pt, "Understanding and exploiting this near-field regime requires a method capable of reporting local optical ")
  #line-at(72.024pt, 311.93pt, "conditions with nanometer precision, ideally one that can reveal both spatial and temporal information ")
  #line-at(72.024pt, 326.45pt, "on emission processes and kinetics. DNA-PAINT (Points Accumulation for Imaging in Nanoscale ")
