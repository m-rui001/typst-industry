  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(379.75pt, 151.58pt, "/Mn³")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(403.99pt, 151.58pt, "⁺")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(408.91pt, 151.58pt, ") allows field-induced ")
  #line-at(72.024pt, 168.38pt, "electronic bistability, electrochromism, and even metal–insulator transitions under ")
  #line-at(72.024pt, 185.42pt, "modest bias. Together, these characteristics create ideal conditions for ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(465.22pt, 185.42pt, "ionic-drift-")
  #line-at(72.024pt, 202.34pt, "driven RS")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(126.5pt, 202.34pt, ", multilevel memory operation, and the possibility of coupling electrical, ")
  #line-at(72.024pt, 219.26pt, "optical, or magnetic degrees of freedom within the same device. ")
  #line-at(72.024pt, 244.22pt, "PBAs also offer compelling advantages for ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(314.71pt, 244.22pt, "fabrication and integration")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(466.78pt, 244.22pt, ". They are ")
  #line-at(72.024pt, 261.26pt, "composed of earth-abundant, environmentally benign elements and can be synthesized ")
  #line-at(72.024pt, 278.21pt, "through ")
  #line-at(125.652pt, 278.21pt, "highly ")
  #line-at(169.788pt, 278.21pt, "scalable, ")
  #line-at(230.712pt, 278.21pt, "low-temperature, ")
  #line-at(334.106pt, 278.21pt, "water-based ")
  #line-at(412.378pt, 278.21pt, "methods ")
  #line-at(472.114pt, 278.21pt, "such ")
  #line-at(511.102pt, 278.21pt, "as ")
  #line-at(72.024pt, 295.25pt, "electrodeposition, printing, and solution processing. Electrodeposition, in particular, ")
  #line-at(72.024pt, 312.17pt, "enables ")
  #line-at(127.56pt, 312.17pt, "nanometer-to-micrometer ")
  #line-at(277.826pt, 312.17pt, "thickness ")
  #line-at(342.098pt, 312.17pt, "control, ")
  #line-at(396.794pt, 312.17pt, "uniform ")
  #line-at(451.838pt, 312.17pt, "coatings ")
  #line-at(510.014pt, 312.17pt, "on ")
  #line-at(72.024pt, 329.09pt, "microelectrodes, and full compatibility with CMOS metal stacks—capabilities difficult to ")
  #line-at(72.024pt, 346.13pt, "achieve with conventional oxide dielectrics. ")
  #line-at(72.024pt, 371.09pt, "Recent studies have demonstrated robust bipolar and unipolar resistive switching in PB, ")
  #line-at(72.024pt, 388.01pt, "Prussian White (PW), and other PBAs, with conduction dominated by alkali-ion migration ")
  #line-at(72.024pt, 405.05pt, "and defect-mediated filament formation. Advanced work has revealed ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(451.42pt, 405.05pt, "conductance ")
  #line-at(72.024pt, 421.97pt, "quantization")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(140.54pt, 421.97pt, " in PB-based devices, confirming the formation of atomic-scale channels ")
  #line-at(72.024pt, 439.01pt, "and positioning PBAs as strong candidates for multilevel memory and neuromorphic ")
  #line-at(72.024pt, 455.95pt, "synaptic elements. Variability analyses further indicate that PB-based memristors ")
  #line-at(72.024pt, 472.87pt, "possess sufficiently stable switching characteristics for neuromorphic computing and ")
  #line-at(72.024pt, 489.91pt, "hardware cryptography, including TRNGs and PUFs. ")
  #line-at(72.024pt, 539.83pt, "Building upon this rich foundation, the present work focuses on the characterization and ")
  #line-at(72.024pt, 556.75pt, "modeling of conductance quantization in RRAM devices employing electrodeposited ")
  #line-at(72.024pt, 573.79pt, "Prussian Blue as the active dielectric layer. Owing to its mixed-valence redox chemistry, ")
  #line-at(72.024pt, 590.71pt, "open-framework structure, and reversible ionic mobility, PB offers a unique platform for ")
  #line-at(72.024pt, 607.63pt, "the formation of atomic-scale conduction channels. By analyzing quantized ")
  #line-at(72.024pt, 624.7pt, "conductance states and elucidating filament dynamics, this study advances the ")
  #line-at(72.024pt, 641.62pt, "understanding of PB-based memristors and highlights their potential for robust ")
  #line-at(72.024pt, 658.66pt, "multilevel memory, neuromorphic architectures, and secure hardware applications. ")
]

