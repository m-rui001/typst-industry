#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Calibri", size: 15.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(105.86pt, 87.02pt, "Prussian Blue and Prussian Blue Analogues as Emerging ")
  #line-at(226.01pt, 109.7pt, "Memristive Materials ")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 136.58pt, "L. B. Avila")
  #set text(font: "Calibri", size: 6.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(121.46pt, 132.62pt, "1")
  #line-at(72.024pt, 157.58pt, "1")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(75.744pt, 161.54pt, "Institute of Condensed Matter and Nanosciences (ICMN), Université catholique de ")
  #line-at(72.024pt, 183.5pt, "Louvain (UCLouvain), Louvain-la-Neuve B-1348, Belgium.  ")
  #line-at(72.024pt, 238.46pt, "Abstract. ")
  #line-at(72.024pt, 263.45pt, "Prussian blue analogues (PBAs) and related organic materials continue to emerge as ")
  #line-at(72.024pt, 280.37pt, "promising platforms for next-generation memory and energy-storage technologies due to ")
  #line-at(72.024pt, 297.41pt, "their rich redox chemistry, ionic mobility, and compatibility with low-cost, scalable ")
  #line-at(72.024pt, 314.33pt, "fabrication methods. Across the collected studies, electrodeposited Prussian Blue (PB) ")
  #line-at(72.024pt, 331.25pt, "and Prussian White (PW) thin films consistently exhibit robust resistive switching (RS) ")
  #line-at(72.024pt, 348.29pt, "with ON/OFF ratios from one to three orders of magnitude, operating in both bipolar and ")
  #line-at(72.024pt, 365.21pt, "unipolar modes. Structural and spectroscopic analyses confirm that these films display ")
  #line-at(72.024pt, 382.25pt, "homogeneous composition, well-defined grain boundaries, and ionic pathways that ")
  #line-at(72.024pt, 399.17pt, "enable filamentary conduction. The switching mechanisms identified through I–V ")
  #line-at(72.024pt, 416.09pt, "analysis, electrochemical impedance spectroscopy, and quantum transport modeling ")
  #line-at(72.024pt, 433.13pt, "are governed by ohmic or space-charge-limited conduction, where potassium-ion ")
  #line-at(72.024pt, 450.07pt, "migration and reversible redox processes drive filament formation and rupture. ")
  #line-at(72.024pt, 467.11pt, "Furthermore, PB-based devices demonstrate conductance quantization with discrete ")
  #line-at(72.024pt, 484.03pt, "current steps corresponding to integer and half-integer multiples of G₀, indicating ")
  #line-at(72.024pt, 500.95pt, "ballistic electron transport through atomic-scale channels. Complementary work on ")
  #line-at(72.024pt, 517.99pt, "perylene-based columnar liquid crystals shows stable, reversible switching enabled by ")
  #line-at(72.024pt, 534.91pt, "trap-controlled SCLC processes, further broadening the landscape of organic memory ")
  #line-at(72.024pt, 551.95pt, "materials. Finally, FeHCF/graphene oxide electrodes highlight the versatility of PB ")
  #line-at(72.024pt, 568.87pt, "analogues in high-voltage symmetric supercapacitors with excellent cycling stability. ")
  #line-at(72.024pt, 585.79pt, "Collectively, these studies underscore the multifunctionality, scalability, and tunability of ")
  #line-at(72.024pt, 602.83pt, "PBAs and related systems, positioning them as strong candidates for future ReRAM, ")
  #line-at(72.024pt, 619.78pt, "neuromorphic computing, multilevel memory, cryptographic hardware, and high-")
  #line-at(72.024pt, 636.82pt, "performance energy-storage applications. ")
  #line-at(72.024pt, 661.78pt, "Keywords: Prussian Blue Analogues; Memristive Devices; Resistive Switching;  ")
  #line-at(72.024pt, 678.7pt, "Conductance Quantization; Ionic Filament Formation; Mixed-Valence Compounds; ")
  #line-at(72.024pt, 695.62pt, "Redox-Active Dielectrics   ")
  #line-at(72.024pt, 745.656pt, "Corresponding author email: lindiomar.borges@uclouvain.be ")
]

