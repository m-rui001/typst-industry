  #line-at(253.73pt, 316.97pt, " is generally signed, whereas one would expect only a ")
  #line-at(70.944pt, 331.85pt, "single (positive) sign from physical information (requirement 9). This bis reminiscent of the ")
  #line-at(70.944pt, 346.73pt, "interplay between (signed) particle velocity and the associated (always positive) kinetic energy, ")
