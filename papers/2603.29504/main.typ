  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(166.22pt, 225.86pt, " in general. Unlike the constant ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.13pt, 225.86pt, "𝐴")
  #set text(font: "Cambria Math", size: 8.52pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.71pt, 228.5pt, "0")
  #line-at(332.59pt, 221.3pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(338.11pt, 225.86pt, ", this expression represents a spatially ")
  #line-at(70.944pt, 241.82pt, "and temporally dependent normalizing quantity that also changes the nature of the information ")
  #line-at(70.944pt, 257.18pt, "itself. The latter can then be interpreted as a ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(286.97pt, 257.18pt, "relative")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(323.45pt, 257.18pt, " change in the measured quantity ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(486.7pt, 257.18pt, "∆𝑀𝑀")
  #line-at(504.34pt, 256.7pt, "⁄")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(521.5pt, 257.18pt, ", ")
  #line-at(70.944pt, 272.18pt, "which is related again to a relative parameter change ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(326.57pt, 272.18pt, "∆𝑃")
