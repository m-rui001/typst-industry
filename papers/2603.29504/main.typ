#original-page(595.32pt, 841.92pt, (image("graphics/page-14.png", width: 451.5pt), 71pt, 268.5pt))[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(292.13pt, 790.176pt, "14 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.944pt, 82.08pt, "Our difference wave fields do not currently fulfill all four new requirements. Let us first turn to ")
  #line-at(70.944pt, 96.98pt, "requirement 8. ")
