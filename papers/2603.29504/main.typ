  #line-at(70.944pt, 164.9pt, "In passive measurements (right-hand side of Figure 26), the energy of the excitation signal is ")
  #line-at(70.944pt, 179.78pt, "either unknown (as in acoustic emission testing) or no excitation is present at all. In both cases, ")
  #line-at(70.944pt, 194.78pt, "the energy of the excitation signal is therefore unsuitable as a normalizing quantity. Instead, the ")
  #line-at(70.944pt, 209.66pt, "only plausible alternative is the square of the measured quantity before the parameter change, ")
  #line-at(70.944pt, 225.86pt, "i.e., ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(92.544pt, 225.86pt, "𝑀")
  #set text(font: "Cambria Math", size: 8.52pt, weight: "regular", style: "normal", fill: rgb("#000000"))
