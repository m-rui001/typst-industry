  #line-at(70.944pt, 222.5pt, "For reasons of symmetry with the original model, we work with both variations and denote ")
  #line-at(70.944pt, 237.74pt, "them as ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
