  #line-at(152.06pt, 654.07pt, "𝑡=")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(169.34pt, 654.07pt, " 12.08 µs). The majority of information is thus carried by the forward wave ")
