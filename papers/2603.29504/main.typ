  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.944pt, 539.59pt, "We first address requirement 1 from Section 2 and consider how we can separately investigate ")
  #line-at(70.944pt, 554.47pt, "the effects of the various structural system parameters on the scattered wave field. In practice, ")
  #line-at(70.944pt, 569.47pt, "a single simulation is usually insufficient; instead, several calculations with varying parameters ")
