  #line-at(414.31pt, 298.88pt, "-3")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(419.45pt, 301.88pt, " fL),  the chemical reaction can be ")
  #line-at(303.64pt, 313.88pt, "monitored only using a highly localized label free spectroscopy. ")
  #line-at(303.64pt, 325.88pt, "In particular, Surface Enhanced Raman Spectroscopy (SERS) ")
  #line-at(303.64pt, 337.88pt, "represents a valuable technique where the electromagnetic ")
  #line-at(303.64pt, 349.9pt, "field can be squeezed in the nanopore volume thanks to a ")
  #line-at(303.64pt, 361.9pt, "proper design of a plasmonic nanopore")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(463.19pt, 358.9pt, "4,19")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(474.76pt, 361.9pt, ".  Therefore, in this ")
  #line-at(303.64pt, 373.9pt, "work we replaced the Si")
