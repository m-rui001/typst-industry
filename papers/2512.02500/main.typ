  #line-at(369.26pt, 396.21pt, ", clearly corresponding to the vibration of the ")
  #line-at(303.64pt, 408.21pt, "phosphate group")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(366.69pt, 405.21pt, "34,35")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(381.29pt, 408.21pt, ". A minor broad peak at around 1600 cm")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(533.52pt, 405.21pt, "-1")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(538.24pt, 408.21pt, " can ")
  #line-at(303.64pt, 420.21pt, "be also detected, as expected, to be associated with with the H-O-")
  #line-at(303.64pt, 432.21pt, "H bending")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(343.95pt, 429.21pt, "33,36")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
