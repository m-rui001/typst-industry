  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(398pt, 261.14pt, "-1")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(403.14pt, 264.14pt, " appeared. This can be associated with ")
  #line-at(303.64pt, 276.14pt, "the H-O-H bending vibration of the water of crystallization")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(534.38pt, 273.14pt, "33")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(540.81pt, 276.14pt, ". In ")
  #line-at(303.64pt, 288.14pt, "the nanopore system we are not dealing with salts powders, but ")
  #line-at(303.64pt, 300.16pt, "we are interested to monitor the precipitation and dissolution ")
  #line-at(303.64pt, 312.16pt, "processes driven by the external applied electrical potential. ")
  #line-at(303.64pt, 324.16pt, "Therefore we also collected the Raman signatures of the ")
  #line-at(303.64pt, 336.16pt, "precipitated salts as reported in eq. (1). To do that, we mixed ")
  #line-at(303.64pt, 348.19pt, "the compounds using the same concentrations and pH ")
  #line-at(303.64pt, 360.19pt, "conditions used in the nanopore experiments and after letting ")
  #line-at(303.64pt, 372.19pt, "them dry we collected the spectra. In both the cases (Ca₃(PO₄)₂ ")
  #line-at(303.64pt, 384.19pt, "and Mn₃(PO₄)₂), we can observe the presence of a main peak at ")
  #line-at(303.64pt, 396.21pt, "around 960 cm")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(364.55pt, 393.21pt, "-1")
