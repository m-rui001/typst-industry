  #line-at(42.452pt, 698.07pt, "systems")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(74.19pt, 695.07pt, "16–18")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(90.5pt, 698.07pt, ". ")
  #line-at(56.619pt, 710.09pt, "To improve our understanding on the demonstrated “in-")
  #line-at(42.452pt, 722.09pt, "pore chemistry”, here we investigated the chemical reaction ")
  #line-at(42.452pt, 734.09pt, "inside the nanopore using optical spectroscopy. Considering ")
  #line-at(42.452pt, 746.092pt, "that the reaction takes place in a very small volume (with ")
  #line-at(303.64pt, 289.85pt, "nanopore’s diameter of 200 nm and thickeness of 50 nm, the ")
  #line-at(303.64pt, 301.88pt, "volume is of the order of 10")
