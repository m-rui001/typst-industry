  #line-at(253.48pt, 482.83pt, "4")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(256.9pt, 481.97pt, "- or SiO₂-")
  #line-at(42.452pt, 493.97pt, "based nanopores")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(113.21pt, 490.97pt, "13,14")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(128.24pt, 493.97pt, ". In this context, a novel strategy for ")
  #line-at(42.452pt, 505.97pt, "fabricating ")
  #line-at(95.921pt, 505.97pt, "solid-state ")
  #line-at(148.768pt, 505.97pt, "nanopores ")
  #line-at(202.669pt, 505.97pt, "exhibiting ")
  #line-at(252.754pt, 505.97pt, "diode-like ")
  #line-at(42.452pt, 517.97pt, "properties, characterized by exceptionally high ion current ")
  #line-at(42.452pt, 530pt, "rectification (ICR)")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.52pt, 527pt, "15")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(120.95pt, 530pt, ", has been recently demonstrated. This ")
  #line-at(42.452pt, 542pt, "method relies on the so-called “in-pore chemistry,” where two ")
  #line-at(42.452pt, 554pt, "solutions interact at the interface between the Cis and Trans ")
  #line-at(42.452pt, 566pt, "reservoirs of the nanopore chamber—an interface effectively ")
  #line-at(42.452pt, 578.02pt, "defined by the nanopore volume itself. In particular, this can be ")
  #line-at(42.452pt, 590.02pt, "possible by using a thin Si")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.81pt, 590.88pt, "3")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(148.83pt, 590.02pt, "N")
  #set text(font: "Calibri", size: 6pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(155.26pt, 590.88pt, "4")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(158.26pt, 590.02pt, " membrane including a nanopore ")
  #line-at(42.452pt, 602.02pt, "connecting two distinct ionic reactant solutions for precise ")
  #line-at(42.452pt, 614.02pt, "confinement of the ion electromigration. These ions are capable ")
  #line-at(42.452pt, 626.04pt, "of ")
  #line-at(64.286pt, 626.04pt, "inducing ")
  #line-at(112.202pt, 626.04pt, "electrically ")
  #line-at(168.245pt, 626.04pt, "tunable ")
  #line-at(212.759pt, 626.04pt, "metal ")
  #line-at(249.569pt, 626.04pt, "phosphate ")
  #line-at(42.452pt, 638.04pt, "precipitation/dissolution in the pore. This can be applied to the ")
  #line-at(42.452pt, 650.04pt, "preparation of advanced nanofluidic devices including diodes ")
  #line-at(42.452pt, 662.04pt, "and memristors, where the use of easy-to-fabricate large pore ")
