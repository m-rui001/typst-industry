  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(474.34pt, 651.34pt, ", the key ")
  #line-at(72.024pt, 674.38pt, "parameter governing the magneto-Leidenfrost effect, with predictions in close agreement ")
