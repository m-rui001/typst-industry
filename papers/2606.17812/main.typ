  #line-at(359.11pt, 165.38pt, " in the range of 150 °C to 225 °C ")
  #line-at(72.024pt, 188.3pt, "were maintained using a precision, digitized plate-heater (Holmarc Opto-Mechatronics Ltd., ")
  #line-at(72.024pt, 209.06pt, "India), with an accuracy of ± 2 °C and integrated T-type thermocouple based control. The ")
  #line-at(72.024pt, 229.7pt, "magnetic field was generated between the horizontal poles of an electromagnet (Holmarc ")
  #line-at(72.024pt, 250.46pt, "Opto-Mechatronics Ltd., India) by supplying current from a DC power source. A GaAs ")
