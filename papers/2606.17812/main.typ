#original-page(595.32pt, 841.92pt, (image("graphics/page-02.png", width: 12pt), 183.5pt, 75.5pt))[
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.89pt, 790.2pt, "2 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 83.78pt, "rebound, and predicts ")
