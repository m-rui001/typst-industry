  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(373.51pt, 469.03pt, "), ferrofluid droplets exhibit a ")
  #line-at(72.024pt, 492.07pt, "fragmenting Leidenfrost behaviour characterized by vigorous boiling, lamella rupture, and ")
