  #line-at(286.521pt, 311.542pt, "BSTRACT")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.032pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 333.77pt, "Physics-informed neural networks (PINNs) and neural operators (NOs) for solving the problem of")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.062pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 344.679pt, "diffraction of Extreme Ultraviolet (EUV) electromagnetic waves from contemporary lithography")
  #line-at(107.866pt, 355.588pt, "masks are presented.")
  #line-at(197.809pt, 355.588pt, "A novel hybrid Waveguide Neural Operator (WGNO) is introduced,")
  #line-at(480.999pt, 355.588pt, "based")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.037pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 366.497pt, "on a waveguide method with its most computationally expensive components replaced by a neural")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.878pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 377.406pt, "network.")
  #line-at(145.423pt, 377.406pt, "To evaluate performance, the accuracy and inference time of PINNs and NOs are compared")
  #line-at(107.866pt, 388.315pt, "against modern numerical solvers for a series of problems with known exact solutions.")
  #line-at(449.973pt, 388.315pt, "The emphasis")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.862pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 399.224pt, "is placed on investigation of solution accuracy by considered artificial neural systems for 13.5 nm and")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.903pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.118pt, 410.133pt, "11.2 nm wavelengths.")
  #line-at(196.198pt, 410.133pt, "Numerical experiments on realistic 2D and 3D masks demonstrate that PINNs")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.862pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 421.043pt, "and neural operators achieve competitive accuracy and significantly reduced prediction times, with the")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.973pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 431.952pt, "proposed WGNO architecture reaching state-of-the-art performance.")
  #line-at(384.831pt, 431.952pt, "The presented neural operator")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.062pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 442.861pt, "has pronounced generalizing properties, meaning that for unseen problem parameters it delivers a")
  #line-at(107.866pt, 453.77pt, "solution accuracy close to that for parameters seen in the training dataset.")
  #line-at(410.069pt, 453.77pt, "These results provide a")
  #set text(font: "NimbusRomNo9L-Regu", size: 10.012pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 464.679pt, "highly efficient solution for accelerating the design and optimization workflows of next-generation")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.963pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(107.866pt, 475.588pt, "lithography masks.")
  #set text(font: "NimbusRomNo9L-MediItal", size: 9.862pt, weight: "bold", style: "italic", fill: rgb("#000000"))
