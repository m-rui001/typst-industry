  #line-at(71.691pt, 263.409pt, "The Finite Element Method is a powerful and general numerical technique for solving partial differential equations.")
  #set text(font: "NimbusRomNo9L-Regu", size: 9.903pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(71.691pt, 274.318pt, "The core principle of FEM involves discretizing the computational domain into a mesh of smaller, simpler subdomains")
