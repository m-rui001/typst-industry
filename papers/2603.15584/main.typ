  #line-at(72pt, 307.045pt, "to obtain the approximate solution across the entire domain.")
  #line-at(320.488pt, 307.045pt, "While robust, FEM can be computationally expensive")
  #line-at(72pt, 317.954pt, "for problems like EUV diffraction, which require very fine meshes to resolve the small wavelength features.")
  #line-at(515.514pt, 317.954pt, "In our")
