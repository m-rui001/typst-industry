#align(center)[
  #text(size: 15pt, weight: "bold")[Injection dynamics in spin-wave active ring oscillator (SWARO)]
  #v(6pt)
  Anirban Mukhopadhyay#super[1], Ihor I. Syvorotka#super[2,3], and Anil Prabhakar#super[1] \
  #text(size: 8pt)[
    #super[1] Department of Electrical Engineering, Indian Institute of Technology, Chennai 600036, India. \
