  #line-at(70.824pt, 226.97pt, "generality and robustness of the analytical treatment. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 268.37pt, "Relating ionic relaxation to hysteresis")
