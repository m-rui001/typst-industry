  #line-at(70.824pt, 524.71pt, "Conclusions ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 545.5pt, "In this work, we developed an analytical framework that links the frequency-dependent ")
  #line-at(70.824pt, 566.14pt, "capacitance response of perovskite solar cells directly to ionic transport properties through ionic ")
  #line-at(70.824pt, 586.9pt, "dielectric relaxation. The model demonstrates that the transition from low-frequency depletion ")
  #line-at(70.824pt, 607.54pt, "capacitance to high-frequency geometric capacitance is governed by the characteristic ionic ")
  #line-at(70.824pt, 628.3pt, "relaxation time, providing a straightforward route for determining ion mobility from ")
  #line-at(70.824pt, 648.94pt, "experimentally accessible ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(207.53pt, 648.94pt, "C–f")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(224.93pt, 648.94pt, " measurements when the ion density is known. Unlike ")
  #line-at(70.824pt, 669.7pt, "conventional approaches that often require complex transient techniques or extensive numerical ")
  #line-at(70.824pt, 690.36pt, "fitting, the proposed method offers a physically transparent and computationally efficient ")
  #line-at(70.824pt, 711.12pt, "alternative. The analytical description was validated through self-consistent drift–diffusion ")
  #line-at(70.824pt, 731.76pt, "simulations over wide ranges of ion density and ion mobility. The framework was further ")
  #line-at(70.824pt, 752.52pt, "extended to device architectures containing thick, doped transport layers, revealing the ")
]

