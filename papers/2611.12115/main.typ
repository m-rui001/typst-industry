#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(518.16pt, 788.64pt, "3 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.98pt, "numerical simulations, or interpretation of transient responses using multiple assumptions ")
  #line-at(70.824pt, 102.74pt, "regarding dielectric properties, interfacial charge accumulation, recombination pathways, and ")
  #line-at(70.824pt, 123.38pt, "transport mechanisms  [29–31,17,32,33]. As a consequence, reported ion mobility values ")
  #line-at(70.824pt, 144.14pt, "frequently vary by ")
  #line-at(191.352pt, 144.14pt, "several orders of magnitude even for similar perovskite ")
  #line-at(70.824pt, 164.78pt, "compositions  [13,21,34]. Recent studies have emphasized that interpretation of frequency-")
  #line-at(70.824pt, 185.54pt, "domain measurements requires careful separation of ionic, electronic, and recombination-")
  #line-at(70.824pt, 206.18pt, "related contributions, further complicating the quantitative extraction of ionic transport ")
  #line-at(70.824pt, 226.97pt, "parameters  [19,20]. Although ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(220.97pt, 226.97pt, "C–f")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(238.37pt, 226.97pt, " measurements are widely used to probe ionic dynamics, a ")
  #line-at(70.824pt, 247.61pt, "simple analytical relationship directly connecting measurable capacitance transitions to ion ")
  #line-at(70.824pt, 268.37pt, "transport is still lacking. ")
  #line-at(70.824pt, 289.01pt, "In this work, we develop an analytical dielectric-relaxation framework that establishes a direct ")
  #line-at(70.824pt, 309.77pt, "relationship between capacitance–frequency characteristics and ionic transport properties in ")
  #line-at(70.824pt, 330.41pt, "perovskite solar cells. The model describes the transition from ion-screened depletion ")
  #line-at(70.824pt, 351.17pt, "capacitance at low frequencies to geometric capacitance at high frequencies and demonstrates ")
  #line-at(70.824pt, 371.81pt, "that the characteristic transition frequency provides a direct measure of the dielectric relaxation ")
  #line-at(70.824pt, 392.59pt, "time for ions, from which the ion mobility can be estimated when the ion density is known. ")
  #line-at(70.824pt, 413.23pt, "Self-consistent drift–diffusion simulations are used to validate the analytical predictions over ")
  #line-at(70.824pt, 433.99pt, "broad ranges of ion density and mobility in the perovskite layer, and transport-layer ")
  #line-at(70.824pt, 454.63pt, "conductivity. Crucially, we demonstrate that the same dielectric-relaxation process governing ")
  #line-at(70.824pt, 475.39pt, "frequency-dependent capacitance also determines the scan-rate dependence of ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(452.14pt, 475.39pt, "J–V")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(470.74pt, 475.39pt, " hysteresis, ")
  #line-at(70.824pt, 496.03pt, "enabling prediction of the scan-rate window corresponding to maximum hysteresis. Finally, ")
  #line-at(70.824pt, 516.79pt, "temperature-dependent ")
  #line-at(209.744pt, 516.79pt, "capacitance ")
  #line-at(293.936pt, 516.79pt, "and ")
  #line-at(339.632pt, 516.79pt, "hysteresis ")
  #line-at(415.316pt, 516.79pt, "measurements ")
  #line-at(512.144pt, 516.79pt, "on ")
  #line-at(70.824pt, 537.46pt, "NiOx/SAM/perovskite/C60 devices provide experimental validation of the proposed ")
  #line-at(70.824pt, 558.22pt, "framework. The resulting model offers an analytic, physically transparent, and experimentally ")
  #line-at(70.824pt, 578.86pt, "accessible route for extracting ionic transport parameters and understanding ion-induced ")
  #line-at(70.824pt, 599.62pt, "dynamic phenomena in perovskite solar cells. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 641.02pt, "Theoretical framework of the capacitance  ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 661.66pt, "The frequency-dependent response of perovskite solar cells is fundamentally governed by the ")
  #line-at(70.824pt, 682.3pt, "coexistence of fast electronic transport and comparatively slow ionic migration. Electronic ")
  #line-at(70.824pt, 703.08pt, "carriers typically respond to electrical perturbations on timescales ranging from picoseconds to ")
  #line-at(70.824pt, 723.72pt, "microseconds and therefore rapidly establish local electrostatic equilibrium. In contrast, mobile ")
  #line-at(70.824pt, 744.48pt, "ionic defects redistribute much more slowly [7,35] and may require milliseconds to seconds to ")
  #line-at(70.824pt, 765.12pt, "reach equilibrium, depending on ion mobility, defect concentration, and electric-field strength. ")
]

