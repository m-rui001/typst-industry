#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(518.16pt, 788.64pt, "2 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.98pt, "future commercialization  [2–4]. In addition to their excellent electronic properties, however, ")
  #line-at(70.824pt, 102.74pt, "metal-halide perovskites exhibit a unique mixed ionic–electronic character, where both ")
  #line-at(70.824pt, 123.38pt, "electronic charge carriers and mobile ionic defects contribute to the electrical response of the ")
  #line-at(70.824pt, 144.14pt, "device  [5–7]. ")
  #line-at(70.824pt, 164.78pt, "Unlike in conventional semiconductors, mobile ionic species in perovskite materials can ")
  #line-at(70.824pt, 185.54pt, "redistribute under an applied electric field and dynamically modify the internal electrostatic ")
  #line-at(70.824pt, 206.18pt, "potential landscape. This ionic redistribution influences the potential landscape and thereby ")
  #line-at(70.824pt, 226.97pt, "charge-carrier transport, interfacial charge accumulation, and recombination processes, ")
  #line-at(70.824pt, 247.61pt, "resulting in a variety of time-dependent phenomena including current–voltage hysteresis, ")
  #line-at(70.824pt, 268.37pt, "transient responses, dielectric relaxation, and operational instability  [8–12]. Ion migration is a ")
  #line-at(70.824pt, 289.01pt, "fundamental transport process governing the dynamic behavior of perovskite based devices ")
  #line-at(70.824pt, 309.77pt, "across a broad range of timescales  [10,13,14]. ")
  #line-at(70.824pt, 330.41pt, "Among the various manifestations of ionic transport, current–voltage ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(406.3pt, 330.41pt, "(J–V")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(429.1pt, 330.41pt, ") hysteresis remains ")
  #line-at(70.824pt, 351.17pt, "one of the most extensively studied phenomena in PSCs. Hysteresis arises because ionic ")
  #line-at(70.824pt, 371.81pt, "redistribution occurs on timescales comparable to those of the electrical measurements, causing ")
  #line-at(70.824pt, 392.59pt, "the internal electric field to lag behind changes in the externally applied bias ")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(438.7pt, 388.03pt, "7,8,14,15")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.82pt, 392.59pt, ". Numerous ")
  #line-at(70.824pt, 413.23pt, "experimental and theoretical studies have shown that the magnitude and position of hysteresis ")
  #line-at(70.824pt, 433.99pt, "strongly ")
  #line-at(127.332pt, 433.99pt, "depend ")
  #line-at(179.04pt, 433.99pt, "on ")
  #line-at(208.188pt, 433.99pt, "ion ")
  #line-at(240.696pt, 433.99pt, "migration, ")
  #line-at(307.38pt, 433.99pt, "measurement ")
  #line-at(388.368pt, 433.99pt, "conditions, ")
  #line-at(458.652pt, 433.99pt, "and ")
  #line-at(493.08pt, 433.99pt, "device ")
  #line-at(70.824pt, 454.63pt, "architecture  [17,11,18,19]. At the same time, ion migration also affects capacitance ")
  #line-at(70.824pt, 475.39pt, "measurements by inducing space-charge formation that become particularly pronounced at low ")
  #line-at(70.824pt, 496.03pt, "frequencies  [20–23]. Consequently, both frequency-dependent capacitance and hysteresis can ")
  #line-at(70.824pt, 516.79pt, "be viewed as different manifestations of the same underlying ionic dynamics. ")
  #line-at(70.824pt, 537.46pt, "Accurate determination of ionic transport parameters, particularly ion density and ion mobility, ")
  #line-at(70.824pt, 558.22pt, "is therefore essential for understanding device operation, predicting dynamic behavior, and ")
  #line-at(70.824pt, 578.86pt, "improving long-term stability. Several approaches have been developed to characterize ionic ")
  #line-at(70.824pt, 599.62pt, "transport in perovskite semiconductors, including transient ion-drift measurements, transient ")
  #line-at(70.824pt, 620.26pt, "photocurrent and photovoltage techniques, charge extraction methods, impedance ")
  #line-at(70.824pt, 641.02pt, "spectroscopy, ")
  #line-at(162.6pt, 641.02pt, "capacitance ")
  #line-at(244.644pt, 641.02pt, "spectroscopy, ")
  #line-at(336.636pt, 641.02pt, "and ")
  #line-at(380.064pt, 641.02pt, "numerical ")
  #line-at(454.308pt, 641.02pt, "drift–diffusion ")
  #line-at(70.824pt, 661.66pt, "simulations  [24,25,18,26]. Among these methods, electrochemical impedance spectroscopy ")
  #line-at(70.824pt, 682.3pt, "and capacitance-frequency (")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(209.09pt, 682.3pt, "C–f")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(226.49pt, 682.3pt, ") measurements have become particularly attractive because ")
  #line-at(70.824pt, 703.08pt, "they are experimentally accessible and provide direct information about relaxation processes ")
  #line-at(70.824pt, 723.72pt, "occurring over a wide range of timescales  [11,20,27,28]. ")
  #line-at(70.824pt, 744.48pt, "Despite considerable progress, reliable extraction of ionic transport parameters remains ")
  #line-at(70.824pt, 765.12pt, "challenging. Existing approaches often require equivalent-circuit fitting procedures, extensive ")
]

