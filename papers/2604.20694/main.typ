  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(510.94pt, 515.95pt, " across all in-")
  #line-at(313.25pt, 527.47pt, "plane orientations, with the extracted range reduced to ")
  #line-at(313.25pt, 538.99pt, "approximately −0.4 to −0.04 MPa/nm, compared to −0.8 to ")
  #line-at(313.25pt, 550.39pt, "0.34 MPa/nm for the single-layer counterpart. Notably, ")
  #line-at(313.25pt, 561.91pt, "although the bilayer has a total thickness of 200 nm, a single-")
  #line-at(313.25pt, 573.43pt, "layer film of this thickness would be expected to exhibit a ")
  #line-at(313.25pt, 584.95pt, "larger σ₁ based on the observed thickness-dependent trend, in ")
