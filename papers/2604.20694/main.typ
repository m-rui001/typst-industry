  #line-at(451.933pt, 619.06pt, "the ")
  #line-at(474.951pt, 619.06pt, "corresponding ")
  #line-at(542.908pt, 619.06pt, "stress ")
  #line-at(313.25pt, 631.18pt, "components can be extracted quantitatively for cantilevers ")
  #line-at(313.25pt, 643.3pt, "following the stress–curvature calibration described in [34]. ")
  #set text(font: "Cambria Math", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
