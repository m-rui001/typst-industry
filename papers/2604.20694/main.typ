  #line-at(452.95pt, 268.73pt, " corresponds to the bottom ")
  #line-at(313.25pt, 280.97pt, "surface. With this truncation, the stress can be separated into a ")
  #line-at(313.25pt, 293.09pt, "uniform (mean) component σ₀ and a linear gradient ")
  #line-at(313.25pt, 305.09pt, "component σ₁. The σ₀ component is symmetric about the mid-")
  #line-at(313.25pt, 317.21pt, "plane, while σ₁ represents a stress gradient in the thickness ")
  #line-at(313.25pt, 329.33pt, "direction. In typical thin-film-on-substrate systems, σ₀ is ")
  #line-at(313.25pt, 341.33pt, "commonly associated with the coefficient of thermal ")
  #line-at(313.25pt, 353.45pt, "expansion (CTE) mismatch between the film and the substrate ")
  #line-at(313.25pt, 365.45pt, "[28], [29], whereas σ₁ reflects depth-dependent effects such as ")
  #line-at(313.25pt, 377.57pt, "ion-implantation ")
  #line-at(391.202pt, 377.57pt, "damage, ")
  #line-at(435.803pt, 377.57pt, "bonding-induced ")
  #line-at(514.958pt, 377.57pt, "defects, ")
  #line-at(556.8pt, 377.57pt, "or ")
  #line-at(313.25pt, 389.69pt, "differential relaxation during chemical-mechanical polishing ")
  #line-at(313.25pt, 401.69pt, "(CMP) [30], as well as interface-driven stress gradients in ")
  #line-at(313.25pt, 413.81pt, "multilayer or heterogeneous structures [31]. In addition to ")
  #line-at(313.25pt, 425.83pt, "these factors, σ₁ can also arise from non-uniform thermal ")
  #line-at(313.25pt, 437.95pt, "strain across the film thickness, driven by anisotropic thermal ")
  #line-at(313.25pt, 450.07pt, "expansion in LN [32] during cooldown and the resulting ")
  #line-at(313.25pt, 462.07pt, "differential stress relaxation between the top and bottom of the ")
  #line-at(313.25pt, 474.19pt, "film. ")
  #line-at(323.33pt, 486.31pt, "To experimentally distinguish these two contributions, we ")
  #line-at(313.25pt, 498.31pt, "adopt the cantilever-based methodology in [33], which ")
  #line-at(313.25pt, 510.43pt, "decomposes the out-of-plane deflection profile of released ")
  #line-at(313.25pt, 522.43pt, "beams into σ₀ and σ₁ components, as shown in Fig. 2(a)")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#ff0000"))
  #line-at(536.98pt, 522.43pt, ".")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(539.5pt, 522.43pt, " Finite ")
  #line-at(313.25pt, 534.55pt, "element analysis (FEA), shown in Fig. 2(b), further illustrates ")
  #line-at(313.25pt, 546.67pt, "how positive and negative σ₀ and σ₁ produce distinct ")
  #line-at(313.25pt, 558.67pt, "deformation signatures. In particular, a positive σ₁ results in a ")
  #line-at(313.25pt, 570.79pt, "concave-up beam profile, while a negative σ₁ leads to a ")
  #line-at(313.25pt, 582.79pt, "concave-down curvature. In contrast, σ₀ primarily introduces a ")
  #line-at(313.25pt, 594.94pt, "rigid-body rotation of the cantilever, where a positive σ₀ ")
  #line-at(313.25pt, 607.06pt, "causes upward rotation near the fixed end, and vice versa. ")
  #line-at(313.25pt, 619.06pt, "Based ")
  #line-at(348.508pt, 619.06pt, "on ")
  #line-at(369.474pt, 619.06pt, "this ")
