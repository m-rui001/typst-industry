  #line-at(497.181pt, 423.91pt, "imaging, ")
  #line-at(544.65pt, 423.91pt, "SEM ")
  #line-at(313.25pt, 435.43pt, "observation, and profilometry-based curvature fitting [Fig. 6 ")
  #line-at(313.25pt, 446.95pt, "(b)–(e)]. These measurements enable direct extraction of the ")
  #line-at(313.25pt, 458.47pt, "normalized σ₁ in the bilayer system, allowing for a consistent ")
  #line-at(313.25pt, 469.99pt, "comparison with the single-layer results presented in Section ")
  #line-at(313.25pt, 481.39pt, "IV. ")
  #line-at(320.45pt, 492.91pt, "Fig. 7 compares the stress behavior between a 220 nm ")
