keywords = {free-surface flow,meshfree method,multiphase flow,particle method,smoothed particle hydrodynamics (SPH)},
month = {feb},
number = {3},
pages = {37001},
publisher = {IOP Publishing},
title = {{Smoothed particle hydrodynamics for free-surface and multiphase flows: a review}},
