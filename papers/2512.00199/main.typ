  #line-at(337.99pt, 573.55pt, "π")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(345.43pt, 573.55pt, " [9,11].  This phase shift leads to the ")
  #line-at(72.024pt, 592.63pt, "destructive interference and associated suppression of the spin waves’ stray field behind the ")
  #line-at(72.024pt, 611.59pt, "disk.  As the frequency increases to 2.08 GHz (Fig. 3 (f)), the strength of the resonant ")
  #line-at(72.024pt, 630.58pt, "scattering is reduced and the phase shift deviates from ")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(347.83pt, 630.58pt, "π")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(355.15pt, 630.58pt, ", weakening the field suppression.  ")
