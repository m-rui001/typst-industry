  #line-at(72.024pt, 728.02pt, "the secondary frequency shift exceeds ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(265.85pt, 728.02pt, "100 MHz")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.09pt, 728.02pt, " (Fig. 4 (b) and (e)), being especially strong ")
  #line-at(72.024pt, 747.216pt, "along the caustic beams, another consequence of the anisotropic spin-wave dispersion ")
  #line-at(72.024pt, 766.296pt, "[29,30].  At the highest excitation amplitude (Fig. 4 (c) and (f)), the scattered wave is strong ")
