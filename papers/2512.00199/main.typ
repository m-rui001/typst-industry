  #line-at(72.024pt, 459.43pt, "and 2.08 GHz (Fig. 3 (f)).  In contrast to the reference simulations, we see a stark difference ")
  #line-at(72.024pt, 478.51pt, "between the patterns obtained for the two frequencies behind the disk within the ")
  #set text(font: "Cambria Math", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(479.02pt, 478.51pt, "60°")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
