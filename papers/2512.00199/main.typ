#original-page(595.32pt, 841.92pt, (image("graphics/page-11.png", width: 144.5pt), 72pt, 414pt))[
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(291.53pt, 790.056pt, "11 ")
  #line-at(100.34pt, 82.32pt, "In summary, we have used micromagnetic simulations to demonstrate a two-")
  #line-at(72.024pt, 101.3pt, "dimensional chiral magnonic resonator as a magnonic neuron.  Its functionality is based on ")
  #line-at(72.024pt, 120.26pt, "the nonlinear resonant scattering of propagating spin waves from the edge spin-wave mode ")
  #line-at(72.024pt, 139.22pt, "confined in a permalloy disk located above a low-damping YIG magnonic medium.  Depending ")
  #line-at(72.024pt, 158.18pt, "on the frequency and amplitude of the incident spin waves, we observe complex patterns of ")
  #line-at(72.024pt, 177.26pt, "the scattered waves and show that their dynamic dipolar field could be strong enough to ")
  #line-at(72.024pt, 196.22pt, "activate hypothetical magnonic neurons in the next layer of the network.  Our results therefore ")
  #line-at(72.024pt, 215.18pt, "suggest that the proposed magnonic neurons could serve as viable building blocks of future ")
  #line-at(72.024pt, 234.14pt, "2D artificial neural networks.  ")
  #line-at(100.34pt, 259.1pt, "The research leading to these results has received funding from the UK Research and ")
  #line-at(72.024pt, 278.09pt, "Innovation (UKRI) under the UK government’s Horizon Europe funding guarantee (Grant No. ")
  #line-at(72.024pt, 297.05pt, "10039217) as part of the Horizon Europe (HORIZON-CL4-2021-DIGITAL-EMERGING-01) ")
  #line-at(72.024pt, 316.01pt, "under Grant Agreement No. 101070347 (MANNGA project). Co-funded by the European ")
  #line-at(72.024pt, 334.97pt, "Union. Views and opinions expressed are however those of the authors only and do not ")
  #line-at(72.024pt, 354.05pt, "necessarily reflect those of the European Union or the European Health and Digital Executive ")
  #line-at(72.024pt, 373.01pt, "Agency (HADEA). Neither the European Union nor the granting authority can be held ")
  #line-at(72.024pt, 391.97pt, "responsible for them.  ")
  #line-at(72.024pt, 450.19pt, "[1]  ")
