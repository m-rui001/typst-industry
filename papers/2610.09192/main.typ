#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(291.65pt, 779.4pt, "36 ")
  #line-at(90.024pt, 88.58pt, "results in close agreement with normalized Monte Carlo simulations across six ")
  #line-at(90.024pt, 113.06pt, "representative multilayer systems.  ")
  #line-at(114.02pt, 137.42pt, "The resulting framework resolves the long-standing trade-off between ")
  #line-at(90.024pt, 161.9pt, "computational efficiency and statistical fidelity in thermoreflectance uncertainty ")
  #line-at(90.024pt, 186.38pt, "analysis. The analytical route reduces the evaluation time from hours of repeated ")
  #line-at(90.024pt, 210.86pt, "nonlinear optimization to a single Jacobian evaluation, while retaining the accuracy of ")
  #line-at(90.024pt, 235.25pt, "the Monte Carlo benchmark. This efficiency gain stems from identifying the correct ")
  #line-at(90.024pt, 259.73pt, "statistical coordinates in which the inverse problem is locally linear and approximately ")
  #line-at(90.024pt, 284.21pt, "Gaussian. The workflow is expected to apply to any thermoreflectance modality sharing ")
  #line-at(90.024pt, 308.69pt, "the multilayer heat-diffusion kernel of Eq. (2), and provides a template for coordinate ")
  #line-at(90.024pt, 333.05pt, "transformations in other non-Gaussian inverse heat-conduction problems. Extensions ")
  #line-at(90.024pt, 357.53pt, "to non-diffusive transport regimes or Bayesian frameworks with physical priors remain ")
  #line-at(90.024pt, 382.01pt, "promising directions for future work. ")
