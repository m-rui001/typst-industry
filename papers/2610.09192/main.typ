  #line-at(90.024pt, 161.9pt, "each trial requires a complete nonlinear fit. For multilayer models with several coupled ")
  #line-at(90.024pt, 186.38pt, "unknowns, wide frequency ranges, or multiple simultaneously fitted datasets, the ")
