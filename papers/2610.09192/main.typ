#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(294.65pt, 779.4pt, "2 ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(90.024pt, 83.18pt, "1. INTRODUCTION ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(114.02pt, 109.22pt, "Thermoreflectance techniques have become indispensable non-contact tools in ")
  #line-at(90.024pt, 133.7pt, "modern thermal metrology for measuring thermal conductivity, volumetric heat ")
  #line-at(90.024pt, 158.18pt, "capacity, and interfacial thermal conductance in bulk materials, thin films, and ")
  #line-at(90.024pt, 182.66pt, "multilayer ")
  #line-at(153.228pt, 182.66pt, "structures ")
  #line-at(213.89pt, 182.66pt, "[1-4]. ")
  #line-at(254.786pt, 182.66pt, "Representative ")
  #line-at(339.95pt, 182.66pt, "methods ")
  #line-at(394.538pt, 182.66pt, "include ")
  #line-at(443.834pt, 182.66pt, "time-domain ")
  #line-at(90.024pt, 207.02pt, "thermoreflectance (TDTR) [5-9], frequency-domain thermoreflectance (FDTR) [10-")
  #line-at(90.024pt, 231.53pt, "12], steady-state thermoreflectance (SSTR) [13], spatial-domain thermoreflectance ")
  #line-at(90.024pt, 256.01pt, "(SDTR) [14], and the recently developed square-pulsed source thermoreflectance (SPS) ")
  #line-at(90.024pt, 280.49pt, "[15-18]. These methods offer micron-scale spatial resolution, require minimal sample ")
  #line-at(90.024pt, 304.85pt, "material, and apply to a broad range of micro- and nanoscale heat-transport problems.  ")
  #line-at(114.02pt, 329.33pt, "At the same time, thermoreflectance measurements are inherently inverse ")
  #line-at(90.024pt, 353.81pt, "problems: the measured signal must be interpreted through a heat-transfer model to ")
  #line-at(90.024pt, 378.29pt, "infer the underlying thermophysical parameters. In practice, the sensitivities of the ")
  #line-at(90.024pt, 402.67pt, "measured signal to different unknown parameters are often strongly coupled, and some ")
  #line-at(90.024pt, 427.15pt, "parameters may exhibit intrinsically weak sensitivity. Consequently, parameter ")
  #line-at(90.024pt, 451.63pt, "extraction can become ill-conditioned, leading to substantial uncertainties in the fitted ")
  #line-at(90.024pt, 476.11pt, "thermophysical properties. Rigorous uncertainty quantification is therefore essential for ")
  #line-at(90.024pt, 500.47pt, "converting a fitted value into a reliable physical result.  ")
  #line-at(114.02pt, 524.95pt, "Uncertainty evaluation in thermoreflectance experiments is commonly performed ")
  #line-at(90.024pt, 549.46pt, "using either covariance-based analytical propagation via local linearization or Monte ")
  #line-at(90.024pt, 573.94pt, "Carlo (MC) analysis through repeated sampling and nonlinear refitting. In the analytical ")
  #line-at(90.024pt, 598.3pt, "route, early thermoreflectance studies [13, 19, 20] typically propagated the ")
  #line-at(90.024pt, 622.78pt, "uncertainties of individual input parameters through first-order sensitivity coefficients, ")
  #line-at(90.024pt, 647.26pt, "treating the parameters as statistically independent and attributing total uncertainty ")
  #line-at(90.024pt, 671.74pt, "solely to known inputs, as outlined in the Guide to the Expression of Uncertainty in ")
  #line-at(90.024pt, 696.12pt, "Measurement (GUM) [21]. This practice effectively neglected two important sources ")
  #line-at(90.024pt, 720.6pt, "of error: the correlations among fitted parameters introduced by the coupled inverse ")
  #line-at(90.024pt, 745.08pt, "problem, and the additional uncertainty arising from the quality of the fit itself (i.e., the ")
]

