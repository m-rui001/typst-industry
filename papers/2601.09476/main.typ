  #line-at(93.78pt, 367.98pt, "Table 1:")
  #set text(font: "Times New Roman", size: 8.459pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(123.66pt, 367.98pt, " Process parameters for the generation of the cavities ")
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.78pt, 386.94pt, "All thinning strategies (LTS, STL and RND) were followed with the same parameters from table 1 ")
  #line-at(93.781pt, 398.82pt, "using 230 repetitions, which led to cavities with a depth of 200 µm. Just the diameter of the circle was ")
  #line-at(93.781pt, 410.76pt, "changed for each repetition. Thus, the difference in surface quality and geometry is solely attributed to ")
