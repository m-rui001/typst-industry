#original-page(612pt, 792pt, (image("graphics/page-05.png", width: 425pt), 93.5pt, 242.5pt))[
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.78pt, 77.4pt, "profile measurements also show that the sidewalls form an inclination angle of approximately 13°, ")
  #line-at(93.78pt, 89.34pt, "despite using the same diameter for each repetition. This can be attributed to the increase of the laser ")
  #line-at(93.78pt, 101.16pt, "beam’s area projected on the sidewalls at larger depths, which in turn reduces the fluence to the level ")
  #line-at(93.78pt, 113.1pt, "of the threshold fluence, hence no further ablation occurs [27].  ")
  #line-at(93.78pt, 132.541pt, "To suppress the formation of the trenches along the sideline and to investigate the influence of various ")
  #line-at(93.78pt, 144.421pt, "scanning patterns on the resulting cavity geometry, the following strategies were applied:  ")
  #set text(font: "Symbol", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.701pt, 164.641pt, "•")
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.621pt, 164.641pt, "large to small (LTS), where the diameter of the circular hatch pattern is decreased for each ")
  #line-at(127.621pt, 176.461pt, "repetition ")
  #set text(font: "Symbol", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.702pt, 189.121pt, "•")
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.622pt, 189.121pt, "small to large (STL), where the diameter is increased for each repetition ")
  #set text(font: "Symbol", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(110.703pt, 201.781pt, "•")
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.623pt, 201.781pt, "random (RND), where the diameter is randomly chosen between a maximum and minimum ")
  #line-at(127.623pt, 213.661pt, "value for each repetition ")
  #line-at(93.783pt, 233.101pt, "Each strategy was processed with the same parameters listed in table 1.  ")
  #line-at(99.063pt, 253.021pt, "Wavelength ")
  #line-at(311.137pt, 253.021pt, "523 nm ")
  #line-at(99.06pt, 267.6pt, "Lens, focal length ")
