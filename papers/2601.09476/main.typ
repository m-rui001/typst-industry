#original-page(612pt, 792pt, (image("graphics/page-07.png", width: 341pt), 134.5pt, 67.5pt))[
  #set text(font: "Times New Roman", size: 8.459pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(107.28pt, 374.1pt, "Fig. 5")
  #set text(font: "Times New Roman", size: 8.459pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(127.56pt, 374.1pt, " SEM images of left and right ends of cavities realised with shift values of 1 µm (top), 2 µm (middle) and 4 µm ")
  #line-at(283.8pt, 383.82pt, "(bottom line) ")
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.78pt, 404.7pt, "As moving the pattern to the right means that the machined surface on the left is no longer passed by ")
  #line-at(93.78pt, 416.58pt, "the laser, debris is expected to be deposited on the side edge. The reduced surface quality can be ")
  #line-at(93.78pt, 428.52pt, "recognised at a pattern shift value of 1 µm. However, the amount of accumulations is already reduced ")
