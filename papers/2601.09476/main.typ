  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.78pt, 582.72pt, "The inner and outer diameters (450 µm and 500 µm) were chosen in a way that they correspond to the ")
