// arXiv source page 9
#original-page(612pt, 792pt, (image("graphics/page-09.png", width: 304pt), 154pt, 462pt))[
  #set text(font: "Times New Roman", size: 10.32pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(93.78pt, 77.4pt, "noticeable indentation at the side edges in the case of RND, which seems to have a direct impact on ")
  #line-at(93.78pt, 89.34pt, "the layer conductivity in this region. As a result of these measurements further examinations regarding ")
  #line-at(93.78pt, 101.22pt, "layer structuring were continued with cavities fabricated using the STL method. ")
  #line-at(93.779pt, 120.66pt, "Circular cavities were generated for the tests to create structured metallic contacts on non-planar ")
  #line-at(93.78pt, 132.54pt, "surfaces. Inner diameters of 350 µm and 450 µm were chosen, resulting in the smallest and largest ")
  #line-at(93.78pt, 144.421pt, "values for the sidewall inclination, as demonstrated in ")
  #set text(font: "Times New Roman", size: 10.32pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(319.379pt, 144.421pt, "Error! Reference source not found.")
