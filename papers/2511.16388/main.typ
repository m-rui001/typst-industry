  #line-at(173.88pt, 474.24pt, " through “thermalization” ")
  #line-at(71.997pt, 485.823pt, "represents the principal efficiency loss in solar cells. ")
  #line-at(71.997pt, 497.286pt, "This is in contrast with thermoelectric generators ")
  #line-at(71.997pt, 508.809pt, "where this loss is small and frequently neglected. The ")
  #line-at(71.997pt, 520.332pt, "reason for this different magnitude in the two ")
  #line-at(72.007pt, 531.795pt, "applications lies in the temperature difference ")
  #set text(font: "Times New Roman", size: 10.02pt, weight: "regular", style: "italic", fill: rgb("#000000"))
