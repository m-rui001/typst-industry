  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(222.29pt, 354.65pt, "11–14")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(242.45pt, 359.21pt, ". ")
  #line-at(72.024pt, 373.01pt, "In this work, we propose a two-step pathway to address the material and integration challenges, ")
  #line-at(72.024pt, 386.81pt, "shown in Figure 1. First, Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(205.85pt, 387.77pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(209.93pt, 386.81pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(218.57pt, 387.77pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(222.65pt, 386.81pt, " thin films are deposited on sapphire substrates by radio-frequency ")
  #line-at(72.024pt, 400.61pt, "(RF) sputtering and subsequently crystallized through high-temperature post-deposition annealing, ")
  #line-at(72.024pt, 414.43pt, "yielding epitaxial-quality films via solid-phase epitaxy (SPE). These sputtered and subsequently ")
  #line-at(72.024pt, 428.23pt, "post-annealed templates serve as high-quality seed layers with improved crystalline order and ")
  #line-at(72.024pt, 442.03pt, "reduced defect density compared with Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(272.69pt, 442.99pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(276.77pt, 442.03pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(285.41pt, 442.99pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(289.49pt, 442.03pt, " direct growth on sapphire with CVD. In the second ")
  #line-at(72.024pt, 455.83pt, "step, thicker device-grade Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(216.17pt, 456.79pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(220.25pt, 455.83pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(228.89pt, 456.79pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(232.97pt, 455.83pt, " layers are grown on these SPE templates using MOCVD and ")
  #line-at(72.024pt, 469.63pt, "Low-Pressure Chemical Vapor Deposition (LPCVD), taking advantage of the improved surface ")
  #line-at(72.024pt, 483.43pt, "morphology and crystalline quality of the underlying film. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 511.03pt, "Experiment: ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 524.83pt, "For the preparation of SPE β-Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(226.85pt, 525.79pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(230.93pt, 524.83pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(239.57pt, 525.79pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(243.65pt, 524.83pt, " on sapphire substrates, an amorphous 25 nm Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(475.3pt, 525.79pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(479.38pt, 524.83pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(487.9pt, 525.79pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(491.98pt, 524.83pt, " layer was ")
  #line-at(72.024pt, 538.63pt, "first deposited on both c-plane sapphire and 6° miscut sapphire (toward the m-plane) using on-axis ")
  #line-at(72.024pt, 552.43pt, "RF magnetron sputtering. The deposition was carried out at a substrate temperature of 200 °C ")
  #line-at(72.024pt, 566.23pt, "under a chamber pressure of 15 mTorr, with 100 W RF power applied. Crystallization of the ")
  #line-at(72.024pt, 580.03pt, "sputtered Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(132.5pt, 581.02pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.58pt, 580.03pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(145.22pt, 581.02pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.3pt, 580.03pt, " was then achieved by annealing in air at 850 °C in a muffle furnace. The resulting ")
  #line-at(72.024pt, 593.86pt, "crystalline films were subsequently used as templates for buffer growth in MOCVD or LPCVD. ")
  #line-at(72.024pt, 607.66pt, "For MOCVD-grown undoped β-Ga")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(249.53pt, 608.62pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(253.61pt, 607.66pt, "O")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(262.25pt, 608.62pt, "3")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(266.33pt, 607.66pt, " buffers on c-plane sapphire at 820°C, triethylgallium ")
  #line-at(72.024pt, 621.46pt, "(TEG) was employed as the Ga precursor at a molar flow rate of 9.2 µmol/min under an N₂ carrier ")
  #line-at(72.024pt, 635.26pt, "environment. The VI/III ratio was varied between 1000, 1500, and 3000, while maintaining a film ")
  #line-at(72.024pt, 649.06pt, "thickness of approximately 200 nm. For the n-type LPCVD β-Ga₂O₃ growth, 6° off miscut sapphire ")
  #line-at(72.024pt, 662.86pt, "is utilized to suppress the island-nucleation-dominated growth mode expected on flat sapphire ")
  #line-at(72.024pt, 676.66pt, "under high growth rate (6 - 8 µm/hour), where the absence of atomic steps limits ordered adatom ")
  #line-at(72.024pt, 690.46pt, "incorporation")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(136.58pt, 685.9pt, "15")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(144.74pt, 690.46pt, ". The deposition was carried out at 1000 °C following the growth conditions ")
  #line-at(72.024pt, 704.256pt, "described in Reference")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
