  #set text(font: "Arial", size: 11.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 215.18pt, "David J. Webb")
  #set text(font: "Arial", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(149.78pt, 215.18pt, " joined Aston University as Reader in Photonics in 2001, was promoted to ")
  #line-at(72.024pt, 234.14pt, "Professor in 2012 and awarded a 50th Anniversary Chair in 2016. Prior to joining Aston he ")
  #line-at(72.024pt, 253.13pt, "had spent 10 years as a Lecturer, then Senior Lecturer in the Physics Department at the ")
  #line-at(72.024pt, 272.09pt, "University of Kent at Canterbury. He received BA in Physics (1982) at the University of Oxford ")
  #line-at(72.024pt, 291.05pt, "and the PhD in Physics (1988) at the University of Kent. His professional work has primarily ")
  #line-at(72.024pt, 310.01pt, "focused on solving complex object detection and tracking problems across a variety of ")
