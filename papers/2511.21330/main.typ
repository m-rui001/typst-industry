  #line-at(167.9pt, 159.14pt, "*, Alexander Dulebo")
  #set text(font: "Arial", size: 8.04pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(280.85pt, 155.18pt, "b")
