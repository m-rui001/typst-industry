  #line-at(72.024pt, 576.94pt, "sample. ")
  #set text(font: "Arial", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 602.02pt, "The registered probe track position, cross section and 3D topography of the 2PP-")
