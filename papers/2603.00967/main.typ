  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(113.36pt, 575.32pt, "24")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(121.4pt, 579.82pt, " (adsorbates, moisture) and intrinsic (sulfur-vacancy states)")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(401.98pt, 575.32pt, "56,57")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(419.98pt, 579.82pt, " sources of hysteresis. ")
  #line-at(72pt, 600.52pt, "Extrinsic adsorbates are often bound to sulfur-vacancy sites, meaning that a significant portion ")
  #line-at(72pt, 621.22pt, "of the hysteresis contribution can be traced back to sulfur-vacancy induced trap states")
