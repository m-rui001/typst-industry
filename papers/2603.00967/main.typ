  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(385.78pt, 455.6pt, " conduction band edge, the ")
  #line-at(72pt, 476.3pt, "available band offset for electron extraction is small, resulting in much weaker charge transfer. ")
  #line-at(72pt, 497.02pt, "Consequently, the V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(171.56pt, 497.5pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(177.8pt, 497.02pt, " shift is modest, and full enhancement-mode operation is not achieved. ")
  #line-at(72pt, 517.72pt, "This highlights how interfacial Fermi-level alignment governs charge transfer, modulates ")
  #line-at(72pt, 538.42pt, "carrier density, and directly influences the threshold voltage. Interfacial charge transfer also ")
  #line-at(72pt, 559.12pt, "plays a critical role in suppressing hysteresis. As discussed earlier, MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(426.82pt, 559.6pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(430.84pt, 559.12pt, " FETs exhibit both ")
