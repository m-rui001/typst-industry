  #line-at(480.82pt, 616.72pt, "52")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(488.8pt, 621.22pt, ". When ")
  #line-at(72pt, 641.92pt, "PBTTT-C14 or P3HT withdraw electrons from the MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(338.92pt, 642.4pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(342.94pt, 641.92pt, " channel, these sulfur-vacancy-related ")
  #line-at(72pt, 662.62pt, "traps become electronically passivated. With fewer active trap states available for charge ")
  #line-at(72pt, 683.32pt, "trapping/detrapping, the hysteresis window decreases substantially. This suppression is most ")
  #line-at(72pt, 704.02pt, "pronounced for PBTTT-C14 and P3HT, consistent with their stronger charge-transfer ")
