  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(139.22pt, 352.16pt, ". The pronounced reduction in hysteresis after PBTTT-C14 coating can be ")
  #line-at(72pt, 372.86pt, "explained as follows. First, the polymer forms a van der Waals interface with MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(466.78pt, 373.34pt, "2")
  #line-at(470.8pt, 368.36pt, "37")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(478.78pt, 372.86pt, ", creating ")
  #line-at(72pt, 393.56pt, "a clean interface that does not introduce additional trap states or disturb the channel ")
  #line-at(72pt, 414.26pt, "electrostatics. Such an interface enables efficient interfacial charge transfer when the Fermi-")
  #line-at(72pt, 434.96pt, "level alignment is favourable. Owing to the favourable energy-level alignment")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(454.9pt, 430.46pt, "41")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(462.94pt, 434.96pt, ", between p-")
  #line-at(72pt, 455.6pt, "type PBTTT-C14 and n-type MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(246.74pt, 456.08pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(250.76pt, 455.6pt, ", significant charge transfer occurs from MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(484.24pt, 456.08pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(488.26pt, 455.6pt, " to the ")
  #line-at(72pt, 476.3pt, "polymer, extracting electrons associated with donor-like sulfur vacancies")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(420.4pt, 471.8pt, "48")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(428.38pt, 476.3pt, ", effectively leading ")
  #line-at(72pt, 497.02pt, "to electrical deactivation of these defects. Park ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(294.02pt, 497.02pt, "et al.")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(317.32pt, 493pt, "49")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(325.36pt, 497.02pt, " demonstrated that charge-transfer doping ")
  #line-at(72pt, 517.72pt, "at a van der Waals organic/MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(234.74pt, 518.2pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(238.76pt, 517.72pt, " interface electronically deactivates sulfur-vacancy defect ")
  #line-at(72pt, 538.42pt, "states, which is consistent with our observed hysteresis suppression. This underscores the ")
  #line-at(72pt, 559.12pt, "effectiveness of PBTTT-C14 in enabling both E-mode operation and highly stable device ")
  #line-at(72pt, 579.88pt, "characteristics.  ")
