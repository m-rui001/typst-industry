  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(117.38pt, 145.14pt, " channel is governed primarily by Fermi-level alignment with the polymer coatings. ")
  #line-at(72pt, 165.86pt, "In PBTTT-C14 and P3HT, the polymer Fermi level lies well below that of MoS")
