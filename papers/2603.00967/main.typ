  #line-at(464.86pt, 166.34pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(468.88pt, 165.86pt, ", creating a ")
  #line-at(72pt, 186.56pt, "strong driving force for electron transfer, whereas the near-aligned Fermi level of N2200 results ")
  #line-at(72pt, 207.26pt, "in much weaker extraction. The corresponding band alignment is schematically illustrated in ")
  #line-at(72pt, 227.96pt, "Figure 6(e → h). Specifically, pristine multilayer MoS")
