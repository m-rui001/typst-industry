  #line-at(72pt, 331.46pt, "channel electrostatics. Such defects have been identified as a key contributor to hysteresis in ")
  #line-at(72pt, 352.16pt, "MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(95.34pt, 352.64pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(99.36pt, 352.16pt, " FETs")
