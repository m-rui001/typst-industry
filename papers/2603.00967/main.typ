  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(344.74pt, 227.96pt, " FETs have a conduction band (CB) ")
  #line-at(72pt, 248.66pt, "located at approximately −4.0 eV and a valence band (VB) near −5.2 eV, with the Fermi level ")
  #line-at(72pt, 269.36pt, "positioned close to the CB due to intrinsic n-type doping")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(340.54pt, 264.86pt, "51")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(348.58pt, 269.36pt, ". PBTTT-C14, a p-type polymer, has ")
  #line-at(72pt, 290.06pt, "HOMO (Highest Occupied Molecular Orbital/LUMO (Lowest Occupied Molecular Orbital) ")
  #line-at(72pt, 310.76pt, "levels at −5.1 eV/−3.1 eV")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(195.08pt, 306.26pt, "54")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(203.12pt, 310.76pt, ", while P3HT exhibits HOMO/LUMO levels at −5.2 eV/−3.2 eV")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(512.32pt, 306.26pt, "55")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(520.36pt, 310.76pt, ". ")
  #line-at(72pt, 331.46pt, "Since the Fermi levels of these p-type polymers lie close to their HOMO levels, which are ")
  #line-at(72pt, 352.16pt, "substantially deeper than the MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(239.48pt, 352.64pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(243.5pt, 352.16pt, " Fermi level, there is a strong energetic driving force for ")
  #line-at(72pt, 372.86pt, "electron transfer from MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(202.22pt, 373.34pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(206.24pt, 372.86pt, " into the polymer. This efficient extraction of free electrons lowers ")
