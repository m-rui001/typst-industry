#original-page(595.32pt, 841.92pt, none)[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 83.04pt, "achieved 96% hysteresis reduction using a hydrophobic organosilane HMDS treatment, ")
  #line-at(72pt, 103.74pt, "although Vₜₕ shifted slightly in the right direction, it remained strongly negative, leaving the ")
  #line-at(72pt, 124.44pt, "device in depletion-mode")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.82pt, 119.94pt, "36")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(201.86pt, 124.44pt, ". Collectively, these studies highlight the following critical gap; (1) ")
  #line-at(72pt, 145.14pt, "achieving a large, positive and stable V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(275.54pt, 145.62pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(281.78pt, 145.14pt, " shift (sufficient for D→E conversion), and (2) ")
  #line-at(72pt, 165.86pt, "simultaneously addressing hysteresis, or ideally, minimizing it to ensure reliable device ")
  #line-at(72pt, 186.56pt, "performance. In this context, organic polymers offer a compelling alternative. Owing to the ")
  #line-at(72pt, 207.26pt, "absence of dangling bonds and native surface oxides, they interact with 2D materials primarily ")
  #line-at(72pt, 227.96pt, "through van der Waals forces, forming a gentle, non-destructive interface that does not ")
  #line-at(72pt, 248.66pt, "introduce additional trap states and preserves the structural integrity of MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(430.42pt, 249.14pt, "2")
  #line-at(434.44pt, 244.16pt, "37–40")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(454.48pt, 248.66pt, ". Their tunable ")
  #line-at(72pt, 269.36pt, "energy levels, together with the ability to incorporate diverse functional groups, enable precise ")
  #line-at(72pt, 290.06pt, "interfacial charge-transfer modulation and controlled tuning of V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(408.76pt, 290.54pt, "th")
  #line-at(415pt, 285.56pt, "41–43")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(435.1pt, 290.06pt, ". Moreover, their ")
  #line-at(72pt, 310.76pt, "mechanical flexibility makes them highly suitable for surface engineering and integration into ")
  #line-at(72pt, 331.46pt, "next-generation flexible electronics")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(243.02pt, 326.96pt, "44")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(251pt, 331.46pt, ". Here, we demonstrate for the first time that employing ")
  #line-at(72pt, 352.16pt, "PBTTT-C14 ")
  #line-at(146.18pt, 352.16pt, "(poly(2,5-bis(3-tetradecylthiophen-2-yl)thieno[3,2-b]thiophene)), ")
  #line-at(473.848pt, 352.16pt, "a ")
  #line-at(492.64pt, 352.16pt, "p-type ")
  #line-at(72pt, 372.86pt, "conjugated hydrophobic polymer, enables E-mode operation in multilayer MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(448.78pt, 373.34pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(452.8pt, 372.86pt, " FETs, shifting ")
  #line-at(72pt, 393.56pt, "the threshold voltage (V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(187.52pt, 394.04pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(193.76pt, 393.56pt, ") from a large negative value (")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(337.54pt, 393.56pt, "–")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(343.54pt, 393.56pt, "9.6 V) toward positive value (+5.9 V) ")
  #line-at(72pt, 414.26pt, "(total shift ~15.5 V), effectively converting the device from D-mode to E-mode operation, ")
  #line-at(72pt, 434.96pt, "while simultaneously achieving strong hysteresis suppression from 8.8  to 1.3 V (~ 85 %). The ")
  #line-at(72pt, 455.6pt, "modulation arises from interfacial charge-transfer due to favourable energy band alignment; ")
  #line-at(72pt, 476.3pt, "PBTTT-C14 extract electrons from MoS")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(270.86pt, 476.78pt, "2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(274.88pt, 476.3pt, ", lowering its Fermi level, thus inducing a positive ")
  #line-at(72pt, 497.02pt, "shift in the V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(139.94pt, 497.5pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(146.18pt, 497.02pt, ". A second p-type polymer, P3HT (poly(3-hexylthiophene-2,5-diyl)), with a ")
  #line-at(72pt, 517.72pt, "comparable energy level to PBTTT-C14, produces similar results. In contrast, coating with the ")
  #line-at(72pt, 538.42pt, "n-type ")
  #line-at(132.108pt, 538.42pt, "polymer ")
  #line-at(201.516pt, 538.42pt, "N2200 ")
  #line-at(263.66pt, 538.42pt, "(Poly{[N,N′-bis(2-octyldodecyl)-naphthalene-1,4,5,8-")
  #line-at(72pt, 559.12pt, "bis(dicarboximide)-2,6-diyl]-alt-5,5′-(2,2′-bithiophene)})")
  #line-at(350.86pt, 559.12pt, "yields a smaller V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(441.1pt, 559.6pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(447.34pt, 559.12pt, " shift (~ 5.5 V) ")
  #line-at(72pt, 579.82pt, "without E-mode conversion and moderate hysteresis reduction (~50 %) due to minimal charge-")
  #line-at(72pt, 600.52pt, "transfer due to unfavourable band level alignment. Furthermore, the ambient passivation layer ")
  #line-at(72pt, 621.22pt, "of insulating polymer PDMS (Polymethyl siloxane), shows no observable shift in V")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(494.98pt, 621.7pt, "th")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(501.22pt, 621.22pt, " and ")
  #line-at(72pt, 641.92pt, "hysteresis, confirming how passivation from ambient gases results in no improvement. These ")
  #line-at(72pt, 662.62pt, "control experiments demonstrate that significant shifts in V")
