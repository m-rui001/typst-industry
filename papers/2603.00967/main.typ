  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(392.98pt, 393.56pt, " Fermi level downward. In ")
  #line-at(72pt, 414.26pt, "contrast, N2200 is an n-type polymer with HOMO/LUMO levels at −5.5 eV/−4.1 eV, and its ")
  #line-at(72pt, 434.96pt, "Fermi level lies close to the LUMO")
  #set text(font: "Times New Roman", size: 7.98pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(242.6pt, 430.46pt, "50")
