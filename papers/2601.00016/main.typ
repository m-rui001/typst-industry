// arXiv source page 15
#original-page(595.32pt, 841.92pt, (image("graphics/page-15.png", width: 453.5pt), 71pt, 112pt))[
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.824pt, 81.96pt, "Figure 7.A demonstrates a linear variation of the output voltage with the number of junctions. ")
  #line-at(70.824pt, 102.74pt, "This is explained by the fact that, as in other studies, we consider the contact resistances as ")
  #line-at(70.824pt, 123.38pt, "perfect. Here we rely on the fact that the vacuum allows to exert mechanical pressure on the ")
  #line-at(70.824pt, 144.14pt, "material therefore justifying the omittance of these contact resistances. Nevertheless, this first ")
  #line-at(70.824pt, 164.78pt, "graph perfectly illustrates the interest in moving towards an architecture composed of a large ")
  #line-at(70.824pt, 185.54pt, "number of junctions: for a difference of 50°C and a 1m² module composed of 1000 junctions ")
  #line-at(70.824pt, 206.18pt, "(10 cm² per junction), the expected output voltage with the current material reaches 1.25 V, ")
  #line-at(70.824pt, 226.94pt, "then 2.5 V with the target material (p-p junctions) and finally 5 V with the combination of target ")
  #line-at(70.824pt, 247.58pt, "materials (n-p junctions). In Figure 7.B, if we now set the number of junctions to 1000 and vary ")
  #line-at(70.824pt, 268.37pt, "the temperature difference from 0°C to 100°C, then we see that the n-p architecture offers a ")
  #line-at(70.824pt, 289.01pt, "power density much higher compared to the other two systems: the expected power density for ")
  #line-at(70.824pt, 309.77pt, "the n-p junction module reaches 22 Wm")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(265.13pt, 305.21pt, "-2")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(271.85pt, 309.77pt, " compared to 5.5 Wm")
  #set text(font: "Times New Roman", size: 8.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(377.35pt, 305.21pt, "-2")
