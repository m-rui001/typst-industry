  #line-at(72.024pt, 739.78pt, "bubble grew and filled the cavity (Figure 14(c)), the surplus superheated liquid was pushed out of the ")
  #line-at(72.024pt, 754.296pt, "cavity, bolstering the thermal boundary layer above the cavity and enabled the bubble to grow faster ")
]

