  #line-at(72.024pt, 475.15pt, "to normalise the results. For the normalised minimum base radius, a value of unity represents a bubble ")
  #line-at(72.024pt, 489.67pt, "interface that remained pinned to the cavity edge and values lower than unity represent a bubble ")
  #line-at(72.024pt, 504.19pt, "interface that travelled along the cavity wall as the bubble departed. Figure 16 shows the relationship ")
  #line-at(72.024pt, 518.59pt, "between the cavity angle and this normalised minimum base radius, with larger cavity angles leading ")
  #line-at(72.024pt, 533.11pt, "to smaller minimum base radii. Larger cavity radii also resulted in more relative slippage for any given ")
  #line-at(72.024pt, 547.63pt, "cavity angle, with cavity angles larger than 63° leading to complete vapour departure.  ")
  #set text(font: "Calibri", size: 9pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(82.344pt, 748.416pt, "Figure 16: Normalised minimum base radius as a function of cavity angle for conical cavities with radii of 50 μm (blue), ")
