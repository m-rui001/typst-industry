  #line-at(72.024pt, 125.9pt, "coupling. A variable time-step was used, and the length of each time-step was determined such that ")
  #line-at(72.024pt, 140.42pt, "the maximum Courant number, ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "italic", fill: rgb("#000000"))
