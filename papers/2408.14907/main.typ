  #line-at(76.224pt, 397.85pt, "Figure 15: Comparison of the bubble base radius during the first bubble lifecycle for concial cavities with depths of 250 μm ")
  #line-at(111.38pt, 408.89pt, "(solid line) and 1000 μm (dashed line) and radii of 50 μm (blue), 250 μm (orange) and 400 μm (purple). ")
  #set text(font: "Calibri", size: 11.04pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72.024pt, 431.69pt, "The minimum base radius value reached during the necking process gives an indication of how far ")
  #line-at(72.024pt, 446.11pt, "down the cavity wall the interface was able to travel before departure. As a wide array of cavity radii ")
