  #line-at(75.996pt, 304.08pt, "C")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(84pt, 304.08pt, "), and interfacial thermal resistance (ITR) evolve with mechanical pressure and cannot be ")
  #line-at(72pt, 324.72pt, "determined simultaneously using existing steady-state or transient techniques. As a result, the ")
  #line-at(72pt, 345.36pt, "coupled roles of bulk compaction and interfacial contact in governing heat transport in TIM ")
  #line-at(72pt, 366.24pt, "assemblies remain poorly resolved. Here, we present a square-pulsed source (SPS) ")
  #line-at(72pt, 386.88pt, "thermoreflectance method that enables simultaneous determination of ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(416.306pt, 386.88pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(421.632pt, 386.88pt, ", ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(428.598pt, 386.88pt, "C")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(436.601pt, 386.88pt, ", and ITR in TIM ")
  #line-at(72pt, 407.52pt, "stacks under controlled mechanical loading. By spanning square-wave modulation frequencies ")
  #line-at(72pt, 428.16pt, "from 1 Hz to 10 MHz, SPS probes a broad range of thermal penetration depths, enabling ")
  #line-at(72pt, 449.04pt, "distinction between heat diffusion in the TIM bulk and interfacial heat transfer at the Al/TIM ")
  #line-at(72pt, 469.68pt, "contact. Measurements on a thermally conductive gel, a thermal pad, and a high-vacuum grease ")
  #line-at(72pt, 490.32pt, "during compression-unloading cycles reveal distinct pressure-dependent thermal transport ")
  #line-at(72pt, 510.96pt, "mechanisms. The gel and pad exhibit increases in ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(326.976pt, 510.96pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(332.303pt, 510.96pt, " and ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(359.141pt, 510.96pt, "C")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(367.145pt, 510.96pt, ", reduced ITR, and pronounced ")
  #line-at(72pt, 531.84pt, "hysteresis, indicating coupled bulk densification and persistent interfacial conformity during ")
