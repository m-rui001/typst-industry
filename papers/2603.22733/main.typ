  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(281.677pt, 207.6pt, ", and ITR under the actual compressed state of the ")
  #line-at(72pt, 228.48pt, "TIM. The SPS approach developed here therefore provides both a measurement tool and a ")
  #line-at(72pt, 249.36pt, "physically informative framework for the thermal design and assessment of TIM-based heat-")
