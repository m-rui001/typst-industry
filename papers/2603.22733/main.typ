  #line-at(72pt, 262.56pt, "ABSTRACT:")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(141.346pt, 262.56pt, " Thermal interface materials (TIMs) critically regulate heat dissipation from ")
