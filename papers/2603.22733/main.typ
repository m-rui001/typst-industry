  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 458.16pt, "separately. The accessible frequency range is also limited in practice, because conventional ")
  #line-at(72pt, 478.8pt, "TDTR is usually operated above about 0.1 MHz, where lock-in detection remains robust. Low-")
  #line-at(72pt, 499.44pt, "frequency thermoreflectance approaches have recently extended sensitivity to ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(445.805pt, 499.44pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
