  #line-at(399.765pt, 311.04pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(405.091pt, 311.04pt, " and ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(429.273pt, 311.04pt, "C")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(437.277pt, 311.04pt, " without auxiliary ")
  #line-at(72pt, 331.68pt, "calorimetric input. In assembled TIM structures, LFA is also not well suited to separating bulk ")
  #line-at(72pt, 352.32pt, "and interfacial contributions. Optical thermoreflectance techniques, particularly time-domain ")
  #line-at(72pt, 372.96pt, "thermoreflectance (TDTR) [11-13] and frequency-domain thermoreflectance (FDTR) [6, 14], ")
  #line-at(72pt, 393.84pt, "offer much higher spatial resolution and have become powerful tools for small-scale thermal-")
  #line-at(72pt, 414.48pt, "property measurements. Nevertheless, conventional TDTR is often mainly sensitive to thermal ")
  #line-at(72pt, 437.28pt, "effusivity ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(121.68pt, 437.52pt, "√𝑘𝐶")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(144.489pt, 437.28pt, " and ITR when applied to low-k materials [15, 16], rather than to ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(482.785pt, 437.28pt, "k")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(488.111pt, 437.28pt, " and ")
