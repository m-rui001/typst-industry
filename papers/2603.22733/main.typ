  #line-at(72pt, 166.08pt, "by pressure and mechanical history. From an application perspective, this means that accurate ")
  #line-at(72pt, 186.72pt, "prediction of transient thermal impedance and thermal reliability in electronic packaging ")
  #line-at(72pt, 207.6pt, "requires simultaneous consideration of ")
  #set text(font: "Cambria Math", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(261.017pt, 207.6pt, "𝑘")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
