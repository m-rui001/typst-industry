  #line-at(87.24pt, 568.32pt, "Architecture of the Microheater Array")
  #set text(font: "Times New Roman", size: 9.96pt, weight: "regular", style: "normal", fill: rgb("#231f20"))
  #line-at(56.64pt, 586.68pt, "The row and column electrodes of 32")
