  #line-at(54.58pt, 486.96pt, "significant challenges for its transportation and assembly ")
  #set text(font: "Times New Roman", size: 9.734pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(54.4pt, 498.71pt, "in ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(66.15pt, 498.71pt, "orbit, necessitating division into multiple modules for ")
  #line-at(54.4pt, 510.24pt, "launch into orbit based on the transport capacity ")
  #set text(font: "Times New Roman", size: 10.127pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(262.22pt, 510.24pt, "of ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(275.02pt, 510.24pt, "the ")
  #line-at(54.4pt, 521.75pt, "launch vehicle. MMR-SPS adopts the GEO assembly and ")
  #line-at(54.46pt, 533.52pt, "transportation mode. The process involves utilizing heavy-")
  #line-at(54.4pt, 545.27pt, "lift rockets to launch the SPS modules into low Earth orbit ")
  #line-at(54.61pt, 556.79pt, "(LEO). Then, the upper stage ")
  #set text(font: "Times New Roman", size: 9.993pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(173.9pt, 556.79pt, "of ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(185.02pt, 556.79pt, "the rocket ")
  #set text(font: "Times New Roman", size: 9.719pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(226.95pt, 556.79pt, "or ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(237.98pt, 556.79pt, "an interorbit ")
  #line-at(54.46pt, 568.56pt, "transporter is employed to transport all the SPS modules to ")
  #line-at(54.62pt, 579.84pt, "GEO, where assembly takes place (refer to Fig. 14). ")
  #line-at(69.08pt, 591.59pt, "Key features ")
  #set text(font: "Times New Roman", size: 9.993pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(124.7pt, 591.59pt, "of ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(137.02pt, 591.59pt, "this approach include conducting all ")
  #line-at(54.62pt, 603.11pt, "assembly processes in GEO, which significantly reduces ")
  #line-at(54.46pt, 615.11pt, "the risk ")
  #set text(font: "Times New Roman", size: 9.993pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(87.5pt, 615.11pt, "of ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(99.03pt, 615.11pt, "collisions with space debris. This is due to the ")
  #line-at(54.58pt, 626.63pt, "substantially lower concentration ")
  #set text(font: "Times New Roman", size: 9.993pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(188.3pt, 626.63pt, "of ")
  #set text(font: "Times New Roman", size: 9.7pt, weight: "regular", style: "normal", fill: rgb("#000000"))
