  #line-at(292.85pt, 199.46pt, " is directly inherited from a signal generator ")
  #line-at(85.104pt, 220.22pt, "referenced to a rubidium clock. ")
  #line-at(96.984pt, 254.93pt, "To spatially control the comb modes, a virtually imaged phased array (VIPA; free ")
  #line-at(85.104pt, 275.57pt, "spectral range: 60 GHz) and a transmission grating (966 lines mm⁻¹) jointly disperse the ")
