  #line-at(85.104pt, 600.1pt, "programmable spectral encoding that underpins subsequent computational sensing and ")
  #line-at(85.104pt, 620.86pt, "non-cooperative measurements. ")
  #line-at(96.984pt, 655.54pt, "For spectroscopic gas sensing, the encoded comb is launched into free space through a ")
