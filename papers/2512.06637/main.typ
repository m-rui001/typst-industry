  #line-at(70.02pt, 393.902pt, "sample preparation—which are typically costly, technically demanding and time-consuming—the ")
  #line-at(70.02pt, 414.056pt, "emerging approach based on sacrificial layer etching combined with dry/wet transfer techniques ")
  #line-at(70.02pt, 434.164pt, "demonstrates significant advantages. ")
