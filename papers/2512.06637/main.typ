  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 421.863pt, "Heteroepitaxy of high-quality thin films traditionally relies on rigid single-crystal substrates (e.g., ")
  #line-at(70.02pt, 442.017pt, "sapphire, SiC) for lattice matching, yet faces three fundamental constraints: lattice mismatch-")
  #line-at(70.02pt, 462.125pt, "induced high-density dislocations [")
