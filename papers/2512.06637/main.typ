  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(85.623pt, 671.216pt, "]. In 2022, Sun ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "italic", fill: rgb("#000000"))
  #line-at(158.164pt, 671.216pt, "et al.")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(181.504pt, 671.216pt, " leveraged the energy match between 355-nm picosecond ultraviolet laser ")
  #line-at(70.02pt, 691.324pt, "photons (3.5 eV) and the GaN bandgap (3.4 eV), inducing intrinsic absorption-plasma synergy at ")
  #line-at(70.02pt, 711.478pt, "ultralow energies (0.09–0.13 J/cm")
  #set text(font: "Times New Roman", size: 7.761pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(228.973pt, 707.089pt, "2")
