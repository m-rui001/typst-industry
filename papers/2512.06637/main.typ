#original-page(595.276pt, 841.89pt, (image("graphics/page-64.png", width: 347.5pt), 125pt, 180.5pt))[
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(513.48pt, 793.74pt, "64")
  #set text(font: "Times New Roman", size: 13.596pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(198.189pt, 118.474pt, "Freestanding Thin-Film Materials ")
  #line-at(242.58pt, 165.462pt, "Graphical abstract ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 552.906pt, "Freestanding thin-film materials overcome substrate clamping to unlock intrinsic material ")
  #line-at(70.02pt, 573.06pt, "properties and enable cross-platform integration. This review details fabrication techniques ")
  #line-at(70.02pt, 593.156pt, "(physical delamination, chemical etching) and transfer strategies for these films. It highlights their ")
  #line-at(70.02pt, 613.321pt, "unique advantages in strain engineering, extreme mechanics, and interface decoupling, driving ")
  #line-at(70.02pt, 633.417pt, "applications in flexible/sensing devices and quantum exploration. Challenges in scalability and ")
  #line-at(70.02pt, 653.583pt, "stability are discussed, with promising future prospects. ")
]
