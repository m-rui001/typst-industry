  #line-at(70.02pt, 285.476pt, "3.4 Transfer-Enabled Planar-View TEM Technique ")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(70.02pt, 313.379pt, "The advent of freestanding thin-film fabrication and transfer techniques has not only established a ")
  #line-at(70.02pt, 333.545pt, "cross-material strain engineering platform for flexible electronics and quantum devices but also ")
  #line-at(70.02pt, 353.641pt, "provided a novel and powerful technical pathway for direct planar-view structural characterization ")
