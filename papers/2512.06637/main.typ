  #line-at(453.835pt, 257.585pt, " thermoelectric ")
  #line-at(70.02pt, 277.739pt, "films and PLZT piezoelectric films as well as the fabrication of flexible Organic LED/resistance ")
  #line-at(70.02pt, 297.905pt, "random access memory (RRAM) memory arrays (")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(301.016pt, 297.905pt, "Fig. 2")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(327.6pt, 297.905pt, "c, d). (ii) Replacing thermal decomposition ")
  #line-at(70.02pt, 318pt, "with ion-implanted damage layers [")
