  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(248.396pt, 630.955pt, "]. In 2016, a defocused 266-nm solid-state laser irradiation ")
  #line-at(70.02pt, 651.062pt, "strategy enabled selective precision lift-off for micron-scale light-emitting diodes (LEDs) (")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#00b0f0"))
  #line-at(489.358pt, 651.062pt, "Fig. 2")
  #set text(font: "Times New Roman", size: 11.67pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(516.117pt, 651.062pt, "a)")
  #line-at(70.02pt, 671.216pt, "[")
