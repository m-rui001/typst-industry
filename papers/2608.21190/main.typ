#original-page(612pt, 792pt, none)[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(275.16pt, 752.64pt, "Page ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(302.52pt, 752.64pt, "9")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.88pt, 752.64pt, " of ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(324pt, 752.64pt, "13")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 83.16pt, "LAB EXPERIMENT ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 107.04pt, "The objective of this experiment was to demonstrate the realization of physical minimal-surface ")
  #line-at(72pt, 122.88pt, "structure inspired by a Schwarz-P element. It examined the tooling, fabrication logic and steps ")
  #line-at(72pt, 138.72pt, "required to achieve such element, with particular emphasis on the role of boundary conditions as ")
  #line-at(72pt, 154.68pt, "primary design drivers.  ")
  #line-at(72pt, 178.56pt, "To simulate microgravity on Earth, we carried out the experiment in a neutral-buoyancy tank using ")
  #line-at(72pt, 194.4pt, "Plateau’s density-matching method (Plateau, 1857). We adjusted a water-glycerol solution to ")
  #line-at(72pt, 210.24pt, "match the density of a curable photopolymer, allowing the polymer to behave as if weightless ")
  #line-at(72pt, 226.08pt, "within the fluid. Next, we placed a Fixator containing six annular boundary rings into the tank and ")
  #line-at(72pt, 241.92pt, "introduced a controlled volume of liquid photopolymer through its boundary inlet, initiating the ")
  #line-at(72pt, 257.88pt, "formation of a suspended polymeric blob (Figure 5b). We then inflated the blob using an ")
  #line-at(72pt, 273.72pt, "immersion-liquid inflation device, which expanded the polymer until it contacted all boundary ")
  #line-at(72pt, 289.56pt, "surfaces (Figure 5c–d). Once it had fully expanded, we used a jetting nozzle to puncture the ")
  #line-at(72pt, 305.4pt, "polymeric membrane enclosed within the boundary rings, equalizing the internal and external ")
  #line-at(72pt, 321.36pt, "pressures and allowing the interface to relax freely into its minimal-surface configuration (Figure ")
  #line-at(72pt, 337.2pt, "5e–f). After the surface had relaxed, we removed the sealing plug at the illumination port and ")
  #line-at(72pt, 353.04pt, "inserted a UV illumination device into the center of the form to cure the polymer and solidify the ")
  #line-at(72pt, 368.88pt, "final geometry (Figure 5g). ")
  #line-at(72pt, 398.76pt, "Figure 6 presents an evaluation of the computational model through a quantitative comparison ")
  #line-at(72pt, 414.72pt, "with the fabricated prototype, scanned using a 3D scanner (GOM Scan 1, Carl Zeiss). Deviations ")
  #line-at(72pt, 430.56pt, "between the two external surfaces were quantified using the GOM Inspect software, revealing a ")
  #line-at(72pt, 446.4pt, "maximum absolute error of 2.75 mm for a model with overall dimensions of 80 × 80 × 80 mm. ")
]

