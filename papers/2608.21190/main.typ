// arXiv source page 8
#original-page(612pt, 792pt, (image("graphics/page-08.png", width: 468pt), 72pt, 344pt))[
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(275.16pt, 752.64pt, "Page ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(302.52pt, 752.64pt, "8")
  #set text(font: "Calibri", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(308.88pt, 752.64pt, " of ")
  #set text(font: "Calibri", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(324pt, 752.64pt, "13")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 83.16pt, "Liquid volume ")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 107.04pt, "The enclosed volume is an additional degree of freedom in shaping a LiquiBrick. Figure 4 ")
  #line-at(72pt, 122.88pt, "illustrates how changes in this parameter affect the distribution of wall thickness across a unit. ")
  #line-at(72pt, 138.72pt, "Figures 4a–d show a representative geometry sectioned along a diagonal plane to expose its ")
  #line-at(72pt, 154.68pt, "internal structure. ")
  #line-at(72pt, 178.56pt, "Figures 4e–h then present a sequence of units generated from identical boundary conditions but ")
  #line-at(72pt, 194.4pt, "with different prescribed volumes. Smaller volumes produce geometries with pronounced ")
  #line-at(72pt, 210.24pt, "variations in local thickness, including regions where the inner and outer surfaces come into close ")
  #line-at(72pt, 226.08pt, "proximity. At a specific volume threshold, the surface converges toward a more uniform thickness. ")
  #line-at(72pt, 241.92pt, "Increasing the volume beyond this point leads to an overall thicker shell. Across all cases, the ")
  #line-at(72pt, 257.88pt, "thickness at the boundary interfaces remains fixed by the predefined boundary geometry. ")
  #line-at(72pt, 281.76pt, "These examples demonstrate that enclosed volume provides a straightforward means of adjusting ")
  #line-at(72pt, 297.6pt, "the global shell characteristics while preserving the minimal-surface topology imposed by the ")
  #line-at(72pt, 313.44pt, "boundary conditions. ")
  #set text(font: "Times New Roman", size: 12pt, weight: "bold", style: "normal", fill: rgb("#000000"))
  #line-at(72pt, 603.36pt, "Figure 4:")
  #set text(font: "Times New Roman", size: 12pt, weight: "regular", style: "normal", fill: rgb("#000000"))
  #line-at(118.2pt, 603.36pt, " Influence of liquid volume on the wall-thickness distribution of a LiquiBrick. (a–d) ")
  #line-at(72pt, 619.2pt, "Sectioning of a representative geometry along a diagonal plane to reveal its internal structure. (e-h) ")
  #line-at(72pt, 635.16pt, "Units generated from identical boundary conditions with different liquid volumes, showing how ")
  #line-at(72pt, 651pt, "small volumes create areas where surfaces approach each other, intermediate volumes yield a more ")
  #line-at(72pt, 666.84pt, "uniform thickness, and larger volumes produce thicker shells. In all cases, the boundary-interface ")
  #line-at(72pt, 682.68pt, "thickness is fixed by the ring geometry. ")
]

